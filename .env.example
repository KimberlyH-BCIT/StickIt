# Optional local overrides for docker compose
# Copy to .env and fill in only the values you need.

DEFAULT_CONNECTION_STRING=Data Source=/app/Data/app.db;Cache=Shared
IMAGESTORE_CONNECTION_STRING=Data Source=/app/Data/ImageStore.db

# Optional seeded admin account for local review
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional external integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
