# E2E Testing Environment Variables Example
# Copy this file to .env and update with your test credentials

# Test user credentials for E2E testing
E2E_EMAIL=your-test-email@example.com
E2E_PASSWORD=your-test-password

# Optional: Base URL for testing (defaults to localhost)
E2E_BASE_URL=http://localhost:5000

# Optional: Browser settings
E2E_HEADLESS=true
E2E_BROWSER=chromium