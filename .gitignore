appsettings.Development.json
appsettings.Staging.json
appsettings.Production.json
appsettings.*.json

# FileEmailSender output directory — may contain sensitive email content
SavedEmails/
**/SavedEmails/

# Environment variables
.env
.env.*
.env.local
.env.development
.env.staging
.env.production
!.env.example

