@{
    ViewData["Title"] = "About StickIt | Story, Architecture, and Storefront Vision";
}

@section title {
    <header class="mb-4">
        <h1 class="fw-bold">About StickIt</h1>
        <p class="text-muted mb-0">
            Learn how StickIt combines storefront UX, systems thinking, and production-ready .NET architecture
        </p>
    </header>
}

<main class="container py-5" role="main">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <section aria-labelledby="our-story-heading">
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h2 id="our-story-heading" class="card-title mb-3 h5">Our Story</h2>
                        <p>StickIt is the public-facing portfolio identity for this sticker storefront application. It highlights a complete eCommerce experience built with ASP.NET Core, Razor Pages, role-based workflows, and maintainable architecture.</p>
                        <p>The platform began as a group systems project and has since been hardened in this branch as a portfolio piece, with extra attention on branding consistency, deployment readiness, observability, and overall software quality.</p>
                    </div>
                </div>
            </section>

            <section aria-labelledby="offerings-heading">
                <div class="card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h2 id="offerings-heading" class="card-title mb-3 h5">What We Offer</h2>
                        <div class="row g-3" role="list" aria-label="Our key offerings and features">
                            <div class="col-md-6" role="listitem">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-patch-check-fill text-primary me-3 fs-4" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="h6">Premium Quality</h3>
                                        <p class="small text-muted mb-0">A polished storefront experience backed by durable product presentation and accessible UI patterns</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" role="listitem">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-palette-fill text-primary me-3 fs-4" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="h6">Unique Designs</h3>
                                        <p class="small text-muted mb-0">Product discovery, filtering, and search flows designed to showcase a curated catalog</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" role="listitem">
                                <div class="d-flex align-items-start">
                                    <i class="bi bi-truck text-primary me-3 fs-4" aria-hidden="true"></i>
                                    <div>
                                        <h3 class="h6">Fast Shipping</h3>
                                        <p class="small text-muted mb-0">Checkout, fulfillment, and order lifecycle flows that demonstrate end-to-end commerce implementation</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6" role="listitem">
                                <div class="d-flex align-items-start">
                                <i class="bi bi-heart-fill text-primary me-3 fs-4"></i>
                                <div>
                                    <h6>Customer First</h6>
                                    <p class="small text-muted mb-0">Admin, staff, and customer features that reflect real-world operational needs</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3">What This Portfolio Emphasizes</h5>
                    <ul class="mb-0">
                        <li class="mb-2"><strong>Architecture:</strong> Clear layering, separation of concerns, and practical maintainability</li>
                        <li class="mb-2"><strong>Product Thinking:</strong> User journeys that feel coherent from browsing through checkout</li>
                        <li class="mb-2"><strong>Operations:</strong> Docker readiness, health checks, monitoring, and deployment documentation</li>
                        <li><strong>Honest Iteration:</strong> Clear acknowledgement of the original team project and the follow-on hardening work in this branch</li>
                    </ul>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body p-4 text-center">
                    <h5 class="card-title mb-3">Explore the Project</h5>
                    <p>Review the storefront, documentation, and deployment materials to see how the StickIt portfolio branch presents the project as a cohesive product.</p>
                    <div class="d-flex gap-3 justify-content-center fs-4">
                        <a class="text-dark" href="#"><i class="bi bi-instagram"></i></a>
                        <a class="text-dark" href="#"><i class="bi bi-facebook"></i></a>
                        <a class="text-dark" href="#"><i class="bi bi-youtube"></i></a>
                        <a class="text-dark" href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>
            </div>

            <div class="alert alert-primary mt-4">
                <i class="bi bi-envelope me-2"></i>
                Have questions or want to learn more? <a asp-action="Contact" class="alert-link">Get in touch</a> to discuss the architecture, implementation choices, or portfolio hardening work.
            </div>
        </div>
    </div>
</div>
