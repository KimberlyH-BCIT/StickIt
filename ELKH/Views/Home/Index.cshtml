                       style="font-weight: 500;"
                       aria-label="Shop sample pack stickers - Waterproof and durable options">Shop stickers</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6">
            <article class="kawaii-card surface-mint h-100 p-4 shadow-sm d-flex flex-column">
                <div class="kawaii-image-container rounded-3 overflow-hidden mb-3 shadow-sm">
                    <img src="~/Images/StickIt_Logo.jpg"
                         asp-append-version="true"
                         alt="Die-cut stickers preview showing StickIt logo design"
                         class="w-100"
                         style="height:200px; object-fit:cover;" />
                </div>
                <h3 class="font-heading mb-2" style="font-size: 1.5rem;">Die-Cut Stickers</h3>
                <p class="hierarchy-secondary mb-3" style="font-size: 0.9375rem; flex-grow: 1;">
                    <i class="bi bi-scissors me-1" style="color: var(--purple);" aria-hidden="true"></i>Any shape •
                    <i class="bi bi-gem me-1" style="color: var(--purple);" aria-hidden="true"></i>Premium finish
                </p>
                <div class="mt-auto">
                    <a asp-controller="Product" asp-action="Index" 
                       class="btn-kawaii btn-outline-kawaii w-100 py-2"
                       style="font-weight: 500;"
                       aria-label="Shop die-cut stickers - Custom shapes with premium finish">Shop stickers</a>
                </div>
            </article>
        </div>

        <div class="col-lg-4 col-md-6">
            <article class="kawaii-card surface-sky h-100 p-4 shadow-sm d-flex flex-column">
                <div class="kawaii-image-container rounded-3 overflow-hidden mb-3 shadow-sm">
                    <img src="~/Images/StickIt_Logo.jpg"
                         asp-append-version="true"
                         alt="Premium quality stickers preview showing StickIt logo design"
                         class="w-100"
                         style="height:200px; object-fit:cover;" />
                </div>
                <h3 class="font-heading mb-2" style="font-size: 1.5rem;">Premium Quality</h3>
                <p class="hierarchy-secondary mb-3" style="font-size: 0.9375rem; flex-grow: 1;">
                    <i class="bi bi-droplet me-1" style="color: var(--purple);" aria-hidden="true"></i>Waterproof •
                    <i class="bi bi-shield me-1" style="color: var(--purple);" aria-hidden="true"></i>Durable •
                    <i class="bi bi-star me-1" style="color: var(--purple);" aria-hidden="true"></i>Scratch-resistant
                </p>
                <div class="mt-auto">
                    <a asp-controller="Product" asp-action="Index" 
                       class="btn-kawaii btn-outline-kawaii w-100 py-2"
                       style="font-weight: 500;"
                       aria-label="Shop premium quality stickers - Waterproof and durable options">Shop stickers</a>
                </div>
            </article>
        </div>
    </div>

        <!-- =========================================================================== -->
        <!-- ║ FAQ Section - Frequently Asked Questions with Bootstrap Accordion     ║ -->
        <!-- =========================================================================== -->
        <section class="mt-5 mb-5" aria-labelledby="faq-heading">
            <div class="text-center mb-4">
                <h2 id="faq-heading" class="font-heading" style="font-size: 2rem; margin-bottom: 0.5rem;">Frequently Asked Questions</h2>
                <p class="hierarchy-tertiary" style="font-size: 1rem;">Quick answers to common questions</p>
            </div>

            <div class="accordion mt-3" id="faqAccordion" role="tablist" aria-label="Frequently Asked Questions" style="max-width: 800px; margin-left: auto; margin-right: auto;">
                <div class="accordion-item mb-2 border-0 shadow-sm rounded-3 overflow-hidden">
                    <h3 class="accordion-header" id="q1">
                        <button class="accordion-button" 
                                type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#a1"
                                aria-expanded="true"
                                aria-controls="a1"
                                role="tab"
                                style="font-size: 1.0625rem; font-weight: 600; padding: 1.25rem 1.5rem;">
                            How long does delivery take?
                        </button>
                    </h3>
                    <div id="a1" 
                         class="accordion-collapse collapse show" 
                         data-bs-parent="#faqAccordion"
                         role="tabpanel"
                         aria-labelledby="q1">
                        <div class="accordion-body hierarchy-secondary" style="padding: 1.25rem 1.5rem; font-size: 1rem;">Most orders ship quickly once confirmed.</div>
                    </div>
                </div>

                <div class="accordion-item mb-2 border-0 shadow-sm rounded-3 overflow-hidden">
                    <h3 class="accordion-header" id="q2">
                        <button class="accordion-button collapsed" 
                                type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#a2"
                                aria-expanded="false"
                                aria-controls="a2"
                                role="tab"
                                style="font-size: 1.0625rem; font-weight: 600; padding: 1.25rem 1.5rem;">
                            Can I refund my order?
                        </button>
                    </h3>
                    <div id="a2" 
                         class="accordion-collapse collapse" 
                         data-bs-parent="#faqAccordion"
                         role="tabpanel"
                         aria-labelledby="q2">
                        <div class="accordion-body hierarchy-secondary" style="padding: 1.25rem 1.5rem; font-size: 1rem;">
                            <p class="mb-3">No. This is a non-refundable purchase.</p>
                            <a asp-controller="Order" asp-action="MyHistory" 
                               class="btn-kawaii btn-outline-kawaii btn-sm px-3 py-2"
                               style="font-weight: 500;"
                               aria-label="View my order history">My Orders</a>
                        </div>
                    </div>
                </div>

                <div class="accordion-item mb-2 border-0 shadow-sm rounded-3 overflow-hidden">
                    <h3 class="accordion-header" id="q3">
                        <button class="accordion-button collapsed" 
                                type="button" 
                                data-bs-toggle="collapse" 
                                data-bs-target="#a3"
                                aria-expanded="false"
                                aria-controls="a3"
                                role="tab"
                                style="font-size: 1.0625rem; font-weight: 600; padding: 1.25rem 1.5rem;">
                            What materials do you offer?
                        </button>
                    </h3>
                    <div id="a3" 
                         class="accordion-collapse collapse" 
                         data-bs-parent="#faqAccordion"
                         role="tabpanel"
                         aria-labelledby="q3">
                        <div class="accordion-body hierarchy-secondary" style="padding: 1.25rem 1.5rem; font-size: 1rem;">Stickers, labels, sheets and more.</div>
                    </div>
                </div>
            </div>
        </section>

        <!-- =========================================================================== -->
        <!-- ║ Customer Reviews Section - Dynamic carousel with pagination           ║ -->
        <!-- =========================================================================== -->
        <section id="reviews-section" class="py-5" aria-labelledby="reviews-heading">
            <div class="text-center mb-5">
                <h2 id="reviews-heading" class="font-heading" style="font-size: 2rem; margin-bottom: 0.5rem;">What Our Customers Say</h2>
                <p class="hierarchy-tertiary" style="font-size: 1.0625rem;">Real words from real sticker lovers.</p>
            </div>

            @if (hasReviews)
            {
                <!-- ======================================================================= -->
                <!-- ║ Review Carousel Container - Shows max 3 reviews with navigation   ║ -->
                <!-- ======================================================================= -->
                <div class="position-relative container-kawaii" role="region" aria-label="Customer reviews carousel">
                    <!-- Navigation Arrows -->
                    <button class="btn-kawaii btn-outline-kawaii rounded-circle position-absolute top-50 start-0 translate-middle-y shadow-sm" 
                            id="prevReview" 
                            style="width: 55px; height: 55px; z-index: 10; margin-left: -27px; font-size: 1.25rem;"
                            aria-label="Previous reviews"
                            title="Previous review"
                            role="button"
                            tabindex="0">
                        <i class="bi bi-chevron-left fw-bold" aria-hidden="true"></i>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="btn-kawaii btn-outline-kawaii rounded-circle position-absolute top-50 end-0 translate-middle-y shadow-sm" 
                            id="nextReview" 
                            style="width: 55px; height: 55px; z-index: 10; margin-right: -27px; font-size: 1.25rem;"
                            aria-label="Next reviews"
                            title="Next review"
                            role="button"
                            tabindex="0">
                        <i class="bi bi-chevron-right fw-bold" aria-hidden="true"></i>
                        <span class="visually-hidden">Next</span>
                    </button>

                    <!-- Review Cards: Display up to 3 reviews with alternating visual themes -->
                    <div id="reviewCarousel" class="row g-4" role="group" aria-live="polite" aria-label="Customer reviews">
                        @for (int i = 0; i < Math.Min(3, reviews?.Count ?? 0); i++)
                        {
                            var review = reviews?[i];
                            if (review == null) continue;

                            // ===================================================================
                            // ║ Alternating Card Theme Logic                                  ║
                            // ║ Even-indexed cards: Light theme with subtle green verified badge  ║
                            // ║ Odd-indexed cards:  Dark theme with warning-colored badge         ║
                            // ===================================================================
                            var isEven = i % 2 == 0;
                            var cardClass = isEven ? "card border-0 shadow-sm h-100 rounded-4" : "card border-0 shadow-sm h-100 rounded-4 bg-dark text-white";
                            var badgeClass = isEven ? "badge" : "badge bg-warning text-dark";
                            var badgeStyle = isEven ? "background: rgba(46,204,113,.15); color:#2ecc71;" : "";
                            var textClass = isEven ? "text-muted" : "text-white-50";
                            var bgClass = isEven ? "bg-light" : "bg-secondary";

                            <div class="col-md-4 review-card" data-index="@i" role="article" tabindex="0">
                                <article class="@cardClass" style="transition: transform 0.2s ease;">
                                    <div class="card-body p-4">
                                        <div class="d-flex align-items-center justify-content-between mb-3">
                                            @if (review.IsVerifiedBuyer)
                                            {
                                                <span class="@badgeClass px-3 py-1" style="@badgeStyle; font-size: 0.875rem; font-weight: 500; border-radius: 12px;" aria-label="Verified buyer">✓ Verified buyer</span>
                                            }
                                            else
                                            {
                                                <span></span>
                                            }
                                            <div class="text-warning" role="img" aria-label="@review.Rating out of 5 stars" style="font-size: 1.125rem;">
                                                @for (int s = 0; s < review.Rating; s++)
                                                {
                                                    <span aria-hidden="true">★</span>
                                                }
                                                <span class="visually-hidden">@review.Rating out of 5 stars</span>
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrEmpty(review.Title))
                                        {
                                            <h3 class="fw-bold mb-2 h6" style="font-size: 1.125rem;">@review.Title</h3>
                                        }
                                        <p class="@textClass mb-4" style="min-height: 100px; font-size: 0.9375rem; line-height: 1.6;">
                                            @review.Description
                                        </p>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="rounded-circle @bgClass d-flex align-items-center justify-content-center" 
                                                 style="width:45px;height:45px; flex-shrink: 0;"
                                                 role="img" 
                                                 aria-label="User avatar for @(review.RegisteredUser?.Email?.Split('@').FirstOrDefault() ?? "Anonymous")">
                                                <span class="fw-bold" style="font-size: 1.125rem;" aria-hidden="true">@(review.RegisteredUser?.Email?.FirstOrDefault().ToString().ToUpper() ?? "?")</span>
                                            </div>
                                            <div>
                                                <div class="fw-semibold" style="font-size: 0.9375rem;">@(review.RegisteredUser?.Email?.Split('@').FirstOrDefault() ?? "Anonymous")</div>
                                                <time class="@textClass small" datetime="@review.CreatedAt.ToString("yyyy-MM-dd")">@review.CreatedAt.ToString("MMM dd, yyyy")</time>
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>

                    <!-- Review indicators -->
                    @if ((reviews?.Count ?? 0) > 3)
                    {
                        <div class="text-center mt-3" role="status" aria-live="polite" aria-label="Review pagination status">
                            <span class="text-muted small" id="reviewPaginationStatus">
                                Showing <span id="currentReviewSet" aria-label="Current review set">1</span> - <span id="maxReviewSet" aria-label="Maximum review set">@((reviews?.Count ?? 0) - 2)</span> of <span aria-label="Total reviews">@(reviews?.Count ?? 0)</span> reviews
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <!-- No reviews yet - show placeholder -->
                <div class="text-center py-5" role="status" aria-label="No reviews available">
                    <i class="bi bi-chat-quote display-1 text-muted mb-3" aria-hidden="true"></i>
                    <p class="text-muted">Be the first to leave a review!</p>
                </div>
            }

            <div class="text-center mt-5">
                <a asp-controller="User" asp-action="LeaveReview" 
                   class="btn btn-warning btn-lg px-5 py-3 shadow-sm"
                   style="font-size: 1.125rem; font-weight: 600; border-radius: 12px;"
                   aria-label="Leave your review - Share your experience with our products">
                    <i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Leave Your Review
                </a>
            </div>
        </section>
    </div>
</section>
</main>

@section Scripts {
    @if (hasReviews && (reviews?.Count ?? 0) > 3)
    {
        <script>
            // Client-Side Review Carousel Logic - Handles pagination through customer reviews
            // Enhanced with accessibility features for keyboard navigation and screen readers

            // Serialize review data from server to JavaScript for client-side manipulation
            // Only includes necessary fields to minimize payload size
            const allReviews = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(reviews?.Select(r => new {
                r.Title,
                r.Rating,
                r.Description,
                r.IsVerifiedBuyer,
                r.CreatedAt,
                Email = r.RegisteredUser?.Email ?? "Anonymous"
            }) ?? Enumerable.Empty<object>()));

            // Pagination state management
            let currentStartIndex = 0;  // Current starting position in the review array
            const maxIndex = allReviews.length - 3;  // Maximum starting index (ensures 3 items always visible)

            // ===============================================================================
            // ║ Accessibility Enhancement Functions                                       ║
            // ===============================================================================

            // Announce changes to screen readers
            function announceToScreenReader(message) {
                const announcement = document.createElement('div');
                announcement.setAttribute('aria-live', 'polite');
                announcement.setAttribute('aria-atomic', 'true');
                announcement.className = 'visually-hidden';
                announcement.textContent = message;
                document.body.appendChild(announcement);

                // Remove after announcement
                setTimeout(() => {
                    document.body.removeChild(announcement);
                }, 1000);
            }

            // Update ARIA labels for navigation buttons
            function updateButtonStates() {
                const prevButton = document.getElementById('prevReview');
                const nextButton = document.getElementById('nextReview');

                // Update button states and ARIA attributes
                prevButton.disabled = currentStartIndex === 0;
                nextButton.disabled = currentStartIndex >= maxIndex;

                prevButton.setAttribute('aria-label', 
                    currentStartIndex === 0 ? 'Previous reviews (disabled)' : 'Previous reviews');
                nextButton.setAttribute('aria-label', 
                    currentStartIndex >= maxIndex ? 'Next reviews (disabled)' : 'Next reviews');
            }

            // ===============================================================================
            // ║ Navigation Event Handlers                                                 ║
            // ===============================================================================

            document.getElementById('prevReview').addEventListener('click', function() {
                if (currentStartIndex > 0) {
                    currentStartIndex--;
                    updateReviews();
                    announceToScreenReader(`Showing reviews ${currentStartIndex + 1} through ${currentStartIndex + 3}`);
                }
            });

            document.getElementById('nextReview').addEventListener('click', function() {
                if (currentStartIndex < maxIndex) {
                    currentStartIndex++;
                    updateReviews();
                    announceToScreenReader(`Showing reviews ${currentStartIndex + 1} through ${Math.min(currentStartIndex + 3, allReviews.length)}`);
                }
            });

            // Keyboard navigation for carousel
            document.addEventListener('keydown', function(e) {
                // Only handle keyboard navigation when focus is on carousel elements
                if (e.target.id === 'prevReview' || e.target.id === 'nextReview' || e.target.closest('.review-card')) {
                    switch(e.key) {
                        case 'ArrowLeft':
                            e.preventDefault();
                            if (currentStartIndex > 0) {
                                document.getElementById('prevReview').click();
                            }
                            break;
                        case 'ArrowRight':
                            e.preventDefault();
                            if (currentStartIndex < maxIndex) {
                                document.getElementById('nextReview').click();
                            }
                            break;
                        case 'Home':
                            e.preventDefault();
                            if (currentStartIndex !== 0) {
                                currentStartIndex = 0;
                                updateReviews();
                                announceToScreenReader('Showing first set of reviews');
                            }
                            break;
                        case 'End':
                            e.preventDefault();
                            if (currentStartIndex !== maxIndex) {
                                currentStartIndex = maxIndex;
                                updateReviews();
                                announceToScreenReader('Showing last set of reviews');
                            }
                            break;
                    }
                }
            });

            // Dynamic DOM Update Function - Updates the 3 visible review cards with new data
            // Enhanced with accessibility features and focus management
            function updateReviews() {
                const reviewCards = document.querySelectorAll('.review-card');
                const activeElement = document.activeElement;
                let focusedCardIndex = null;

                // Remember which card had focus
                if (activeElement && activeElement.closest('.review-card')) {
                    const focusedCard = activeElement.closest('.review-card');
                    focusedCardIndex = Array.from(reviewCards).indexOf(focusedCard);
                }

                // Update each of the 3 visible review cards with new review data
                for (let i = 0; i < 3; i++) {
                    const review = allReviews[currentStartIndex + i];
                    const card = reviewCards[i];

                    if (review && card) {
                        // Verified Buyer Badge Update
                        const badge = card.querySelector('.badge');
                        if (badge && review.IsVerifiedBuyer) {
                            badge.textContent = 'Verified buyer';
                            badge.setAttribute('aria-label', 'Verified buyer');
                            badge.style.display = '';
                        } else if (badge) {
                            badge.style.display = 'none';
                        }

                        // Star Rating Display Update with accessibility
                        const starsContainer = card.querySelector('.text-warning');
                        if (starsContainer) {
                            starsContainer.innerHTML = '★'.repeat(review.Rating) + 
                                `<span class="visually-hidden">${review.Rating} out of 5 stars</span>`;
                            starsContainer.setAttribute('aria-label', `${review.Rating} out of 5 stars`);
                        }

                        // Review Title Handling (Optional Field)
                        const titleElem = card.querySelector('h3.fw-bold') || card.querySelector('h6.fw-bold');
                        if (review.Title) {
                            if (titleElem) {
                                titleElem.textContent = review.Title;
                                titleElem.style.display = '';
                            } else {
                                // Create title element if it doesn't exist
                                const starsDiv = card.querySelector('.text-warning').parentElement.parentElement;
                                const newTitle = document.createElement('h3');
                                newTitle.className = 'fw-bold mb-2 h6';
                                newTitle.textContent = review.Title;
                                starsDiv.insertAdjacentElement('afterend', newTitle);
                            }
                        } else if (titleElem) {
                            titleElem.style.display = 'none';
                        }

                        // Update description
                        const description = card.querySelector('p');
                        if (description) {
                            description.textContent = review.Description;
                        }

                        // User Information Display (Name and Avatar) with accessibility
                        const avatar = card.querySelector('.rounded-circle');
                        const initial = avatar?.querySelector('span');
                        if (initial && avatar) {
                            const userName = review.Email.split('@@')[0];
                            initial.textContent = review.Email.charAt(0).toUpperCase();
                            avatar.setAttribute('aria-label', `User avatar for ${userName}`);
                        }

                        // Extract username from email (part before at symbol)
                        const username = card.querySelector('.fw-semibold');
                        if (username) {
                            username.textContent = review.Email.split('@@')[0];
                        }

                        // Date Formatting and Display with semantic time element
                        const dateElem = card.querySelector('time') || card.querySelectorAll('.small')[card.querySelectorAll('.small').length - 1];
                        if (dateElem) {
                            const reviewDate = new Date(review.CreatedAt);
                            const formattedDate = reviewDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                            dateElem.textContent = formattedDate;
                            if (dateElem.tagName.toLowerCase() === 'time') {
                                dateElem.setAttribute('datetime', review.CreatedAt);
                            }
                        }

                        // Update card accessibility
                        const reviewUser = review.Email.split('@@')[0];
                        const reviewSnippet = review.Description.substring(0, 100);
                        const ellipsis = review.Description.length > 100 ? '...' : '';
                        card.setAttribute('aria-label', `Review by ${reviewUser}, ${review.Rating} out of 5 stars: ${reviewSnippet}${ellipsis}`);
                    }
                }

                // ===========================================================================
                // ║ UI State Updates with Accessibility and Focus Management             ║
                // ===========================================================================

                // Update pagination indicator to show current position
                const currentReviewSetElem = document.getElementById('currentReviewSet');
                const maxReviewSetElem = document.getElementById('maxReviewSet');

                if (currentReviewSetElem && maxReviewSetElem) {
                    currentReviewSetElem.textContent = currentStartIndex + 1;

                    // Update ARIA live region for screen readers
                    const carouselContainer = document.getElementById('reviewCarousel');
                    if (carouselContainer) {
                        carouselContainer.setAttribute('aria-label', 
                            `Customer reviews, showing ${currentStartIndex + 1} to ${Math.min(currentStartIndex + 3, allReviews.length)} of ${allReviews.length} reviews`);
                    }
                }

                // Update navigation button states and accessibility
                updateButtonStates();

                // Restore focus to the same relative position after content update
                if (focusedCardIndex !== null && reviewCards[focusedCardIndex]) {
                    // Use requestAnimationFrame to ensure DOM has been updated
                    requestAnimationFrame(() => {
                        reviewCards[focusedCardIndex].focus();
                    });
                }
            }

            // Initialize the carousel with proper button states and accessibility on page load
            document.addEventListener('DOMContentLoaded', function() {
                try {
                    updateReviews();

                    // Set initial ARIA labels
                    const carouselRegion = document.querySelector('[role="region"][aria-label*="carousel"]');
                    if (carouselRegion) {
                        carouselRegion.setAttribute('aria-label', `Customer reviews carousel with ${allReviews.length} total reviews`);
                    }

                    // Add instructions for keyboard users
                    const instructionsId = 'carousel-instructions';
                    if (!document.getElementById(instructionsId)) {
                        const instructions = document.createElement('div');
                        instructions.id = instructionsId;
                        instructions.className = 'visually-hidden';
                        instructions.setAttribute('aria-live', 'polite');
                        instructions.textContent = 'Use arrow keys to navigate between review sets, Home key for first set, End key for last set';
                        document.body.appendChild(instructions);
                    }

                    // Add WCAG compliance metadata
                    const complianceInfo = document.createElement('div');
                    complianceInfo.className = 'visually-hidden';
                    complianceInfo.setAttribute('aria-label', 'Accessibility compliance information');
                    complianceInfo.textContent = 'This page follows WCAG 2.1 AA accessibility standards with semantic HTML, ARIA labels, keyboard navigation, and screen reader support';
                    document.body.appendChild(complianceInfo);

                } catch (error) {
                    console.error('Error initializing review carousel accessibility features:', error);
                    // Graceful degradation - ensure basic functionality works
                    const navButtons = document.querySelectorAll('#prevReview, #nextReview');
                    navButtons.forEach(button => {
                        if (!button.hasAttribute('aria-label')) {
                            button.setAttribute('aria-label', button.id.includes('prev') ? 'Previous reviews' : 'Next reviews');
                        }
                    });
                }
            });
        </script>
    }
}
