@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HERO (dark) -->
<section class="bg-dark text-white" style="background: radial-gradient(1200px 600px at 15% 20%, #2b2b2b 0%, #111 45%, #0b0b0b 100%);">
    <div class="container py-5">
        <div class="row align-items-center g-4">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold lh-1 mb-3">Print Custom Stickers and Labels</h1>
                <p class="text-white-50 lead mb-4">
                    Express delivery, premium materials, and clean cuts.
                    Get an instant quote and shop our ready-made designs.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg px-4 fw-bold">
                        Make custom stickers
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                        All sticker products <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="d-flex flex-wrap gap-4 mt-4 small text-white-50">
                    <div><i class="bi bi-truck me-2"></i>Fast delivery</div>
                    <div><i class="bi bi-stars me-2"></i>Premium finish</div>
                    <div><i class="bi bi-shield-check me-2"></i>Secure checkout</div>
                </div>
            </div>
            <div class="col-lg-6">
                
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="fw-semibold">Trending 🔥</div>
                    <span class="badge text-bg-warning">Hot</span>
                </div>
                <div class="row g-3">
                        
                    <div class="col-6">
                        <div class="ratio ratio-1x1 rounded-4 overflow-hidden" style="background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.12);">
                            <div class="d-flex align-items-center justify-content-center">
                                <div class="text-center px-3">
                                    <div class="fs-1">🏷️</div>
                                    <div class="fw-bold">Labels</div>
                                    <div class="small text-white-50">product ready</div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                    </div>
                </div>
                <div class="mt-4 d-flex justify-content-between align-items-center">
                    <div class="small text-white-50">Browse the full catalog</div>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-light">Shop now</a>
                </div>
            </div>
        </div>
    </div>
</div>
</section>

<!-- CATEGORY TILES -->
<section class="bg-light">
    <div class="container py-4 py-lg-5">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <a asp-controller="Product" asp-action="Index" class="text-decoration-none">
                    <div class="p-3 rounded-4 bg-white border h-100">
                        <div class="fw-bold">Sample Packs</div>
                        <div class="text-muted small">Pick your perfect mix</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="Product" asp-action="Index" class="text-decoration-none">
                    <div class="p-3 rounded-4 bg-white border h-100">
                        <div class="fw-bold">Die-Cut</div>
                        <div class="text-muted small">Any shape</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="Product" asp-action="Index" class="text-decoration-none">
                    <div class="p-3 rounded-4 bg-white border h-100">
                        <div class="fw-bold">Sticker Sheets</div>
                        <div class="text-muted small">Multiple designs</div>
                    </div>
                </a>
            </div>
            <div class="col-6 col-lg-3">
                <a asp-controller="Product" asp-action="Index" class="text-decoration-none">
                    <div class="p-3 rounded-4 bg-white border h-100">
                        <div class="fw-bold">Labels on Roll</div>
                        <div class="text-muted small">Perfect for products</div>
                    </div>
                </a>
            </div>
        </div>

        <!-- Two feature cards -->
        <div class="mt-5">
            <h2 class="fw-bold mb-2">Premium and create with confidence</h2>
            <p class="text-muted">High-quality materials, clean cuts, and designs that stand out.</p>

            <div class="row g-3 mt-2">
                <div class="col-lg-6">
                    <div class="p-4 rounded-4 text-white" style="background:#111;">
                        <div class="fw-bold">Sample Packs</div>
                        <div class="text-white-50 small mb-3">Waterproof • durable • scratch-resistant</div>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light btn-sm">Shop stickers</a>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="p-4 rounded-4 text-white" style="background:#111;">
                        <div class="fw-bold">Sample Packs</div>
                        <div class="text-white-50 small mb-3">Waterproof • durable • scratch-resistant</div>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light btn-sm">Shop stickers</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- How-to + CTA -->
        <div class="row g-3 mt-5 align-items-stretch">
            
            <div class="col-lg-6">
                <div class="p-4 rounded-4 text-white h-100" style="background:#111;">
                    <div class="fw-bold mb-2">Sample Packs</div>
                    <div class="text-white-50">Waterproof • durable • scratch-resistant</div>
                    <div class="mt-3">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light">Shop stickers</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- FAQ -->
        <div class="mt-5">
            <h2 class="fw-bold mb-1">FAQ</h2>
            <div class="text-muted">Quick answers to common questions</div>

            <div class="accordion mt-3" id="faqAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="q1">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#a1">
                            How long does delivery take?
                        </button>
                    </h2>
                    <div id="a1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">Most orders ship quickly once confirmed.</div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header" id="q2">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a2">
                            Can I refund my order?
                        </button>
                    </h2>
                    <div id="a2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">No.This is a non-refundable purchase.</div>
                        <a asp-controller="Order" asp-action="History" class="btn btn-sm btn-outline-dark mt-2">My Orders</a>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header" id="q3">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a3">
                            What materials do you offer?
                        </button>
                    </h2>
                    <div id="a3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">Stickers, labels, sheets and more.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BOTTOM CTA -->
        <div class="mt-5 p-4 p-lg-5 rounded-4" style="background:#111;">
            <div class="row align-items-center g-3">
                <div class="col-lg-8 text-white">
                    <h2 class="fw-bold mb-1">Try before you buy</h2>
                    <div class="text-white-50">Get a feel for our materials and print quality.</div>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg fw-bold w-100 w-lg-auto">Shop All Products</a>
                </div>
            </div>
        </div>

    </div>
</section>