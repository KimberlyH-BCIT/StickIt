@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center hero-box">
    
    <img src="~/logo-stickit.png" class="hero-image" />
    <h1 class="hero-title">
        🌸 Welcome to <span class="brand-text">StickIt</span> 🌸
    </h1>

    <p class="hero-subtitle">
        Your happy place for cute, pastel, and kawaii stickers.
    </p>

    <p class="hero-description">
        Discover adorable sticker collections, limited editions, and
        colorful designs that brighten your laptop, journal,
        phone case, and more.
    </p>

    <div class="mt-4">
        <a class="btn kawaii-btn-purple me-3">
            Browse Stickers
        </a>
        <a class="btn kawaii-btn-pink">
            Design Your Sticker
        </a>
    </div>
</div>