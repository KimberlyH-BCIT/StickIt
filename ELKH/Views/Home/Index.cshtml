@{
    ViewData["Title"] = "Home";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- HERO (layout kept the same, colors are controlled by site.css) -->
<section class="bg-dark text-white w-100">
    <div class="container-fluid px-0">
        <div class="row align-items-center g-4 mx-0">
            <div class="col-lg-6">
                <h1 class="display-5 fw-bold lh-1 mb-3">Print Premium Stickers for you</h1>
                <p class="text-white-50 lead mb-4">
                    Express delivery, premium materials, and clean cuts.
                    Get an instant quote and shop our ready-made designs.
                </p>

                <div class="d-flex flex-wrap gap-3">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-warning btn-lg px-4 fw-bold">
                        New Arrivals
                    </a>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light btn-lg px-4">
                        All sticker products <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

                <div class="d-flex flex-wrap gap-4 mt-4 small text-white-50">
                    <div><i class="bi bi-truck me-2"></i>Fast delivery</div>
                    <div><i class="bi bi-stars me-2"></i>Premium finish</div>
                    <div><i class="bi bi-shield-check me-2"></i>Secure checkout</div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="fw-semibold">Trending 🔥</div>
                    <span class="badge text-bg-warning">Hot</span>
                </div>

                <div class="rounded-4 overflow-hidden" style="border: 1px solid rgba(255,255,255,.12);">
                    <img src="~/Images/StickIt_Logo.jpg"
                         asp-append-version="true"
                         alt="Trending stickers"
                         class="w-100"
                         style="height:360px; object-fit:cover;" />
                </div>

                <div class="mt-4 d-flex justify-content-between align-items-center">
                    <div class="small text-white-50">Browse the full catalog</div>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-light">Shop now</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- FEATURE CARDS -->
<section class="bg-light">
    <div class="container py-4 py-lg-5">
        <h2 class="fw-bold mb-2">Premium and create with confidence</h2>
        <p class="text-muted">High-quality materials, clean cuts, and designs that stand out.</p>

        <div class="row g-3 mt-2">
            <div class="col-lg-6">
                <div class="p-4 rounded-4 text-white" style="background:#111;">
                    <div class="rounded-4 overflow-hidden" style="height:190px;">
                        <img src="~/Images/StickIt_Logo.jpg"
                             asp-append-version="true"
                             alt="Sticker preview"
                             class="w-100 h-100"
                             style="object-fit:cover;" />
                    </div>
                    <div class="fw-bold mt-3">Sample Packs</div>
                    <div class="text-white-50 small mb-3">Waterproof • durable • scratch-resistant</div>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light btn-sm">Shop stickers</a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="p-4 rounded-4 text-white" style="background:#111;">
                    <div class="rounded-4 overflow-hidden" style="height:190px;">
                        <img src="~/Images/StickIt_Logo.jpg"
                             asp-append-version="true"
                             alt="Sticker preview"
                             class="w-100 h-100"
                             style="object-fit:cover;" />
                    </div>
                    <div class="fw-bold mt-3">Die-Cut Stickers</div>
                    <div class="text-white-50 small mb-3">Any shape • premium finish</div>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light btn-sm">Shop stickers</a>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-4">
            <div class="col-lg-6">
                <div class="p-4 rounded-4 text-white" style="background:#111;">
                    <div class="rounded-4 overflow-hidden" style="height:190px;">
                        <img src="~/Images/StickIt_Logo.jpg"
                             asp-append-version="true"
                             alt="Sticker preview"
                             class="w-100 h-100"
                             style="object-fit:cover;" />
                    </div>
                    <div class="fw-bold mt-3">Sample Packs</div>
                    <div class="text-white-50 small mb-3">Waterproof • durable • scratch-resistant</div>
                    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-light btn-sm">Shop stickers</a>
                </div>
            </div>
        </div>

        <!-- FAQ -->
        <div class="mt-5">
            <h2 class="fw-bold mb-1">FAQ</h2>
            <div class="text-muted">Quick answers to common questions</div>

            <div class="accordion mt-3" id="faqAccordion">
                <div class="accordion-item">
                    <h2 class="accordion-header" id="q1">
                        <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#a1">
                            How long does delivery take?
                        </button>
                    </h2>
                    <div id="a1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">Most orders ship quickly once confirmed.</div>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header" id="q2">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a2">
                            Can I refund my order?
                        </button>
                    </h2>
                    <div id="a2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">No. This is a non-refundable purchase.</div>
                        <a asp-controller="Order" asp-action="History" class="btn btn-sm btn-outline-dark mt-2">My Orders</a>
                    </div>
                </div>

                <div class="accordion-item">
                    <h2 class="accordion-header" id="q3">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#a3">
                            What materials do you offer?
                        </button>
                    </h2>
                    <div id="a3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                        <div class="accordion-body text-muted">Stickers, labels, sheets and more.</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- REVIEWS -->
        <section class="py-5">
            <h2 class="fw-bold mb-1 text-center">What our beloved Customers Say!</h2>
            <p class="text-muted text-center mb-4">Real words from real sticker lovers.</p>

            <div class="row g-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge" style="background: rgba(46,204,113,.15); color:#2ecc71;">Verified buyer</span>
                                <span class="text-warning">★★★★★</span>
                            </div>
                            <h5 class="fw-bold mb-2">“Great quality and super fast!”</h5>
                            <p class="text-muted mb-4">
                                The cuts are clean, the colors pop, and shipping was quicker than I expected.
                                I’m already planning my next order.
                            </p>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                    <span class="fw-bold">J</span>
                                </div>
                                <div>
                                    <div class="fw-semibold">Lovedeep</div>
                                    <div class="text-muted small">Sticker sheets</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100 rounded-4" style="background:#111; color:white;">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge bg-warning text-dark">Verified buyer</span>
                                <span class="text-warning">★★★★★</span>
                            </div>
                            <h5 class="fw-bold mb-2">“I'm loving it!”</h5>
                            <p class="text-white-50 mb-4">
                                The purchase was simple, checkout was smooth, and the stickers look premium.
                                Perfect for my small business packaging.
                            </p>
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                    <span class="fw-bold">N</span>
                                </div>
                                <div>
                                    <div class="fw-semibold">Evan</div>
                                    <div class="text-white-50 small">Labels</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100 rounded-4">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="badge" style="background: rgba(46,204,113,.15); color:#2ecc71;">Verified buyer</span>
                                <span class="text-warning">★★★★★</span>
                            </div>
                            <h5 class="fw-bold mb-2">“Durable and looks stunning!”</h5>
                            <p class="text-muted mb-4">
                                I put mine on my laptop and water bottle, still looks brand new.
                                The finish is smooth and the print is sharp.
                            </p>
                            <div class="d-fle   x align-items-center gap-2">
                                <div class="rounded-circle bg-light d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                    <span class="fw-bold">L</span>
                                </div>
                                <div>
                                    <div class="fw-semibold">Kimberly</div>
                                    <div class="text-muted small">Sticker sheets</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <a asp-controller="User" asp-action="LeaveReview" class="btn btn-warning btn-lg px-4">
                    Leave your reviews
                </a>
            </div>
        </section>
    </div>
</section>