@{
    ViewData["Title"] = "Accessibility Statement";
}

<div class="container-kawaii py-4 py-md-5">
    <header class="kawaii-hero mb-4" aria-labelledby="accessibility-statement-heading">
        <h1 id="accessibility-statement-heading" class="kawaii-cloud-title font-heading">
            @ViewData["Title"]
        </h1>
        <p class="kawaii-subtitle">A short statement of the current accessibility patterns and dated evidence available in this branch.</p>
    </header>

    <main id="main-content" role="main">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5">
                        <h2 class="font-heading hierarchy-primary mb-3">Our commitment</h2>
                        <p class="hierarchy-secondary mb-3">ELKH Stickers has documented accessibility patterns in the shared layout and key storefront views, and the current branch should be reviewed against those implementation notes rather than assumed compliant.</p>
                        <p class="mb-0">This page summarizes the current in-repo accessibility posture. It is not a third-party certification and it should be read alongside the implementation notes in <code>docs/ACCESSIBILITY.md</code> and any dated audit artifacts checked into the repository.</p>
                    </div>
                </div>

                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5">
                        <h2 class="font-heading hierarchy-primary mb-3">Implemented patterns</h2>
                        <ul class="mb-0">
                            <li>Semantic HTML structure for navigation and content landmarks</li>
                            <li>Skip links and keyboard-friendly navigation patterns</li>
                            <li>ARIA labels, roles, and live regions for forms and status updates</li>
                            <li>Focus styling and reduced-motion support in the shared layout</li>
                            <li>Responsive layouts and visible form labels across storefront and Identity pages</li>
                        </ul>
                    </div>
                </div>

                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5">
                        <h2 class="font-heading hierarchy-primary mb-3">Known limitations</h2>
                        <p class="mb-0">The repository still needs committed axe/Lighthouse results, screen-reader notes tied to a reviewed build, and a short evidence checklist captured after a real accessibility review session.</p>
                    </div>
                </div>

                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5">
                        <h2 class="font-heading hierarchy-primary mb-3">Feedback</h2>
                        <p>If you encounter an accessibility barrier, please report it so it can be reviewed and documented.</p>
                        <ul class="mb-0">
                            <li>Email: accessibility@stickit.dev</li>
                            <li>Contact form: <a asp-action="Contact" class="kawaii-link">Contact Us</a></li>
                        </ul>
                    </div>
                </div>

                <div class="alert alert-info mt-4" role="status">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Last Updated:</strong> 2026-05-25
                </div>
            </div>
        </div>
    </main>
</div>
