@{
    ViewData["Title"] = "Accessibility Statement";
}

<!-- Skip Links for Keyboard Navigation -->
<nav class="skip-links sr-only-focusable" aria-label="Skip navigation">
    <a href="#accessibility-statement-heading" class="skip-link btn-kawaii btn-secondary-kawaii">Skip to accessibility statement</a>
    <a href="#main-content" class="skip-link btn-kawaii btn-secondary-kawaii">Skip to main content</a>
</nav>

<div class="container-kawaii py-4 py-md-5">
    <header class="kawaii-hero mb-4" aria-labelledby="accessibility-statement-heading">
        <h1 id="accessibility-statement-heading" class="kawaii-cloud-title font-heading">
            @ViewData["Title"]
        </h1>
        <p class="kawaii-subtitle">A short statement of the current accessibility patterns and dated evidence available in this branch.</p>
    </header>

    <main id="main-content" role="main">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Compliance Status Badge -->
                <div class="alert alert-success mb-4" role="status">
                    <i class="bi bi-check-circle me-2"></i>
                    <strong>WCAG 2.1 Level AA Ready:</strong> This storefront has been audited and designed to meet Web Content Accessibility Guidelines (WCAG) 2.1 Level AA standards.
                </div>

                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5">
                        <h2 class="font-heading hierarchy-primary mb-3">Our commitment</h2>
                        <p class="hierarchy-secondary mb-3">StickIt is committed to ensuring digital accessibility for people with disabilities. We continuously work to increase the usability and accessibility of our storefront and associated services.</p>
                        <p class="mb-0">This page documents our current accessibility features, patterns, and commitment. For detailed technical information, see the <a href="#documentation" class="kawaii-link">documentation section</a> below or review the full audit in <code>docs/AUDIT-CONSISTENCY-ACCESSIBILITY.md</code>.</p>
                    </div>
                </div>

                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5">
                        <h2 class="font-heading hierarchy-primary mb-3">Accessibility features</h2>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <h3 class="hierarchy-secondary mb-2">Navigation & Structure</h3>
                                <ul class="small mb-0">
                                    <li>✓ Semantic HTML landmarks (header, main, footer, nav)</li>
                                    <li>✓ Skip links on all public pages</li>
                                    <li>✓ Proper heading hierarchy (H1-H6)</li>
                                    <li>✓ Breadcrumb navigation</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h3 class="hierarchy-secondary mb-2">Forms & Input</h3>
                                <ul class="small mb-0">
                                    <li>✓ Associated labels on all form fields</li>
                                    <li>✓ Clear required field indicators</li>
                                    <li>✓ Error messages with role=alert</li>
                                    <li>✓ Descriptive help text</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h3 class="hierarchy-secondary mb-2">Visual & Motor</h3>
                                <ul class="small mb-0">
                                    <li>✓ 4.5:1 contrast ratio (WCAG AA)</li>
                                    <li>✓ 44×44px touch targets (WCAG AAA)</li>
                                    <li>✓ Keyboard-only navigation support</li>
                                    <li>✓ Focus indicators (outline + shadow)</li>
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h3 class="hierarchy-secondary mb-2">Assistive Technology</h3>
                                <ul class="small mb-0">
                                    <li>✓ ARIA labels and roles</li>
                                    <li>✓ Live regions for status updates</li>
                                    <li>✓ Reduced motion media query support</li>
                                    <li>✓ Screen reader friendly markup</li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5" id="documentation">
                        <h2 class="font-heading hierarchy-primary mb-3">Documentation & Evidence</h2>
                        <p class="mb-3">For developers and auditors, the following resources are available in the repository:</p>
                        <ul class="mb-0">
                            <li><strong>Accessibility Implementation Guide:</strong> <code>docs/ACCESSIBILITY.md</code> - Complete technical details of accessibility patterns</li>
                            <li><strong>Detailed Audit Report:</strong> <code>docs/AUDIT-CONSISTENCY-ACCESSIBILITY.md</code> - Full WCAG 2.1 compliance audit by page</li>
                            <li><strong>Remediation Roadmap:</strong> <code>docs/REMEDIATION-ROADMAP.md</code> - Implementation timeline and next steps</li>
                            <li><strong>Audit Index:</strong> <code>docs/AUDIT-INDEX.md</code> - Quick navigation guide to all audit documentation</li>
                        </ul>
                    </div>
                </div>

                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5">
                        <h2 class="font-heading hierarchy-primary mb-3">Known limitations & next steps</h2>
                        <p class="mb-3">We're committed to continuous improvement. Current areas for enhancement:</p>
                        <ul class="mb-0">
                            <li>Commitment to test with NVDA and JAWS screen readers (manual testing in progress)</li>
                            <li>Plan to commit Lighthouse and axe DevTools screenshots as evidence artifacts</li>
                            <li>Ongoing keyboard-only navigation testing across all browsers</li>
                            <li>Regular audits to maintain WCAG 2.1 Level AA compliance</li>
                        </ul>
                    </div>
                </div>

                <div class="kawaii-card mb-4">
                    <div class="p-4 p-md-5">
                        <h2 class="font-heading hierarchy-primary mb-3">Report an issue</h2>
                        <p class="mb-3">If you encounter an accessibility barrier, please help us improve by reporting it:</p>
                        <ul class="mb-0">
                            <li><strong>Email:</strong> <a href="mailto:accessibility@stickit.dev" class="kawaii-link">accessibility@stickit.dev</a></li>
                            <li><strong>Contact Form:</strong> <a asp-action="Contact" class="kawaii-link">Contact Us</a> - mention accessibility in your message</li>
                            <li><strong>GitHub Issues:</strong> <a href="https://github.com/Velyene/StickIt/issues" target="_blank" rel="noopener noreferrer" class="kawaii-link">Report on GitHub</a></li>
                        </ul>
                    </div>
                </div>

                <div class="alert alert-info mt-4" role="status">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Last Updated:</strong> 2026-05-25 &middot; 
                    <strong>Audit Date:</strong> May 2026 &middot; 
                    <strong>Status:</strong> WCAG 2.1 Level AA Ready
                </div>
            </div>
        </div>
    </main>
</div>
