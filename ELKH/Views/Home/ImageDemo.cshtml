@{
    ViewData["Title"] = "Image Optimization Demo";
}

<div class="container py-5">
    <div class="row">
        <div class="col-12">
            <h1>Image Optimization & Lazy Loading Demo</h1>
            <p class="lead">This page demonstrates the new image optimization and lazy loading features integrated with Kawaii UI theme.</p>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6">
            <h3>Optimized Image with Lazy Loading</h3>
            <p>This image uses the new <code>&lt;img optimized&gt;</code> tag helper:</p>
            
            <!-- Example of optimized image with lazy loading -->
            <img optimized
                 src="~/images/sample-product.jpg" 
                 alt="Sample Product with Optimization"
                 lazy="true"
                 responsive="true"
                 placeholder="blur"
                 width="300"
                 height="200"
                 class="img-fluid rounded shadow-sm" />
        </div>
        
        <div class="col-md-6">
            <h3>Standard Image</h3>
            <p>This is a regular image without optimization:</p>
            
            <!-- Standard image for comparison -->
            <img src="~/images/sample-product.jpg" 
                 alt="Sample Product without Optimization"
                 width="300"
                 height="200"
                 class="img-fluid rounded shadow-sm" />
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <h3>Kawaii UI Components Demo</h3>
            <p>Demonstrating the integrated Kawaii UI components:</p>
            
            <!-- Kawaii UI Tabs Demo -->
            <div data-tab-group="demo-tabs" class="mb-4">
                <div class="tab-nav">
                    <button data-tab="features" class="tab-button active" aria-selected="true">Features</button>
                    <button data-tab="benefits" class="tab-button" aria-selected="false">Benefits</button>
                    <button data-tab="performance" class="tab-button" aria-selected="false">Performance</button>
                </div>
                
                <div data-tab-panel="features" class="tab-panel">
                    <h4>🎨 New Features</h4>
                    <ul>
                        <li><strong>Image Optimization:</strong> Automatic WebP conversion and compression</li>
                        <li><strong>Lazy Loading:</strong> Images load only when they enter the viewport</li>
                        <li><strong>PWA Support:</strong> Offline capabilities and app installation</li>
                        <li><strong>Structured Logging:</strong> Enhanced logging with correlation IDs</li>
                        <li><strong>Kawaii Theme:</strong> Beautiful, playful design system</li>
                    </ul>
                </div>
                
                <div data-tab-panel="benefits" class="tab-panel" hidden>
                    <h4>📈 Benefits</h4>
                    <ul>
                        <li>Faster page load times with optimized images</li>
                        <li>Reduced bandwidth usage with lazy loading</li>
                        <li>Better mobile experience with PWA features</li>
                        <li>Improved debugging with correlation tracking</li>
                        <li>Enhanced user experience with Kawaii design</li>
                    </ul>
                </div>
                
                <div data-tab-panel="performance" class="tab-panel" hidden>
                    <h4>⚡ Performance</h4>
                    <ul>
                        <li>WebP images are 25-35% smaller than JPEG</li>
                        <li>Lazy loading reduces initial page weight by 60-80%</li>
                        <li>Service worker caches static assets for instant loading</li>
                        <li>Correlation IDs help track slow requests</li>
                    </ul>
                </div>
            </div>

            <!-- Kawaii UI Toggle Chips Demo -->
            <div class="mb-4">
                <h5>Toggle Features:</h5>
                <div class="chip-group">
                    <button data-chip-toggle class="chip" aria-pressed="false">
                        🎨 Kawaii Theme
                    </button>
                    <button data-chip-toggle class="chip" aria-pressed="false">
                        📱 PWA Mode
                    </button>
                    <button data-chip-toggle class="chip active" aria-pressed="true">
                        🖼️ Lazy Loading
                    </button>
                    <button data-chip-toggle class="chip" aria-pressed="false">
                        📊 Debug Logging
                    </button>
                </div>
            </div>

            <!-- Add to Cart Demo with Kawaii UI feedback -->
            <div class="mb-4">
                <h5>Interactive Demo:</h5>
                <button data-add-to-cart class="btn btn-primary kawaii-btn">
                    ✨ Add to Wishlist (Demo)
                </button>
            </div>
        </div>
    </div>

    <div class="row mt-5">
        <div class="col-12">
            <div class="alert alert-info">
                <h5>💡 Implementation Notes:</h5>
                <ul class="mb-0">
                    <li>All new assets are cached by the service worker for offline access</li>
                    <li>Images with the <code>optimized</code> attribute automatically use WebP format when supported</li>
                    <li>Correlation IDs are added to all requests for better logging and debugging</li>
                    <li>PWA manifest allows users to install the app on their devices</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Demo script to show interaction feedback
        document.addEventListener('DOMContentLoaded', function() {
            console.log('✅ Image optimization and Kawaii UI demo page loaded successfully');
            console.log('🎨 Kawaii theme CSS applied');
            console.log('🖼️ Lazy loading JavaScript initialized');
            console.log('📱 PWA service worker registered');
            
            // Log when images finish lazy loading
            document.addEventListener('load', function(e) {
                if (e.target.tagName === 'IMG' && e.target.classList.contains('lazy-image')) {
                    console.log('🖼️ Lazy loaded image:', e.target.src);
                }
            }, true);
        });
    </script>
}