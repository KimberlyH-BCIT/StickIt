@model ELKH.ViewModels.UserProfilePageVM

@{
    ViewData["Title"] = "Edit Profile - Manage Your Account Information | User Dashboard";
}

@section title {
    <header class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-action="Index" aria-label="Return to dashboard">Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Edit Profile</li>
            </ol>
        </nav>
        <h1 class="fw-bold">Edit Your Profile</h1>
        <p class="text-muted mb-0">
            Update your profile information, picture, and contact details
        </p>
    </header>
}

<main class="container py-4" role="main">
    @* ── Profile Picture ───────────────────────────────────────────────── *@
    <section aria-labelledby="profile-picture-heading">
        <div class="card mb-4">
            <div class="card-header">
                <h2 id="profile-picture-heading" class="mb-0 h5">Profile Picture</h2>
            </div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-4 flex-wrap">
                    <div>
                        @if (Model.Profile.HasAvatar)
                        {
                            <img src="@Url.Action("GetAvatar", "User")"
                                 alt="Your current profile picture"
                                 class="rounded-circle border"
                                 style="width:96px;height:96px;object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle border bg-secondary d-flex align-items-center justify-content-center text-white"
                                 style="width:96px;height:96px;font-size:2.5rem;"
                                 role="img"
                                 aria-label="Default profile picture placeholder">
                                <span aria-hidden="true">&#128100;</span>
                            </div>
                        }
                    </div>
                    <div class="flex-grow-1">
                        <form asp-action="UploadAvatar" 
                              method="post" 
                              enctype="multipart/form-data"
                              aria-labelledby="upload-avatar-heading">
                            @Html.AntiForgeryToken()
                            <fieldset>
                                <legend id="upload-avatar-heading" class="sr-only">Upload profile picture</legend>
                                <div class="mb-2">
                                    <label asp-for="AvatarFile" class="form-label small text-muted">
                                        Upload a new picture
                                    </label>
                                    <input asp-for="AvatarFile" 
                                           type="file" 
                                           class="form-control form-control-sm"
                                           accept="image/jpeg,image/png,image/gif,image/webp"
                                           aria-describedby="avatar-help" />
                                    <small id="avatar-help" class="form-text text-muted">
                                        Supported formats: JPEG, PNG, GIF, WebP. Maximum size: 10 MB
                                    </small>
                                </div>
                                <button type="submit" 
                                        class="btn btn-sm btn-primary"
                                        aria-describedby="avatar-help">
                                    Upload Picture
                                </button>
                            </fieldset>
                        </form>
                    </div>
                    @if (Model.Profile.HasAvatar)
                    {
                        <form asp-action="RemoveAvatar" 
                              method="post" 
                              class="mb-0"
                              aria-labelledby="remove-avatar-heading">
                            @Html.AntiForgeryToken()
                            <fieldset>
                                <legend id="remove-avatar-heading" class="sr-only">Remove profile picture</legend>
                                <button type="submit" 
                                        class="btn btn-sm btn-outline-danger"
                                        onclick="return confirm('Are you sure you want to remove your profile picture?')"
                                        aria-label="Remove your current profile picture">
                                    Remove Picture
                                </button>
                            </fieldset>
                        </form>
                    }
                </div>
            </div>
        </div>
    </section>

@* ── Account Information ───────────────────────────────────────────── *@
<section aria-labelledby="account-info-heading">
    <div class="card mb-4">
        <div class="card-header">
            <h2 id="account-info-heading" class="mb-0 h5">Account Information</h2>
        </div>
        <div class="card-body">
            <form asp-action="EditProfile" 
                  method="post"
                  novalidate
                  aria-labelledby="account-info-heading">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" 
                     class="alert alert-danger" 
                     role="alert"
                     aria-live="polite"
                     style="display: @(ViewData.ModelState.IsValid ? "none" : "block")">
                </div>

                <fieldset>
                    <legend class="sr-only">Personal information</legend>

                    <div class="mb-3">
                        <label class="form-label text-muted small">Email Address</label>
                        <p class="mb-0 fw-semibold" aria-label="Current email address @Model.Profile.PkEmail">
                            @Model.Profile.PkEmail
                        </p>
                        <small class="text-muted">
                            To change your email address, use the 
                            <a asp-area="Identity" asp-page="/Account/Manage/Index">account security settings</a>.
                        </small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Profile.FirstName" class="form-label fw-semibold">
                                <span aria-hidden="true">*</span> First Name
                            </label>
                            <input asp-for="Profile.FirstName" 
                                   class="form-control" 
                                   required
                                   aria-describedby="firstname-error firstname-help"
                                   autocomplete="given-name" />
                            <small id="firstname-help" class="form-text text-muted">
                                Enter your legal first name
                            </small>
                            <span id="firstname-error" asp-validation-for="Profile.FirstName" 
                                  class="text-danger small" role="alert" aria-live="polite"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Profile.LastName" class="form-label fw-semibold">
                                <span aria-hidden="true">*</span> Last Name
                            </label>
                            <input asp-for="Profile.LastName" 
                                   class="form-control" 
                                   required
                                   aria-describedby="lastname-error lastname-help"
                                   autocomplete="family-name" />
                            <small id="lastname-help" class="form-text text-muted">
                                Enter your legal last name
                            </small>
                            <span id="lastname-error" asp-validation-for="Profile.LastName" 
                                  class="text-danger small" role="alert" aria-live="polite"></span>
                        </div>
                    </div>

                    <button type="submit" 
                            class="btn btn-primary"
                            aria-describedby="save-changes-help">
                        <i class="bi bi-check2 me-1" aria-hidden="true"></i>Save Changes
                    </button>
                    <small id="save-changes-help" class="form-text text-muted d-block mt-2">
                        Changes will be saved to your profile immediately
                    </small>
                </fieldset>
            </form>
        </div>
    </div>
</section>

    @* ── Contact Details ───────────────────────────────────────────────── *@
    <section aria-labelledby="contact-details-heading">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h2 id="contact-details-heading" class="mb-0 h5">Saved Addresses</h2>
                <a class="btn btn-sm btn-outline-primary" 
                   asp-action="AddAddress"
                   aria-label="Add a new shipping address">
                    <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Add Address
                </a>
            </div>
            <div class="card-body">
                @if (!Model.Addresses.Any())
                {
                    <div class="text-center py-4">
                        <i class="bi bi-geo-alt fs-1 text-muted mb-2" aria-hidden="true"></i>
                        <p class="text-muted mb-3">No addresses saved yet.</p>
                        <a asp-action="AddAddress" 
                           class="btn btn-primary"
                           aria-label="Add your first shipping address">
                            Add Your First Address
                        </a>
                    </div>
                }
                else
                {
                    <div class="row g-3" role="list" aria-label="Saved shipping addresses">
                        @foreach (var address in Model.Addresses)
                        {
                            <div class="col-md-6" role="listitem">
                                <article class="card h-100 @(address.IsDefault ? "border-primary" : "")"
                                         aria-labelledby="address-@address.ContactId-name">
                                    <div class="card-body">
                                        @if (address.IsDefault)
                                        {
                                            <span class="badge bg-primary mb-2" 
                                                  role="status" 
                                                  aria-label="Default shipping address">
                                                Default
                                            </span>
                                        }
                                        <address class="mb-3">
                                            <strong id="address-@address.ContactId-name" class="d-block mb-1">
                                                @address.FirstName @address.LastName
                                            </strong>
                                            <span class="small text-muted d-block mb-1" 
                                                  aria-label="Phone @address.PhoneNumber">
                                                @address.PhoneNumber
                                            </span>
                                            <span class="small d-block">@address.Street</span>
                                            <span class="small d-block">
                                                @address.City, @address.Province @address.PostCode
                                            </span>
                                            <span class="small d-block">@address.Country</span>
                                        </address>

                                        <nav aria-label="Address actions for @address.FirstName @address.LastName">
                                            <div class="d-flex gap-2 flex-wrap">
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-action="EditAddress" 
                                                   asp-route-id="@address.ContactId"
                                                   aria-label="Edit address for @address.FirstName @address.LastName">
                                                    <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
                                                </a>
                                                <a class="btn btn-sm btn-outline-danger"
                                                   asp-action="DeleteAddress" 
                                                   asp-route-id="@address.ContactId"
                                                   aria-label="Delete address for @address.FirstName @address.LastName">
                                                    <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                                                </a>
                                                @if (!address.IsDefault)
                                                {
                                                    <form asp-action="SetDefaultAddress" 
                                                          asp-route-id="@address.ContactId"
                                                          method="post" 
                                                          class="mb-0"
                                                          aria-label="Set as default address">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" 
                                                                class="btn btn-sm btn-outline-primary"
                                                                aria-label="Set @address.FirstName @address.LastName address as default">
                                                            <i class="bi bi-star me-1" aria-hidden="true"></i>Set Default
                                                        </button>
                                                    </form>
                                                }
                                            </div>
                                        </nav>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </section>
</main>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <script>
        // Enhanced form validation accessibility
        document.addEventListener('DOMContentLoaded', function() {
            // Real-time validation feedback
            const requiredFields = document.querySelectorAll('[required]');

            requiredFields.forEach(field => {
                field.addEventListener('blur', function() {
                    const errorElement = document.getElementById(this.id.replace(/\./g, '_') + '-error') || 
                                        document.querySelector(`[data-valmsg-for="${this.name}"]`);

                    if (this.value.trim() === '' && errorElement) {
                        this.setAttribute('aria-invalid', 'true');
                    } else if (errorElement && errorElement.textContent.trim() === '') {
                        this.setAttribute('aria-invalid', 'false');
                    }
                });

                field.addEventListener('input', function() {
                    if (this.value.trim() !== '') {
                        this.setAttribute('aria-invalid', 'false');
                    }
                });
            });

            // File input enhancement
            const avatarInput = document.querySelector('input[type="file"]');
            if (avatarInput) {
                avatarInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        // Provide feedback about the selected file
                        const feedback = `Selected file: ${file.name} (${(file.size / 1024 / 1024).toFixed(2)} MB)`;

                        let feedbackElement = document.getElementById('file-feedback');
                        if (!feedbackElement) {
                            feedbackElement = document.createElement('div');
                            feedbackElement.id = 'file-feedback';
                            feedbackElement.className = 'small text-muted mt-1';
                            feedbackElement.setAttribute('aria-live', 'polite');
                            this.parentNode.appendChild(feedbackElement);
                        }

                        feedbackElement.textContent = feedback;
                    }
                });
            }

            // Confirmation dialogs accessibility enhancement
            const deleteButtons = document.querySelectorAll('[onclick*="confirm"]');
            deleteButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const message = this.getAttribute('onclick').match(/confirm\('([^']+)'\)/);
                    if (message && confirm(message[1])) {
                        // Proceed with the original action
                        if (this.type === 'submit') {
                            this.form.submit();
                        } else {
                            window.location.href = this.href;
                        }
                    }
                });
                button.removeAttribute('onclick');
            });
        });
    </script>
}
