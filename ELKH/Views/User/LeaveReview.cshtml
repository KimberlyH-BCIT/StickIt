@{
    ViewData["Title"] = "Leave a Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <h1 class="fw-bold mb-3">Leave a review ✍️</h1>
    <p class="text-muted mb-4">Tell us what you liked about the product.</p>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Product</label>
            <select class="form-select">
                <option>Sample Product A</option>
                <option>Sample Product B</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Rating</label>
            <select class="form-select">
                <option>5 - Amazing</option>
                <option>4 - Good</option>
                <option>3 - Okay</option>
                <option>2 - Not great</option>
                <option>1 - Bad</option>
            </select>
        </div>

        <div class="mb-3">
            <label class="form-label">Your review</label>
            <textarea class="form-control" rows="5" placeholder="Write your comment..."></textarea>
        </div>

        <button type="submit" class="btn btn-dark">Submit review</button>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
</div>