@model ELKH.ViewModels.OrderSectionVM

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="text-muted small">
        @Model.TotalItems order(s)
        @if (Model.TotalPages > 1)
        {
            <span>&mdash; Page @Model.CurrentPage of @Model.TotalPages</span>
        }
    </span>
    <select class="form-select form-select-sm w-auto dashboard-sort-select" aria-label="Sort active orders">
        <option value="date_desc"    selected="@(Model.CurrentSort == "date_desc"    ? "selected" : null)">Descending</option>
        <option value="date_asc"     selected="@(Model.CurrentSort == "date_asc"     ? "selected" : null)">Ascending</option>
        <option value="on_sale"      selected="@(Model.CurrentSort == "on_sale"      ? "selected" : null)">On Sale</option>
        <option value="most_popular" selected="@(Model.CurrentSort == "most_popular" ? "selected" : null)">Most Popular</option>
    </select>
</div>

@if (!Model.Items.Any())
{
    <p class="text-muted mb-0">
        @(Model.CurrentSort == "on_sale" ? "No active orders contain sale items." : "No active orders.")
    </p>
}
else
{
    <div class="row g-3">
        @foreach (var order in Model.Items)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 border-primary">
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <h6 class="card-title mb-0">Order #@order.OrderId</h6>
                            @{
                                var badgeClass = order.OrderStatus switch
                                {
                                    "Pending"    => "bg-warning text-dark",
                                    "Processing" => "bg-info text-dark",
                                    "Shipped"    => "bg-primary",
                                    "In Transit" => "bg-primary",
                                    _            => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@order.OrderStatus</span>
                        </div>
                        <p class="card-text small text-muted mb-1">Placed @order.CreatedAt.ToLocalTime().ToString("d MMM yyyy")</p>
                        <p class="card-text small mb-1">Delivery: <strong>@order.DeliveryStatus</strong></p>
                        <p class="card-text small mb-2">@order.ItemCount item(s) &mdash; @order.TotalAmount.ToString("C")</p>
                        <a class="btn btn-sm btn-outline-primary"
                           asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId">View Details</a>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        int pgStart = Math.Max(1, Model.CurrentPage - 2);
        int pgEnd   = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
        <nav class="mt-3" aria-label="Active orders page navigation">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link dashboard-page-link" data-page="@(Model.CurrentPage - 1)" href="#">&laquo;</a>
                </li>
                @if (pgStart > 1)
                {
                    <li class="page-item">
                        <a class="page-link dashboard-page-link" data-page="1" href="#">1</a>
                    </li>
                    @if (pgStart > 2)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                }
                @for (int i = pgStart; i <= pgEnd; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link dashboard-page-link" data-page="@i" href="#">@i</a>
                    </li>
                }
                @if (pgEnd < Model.TotalPages)
                {
                    @if (pgEnd < Model.TotalPages - 1)
                    {
                        <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                    }
                    <li class="page-item">
                        <a class="page-link dashboard-page-link" data-page="@Model.TotalPages" href="#">@Model.TotalPages</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link dashboard-page-link" data-page="@(Model.CurrentPage + 1)" href="#">&raquo;</a>
                </li>
            </ul>
        </nav>
    }
}
