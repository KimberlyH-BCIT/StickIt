@model ELKH.ViewModels.ContactDetailVM
@{
    ViewData["Title"] = "Add Address";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">My Account</a></li>
                <li class="breadcrumb-item"><a asp-action="Addresses">Addresses</a></li>
                <li class="breadcrumb-item active">Add Address</li>
            </ol>
        </nav>

        <div class="card shadow-sm">
            <div class="card-header fw-bold"><i class="bi bi-plus-circle me-2"></i>Add Address</div>
            <div class="card-body p-4">
                <form asp-action="AddAddress" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label fw-semibold"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label fw-semibold"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="e.g. 604-555-0100" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Street" class="form-label fw-semibold"></label>
                            <input asp-for="Street" class="form-control" placeholder="123 Main St" />
                            <span asp-validation-for="Street" class="text-danger small"></span>
                        </div>
                        <div class="col-md-5">
                            <label asp-for="City" class="form-label fw-semibold"></label>
                            <input asp-for="City" class="form-control" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Province" class="form-label fw-semibold"></label>
                            <input asp-for="Province" class="form-control" placeholder="BC" />
                            <span asp-validation-for="Province" class="text-danger small"></span>
                        </div>
                        <div class="col-md-3">
                            <label asp-for="PostCode" class="form-label fw-semibold"></label>
                            <input asp-for="PostCode" class="form-control" placeholder="V6B 1A1" />
                            <span asp-validation-for="PostCode" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Country" class="form-label fw-semibold"></label>
                            <input asp-for="Country" class="form-control" />
                            <span asp-validation-for="Country" class="text-danger small"></span>
                        </div>
                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="IsDefault" class="form-check-input" type="checkbox" />
                                <label asp-for="IsDefault" class="form-check-label">Set as my default address</label>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-1"></i>Save Address
                        </button>
                        <a asp-action="Addresses" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
