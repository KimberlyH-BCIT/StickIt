@model ELKH.ViewModels.ProductVM

@{
    ViewData["Title"] = "Product Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4 pb-5" style="max-width:900px;">

    @if (TempData["ImageDbError"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["ImageDbError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- ===== TOP NAV ===== -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <a asp-action="EditProduct" asp-route-id="@Model.ProductId"
           class="btn btn-primary rounded-pill px-4">✏️ Edit Product</a>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">← Back to Inventory</a>

    </div>


    <!-- ===== PRODUCT INFO ===== -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">

            <h3 class="fw-bold text-primary mb-4">@Model.ProductName</h3>

            <div class="row g-4">

                <div class="col-12">
                    <p class="text-muted small mb-1 fw-semibold text-uppercase tracking-wide">Description</p>
                    <p class="mb-0">@Model.Description</p>
                </div>

                
                <!-- ===== STATUS ===== -->
                <div class="mb-3">
                    <span class="badge rounded-pill px-3 py-2 fs-6 @(Model.IsActive ? "bg-success" : "bg-secondary")">
                        @(Model.IsActive ? "✅ Active" : "⛔ Inactive")
                    </span>
                </div>

                <div class="col-md-3 col-6">
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">Price</p>
                    <p class="mb-0 fw-bold fs-5 text-success">$@Model.Price.ToString("0.00")</p>
                </div>

                <div class="col-md-3 col-6">
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">Discount</p>
                    @if (Model.DiscountPercent > 0)
                    {
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1 fs-6">
                            @Model.DiscountPercent% OFF
                        </span>
                    }
                    else
                    {
                        <p class="mb-0 text-muted">None</p>
                    }
                </div>

                <div class="col-md-3 col-6">
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">Stock Quantity</p>
                    @{
                        int qty = Model.StockQuantity ?? 0;
                        string qtyClass = qty == 0 ? "bg-secondary" : qty < 50 ? "bg-danger" : "bg-success";
                    }
                    <span class="badge @qtyClass rounded-pill px-3 py-1 fs-6">@qty units</span>
                </div>

                <div class="col-md-3 col-6">
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">Category</p>
                    <p class="mb-0">@(string.IsNullOrEmpty(Model.CategoryName) ? "-" : Model.CategoryName)</p>
                </div>

                <div class="col-md-3 col-6">
                    <p class="text-muted small mb-1 fw-semibold text-uppercase">SKU / ID</p>
                    <p class="mb-0 text-muted">#@Model.ProductId</p>
                </div>

            </div>
        </div>
    </div>

    <!-- ===== IMAGE GALLERY ===== -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">📷 Product Images</h5>

            @if (Model.ExistingImages != null && Model.ExistingImages.Any())
            {
                <div class="d-flex flex-wrap gap-3">
                    @foreach (var img in Model.ExistingImages)
                    {
                        if (img?.ImageData != null)
                        {
                            <img src="data:image/jpeg;base64,@System.Convert.ToBase64String(img.ImageData)"
                                 class="rounded-3 shadow-sm"
                                 style="width:160px; height:160px; object-fit:cover; cursor:pointer;"
                                 onclick="openLightbox(this.src)"
                                 title="Click to enlarge" />
                        }
                    }
                </div>
            }
            else
            {
                <p class="text-muted mb-0">No images uploaded for this product.</p>
            }
        </div>
    </div>

</div>

<!-- ===== LIGHTBOX ===== -->
<div id="lightbox" onclick="closeLightbox()"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.8);
            z-index:9999; align-items:center; justify-content:center; cursor:zoom-out;">
    <img id="lightboxImg" src="" alt="enlarged"
         style="max-width:90vw; max-height:90vh; border-radius:12px;" />
</div>

<script>
    function openLightbox(src) {
        document.getElementById('lightboxImg').src = src;
        document.getElementById('lightbox').style.display = 'flex';
    }
    function closeLightbox() {
        document.getElementById('lightbox').style.display = 'none';
    }
</script>
