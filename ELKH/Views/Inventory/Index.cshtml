@model List<InventoryVM>

@{
    ViewData["Title"] = "Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4 px-4 pb-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="fw-bold text-primary mb-0">Inventory</h2>

        <a asp-action="AddProduct" class="btn btn-outline-primary rounded-pill px-4">
            Add Product
        </a>
    </div>

    <!-- Inventory Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">SKU</th>
                            <th>Product</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-center">Status</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var pro in Model)
                            {
                                string stockClass =
                                pro.Quantity == 0 ? "bg-secondary"
                                : pro.Quantity < 50 ? "bg-danger"
                                : "bg-success";

                                <tr class="@(pro.Quantity == 0 ? "table-secondary" : pro.Quantity < 50 ? "table-danger" : "")">

                                    <td class="ps-4 text-muted small">
                                        @pro.PkProductId
                                    </td>

                                    <td class="fw-semibold">
                                        @pro.ProductName
                                    </td>

                                    <!-- Quantity -->
                                    <td class="text-center">
                                        <span class="badge @stockClass px-2 py-1 rounded-pill">
                                            @pro.Quantity
                                        </span>
                                    </td>

                                    <!-- Active -->
                                    <td class="text-center">
                                        <span class="badge rounded-pill px-2 py-1 @(pro.IsActive ? "bg-success" : "bg-secondary")">
                                            @(pro.IsActive ? "✅ Active" : "⛔ Inactive")
                                        </span>
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">

                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            <!-- Edit Images -->
                                            @* <a asp-controller="Inventory"
                                                   asp-action="ProductImages"
                                                   asp-route-id="@pro.PkProductId"
                                                   class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                Images
                                            </a>

                                            <!-- Toggle Quantity Edit -->
                                            <button class="btn btn-sm btn-outline-secondary rounded-pill editQuantityBtn"
                                                    data-id="@pro.PkProductId">
                                                Edit Qty
                                            </button> *@

                                            <a asp-controller="Inventory"
                                                   asp-action="EditProduct"
                                                   asp-route-id="@pro.PkProductId"
                                                   class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                Edit
                                            </a>

                                        </div>

                                        <!-- Hidden Quantity Edit Area -->
                                        @* <div class="editQuantityArea mt-2 d-none"
                                             data-id="@pro.PkProductId">

                                            <form method="post"
                                                  asp-action="EditProductAmount"
                                                  asp-controller="Inventory"
                                                  class="d-flex justify-content-center gap-2">

                                                <input type="hidden"
                                                       name="productId"
                                                       value="@pro.PkProductId" />

                                                <input type="number"
                                                       name="quantityId"
                                                       value="@pro.Quantity"
                                                       class="form-control form-control-sm"
                                                       style="max-width:100px" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-success rounded-pill">
                                                    Update
                                                </button> 


                                            </form> 
                                    </div>*@

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">

                                    <span style="font-size:2.5rem;">📦</span>

                                    <p class="mt-2 mb-0">
                                        No inventory products found.
                                    </p>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const buttons = document.querySelectorAll(".editQuantityBtn");

        buttons.forEach(btn => {

            btn.addEventListener("click", function () {

                const id = this.dataset.id;

                const editArea = document.querySelector(`.editQuantityArea[data-id='${id}']`);

                if (editArea.classList.contains("d-none")) {
                    editArea.classList.remove("d-none");
                } else {
                    editArea.classList.add("d-none");
                }

            });

        });

    });
</script>