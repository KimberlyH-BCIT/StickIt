@model IEnumerable<ProductImageVM>

<table>
    <thead>
        <tr>
            <th>Images</th>
            <th>Action</th>
            <th>
                <a asp-action="AddImage" asp-controller="Inventory" asp-route-productId="@ViewBag.ProductId">Add Image</a>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var image in Model)
        {
            <tr>
                <td>
                    @if (image?.ImageData != null)
                    {
                        <img src="data:image/jpeg;base64,@System.Convert.ToBase64String(image.ImageData)" style="max-width:200px;max-height:200px;" />
                    }
                </td>
                <td>
                    <form method="post" asp-action="DeleteImage" onsubmit="return TrackUserInput()">
                        <input type="hidden" name="productId" value="@ViewBag.ProductId" />
                        <input type="hidden" name="imageId" value="@image.ImageId" />
                        <button type="submit">Delete Image</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
    function TrackUserInput(){
        return confirm("Are you sure you want to delete this image?")
    }
</script>