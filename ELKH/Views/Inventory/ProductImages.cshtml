@model IEnumerable<ProductImageVM>


@{
    ViewData["Title"] = "Product Images";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="font-heading text-purple mb-0">Add Product</h2>
    <a asp-action="Index" class="btn-kawaii btn-primary-kawaii radius-pill">
        Go Back To Product List
    </a>
    <a asp-controller="Product" asp-action="Edit" asp-route-id="@ViewBag.ProductId" class="btn-kawaii btn-secondary-kawaii radius-pill">
        Go Back To Edit
    </a>
</div>


<div class="container-fluid mt-4 px-4 pb-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">

        <a asp-action="AddImage"
               asp-controller="Inventory"
               asp-route-Id="@ViewBag.ProductId"
               class="btn-kawaii btn-primary-kawaii radius-pill sparkle">
            Add Image
        </a>
    </div>

    <!-- Image Table -->
    <div class="kawaii-card">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Image</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var image in Model)
                            {
                                <tr>

                                    <!-- Image -->
                                    <td class="ps-4">
                                        @if (image?.ImageData != null)
                                        {
                                            <img src="data:image/jpeg;base64,@System.Convert.ToBase64String(image.ImageData)"
                                                 class="rounded shadow-sm"
                                                 style="max-width:150px; max-height:150px;" />
                                        }
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center">

                                        <form method="post"
                                              asp-action="DeleteImage"
                                              onsubmit="return TrackUserInput()"
                                              class="d-inline">

                                            <input type="hidden" name="productId" value="@ViewBag.ProductId" />
                                            <input type="hidden" name="imageId" value="@image.ImageId" />

                                            <button type="submit"
                                                    class="btn-kawaii btn-outline-kawaii btn-sm radius-pill">
                                                Delete
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="2" class="text-center hierarchy-tertiary py-4">
                                    No images uploaded for this product.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>

<script>
    function TrackUserInput(){
        return confirm("Are you sure you want to delete this image?")
    }
</script>
