@model InventoryVM

<table>
    <thead>
        <tr>
            <th>Images</th>
            <th>Action</th>
            <th><a asp-action="AddImage" asp-controller="Inventory" asp-route-productId="@Model.PkProductId">Add Image</a></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var image in Model.ProductImage)
        {
            <tr>
                <td><img src="@image"/></td>
                <td><a>Edit</a></td>
            </tr>
        }
    </tbody>
</table>
