@model ProductVM

@{
    ViewData["Title"] = "Edit Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
        Go Back
    </a>
    <a asp-action="ProductImages" asp-route-Id="@ViewBag.Id" class="btn btn-outline-primary rounded-pill px-4">
        Edit Images
    </a>
    <a asp-action="AddImage" asp-route-Id="@ViewBag.Id" class="btn btn-outline-primary rounded-pill px-4">
        Add Image
    </a>
</div>

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-sm border-0 rounded-4" style="width:650px;">
        <div class="card-body p-5">

            <h2 class="fw-bold text-primary text-center mb-4">Edit Product</h2>

            <form asp-action="EditProduct" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="text-danger mb-3 text-center"></div>

                <input type="hidden" asp-for="ProductId" />

                <div class="mb-3">
                    <label asp-for="ProductName" class="form-label fw-semibold"></label>
                    <input asp-for="ProductName" class="form-control" />
                    <span asp-validation-for="ProductName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" ></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row mb-3">
                    <div class="col">
                        <label asp-for="Price" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Price" class="form-control" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col">
                        <label asp-for="StockQuantity" class="form-label fw-semibold"></label>
                        <input asp-for="StockQuantity" class="form-control" />
                        <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="CategoryId" class="form-label fw-semibold"></label>
                    <select asp-for="CategoryId" asp-items="@ViewBag.Categories">
                        <option value="">Please Select a Category</option>
                    </select>
                </div>


                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
                    <button type="submit" class="btn btn-success px-5">Update</button>
                </div>
            </form>
        </div>
    </div>
</div>

<table>
    <thead>
        <tr>
            <td>Reviews</td>
            <td>Action</td>
        </tr>
    </thead>
    <tbody>
        @foreach(var review in Model.ProductReviews)
        {
            <tr>
                <td>
                    <div>
                        <p>@review.ReviewerFirstName</p>
                        <p>@review.Rating</p>
                        <p>@review.Description</p>
                        <p>@review.CreatedAt</p>
                        <p>@review.LastEditedAt</p>
                    </div>
                </td>
                <td>
                    <a asp-controller="Inventory" asp-action="DeleteProductReview" asp-route-reviewId="@review.RatingId" asp-route-productId="@ViewBag.Id">Delete Review</a>
                </td>
            </tr>
        }
    </tbody>
</table>
