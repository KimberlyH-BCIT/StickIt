@model ELKH.Models.ImageModel

@{
    ViewData["Title"] = "Add Product Image";
}
<h1 class="display-4">Upload Product Image</h1>
<p class="lead">Please select an image file you wish to upload.</p>
<hr class="my-4">

<form asp-action="AddImage" method="post" enctype="multipart/form-data">
    <input type="hidden" name="productId" value="@ViewBag.productId" />
    <div class="form-group">
        <label for="file" class="btn btn-info">
            Choose image
        </label>
        <input type="file" class="form-control-file" id="file" 
            name="file" accept="image/*" style="display:none;" 
            onchange="previewImage();" />
        <img id="preview" src="#" alt="Image Preview"
             style="max-width: 400px; max-height: 400px;
             margin-top: 10px; display:none;" />
    </div>
    <button type="submit" class="btn btn-primary">Upload Image</button>
</form>


<style>
    body {
        background-color: #f7f7f7;
    }

    .container {
        background-color: #ffffff;
        padding: 2rem;
        border-radius: 0.5rem;
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15);
    }

    .btn-info {
        background-color: #17a2b8;
        border-color: #17a2b8;
        color: white;
        font-size: 16px;
    }

    .btn-info:hover {
        background-color: #138496;
        border-color: #117a8b;
        color: white;
    }

    .btn-success {
        font-weight: 400;
        background-color: #28a745;
        border-color: #28a745;
    }

    .btn-success:hover {
        background-color: #218838;
        border-color: #1e7e34;
    }

    .btn-upload {
        padding: 5px 15px;
        font-size: 16px;
    }
</style>


<script>
    function previewImage() {
        var fileInput = document.querySelector('input[type=file]');
        var file = fileInput.files[0];
        var reader = new FileReader();

        reader.onloadend = function () {
            var preview = document.getElementById('preview');       
            preview.src = reader.result;
            preview.style.display = 'block';
        };

        if (file) {
            reader.readAsDataURL(file);
        } else {
            var preview = document.getElementById('preview');
            preview.src = "";
            preview.style.display = 'none';
        }
    }
</script>
    