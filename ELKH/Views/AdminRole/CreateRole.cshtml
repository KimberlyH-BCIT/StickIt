@model ELKH.ViewModels.RoleVM

@{
    ViewData["Title"] = "Create Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center mt-5">

    <div class="card shadow-sm" style="width:700px;">
        <div class="card-body p-5">

            <h2 class="fw-bold text-center mb-4 text-primary">
                Create New Role
            </h2>

            <form asp-action="CreateRole" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3 text-center"></div>

                <div class="mb-4">
                    <label asp-for="RoleName"
                           class="form-label fw-semibold"></label>

                    <input asp-for="RoleName"
                           class="form-control form-control-lg"
                           placeholder="Enter role name" />

                    <span asp-validation-for="RoleName"
                          class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="ListRoles"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-5">
                        Create Role
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>