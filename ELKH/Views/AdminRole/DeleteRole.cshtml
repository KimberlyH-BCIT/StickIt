@model ELKH.ViewModels.RoleVM

@{
    ViewData["Title"] = "Delete Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center mt-5">
    
    <div class="card shadow-sm border-danger" style="width:700px;">
        <div class="card-body p-5 text-center">
            <h2 class="fw-bold mb-3 text-primary">Delete Role</h2>

            <p class="mb-4">
                Are you sure you want to delete this role?
            </p>

            <div class="alert alert-light border">
                <strong>@Model.RoleName</strong>
            </div>

            <form asp-action="DeleteRole" method="post">

                <input type="hidden" asp-for="RoleId" />

                <div class="d-flex justify-content-center gap-4 mt-4">
                    <a asp-action="ListRoles"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger px-5">
                        Delete
                    </button>
                </div>

            </form>

        </div>
    </div>
</div>