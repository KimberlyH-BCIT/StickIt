@model ELKH.ViewModels.AssignRoleVM

@{
    ViewData["Title"] = "Assign Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-sm" style="width:700px;">
        <div class="card-body p-5">

            <h2 class="fw-bold text-center mb-4 text-primary">
                Assign Role to User
            </h2>

            <form asp-action="AssignRoles" method="post">

                <div asp-validation-summary="All"
                     class="text-danger mb-3 text-center"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold"></label>
                    <input asp-for="Email"
                           class="form-control form-control-lg"
                           placeholder="Enter user email" />
                </div>

                <div class="mb-4">

                    @if (Model.IsRoleLocked)
                    {
                        <label class="form-label fw-semibold">Role</label>
                        <input type="text"
                               class="form-control form-control-lg"
                               value="@Model.RoleName"
                               readonly />

                        <input type="hidden" asp-for="RoleName" />
                    }
                    else
                    {
                        <label asp-for="RoleName" class="form-label fw-semibold"></label>
                        <select asp-for="RoleName"
                                asp-items="@(new SelectList(Model.Roles, "RoleName", "RoleName"))"
                                class="form-control form-control-lg">
                            <option value="">-- Select Role --</option>
                        </select>
                    }

                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="ListRoles"
                       class="btn btn-outline-secondary px-4">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-5">
                        Assign Role
                    </button>
                </div>

            </form>
        </div>
    </div>
</div>
