@{
    ViewData["Title"] = "Staff Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string viewAs = ViewBag.ViewAs as string ?? "Staff";
}

<div class="container-fluid px-4 mt-4 pb-5">

    <!-- Header -->
    <header class="kawaii-hero">
        <h1 class="kawaii-cloud-title font-heading">
            <i class="bi bi-person-badge me-2" aria-hidden="true"></i>
            Staff Dashboard
        </h1>
        <p class="hierarchy-tertiary mb-3">
            Daily operations · @DateTime.Now.ToString("dddd, MMMM d yyyy")
        </p>

        <!-- View Switch -->
        <nav class="d-flex gap-2 flex-wrap align-items-center justify-content-center" aria-label="View mode navigation">
            <span class="hierarchy-tertiary small me-1">View as:</span>

            <a asp-controller="Staff" asp-action="Index"
                   class="btn-kawaii @(viewAs == "Staff" ? "btn-primary-kawaii" : "btn-secondary-kawaii") btn-sm radius-pill">
                🧑‍💼 Staff
            </a>

            <a asp-controller="Home" asp-action="Index"
                   class="btn-kawaii @(viewAs == "Customer" ? "btn-primary-kawaii" : "btn-secondary-kawaii") btn-sm radius-pill">
                🛒 Customer
            </a>
        </nav>
    </header>

    <!-- ================= KPI CARDS ================= -->
    <div class="container-kawaii">
        <div class="row g-3 mb-4 align-items-stretch">

            <div class="col-6 col-md-3 col-lg-2">
                <div class="kawaii-card kawaii-card-sm text-center h-100 glow-on-hover">
                    <div class="d-flex flex-column align-items-center justify-content-center p-3">
                        <div class="fs-4">📦</div>
                        <h5 class="font-heading text-purple mb-0">@ViewBag.TotalOrders</h5>
                        <small class="hierarchy-tertiary">All Orders</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <div class="kawaii-card kawaii-card-sm surface-sky text-center h-100 glow-on-hover">
                    <div class="d-flex flex-column align-items-center justify-content-center p-3">
                        <div class="fs-4">🚚</div>
                        <h5 class="font-heading accent-blue mb-0">@ViewBag.TodayOrders</h5>
                        <small class="hierarchy-tertiary">Shipping Today</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <div class="kawaii-card kawaii-card-sm surface-butter text-center h-100 glow-on-hover">
                    <div class="d-flex flex-column align-items-center justify-content-center p-3">
                        <div class="fs-4">❌</div>
                        <h5 class="font-heading mb-0" style="color: #dc3545;">@ViewBag.CancelledOrders</h5>
                        <small class="hierarchy-tertiary">Cancelled</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <div class="kawaii-card kawaii-card-sm surface-butter text-center h-100 glow-on-hover">
                    <div class="d-flex flex-column align-items-center justify-content-center p-3">
                        <div class="fs-4">⏳</div>
                        <h5 class="font-heading mb-0" style="color: #ffc107;">@ViewBag.PendingOrders</h5>
                        <small class="hierarchy-tertiary">Pending</small>
                    </div>
                </div>
            </div>

            <div class="col-6 col-md-3 col-lg-2">
                <a asp-controller="Inventory" asp-action="Index" asp-route-stockFilter="low"
                       class="text-decoration-none d-block h-100">
                    <div class="kawaii-card kawaii-card-sm surface-butter text-center h-100 glow-on-hover">
                        <div class="d-flex flex-column align-items-center justify-content-center p-3">
                            <div class="fs-4">🔴</div>
                            <h5 class="font-heading mb-0" style="color: #dc3545;">@ViewBag.LowStockCount</h5>
                            <small class="hierarchy-tertiary">Low Stock</small>
                        </div>
                    </div>
                </a>
            </div>

        </div>
    </div>

    <!-- ================= MAIN CARDS ================= -->
    <div class="row g-4">

        <!-- Inventory -->
        <div class="col-md-4">
            <a asp-controller="Inventory" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="bg-primary bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">📦</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Inventory</h5>
                            <p class="text-muted small mb-2">
                                View and manage available products
                            </p>
                        </div>
                    </div>
                    <div class="card-footer bg-primary text-white text-center py-2 rounded-bottom-4 small">
                        Go to Inventory →
                    </div>
                </div>
            </a>
        </div>

        <!-- Orders -->
        <div class="col-md-4">
            <a asp-controller="OrdersHistoryStaff" asp-action="Index" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="bg-success bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">📋</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Order History</h5>
                            <p class="text-muted small mb-2">
                                View all customer orders
                            </p>
                        </div>
                    </div>
                    <div class="card-footer bg-success text-white text-center py-2 rounded-bottom-4 small">
                        Go to Orders →
                    </div>
                </div>
            </a>
        </div>

        <!-- Reviews (REPLACED Transactions) -->
        <div class="col-md-4">
            <a asp-controller="Staff" asp-action="Reviews" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="bg-warning bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">⭐</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Reviews</h5>
                            <p class="text-muted small mb-2">
                                View customer feedback
                            </p>
                        </div>
                    </div>
                    <div class="card-footer bg-warning text-dark text-center py-2 rounded-bottom-4 small">
                        Go to Reviews →
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- ================= STAFF MESSAGES ================= -->
    <div class="row mt-4">
        <div class="col-12">

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">

                    <h5 class="fw-bold mb-3">📩 Messages from Manager</h5>

                    @if (ViewBag.Messages != null && ((IEnumerable<dynamic>)ViewBag.Messages).Any())
                    {
                        foreach (var msg in ViewBag.Messages)
                        {
                            <div class="p-3 mb-3 rounded-3 @(msg.IsRead ? "bg-light" : "bg-white")"
                                 style="border:1px solid #e5e7eb;">

                                <div class="d-flex justify-content-between">
                                    <strong>@msg.Title</strong>
                                    <small class="text-muted">
                                        @msg.SentAt.ToString("MMM d, yyyy")
                                    </small>
                                </div>

                                <p class="small text-muted mb-2">@msg.Body</p>

                                <div class="d-flex justify-content-between align-items-center">
                                    <span class="text-muted small">
                                        @(msg.IsRead ? "Read" : "Unread")
                                    </span>

                                    <div class="d-flex gap-2">

                                        <!-- MARK READ -->
                                        <form asp-action="MarkMessageAsRead" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@msg.Id" />
                                            <button type="submit"
                                                    class="btn-kawaii btn-secondary-kawaii btn-sm radius-pill">
                                                ✔ Read
                                            </button>
                                        </form>

                                        <!-- REPLY BUTTON -->
                                        <button class="btn-kawaii btn-primary-kawaii btn-sm radius-pill"
                                                data-bs-toggle="collapse"
                                                data-bs-target="#reply_@msg.Id">
                                            Reply
                                        </button>
                                    </div>
                                </div>

                                <!-- REPLY BOX -->
                                <div class="collapse mt-2" id="reply_@msg.Id">
                                    <form asp-action="ReplyMessage" method="post">
                                        <input type="hidden" name="MessageId" value="@msg.Id" />
                                        <textarea name="ReplyText"
                                                  class="input-kawaii mb-2"
                                                  rows="2"
                                                  placeholder="Write reply..."></textarea>
                                        <button class="btn-kawaii btn-primary-kawaii btn-sm radius-pill">
                                            Send Reply
                                        </button>
                                    </form>
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted small">No messages from manager.</p>
                    }

                </div>
            </div>

        </div>
    </div>

</div>

<style>
    .mgr-card {
        transition: .2s;
    }

        .mgr-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0,0,0,.1);
        }
</style>
