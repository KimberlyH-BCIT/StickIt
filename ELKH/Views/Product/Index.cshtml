@model IEnumerable<ELKH.ViewModels.ProductVM>
@{
    ViewData["Title"] = "Shop";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold mb-0">🏷️ All Products</h1>
    @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i>Add Product
        </a>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-box-seam display-1"></i>
        <p class="fs-5 mt-3">No products available yet. Check back soon!</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var p in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="bg-light d-flex align-items-center justify-content-center" style="height:200px;">
                        <i class="bi bi-image text-muted display-4"></i>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <span class="badge bg-secondary mb-2 align-self-start">@p.CategoryName</span>
                        <h6 class="card-title fw-bold">@p.ProductName</h6>
                        <p class="card-text text-muted small flex-grow-1">
                            @(p.Description.Length > 80 ? p.Description[..80] + "…" : p.Description)
                        </p>
                        <div class="d-flex justify-content-between align-items-center mt-2">
                            <span class="fw-bold fs-5">$@p.Price.ToString("F2")</span>
                            @if (p.IsActive && (p.StockQuantity ?? 0) > 0)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                    In Stock (@p.StockQuantity)
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle small">Out of Stock</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-white border-top-0 pt-0 pb-3 px-3">
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@p.ProductId"
                               class="btn btn-outline-dark btn-sm flex-grow-1">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                            @if (p.IsActive && (p.StockQuantity ?? 0) > 0)
                            {
                                <form asp-controller="Cart" asp-action="Add" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-dark btn-sm" title="Add to Cart">
                                        <i class="bi bi-cart-plus"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
