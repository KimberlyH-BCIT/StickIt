@model IEnumerable<ELKH.ViewModels.ProductVM>

@*
╔══════════════════════════════════════════════════════════════════════════════════╗
║ TABLE OF CONTENTS - Product/Index.cshtml                                         ║
╠══════════════════════════════════════════════════════════════════════════════════╣
║ 1. ViewBag Data Preparation ................................. Lines    4-20     ║
║    - Pagination, search, and sorting parameter extraction                        ║
║    - Helper methods for URL generation and CSS class logic                       ║
║                                                                                  ║
║ 2. Page Header & Search Results Display ..................... Lines   22-35     ║
║    - Page title and search results notification banner                          ║
║                                                                                  ║
║ 3. CSS Styles & Product Card Animations .................... Lines   37-46     ║
║    - Hover effects and transition animations for product cards                   ║
║                                                                                  ║
║ 4. Filtering & Search Form .................................. Lines   48-90     ║
║    - Search input, category filter, and sorting controls                        ║
║    - Form state preservation and URL parameter management                        ║
║                                                                                  ║
║ 5. Results Summary & Sort Controls .......................... Lines   92-125    ║
║    - Total results count and pagination information                             ║
║    - Sort options with active state highlighting                                ║
║                                                                                  ║
║ 6. Product Grid Display .................................... Lines  127-210    ║
║    - Responsive grid layout with product cards                                  ║
║    - Product info, pricing, stock status, and quick actions                     ║
║    - Wishlist and add-to-cart functionality                                     ║
║                                                                                  ║
║ 7. Pagination Controls ..................................... Lines  212-235    ║
║    - Previous/next navigation with page state preservation                      ║
║                                                                                  ║
║ 8. No Results Display ...................................... Lines  237-250    ║
║    - Empty state messaging and search suggestions                               ║
║                                                                                  ║
║ 9. JavaScript Enhancements ................................. Lines  252-266    ║
║    - Product card click navigation to details page                              ║
╚══════════════════════════════════════════════════════════════════════════════════╝
*@

@{
    ViewData["Title"] = "Products";

    // ═══════════════════════════════════════════════════════════════════════════════
    // ║ ViewBag Data Extraction and Processing                                     ║
    // ║ Extract pagination, search, and filtering parameters from controller       ║
    // ═══════════════════════════════════════════════════════════════════════════════

    var products   = Model.ToList();
    var page       = ViewBag.Page       as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var total      = ViewBag.Total      as int? ?? products.Count;
    var search     = ViewBag.Search     as string;
    var categoryId = ViewBag.CategoryId as int?;
    var currentSort = ViewBag.Sort as string ?? "name_asc";

    // Helper methods for dynamic URL generation maintaining current state
    string SortLink(string sortKey) =>
        Url.Action("Index", "Product", new { search, categoryId, page = 1, sort = sortKey }) ?? "#";

    string BtnClass(string sortKey) =>
        currentSort == sortKey
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";
}

<!-- ════════════════════════════════════════════════════════════════════════════════ -->
<!-- ║ Page Header & Search Results Display                                       ║ -->
<!-- ════════════════════════════════════════════════════════════════════════════════ -->

<h2 class="mb-3">Products</h2>

@* ══════════════════════════════════════════════════════════════════════════════════ *@
@* ║ Search Results Information Banner                                              ║ *@
@* ══════════════════════════════════════════════════════════════════════════════════ *@
@if (!string.IsNullOrWhiteSpace(search))
{
    <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
        <svg class="bi flex-shrink-0 me-2" width="24" height="24" role="img" aria-label="Info:">
            <use xlink:href="#info-fill"/>
        </svg>
        <div>
            Search results for: <strong>&ldquo;@search&rdquo;</strong>
        </div>
    </div>
}

<!-- ════════════════════════════════════════════════════════════════════════════════ -->
<!-- ║ CSS Styles - Product Card Hover Animations                                 ║ -->
<!-- ════════════════════════════════════════════════════════════════════════════════ -->
<style>
    /* Product card hover effects for enhanced user interaction feedback */
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.12) !important;
    }
</style>

@* ── Filter form ──────────────────────────────────────────────────────── *@
<form method="get" asp-action="Index" class="row g-2 mb-3 align-items-end">
    <div class="col-sm-5">
        <label class="form-label fw-semibold">Search</label>
        <input type="search" name="search" value="@search"
               class="form-control" placeholder="Search by name or description…" />
    </div>
    <div class="col-sm-4">
        <label class="form-label fw-semibold">Category</label>
        <select name="categoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">All categories</option>
        </select>
    </div>
    <div class="col-sm-auto d-flex gap-2">
        <input type="hidden" name="sort" value="@currentSort" />
        <button type="submit" class="btn btn-primary">Filter</button>
        @if (!string.IsNullOrWhiteSpace(search) || categoryId.HasValue)
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@* ── Sort controls ─────────────────────────────────────────────────────── *@
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="text-muted small me-1">Sort by:</span>

            <a href="@SortLink("name_asc")" class="@BtnClass("name_asc")">
                Name A &rarr; Z
            </a>
            <a href="@SortLink("name_desc")" class="@BtnClass("name_desc")">
                Name Z &rarr; A
            </a>
            <a href="@SortLink("price_low")" class="@BtnClass("price_low")">
                Price Low &rarr; High
            </a>
            <a href="@SortLink("price_high")" class="@BtnClass("price_high")">
                Price High &rarr; Low
            </a>
            <a href="@SortLink("newest")" class="@BtnClass("newest")">
                Newest First
            </a>
            <a href="@SortLink("oldest")" class="@BtnClass("oldest")">
                Oldest First
            </a>
        </div>
    </div>
</div>

@* ── Result count ─────────────────────────────────────────────────────── *@
<p class="text-muted small mb-3">
    Showing @products.Count of @total product@(total != 1 ? "s" : "")
    @if (!string.IsNullOrWhiteSpace(search)) { <span>matching &ldquo;@search&rdquo;</span> }
</p>

@* ── Product grid ─────────────────────────────────────────────────────── *@
@if (!products.Any())
{
    <div class="alert alert-light border">No products found. <a asp-action="Index">Clear filters</a></div>
}
else
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3" id="productGrid">
        @foreach (var p in products)
        {
            <div class="col">
                <div class="card h-100 shadow-sm product-card"
                     data-href="@Url.Action("Details", "Product", new { id = p.ProductId })">
                    <div class="card-body d-flex flex-column p-3">

                        @* Badges for trending, bestseller, new arrival *@
                        @if (p.IsBestSeller || p.IsTrending || p.IsNewArrival)
                        {
                            <div class="mb-2 d-flex gap-1 flex-wrap">
                                @if (p.IsBestSeller)
                                {
                                    <span class="badge bg-warning text-dark">
                                        <i class="bi bi-star-fill"></i> Best Seller
                                    </span>
                                }
                                @if (p.IsTrending)
                                {
                                    <span class="badge bg-info text-dark">
                                        <i class="bi bi-graph-up-arrow"></i> Trending
                                    </span>
                                }
                                @if (p.IsNewArrival)
                                {
                                    <span class="badge bg-success">
                                        <i class="bi bi-sparkles"></i> New
                                    </span>
                                }
                            </div>
                        }

                        <h6 class="card-title text-truncate mb-2 fw-semibold"
                            title="@p.ProductName">@p.ProductName</h6>

                        <p class="text-muted small mb-2" style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">
                            @p.Description
                        </p>

                        <div class="mb-3">
                            @if (p.DiscountPercent > 0)
                            {
                                var effective = p.Price * (1 - p.DiscountPercent / 100m);
                                <div>
                                    <span class="text-muted text-decoration-line-through small">@p.Price.ToString("C")</span>
                                    <span class="badge bg-danger ms-1">@p.DiscountPercent%&nbsp;off</span>
                                </div>
                                <span class="fw-bold text-success">@effective.ToString("C")</span>
                            }
                            else
                            {
                                <span class="fw-semibold">@p.Price.ToString("C")</span>
                            }
                        </div>

                        @* Stock information *@
                        <div class="mb-2">
                            @if (p.IsInStock)
                            {
                                if (p.IsLowStock)
                                {
                                    <small class="text-warning">
                                        <i class="bi bi-exclamation-triangle-fill"></i> Only @p.StockQuantity left in stock!
                                    </small>
                                }
                                else
                                {
                                    <small class="text-success">
                                        <i class="bi bi-check-circle-fill"></i> In Stock (@p.StockQuantity available)
                                    </small>
                                }
                            }
                            else
                            {
                                <small class="text-danger">
                                    <i class="bi bi-x-circle-fill"></i> Out of Stock
                                </small>
                            }
                        </div>

                        <div class="mt-auto d-flex flex-column gap-2">
                            @if (p.StockQuantity > 0)
                            {
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="itemId" value="@p.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn btn-sm btn-primary w-100">Add to Cart</button>
                                </form>
                            }
                            else
                            {
                                @* Out of stock - show notify button *@
                                @if (User.Identity?.IsAuthenticated == true)
                                {
                                    <form asp-controller="Product" asp-action="NotifyStock" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="productId" value="@p.ProductId" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-warning w-100">
                                            <i class="bi bi-bell-fill me-1"></i>Notify When Available
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-secondary w-100" disabled>
                                        <i class="bi bi-x-circle me-1"></i>Out of Stock
                                    </button>
                                }
                            }

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form asp-controller="Wishlist" asp-action="AddAjax" method="post"
                                      class="add-to-wishlist-form" data-product-id="@p.ProductId">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.ProductId" />
                                    <button type="submit"
                                            class="btn btn-sm btn-outline-secondary w-100 add-to-wishlist-button">
                                        ♡&nbsp;Wishlist
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-sm btn-outline-secondary w-100"
                                        data-bs-toggle="modal" data-bs-target="#wishlistSignInModal">
                                    ♡&nbsp;Wishlist
                                </button>
                            }
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>

    @* ── Pagination ───────────────────────────────────────────────────── *@
    @if (totalPages > 1)
    {
        <nav class="mt-4" aria-label="Product pages">
            <ul class="pagination justify-content-center flex-wrap">
                <li class="page-item @(page <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-categoryId="@categoryId"
                       asp-route-page="@(page - 1)">‹</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == page ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-search="@search"
                           asp-route-categoryId="@categoryId"
                           asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(page >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-search="@search"
                       asp-route-categoryId="@categoryId"
                       asp-route-page="@(page + 1)">›</a>
                </li>
            </ul>
        </nav>
    }
}
