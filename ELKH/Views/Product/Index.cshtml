@model IEnumerable<ELKH.ViewModels.ProductVM>

@*
╔══════════════════════════════════════════════════════════════════════════════════╗
║ Product Index View - Optimized with Reusable Partial Components                ║
║ Uses partial views for better maintainability and code reuse                    ║
╚══════════════════════════════════════════════════════════════════════════════════╝
*@

@{
    ViewData["Title"] = "Products - Browse Our Sticker Collection";

    // ═══════════════════════════════════════════════════════════════════════════════
    // ║ ViewBag Data Extraction and Processing                                     ║
    // ║ Extract pagination, search, and filtering parameters from controller       ║
    // ═══════════════════════════════════════════════════════════════════════════════

    var products   = Model.ToList();
    var page       = ViewBag.Page       as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var total      = ViewBag.Total      as int? ?? products.Count;
    var search     = ViewBag.Search     as string;
    var categoryId = ViewBag.CategoryId as int?;
    var currentSort = ViewBag.Sort as string ?? "name_asc";

    // Prepare ViewModels for partial views
    var searchFilterVM = new ELKH.ViewModels.ProductSearchFilterVM
    {
        Search = search,
        CategoryId = categoryId,
        CurrentSort = currentSort,
        Categories = ViewBag.Categories
    };

    var sortingVM = new ELKH.ViewModels.ProductSortingVM
    {
        Search = search,
        CategoryId = categoryId,
        CurrentSort = currentSort
    };

    var paginationVM = new ELKH.ViewModels.PaginationVM
    {
        CurrentPage = page,
        TotalPages = totalPages,
        Search = search,
        CategoryId = categoryId
    };
}

<!-- ════════════════════════════════════════════════════════════════════════════════ -->
<!-- ║ Page Header & Search Results Display with Enhanced Accessibility           ║ -->
<!-- ════════════════════════════════════════════════════════════════════════════════ -->

<header class="product-catalog-header mb-4" role="banner">
    <!-- Skip Links for Keyboard Navigation -->
    <nav class="skip-links sr-only-focusable" aria-label="Skip navigation">
        <a href="#product-search-input" class="skip-link btn btn-primary">Skip to search</a>
        <a href="#productGrid" class="skip-link btn btn-primary">Skip to products</a>
        <a href="#pagination" class="skip-link btn btn-primary">Skip to pagination</a>
    </nav>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="mb-0" id="main-heading">Products</h1>
        @if (!string.IsNullOrWhiteSpace(search) || categoryId.HasValue)
        {
            <div class="badge-group" role="group" aria-label="Active filters">
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <span class="badge bg-primary" aria-label="Search filter: @search">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>@search
                    </span>
                }
                @if (categoryId.HasValue && ViewBag.CategoryName != null)
                {
                    <span class="badge bg-secondary ms-1" aria-label="Category filter: @ViewBag.CategoryName">
                        <i class="bi bi-tag-fill me-1" aria-hidden="true"></i>@ViewBag.CategoryName
                    </span>
                }
            </div>
        }
    </div>
</header>

@* ══════════════════════════════════════════════════════════════════════════════════ *@
@* ║ Search Results Information Banner                                              ║ *@
@* ══════════════════════════════════════════════════════════════════════════════════ *@
@if (!string.IsNullOrWhiteSpace(search))
{
    var searchAlertVM = new ELKH.ViewModels.AlertBannerVM
    {
        Message = $"Search results for: <strong>&ldquo;{search}&rdquo;</strong>",
        AlertType = "alert-info",
        Icon = "info-fill",
        IconType = "bootstrap",
        IconAriaLabel = "Search results information"
    };

    <div role="status" aria-live="polite" aria-label="Search results notification">
        @await Html.PartialAsync("_AlertBannerPartial", searchAlertVM)
    </div>
}

<!-- ════════════════════════════════════════════════════════════════════════════════ -->
<!-- ║ CSS Styles - Product Card Accessibility & Hover Animations                 ║ -->
<!-- ════════════════════════════════════════════════════════════════════════════════ -->
<style>
    /* Product card hover effects for enhanced user interaction feedback */
    .product-card {
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
        position: relative;
    }

    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.12) !important;
    }

    /* Enhanced focus management for product cards */
    .product-card:focus-within {
        outline: 2px solid #0066cc;
        outline-offset: 2px;
        transform: translateY(-2px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15) !important;
    }

    /* Ensure stretched link accessibility */
    .stretched-link:focus {
        z-index: 2;
    }

    /* Improve keyboard navigation for action buttons */
    .product-card .btn:focus {
        z-index: 3;
        position: relative;
    }

    /* Reduce motion for users who prefer it */
    @@media (prefers-reduced-motion: reduce) {
        .product-card {
            transition: none;
        }
        .product-card:hover {
            transform: none;
        }
    }

    /* Enhanced Skip Links */
    .skip-links {
        position: relative;
        z-index: 1050;
    }

    .skip-link {
        position: absolute !important;
        left: -10000px !important;
        top: auto !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
    }

    .skip-link:focus {
        position: static !important;
        width: auto !important;
        height: auto !important;
        overflow: visible !important;
        margin: 0 0.5rem 0.5rem 0 !important;
        padding: 0.5rem 1rem !important;
        z-index: 1051 !important;
    }

    /* Enhanced Badge Groups */
    .badge-group .badge {
        margin-right: 0.25rem;
    }

    .badge-group .badge:last-child {
        margin-right: 0;
    }

    /* Screen Reader Only but Focusable Elements */
    .sr-only-focusable:not(:focus):not(:focus-within) {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        padding: 0 !important;
        margin: -1px !important;
        overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important;
        white-space: nowrap !important;
        border: 0 !important;
    }
</style>

@* ── Search and Filter Form ──────────────────────────────────────────── *@
@await Html.PartialAsync("_ProductSearchFilterPartial", searchFilterVM)

@* ── Sort Controls ─────────────────────────────────────────────────── *@
@await Html.PartialAsync("_ProductSortingPartial", sortingVM)

@* ── Enhanced Result count with Live Region ─────────────────────────────────── *@
<div class="results-summary mb-3" role="region" aria-labelledby="results-summary-heading">
    <h2 id="results-summary-heading" class="sr-only">Search Results Summary</h2>
    <div role="status" 
         aria-live="polite" 
         aria-label="Search results count"
         id="results-announcement">
        <p class="text-muted small mb-0" id="results-count">
            <strong>@products.Count</strong> of <strong>@total</strong> product@(total != 1 ? "s" : "") found
            @if (!string.IsNullOrWhiteSpace(search)) { 
                <span> matching <em>&ldquo;@search&rdquo;</em></span> 
            }
            @if (categoryId.HasValue && ViewBag.CategoryName != null)
            {
                <span> in category <em>@ViewBag.CategoryName</em></span>
            }
        </p>
        @if (products.Count == 0)
        {
            <p class="text-muted small mb-0">
                <i class="bi bi-info-circle me-1" aria-hidden="true"></i>
                Try adjusting your search terms or browse all products
            </p>
        }
    </div>
</div>

@* ── Product grid ─────────────────────────────────────────────────────── *@
@if (!products.Any())
{
    var productEmptyStateVM = new ELKH.ViewModels.EmptyStateCardVM
    {
        Title = "No products found",
        Icon = "search",
        IconType = "bootstrap",
        Description = !string.IsNullOrWhiteSpace(search) 
            ? $"No products match your search for \"{search}\". Try adjusting your search terms or browse all products."
            : (categoryId.HasValue 
                ? "No products found in the selected category. Try browsing other categories or search for specific items."
                : "No products available at the moment."),
        ActionText = !string.IsNullOrWhiteSpace(search) || categoryId.HasValue ? "Browse All Products" : null,
        ActionController = !string.IsNullOrWhiteSpace(search) || categoryId.HasValue ? "Product" : null,
        ActionAction = !string.IsNullOrWhiteSpace(search) || categoryId.HasValue ? "Index" : null,
        ActionButtonClass = "btn btn-primary"
    };

    @await Html.PartialAsync("_EmptyStateCardPartial", productEmptyStateVM)
}
else
{
    <main role="main" aria-labelledby="products-main-heading">
        <section class="product-results" aria-labelledby="products-heading">
            <h2 id="products-main-heading" class="sr-only">Product Catalog</h2>
            <h3 id="products-heading" class="sr-only">
                @total Product@(total != 1 ? "s" : "") 
                @if (!string.IsNullOrWhiteSpace(search)) { <text>matching "@search"</text> }
                @if (categoryId.HasValue && ViewBag.CategoryName != null) { <text>in @ViewBag.CategoryName</text> }
            </h3>

            <div class="product-grid-container" 
                 role="region" 
                 aria-labelledby="products-heading"
                 aria-describedby="results-count">
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3" 
                     id="productGrid"
                     role="list"
                     aria-label="Product grid with @products.Count items displayed">
                    @foreach (var p in products)
                    {
                        <div class="col" role="listitem">
                            @await Html.PartialAsync("_ProductCardPartial", p)
                        </div>
                    }
                </div>
            </div>

            @* ── Enhanced Pagination with Proper Landmark ───────────────────────────── *@
            <nav aria-label="Product pagination" id="pagination" class="mt-4">
                @await Html.PartialAsync("_PaginationPartial", paginationVM)
            </nav>
        </section>
    </main>
}
