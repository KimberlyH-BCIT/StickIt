@model IEnumerable<ELKH.ViewModels.ProductVM>

@{
    ViewData["Title"] = "Products";
    var products = Model.ToList();
    const int pageSize = 15;
}

<h2 class="mb-4">Products</h2>

<style>
    .product-card {
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.12) !important;
    }
</style>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-5 g-3" id="productGrid">
    @for (int i = 0; i < products.Count; i++)
    {
        var p = products[i];
        <div class="col product-card-col@(i >= pageSize ? " extra-product d-none" : "")">
            <div class="card h-100 shadow-sm product-card"
                 data-href="@Url.Action("Details", "Product", new { id = p.ProductId })">
                <div class="card-body d-flex flex-column p-3">

                    @* Product name — single line, truncated *@
                    <h6 class="card-title text-truncate mb-2 fw-semibold"
                        title="@p.ProductName">@p.ProductName</h6>

                    @* Price *@
                    <div class="mb-3">
                        @if (p.DiscountPercent > 0)
                        {
                            var effective = p.Price * (1 - p.DiscountPercent / 100m);
                            <div>
                                <span class="text-muted text-decoration-line-through small price"
                                      data-price="@p.Price">@p.Price.ToString("C")</span>
                                <span class="badge bg-danger ms-1">@p.DiscountPercent%&nbsp;off</span>
                            </div>
                            <span class="fw-bold text-success price"
                                  data-price="@effective">@effective.ToString("C")</span>
                        }
                        else
                        {
                            <span class="fw-semibold price" data-price="@p.Price">@p.Price.ToString("C")</span>
                        }
                    </div>

                    @* Action buttons — stop click from bubbling to card *@
                    <div class="mt-auto d-flex flex-column gap-2">
                        <form asp-controller="Cart" asp-action="AddToCart" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="itemId" value="@p.ProductId" />
                            <input type="hidden" name="quantity" value="1" />
                            <button type="submit" class="btn btn-sm btn-primary w-100">Add to Cart</button>
                        </form>

                        <form asp-controller="Wishlist" asp-action="AddAjax" method="post"
                              class="add-to-wishlist-form" data-product-id="@p.ProductId">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@p.ProductId" />
                            <button type="submit"
                                    class="btn btn-sm btn-outline-secondary w-100 add-to-wishlist-button">
                                ♡&nbsp;Wishlist
                            </button>
                        </form>
                            }
                    </div>

                </div>
            </div>
        </div>
    }
</div>

@if (products.Count > pageSize)
{
    <div class="text-center mt-4" id="showMoreContainer">
        <button class="btn btn-outline-primary px-5" id="showMoreBtn" onclick="showMoreProducts()">
            Show More
        </button>
    </div>
}

@section Scripts {
    <script>
        (function () {
            // Navigate to product details when clicking the card body,
            // but let form submissions and button clicks proceed normally.
            document.querySelectorAll('.product-card').forEach(function (card) {
                card.addEventListener('click', function (e) {
                    if (!e.target.closest('form') && !e.target.closest('button') && !e.target.closest('a')) {
                        window.location.href = card.dataset.href;
                    }
                });
            });

            var step = @pageSize;

            window.showMoreProducts = function () {
                var hidden = document.querySelectorAll('.extra-product.d-none');
                var toShow = Array.prototype.slice.call(hidden, 0, step);
                toShow.forEach(function (el) { el.classList.remove('d-none'); });

                if (document.querySelectorAll('.extra-product.d-none').length === 0) {
                    var container = document.getElementById('showMoreContainer');
                    if (container) container.style.display = 'none';
                }
            };
        })();
    </script>
}
    <script>
        (function () {
            var shown = @pageSize;
            var step  = @pageSize;

            window.showMoreProducts = function () {
                var hidden = document.querySelectorAll('.extra-product.d-none');
                var toShow = Array.prototype.slice.call(hidden, 0, step);
                toShow.forEach(function (el) { el.classList.remove('d-none'); });
                shown += toShow.length;

                if (document.querySelectorAll('.extra-product.d-none').length === 0) {
                    var container = document.getElementById('showMoreContainer');
                    if (container) container.style.display = 'none';
                }
            };
        })();
    </script>
}
