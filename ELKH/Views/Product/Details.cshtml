@model ELKH.ViewModels.ProductVM

@{
    ViewData["Title"] = Model.ProductName;
}

@* ── WIP Banner ────────────────────────────────────────────────────── *@
<div class="alert alert-warning d-flex align-items-center gap-3 mb-4" role="alert">
    <span style="font-size:1.5rem;">🚧</span>
    <div>
        <strong>Work In Progress</strong> &mdash;
        This product detail page is still being completed. Some sections may be missing or incomplete.
    </div>
</div>

<h2>@Model.ProductName</h2>
<p>@Model.Description</p>

<div class="mb-3">
    @if (Model.DiscountPercent > 0)
    {
        <p>
            <span class="text-muted">List Price: </span>
            <s>@Model.Price.ToString("C")</s>
            <span class="ms-2 text-success">@Model.DiscountPercent% off</span>
        </p>
        <p>Effective Price: <strong id="effective-price">@((Model.Price * (1 - Model.DiscountPercent / 100)).ToString("C"))</strong></p>
    }
    else
    {
        <p>Price: <strong id="effective-price">@Model.Price.ToString("C")</strong></p>
    }
</div>

<partial name="_AddToWishlistPartial" model="Model" />

<div class="mt-3">
    <h5>Average Rating: @Model.AverageRating.ToString("F1") / 5</h5>
    <partial name="_RatingFormPartial" model="Model.ProductId" />
</div>

<div class="mt-4">
    @{ var reviews = ViewBag.Reviews as IEnumerable<ELKH.Models.ProductRatingModel> ?? Enumerable.Empty<ELKH.Models.ProductRatingModel>(); }
    <partial name="_ReviewsListPartial" model="reviews" />
</div>

@{
    var eligible = ViewBag.EligibleOrderItems as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
    var userRating = ViewBag.UserRating as ELKH.Models.ProductRatingModel;
}

<script>
    (function(){
        var eligible = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(eligible));
        var userRating = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userRating));
        // populate orderItemIdField select if present
        var orderField = document.getElementById('orderItemIdField');
        if (orderField && eligible && eligible.length > 0) {
            // create select element before the hidden field for user to choose which order item
            var sel = document.createElement('select');
            sel.name = 'orderItemId';
            sel.className = 'form-select mb-2';
            eligible.forEach(function(e){
                var opt = document.createElement('option');
                opt.value = e.Id;
                opt.text = 'Order on ' + e.Label;
                sel.appendChild(opt);
            });
            orderField.parentNode.insertBefore(sel, orderField);
            orderField.value = sel.value;
            sel.addEventListener('change', function(){ orderField.value = sel.value; });
        }

        // Hide rating form if user already has rating and cannot edit
        if (userRating && document.querySelector('form[asp-action="Create"]')) {
            var createForm = document.querySelector('form[asp-action="Create"]');
            // If user's existing rating was deleted and 24h haven't passed, hide create form
            if (userRating.IsDeleted) {
                var deletedAt = userRating.DeletedAt;
                if (deletedAt) {
                    var deletedTime = new Date(deletedAt);
                    var diff = (new Date() - deletedTime) / (1000*60*60);
                    if (diff < 24) { createForm.style.display = 'none'; }
                }
            } else {
                // user has existing rating, hide create form
                createForm.style.display = 'none';
            }
        }

        // AJAX submit for create/edit/delete
        const submitBtn = document.getElementById('submit-rating');
        if (submitBtn) {
            const form = submitBtn.closest('form');
            form.addEventListener('submit', async function(e){
                e.preventDefault();
                const fd = new FormData(form);
                const url = form.action;
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: fd
                });
                const json = await res.json();
                if (json.success) {
                    location.reload();
                } else {
                    alert(json.message || 'Failed');
                }
            });
        }

        // AJAX delete/edit buttons (if present)
        document.querySelectorAll('form[asp-action="Delete"]').forEach(f => {
            f.addEventListener('submit', async function(e){
                e.preventDefault();
                const fd = new FormData(f);
                const res = await fetch(f.action, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    body: fd
                });
                const json = await res.json();
                if (json.success) location.reload(); else alert(json.message || 'Failed');
            });
        });
    })();
</script>

<hr />

<form method="post" asp-controller="Cart" asp-action="AddToCart">
    @Html.AntiForgeryToken()
    <input type="hidden" name="itemId" value="@Model.ProductId" />
    <div class="mb-3">
        <label for="quantity" class="form-label">Quantity</label>
        <input id="quantity" name="quantity" type="number" min="1" value="1" class="form-control" style="width:100px;" />
    </div>
    <button type="submit" class="btn btn-primary">Add to Cart</button>
    <button type="submit" formaction="@Url.Action("BuyNow", "Cart")" class="btn btn-success ms-2">Buy Now</button>
</form>

@section Scripts {
    <script>
        // Poll price every 10 seconds to reflect real-time changes
        const productId = @Model.ProductId;
        async function pollPrice() {
            try {
                const res = await fetch('@Url.Action("GetPrice","Product")?id=' + productId);
                if (!res.ok) return;
                const json = await res.json();
                const effective = json.effective;
                const locale = window.appCulture || undefined;
                const currency = window.appCurrency || 'CAD';
                document.getElementById('effective-price').textContent = new Intl.NumberFormat(locale, { style: 'currency', currency }).format(effective);
            } catch { }
        }
        setInterval(pollPrice, 10000);
    </script>
}
