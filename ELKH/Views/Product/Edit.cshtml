@model ELKH.ViewModels.ProductVM
@{
    ViewData["Title"] = "Edit Product";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Products</a></li>
                <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.ProductId">@Model.ProductName</a></li>
                <li class="breadcrumb-item active">Edit</li>
            </ol>
        </nav>

        <div class="kawaii-card">
            <div class="card-body p-4">
                <h2 class="font-heading mb-4"><i class="bi bi-pencil-square me-2" aria-hidden="true"></i>Edit Product</h2>
                <form asp-action="Edit" method="post" aria-labelledby="edit-product-heading" novalidate>
                    <h3 id="edit-product-heading" class="sr-only">Product Edit Form</h3>
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ProductId" />
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert" aria-live="assertive"></div>

                    <div class="mb-3">
                        <label asp-for="ProductName" class="form-label fw-semibold">
                            <span class="required-indicator" aria-label="Required field">*</span> Product Name
                        </label>
                        <input asp-for="ProductName" class="input-kawaii" required aria-required="true" aria-describedby="productname-validation" />
                        <span id="productname-validation" asp-validation-for="ProductName" class="text-danger small" role="alert" aria-live="polite"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">Description</label>
                        <textarea asp-for="Description" class="input-kawaii" rows="3" aria-describedby="description-validation description-help"></textarea>
                        <small id="description-help" class="form-text hierarchy-tertiary">Provide a detailed description of the product</small>
                        <span id="description-validation" asp-validation-for="Description" class="text-danger small" role="alert" aria-live="polite"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="Price" class="form-label fw-semibold">
                                <span class="required-indicator" aria-label="Required field">*</span> Price
                            </label>
                            <div class="input-group">
                                <span class="input-group-text" aria-hidden="true">$</span>
                                <input asp-for="Price" class="input-kawaii" type="number" step="0.01" min="0" required aria-required="true" aria-describedby="price-validation" aria-label="Price in dollars" />
                            </div>
                            <span id="price-validation" asp-validation-for="Price" class="text-danger small" role="alert" aria-live="polite"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="StockQuantity" class="form-label fw-semibold">
                                <span class="required-indicator" aria-label="Required field">*</span> Stock Quantity
                            </label>
                            <input asp-for="StockQuantity" class="input-kawaii" type="number" min="0" required aria-required="true" aria-describedby="stockquantity-validation" />
                            <span id="stockquantity-validation" asp-validation-for="StockQuantity" class="text-danger small" role="alert" aria-live="polite"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CategoryId" class="form-label fw-semibold">
                                <span class="required-indicator" aria-label="Required field">*</span> Category
                            </label>
                            <select asp-for="CategoryId" asp-items="ViewBag.CategoryId" class="input-kawaii" required aria-required="true" aria-describedby="categoryid-validation">
                                <option value="">- Select Category -</option>
                            </select>
                            <span id="categoryid-validation" asp-validation-for="CategoryId" class="text-danger small" role="alert" aria-live="polite"></span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label">Active (visible in shop)</label>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn-kawaii btn-primary-kawaii sparkle">
                            <i class="bi bi-save me-1"></i>Save Changes
                        </button>
                        <a asp-action="Details" asp-route-id="@Model.ProductId" class="btn-kawaii btn-outline-kawaii">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
