@{
    ViewData["Title"] = "Order Confirmed!";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="text-center mb-4">
        <div class="display-1 mb-3">🎉</div>
        <h1 class="fw-bold">Order Confirmed!</h1>
        <p class="text-muted mb-0">Order #@ViewBag.OrderId</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <p class="text-muted mb-4">
                        Thanks! Your order has been placed successfully.
                    </p>

                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        <a asp-controller="Order" asp-action="History" class="btn btn-outline-dark">
                            View Orders
                        </a>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-dark">
                            Keep Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>