@model ELKH.ViewModels.OrderVM
@{
    ViewData["Title"] = "Order Confirmed!";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var order = Model.Order;
}

<div class="container py-5">
    <div class="text-center mb-5">
        <div class="display-1 mb-3">🎉</div>
        <h1 class="fw-bold text-success">Order Confirmed!</h1>
        <p class="lead text-muted">Your stickers are on their way. Order #@order.PkOrderId</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Order Details</h5>

                    <div class="row mb-3">
                        <div class="col-6">
                            <p class="mb-1 text-muted small">Order Date</p>
                            <p class="fw-semibold">@order.CreatedAt.ToString("MMMM d, yyyy")</p>
                        </div>
                        <div class="col-6">
                            <p class="mb-1 text-muted small">Status</p>
                            <span class="badge bg-success">@order.OrderStatus</span>
                        </div>
                    </div>

                    @if (order.ContactDetail is not null)
                    {
                        <h6 class="fw-bold mt-3 mb-2">Ship To</h6>
                        <address class="text-muted mb-4">
                            @order.ContactDetail.FirstName @order.ContactDetail.LastName<br />
                            @order.ContactDetail.Street<br />
                            @order.ContactDetail.City, @order.ContactDetail.Province @order.ContactDetail.PostCode<br />
                            @order.ContactDetail.Country
                        </address>
                    }

                    <h6 class="fw-bold mb-2">Items</h6>
                    @foreach (var item in order.OrderItems)
                    {
                        <div class="d-flex justify-content-between mb-1">
                            <span>@(item.Products?.Name ?? "Product") <span class="text-muted">× @item.Quantity</span></span>
                            <span>$@((item.Products?.Price ?? 0) * item.Quantity).ToString("F2")</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                        <span>Total</span>
                        <span>$@order.TotalAmount.ToString("F2")</span>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 justify-content-center">
                <a asp-controller="Order" asp-action="History" class="btn btn-outline-dark">View All Orders</a>
                <a asp-controller="Product" asp-action="Index" class="btn btn-dark">Keep Shopping</a>
            </div>
        </div>
    </div>
</div>
