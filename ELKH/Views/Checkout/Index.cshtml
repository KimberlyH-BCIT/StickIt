@model ELKH.ViewModels.CheckoutVM
@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var paypalClientId = ViewBag.PayPalClientId as string ?? "";
}

@section title {
    <h1 class="fw-bold mb-4">Checkout</h1>
}

<div class="container py-4">

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form id="checkoutForm" asp-action="ProcessPayment" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">
                            <i class="bi bi-geo-alt me-2"></i>Shipping Address
                        </h5>

                        @if (Model.SavedAddresses.Any())
                        {
                            <div class="mb-4">
                                <label for="addressSelector" class="form-label fw-semibold">Select a saved address</label>
                                <select class="form-select" id="addressSelector" name="addressSelector">
                                    <option value="">-- Enter new address --</option>
                                    @foreach (var addr in Model.SavedAddresses)
                                    {
                                        var isSelected = addr.ContactId == Model.SelectedContactId;
                                        var badgeText = addr.IsDefault ? " [Default]" : "";
                                        <option value="@addr.ContactId" 
                                                data-fullname="@addr.FirstName @addr.LastName"
                                                data-phone="@addr.PhoneNumber"
                                                data-street="@addr.Street"
                                                data-city="@addr.City"
                                                data-province="@addr.Province"
                                                data-postalcode="@addr.PostalCode"
                                                data-country="@addr.Country"
                                                selected="@isSelected">
                                            @addr.FirstName @addr.LastName - @addr.Street, @addr.City, @addr.Province@(badgeText)
                                        </option>
                                    }
                                </select>
                                <small class="text-muted">Or enter a new address below</small>
                            </div>
                            <hr class="mb-4" />
                        }

                        <input type="hidden" asp-for="SelectedContactId" id="selectedContactId" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Jane Doe" id="fullName" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="604-555-0100" id="phoneNumber" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" placeholder="123 Sticker Lane" id="street" />
                            <span asp-validation-for="Street" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label"></label>
                                <input asp-for="City" class="form-control" id="city" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Province" class="form-label"></label>
                                <input asp-for="Province" class="form-control" placeholder="BC" id="province" />
                                <span asp-validation-for="Province" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="PostalCode" class="form-label"></label>
                                <input asp-for="PostalCode" class="form-control" placeholder="V6B 1A1" id="postalCode" />
                                <span asp-validation-for="PostalCode" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Country" class="form-label"></label>
                                <input asp-for="Country" class="form-control" id="country" />
                                <span asp-validation-for="Country" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="alert alert-info mt-3 mb-0">
                            Complete your shipping details, then pay with PayPal.
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Order Summary</h5>

                        @foreach (var item in Model.Items)
                        {
                            <div class="d-flex justify-content-between mb-2">
                                <span>@item.ProductName <span class="text-muted">× @item.Quantity</span></span>
                                <span>$@item.LineTotal.ToString("F2")</span>
                            </div>
                        }

                        <hr />
                        <div class="d-flex justify-content-between mb-1">
                            <span>Subtotal</span>
                            <span>$@Model.Subtotal.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-1">
                            <span>Tax (12%)</span>
                            <span>$@Model.Tax.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Shipping</span>
                            <span>@(Model.ShippingCost == 0 ? "Free!" : "$" + Model.ShippingCost.ToString("F2"))</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-4">
                            <span>Total</span>
                            <span>$@Model.Total.ToString("F2")</span>
                        </div>

                        <h6 class="text-center mb-3 text-muted">
                            <i class="bi bi-lock me-1"></i>Secure Payment with PayPal
                        </h6>

                        <!-- PayPal Button Container -->
                        <div id="paypal-button-container" class="mb-3"></div>

                        <!-- Fallback button if PayPal doesn't load -->
                        <button type="submit" class="btn btn-dark w-100 btn-lg mb-2" id="fallbackButton">
                            <i class="bi bi-check-circle me-2"></i>Place Order
                        </button>

                        <div class="text-center mb-3">
                            <small class="text-muted">
                                <i class="bi bi-shield-check me-1"></i>
                                Your payment is processed securely through PayPal
                            </small>
                        </div>

                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-arrow-left me-1"></i>Back to Cart
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <!-- ═══════════════════════════════════════════════════════════════════
         Address Selector JavaScript
         ═════════════════════════════════════════════════════════════════
         Functionality: When user selects a saved address from dropdown,
         auto-populate the shipping address form fields with that address.
         When "Enter new address" is selected, clear all fields.
    ═══════════════════════════════════════════════════════════════════ -->
    <script>
        document.getElementById('addressSelector')?.addEventListener('change', function() {
            const selected = this.options[this.selectedIndex];
            if (selected.value) {
                // Populate form fields from data attributes
                document.getElementById('selectedContactId').value = selected.value;
                document.getElementById('fullName').value = selected.dataset.fullname || '';
                document.getElementById('phoneNumber').value = selected.dataset.phone || '';
                document.getElementById('street').value = selected.dataset.street || '';
                document.getElementById('city').value = selected.dataset.city || '';
                document.getElementById('province').value = selected.dataset.province || '';
                document.getElementById('postalCode').value = selected.dataset.postalcode || '';
                document.getElementById('country').value = selected.dataset.country || 'Canada';
            } else {
                // Clear fields for new address entry
                document.getElementById('selectedContactId').value = '';
                document.getElementById('fullName').value = '';
                document.getElementById('phoneNumber').value = '';
                document.getElementById('street').value = '';
                document.getElementById('city').value = '';
                document.getElementById('province').value = '';
                document.getElementById('postalCode').value = '';
                document.getElementById('country').value = 'Canada';
            }
        });
    </script>

    @if (!string.IsNullOrWhiteSpace(paypalClientId))
    {
        <!-- PayPal SDK -->
        <script src="https://www.paypal.com/sdk/js?client-id=@paypalClientId&currency=CAD&disable-funding=paylater"></script>

        <!-- ═══════════════════════════════════════════════════════════════════
             PayPal Integration JavaScript
             ═════════════════════════════════════════════════════════════════
             Client-side PayPal checkout flow (simplified approach from pr-43):

             1. Render PayPal button in #paypal-button-container
             2. onClick: Validate form before allowing PayPal to open
             3. createOrder: Send order total to PayPal
             4. onApprove: Capture payment, then submit form to ProcessPayment
             5. onError: Show fallback "Place Order" button
             6. Hide fallback button once PayPal renders successfully

             This approach avoids backend PayPal API calls - payment is captured
             entirely client-side, then server creates the order record.
        ═══════════════════════════════════════════════════════════════════ -->
        <script>
            (function () {
                const form = document.getElementById("checkoutForm");
                const fallbackBtn = document.getElementById("fallbackButton");
                const total = "@Model.Total.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)";

                // Form validation helper
                function formIsValid() {
                    if (!form) return false;
                    return form.reportValidity(); // HTML5 validation
                }

                // Render PayPal button
                paypal.Buttons({
                    style: {
                        layout: "vertical",
                        color: "gold",
                        shape: "rect",
                        label: "paypal"
                    },

                    // Before PayPal opens, validate the shipping address form
                    onClick: function () {
                        if (!formIsValid()) {
                            alert('Please fill in all required shipping address fields.');
                            return false; // Prevent PayPal from opening
                        }
                        return true; // Allow PayPal to proceed
                    },

                    // Create PayPal order with cart total
                    createOrder: function (data, actions) {
                        return actions.order.create({
                            purchase_units: [{
                                amount: {
                                    currency_code: "CAD",
                                    value: total
                                }
                            }]
                        });
                    },

                    // Payment approved by PayPal, capture the funds
                    onApprove: function (data, actions) {
                        return actions.order.capture().then(function () {
                            // Payment captured successfully, submit form to create order in database
                            form.submit();
                        });
                    },

                    // PayPal error handler - show fallback button
                    onError: function (err) {
                        console.error("PayPal error:", err);
                        alert("PayPal payment could not be started. You can use the 'Place Order' button instead.");
                        if (fallbackBtn) fallbackBtn.style.display = 'block';
                    }
                }).render("#paypal-button-container").then(function() {
                    // PayPal button rendered successfully, hide fallback button
                    if (fallbackBtn) fallbackBtn.style.display = 'none';
                }).catch(function(err) {
                    console.error('PayPal button render error:', err);
                    // Keep fallback button visible if PayPal SDK fails to load
                });
            })();
        </script>
    }
}