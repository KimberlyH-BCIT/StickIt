@model ELKH.ViewModels.CheckoutVM

@{
    ViewData["Title"] = "Checkout";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4">Checkout</h1>

    <div class="row g-4">
        <!-- LEFT: Shipping / Contact Form -->
        <div class="col-lg-7">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Shipping Information</h4>
                    <p class="text-muted mb-4">Please fill in your delivery details.</p>

                    <form asp-action="ProcessPayment" method="post" class="row g-3">
                        @Html.AntiForgeryToken()

                        <div class="col-12">
                            <label asp-for="FullName" class="form-label"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" placeholder="Street address" />
                            <span asp-validation-for="Street" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" placeholder="City" />
                            <span asp-validation-for="City" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="Province" class="form-label"></label>
                            <input asp-for="Province" class="form-control" placeholder="Province" />
                            <span asp-validation-for="Province" class="text-danger"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="PostalCode" class="form-label"></label>
                            <input asp-for="PostalCode" class="form-control" placeholder="Postal code" />
                            <span asp-validation-for="PostalCode" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Country" class="form-label"></label>
                            <input asp-for="Country" class="form-control" placeholder="Country" />
                            <span asp-validation-for="Country" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        
                        <div class="alert alert-warning rounded-4 mb-3">
                            <strong>All sales are final.</strong> No refunds.
                            <a asp-controller="Home" asp-action="ShippingDelivery" class="ms-2">Shipping & Delivery</a>
                        </div>

                        <div class="col-12 d-flex gap-2 mt-3">
                            <button type="submit" class="btn stickit-btn">Place Order</button>
                            <a asp-controller="Cart" asp-action="Index" class="btn stickit-btn-outline">Back to Cart</a>
                        </div>
                        
                        <input type="hidden" name="paypalOrderId" id="paypalOrderId" value="" />

                        <div class="mt-3">
                            
                            <div id="paypal-button-container"></div>
                        </div>
                
                        @section Scripts {
                            <partial name="_ValidationScriptsPartial" />
                
                            <script src="https://www.paypal.com/sdk/js?client-id=@ViewBag.PayPalClientId&currency=CAD&disable-funding=paylater"></script>
                            <script>
                                paypal.Buttons({
                                    createOrder: async function () {
                                        // use Total from your model
                                        const total = @Model.Total.ToString("F2", System.Globalization.CultureInfo.InvariantCulture);
                
                                        const res = await fetch("/paypal/create-order", {
                                            method: "POST",
                                            headers: { "Content-Type": "application/json" },
                                            body: JSON.stringify({ total: total })
                                        });
                
                                        const data = await res.json();
                                        return data.id;
                                    },
                
                                    onApprove: async function (data) {
                                        // capture payment
                                        await fetch("/paypal/capture-order", {
                                            method: "POST",
                                            headers: { "Content-Type": "application/json" },
                                            body: JSON.stringify({ orderId: data.orderID })
                                        });
                
                                        // put the paypal order id into the hidden input then submit to Finalize
                                        document.getElementById("paypalOrderId").value = data.orderID;
                
                                        // submit the SAME shipping form to Checkout/Finalize
                                        const form = document.querySelector("form[asp-action='ProcessPayment'], form[action*='ProcessPayment']") 
                                                   || document.querySelector("form");
                
                                        // IMPORTANT: Make your form post to Finalize
                                        form.action = "/Checkout/Finalize";
                                        form.submit();
                                    }
                                }).render("#paypal-button-container");
                            </script>
                        }
                    </form>
                </div>
            </div>
        </div>

        <!-- RIGHT: Order Summary -->
        <div class="col-lg-5">
            <div class="card shadow-sm rounded-4 border-0">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-3">Order Summary</h4>

                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <p class="text-muted mb-0">Your cart is empty.</p>
                    }
                    else
                    {
                        <div class="mb-3">
                            @foreach (var item in Model.Items)
                            {
                                <div class="d-flex justify-content-between align-items-start py-2 border-bottom">
                                    <div>
                                        <div class="fw-semibold">@item.ProductName</div>
                                        <div class="text-muted small">Qty: @item.Quantity</div>
                                    </div>
                                    <div class="fw-semibold">$@item.LineTotal.ToString("F2")</div>
                                </div>
                            }
                        </div>

                        <div class="pt-3">
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Subtotal</span>
                                <span class="fw-semibold">$@Model.Subtotal.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-muted">Tax</span>
                                <span class="fw-semibold">$@Model.Tax.ToString("F2")</span>
                            </div>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Shipping</span>
                                <span class="fw-semibold">$@Model.ShippingCost.ToString("F2")</span>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between fs-5">
                                <span class="fw-bold">Total</span>
                                <span class="fw-bold">$@Model.Total.ToString("F2")</span>
                            </div>

                            <div class="text-muted small mt-2">
                                Free shipping on orders $50+.
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

