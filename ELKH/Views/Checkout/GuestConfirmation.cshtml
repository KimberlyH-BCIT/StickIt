@model ELKH.Models.OrderModel

@{
    ViewData["Title"] = $"Order Confirmation - Order #{Model.PkOrderId} Successfully Placed";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Delivery status
    var isPending = Model.DeliveryStatus == ELKH.Models.DeliveryStatus.Pending;
}

@section title {
    <header class="mb-4">
        <div class="text-center mb-4">
            <div class="text-success mb-3">
                <i class="bi bi-check-circle-fill" aria-hidden="true" style="font-size: 4rem;"></i>
            </div>
            <h1 class="fw-bold mb-2">Order Confirmed!</h1>
            <p class="text-muted mb-0" role="status">
                Thank you for your purchase. Your order has been successfully placed.
            </p>
        </div>
    </header>
}

<main class="container py-4" role="main">
    <!-- Success Alert -->
    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" aria-live="polite">
        <h2 class="alert-heading h5 mb-2">
            <i class="bi bi-check-circle me-2" aria-hidden="true"></i>
            Order Successfully Placed
        </h2>
        <p class="mb-2">
            <strong>Order Number:</strong> #@Model.PkOrderId<br />
            <strong>Order Total:</strong> @Model.TotalAmount.ToString("C")
        </p>
        <hr />
        <p class="mb-0">
            <i class="bi bi-envelope me-1" aria-hidden="true"></i>
            A confirmation email has been sent with your secure order access link, details, and tracking information.
        </p>
        <button type="button" 
                class="btn-close" 
                data-bs-dismiss="alert"
                aria-label="Close success message"></button>
    </div>

    <!-- Delivery Status Tracker -->
    <section aria-labelledby="delivery-status-heading">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h2 id="delivery-status-heading" class="h5 fw-bold mb-0">
                    <i class="bi bi-truck me-2" aria-hidden="true"></i>
                    Delivery Status
                </h2>
            </div>
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex align-items-center justify-content-between position-relative mb-4"
                             role="progressbar"
                             aria-valuenow="0"
                             aria-valuemin="0"
                             aria-valuemax="3"
                             aria-label="Order delivery progress">
                            <!-- Progress Bar Background -->
                            <div class="position-absolute w-100" style="height: 2px; background: #dee2e6; top: 20px; z-index: 0;"></div>

                            <!-- Step 1: Pending -->
                            <div class="text-center position-relative" style="z-index: 1; flex: 1;">
                                <div class="mb-2">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-success text-white" 
                                         style="width: 40px; height: 40px;"
                                         aria-label="Step 1: Order pending - Completed">
                                        <i class="bi bi-check-lg fw-bold" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <small class="fw-semibold text-success">Pending</small>
                            </div>

                            <!-- Step 2: Processing -->
                            <div class="text-center position-relative" style="z-index: 1; flex: 1;">
                                <div class="mb-2">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted" 
                                         style="width: 40px; height: 40px;"
                                         aria-label="Step 2: Processing - Not started">
                                        <i class="bi bi-circle" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <small class="fw-semibold text-muted">Processing</small>
                            </div>

                            <!-- Step 3: Shipped -->
                            <div class="text-center position-relative" style="z-index: 1; flex: 1;">
                                <div class="mb-2">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted" 
                                         style="width: 40px; height: 40px;"
                                         aria-label="Step 3: Shipped - Not started">
                                        <i class="bi bi-circle" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <small class="fw-semibold text-muted">Shipped</small>
                            </div>

                            <!-- Step 4: Delivered -->
                            <div class="text-center position-relative" style="z-index: 1; flex: 1;">
                                <div class="mb-2">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted" 
                                         style="width: 40px; height: 40px;"
                                         aria-label="Step 4: Delivered - Not started">
                                        <i class="bi bi-circle" aria-hidden="true"></i>
                                    </div>
                                </div>
                                <small class="fw-semibold text-muted">Delivered</small>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 mb-0" role="status">
                            <strong>Current Status:</strong> @Model.DeliveryStatus
                            <p class="mb-0 mt-2 small">
                                You'll receive email updates as your order progresses through each stage.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <div class="row g-4">
        <!-- Order Information -->
        <div class="col-lg-6">
            <section aria-labelledby="order-info-heading">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 id="order-info-heading" class="h5 fw-bold mb-0">
                            <i class="bi bi-receipt me-2" aria-hidden="true"></i>
                            Order Information
                        </h2>
                    </div>
                    <div class="card-body p-4">
                        <dl class="mb-0">
                            <dt class="fw-semibold">Order Number:</dt>
                            <dd class="mb-3">#@Model.PkOrderId</dd>

                            <dt class="fw-semibold">Order Date:</dt>
                            <dd class="mb-3">@Model.CreatedAt.ToString("MMMM dd, yyyy 'at' h:mm tt")</dd>

                            <dt class="fw-semibold">Payment Status:</dt>
                            <dd class="mb-3">
                                <span class="badge bg-success px-3 py-2">@Model.OrderStatus</span>
                            </dd>

                            <dt class="fw-semibold">Delivery Status:</dt>
                            <dd class="mb-0">
                                <span class="badge bg-info px-3 py-2">@Model.DeliveryStatus</span>
                            </dd>
                        </dl>
                    </div>
                </div>
            </section>
        </div>

        <!-- Shipping Address -->
        <div class="col-lg-6">
            <section aria-labelledby="shipping-address-heading">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-white py-3">
                        <h2 id="shipping-address-heading" class="h5 fw-bold mb-0">
                            <i class="bi bi-geo-alt me-2" aria-hidden="true"></i>
                            Shipping Address
                        </h2>
                    </div>
                    <div class="card-body p-4">
                        @if (Model.ContactDetail != null)
                        {
                            <address class="mb-0">
                                <strong>@Model.ContactDetail.FirstName @Model.ContactDetail.LastName</strong><br />
                                @Model.ContactDetail.Street<br />
                                @Model.ContactDetail.City, @Model.ContactDetail.Province @Model.ContactDetail.PostCode<br />
                                @Model.ContactDetail.Country<br />
                                <abbr title="Phone">Phone:</abbr> @Model.ContactDetail.PhoneNumber
                            </address>
                        }
                        else
                        {
                            <p class="text-muted mb-0">Shipping address information not available.</p>
                        }
                    </div>
                </div>
            </section>
        </div>
    </div>

    <!-- Order Items -->
    <section aria-labelledby="order-items-heading">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white py-3">
                <h2 id="order-items-heading" class="h5 fw-bold mb-0">
                    <i class="bi bi-box-seam me-2" aria-hidden="true"></i>
                    Order Items
                </h2>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0" aria-label="Ordered items with quantities and prices">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Product</th>
                                <th scope="col" class="text-center">Quantity</th>
                                <th scope="col" class="text-end">Unit Price</th>
                                <th scope="col" class="text-end">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderItems != null && Model.OrderItems.Any())
                            {
                                foreach (var item in Model.OrderItems)
                                {
                                    var lineTotal = item.UnitPrice * item.Quantity;
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">
                                                @(item.Product?.Name ?? "Product")
                                            </div>
                                        </td>
                                        <td class="text-center">@item.Quantity</td>
                                        <td class="text-end">@item.UnitPrice.ToString("C")</td>
                                        <td class="text-end fw-semibold">@lineTotal.ToString("C")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-4">
                                        No items found in this order.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white py-3">
                <div class="row">
                    <div class="col-md-6 offset-md-6">
                        <dl class="row mb-0">
                            <dt class="col-6 text-end">Subtotal:</dt>
                            <dd class="col-6 text-end mb-2">
                                @{
                                    var subtotal = Model.OrderItems?.Sum(i => i.UnitPrice * i.Quantity) ?? 0m;
                                    var tax = subtotal * 0.12m;
                                    var shipping = subtotal >= 50m ? 0m : 7.99m;
                                }
                                @subtotal.ToString("C")
                            </dd>

                            <dt class="col-6 text-end">Tax (12%):</dt>
                            <dd class="col-6 text-end mb-2">@tax.ToString("C")</dd>

                            <dt class="col-6 text-end">Shipping:</dt>
                            <dd class="col-6 text-end mb-2">
                                @(shipping == 0 ? "Free!" : shipping.ToString("C"))
                            </dd>

                            <dt class="col-6 text-end fw-bold fs-5">Total:</dt>
                            <dd class="col-6 text-end fw-bold fs-5 text-success mb-0">
                                @Model.TotalAmount.ToString("C")
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Next Steps / Actions -->
    <section aria-labelledby="next-steps-heading">
        <div class="card shadow-sm border-primary">
            <div class="card-header bg-primary text-white py-3">
                <h2 id="next-steps-heading" class="h5 fw-bold mb-0">
                    <i class="bi bi-lightbulb me-2" aria-hidden="true"></i>
                    What's Next?
                </h2>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <h3 class="h6 fw-semibold">
                            <i class="bi bi-envelope-check me-2 text-primary" aria-hidden="true"></i>
                            Check Your Email
                        </h3>
                        <p class="mb-0 small text-muted">
                            We've sent a confirmation email with your secure order link, details, and tracking information. 
                            Be sure to check your spam folder if you don't see it in your inbox.
                        </p>
                    </div>
                    <div class="col-md-6">
                        <h3 class="h6 fw-semibold">
                            <i class="bi bi-person-plus me-2 text-primary" aria-hidden="true"></i>
                            Create an Account
                        </h3>
                        <p class="mb-2 small text-muted">
                            Save your information and track orders easily by creating an account.
                        </p>
                        <a asp-area="Identity" 
                           asp-page="/Account/Register" 
                           class="btn btn-sm btn-outline-primary"
                           aria-label="Create an account to track your orders">
                            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>
                            Create Account
                        </a>
                    </div>
                </div>

                <hr class="my-4" role="separator" />

                <div class="text-center">
                    <a asp-controller="Product" 
                       asp-action="Index" 
                       class="btn btn-primary btn-lg me-2"
                       aria-label="Continue shopping for more products">
                        <i class="bi bi-shop me-2" aria-hidden="true"></i>
                        Continue Shopping
                    </a>
                    <button onclick="window.print()" 
                            class="btn btn-outline-secondary btn-lg"
                            aria-label="Print this order confirmation for your records">
                        <i class="bi bi-printer me-2" aria-hidden="true"></i>
                        Print Confirmation
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Support Information -->
    <div class="alert alert-light border mt-4" role="complementary">
        <h3 class="h6 fw-semibold mb-2">
            <i class="bi bi-question-circle me-2" aria-hidden="true"></i>
            Need Help?
        </h3>
        <p class="mb-0 small">
            If you have any questions about your order, please <a asp-controller="Home" asp-action="Contact">contact us</a>. 
            Include your order number (#@Model.PkOrderId) in your message for faster assistance.
        </p>
    </div>
</main>

@section Scripts {
    <script>
        // Auto-focus success alert for screen readers
        document.addEventListener('DOMContentLoaded', function() {
            const successAlert = document.querySelector('.alert-success');
            if (successAlert) {
                successAlert.focus();
            }
        });

        // Print styles optimization
        const printStyles = `
            @@media print {
                .btn, .alert-dismissible .btn-close, nav, footer {
                    display: none !important;
                }
                .card {
                    border: 1px solid #000 !important;
                    page-break-inside: avoid;
                }
            }
        `;
        const styleSheet = document.createElement("style");
        styleSheet.textContent = printStyles;
        document.head.appendChild(styleSheet);
    </script>
}
