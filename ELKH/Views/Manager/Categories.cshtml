@model List<ELKH.Models.CategoryModel>

@{
    ViewData["Title"] = "Category Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main role="main" aria-labelledby="main-heading">
    <div class="container-fluid mt-4 px-4 pb-5">

        <header class="mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h1 id="main-heading" class="fw-bold text-primary mb-0">Category Management</h1>
                    <p class="text-muted mb-0 small">Create, rename, or remove product categories</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="CreateCategory" class="btn btn-success rounded-pill px-4">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>New Category
                    </a>
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">← Dashboard</a>
                </div>
            </div>
        </header>

        @if (TempData["Message"] is string msg)
        {
            var parts = msg.Split(',', 2);
            var alertType = parts[0] switch { "success" => "success", "warning" => "warning", _ => "danger" };
            <div class="alert alert-@alertType alert-dismissible fade show" role="alert">
                @parts.ElementAtOrDefault(1)?.Trim()
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="kawaii-panel">
            <table class="table table-hover align-middle mb-0" aria-label="Product categories">
                <thead>
                    <tr>
                        <th scope="col">Category Name</th>
                        <th scope="col" class="text-center">Products</th>
                        <th scope="col" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@cat.CategoryName</td>
                            <td class="text-center">
                                <span class="badge bg-secondary">@cat.Products.Count</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="EditCategory" asp-route-id="@cat.PkCategoryId"
                                       class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-pencil me-1" aria-hidden="true"></i>Edit
                                    </a>
                                    <form asp-action="DeleteCategory" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@cat.PkCategoryId" />
                                        <button type="submit"
                                                class="btn btn-outline-danger btn-sm rounded-pill px-3"
                                                onclick="return confirm('Delete category \'@cat.CategoryName\'? This cannot be undone.')"
                                                @(cat.Products.Count > 0 ? "disabled title=\"Cannot delete: category has products\"" : "")>
                                            <i class="bi bi-trash me-1" aria-hidden="true"></i>Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">No categories yet. Create one above.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
