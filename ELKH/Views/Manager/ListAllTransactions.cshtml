@model List<ELKH.ViewModels.TransactionVM>

@{
    ViewData["Title"] = "Transactions";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string search = ViewBag.Search as string ?? "";
}

<div class="container mt-4 mb-5" style="max-width:1100px;">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">All Transactions</h2>

        <a asp-controller="Manager"
               asp-action="Index"
               class="btn btn-sm btn-outline-primary rounded-pill px-4">
            ← Back To Dashboard
        </a>
    </div>

    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body py-3 px-4 d-flex justify-content-center">
            <form method="get" class="d-flex align-items-center gap-2">
                <div class="input-group" style="max-width:320px;">
                    <input type="text" name="search" value="@search"
                           class="form-control form-control-sm rounded-start-pill"
                           placeholder="Search by status…" />
                    <button type="submit" class="btn btn-sm btn-primary rounded-end-pill px-3">Search</button>
                </div>

                @if (!string.IsNullOrEmpty(search))
                {
                    <a asp-action="ListAllTransactions"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                        ✕ Clear
                    </a>
                }
            </form>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow rounded-4 overflow-hidden">
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width:60px;">#</th>
                            <th>Transaction Id</th>
                            <th>Status</th>
                            <th class="text-end">Amount</th>
                            <th>Date</th>
                            <th class="text-center" style="width:110px;">Details</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var t in Model)
                            {
                                var badgeClass = t.TransactionStatus?.ToLower() switch
                                {
                                    "paid" => "bg-success",
                                    "pending" => "bg-warning text-dark",
                                    "failed" => "bg-danger",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="ps-3 text-muted small">@t.PkTransactionId</td>

                                    <td class="fw-semibold">
                                        #@t.PkTransactionId
                                    </td>

                                    <td>
                                        <span class="badge @badgeClass px-3 py-1">
                                            @t.TransactionStatus
                                        </span>
                                    </td>

                                    <td class="text-end fw-semibold text-success">
                                        $@t.Amount.ToString("N2")
                                    </td>

                                    <td class="text-muted small" style="white-space:nowrap;">
                                        @t.TransactionDate.ToString("MMM dd, yyyy h:mm tt")
                                    </td>

                                    <td class="text-center">
                                        <a asp-controller="Manager" asp-action="TransactionDetail"
                                               asp-route-id="@t.PkTransactionId"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                            View
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">
                                    No transactions found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination pagination-sm justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link rounded-pill mx-1"
                               asp-action="ListAllTransactions"
                               asp-route-page="@i"
                               asp-route-search="@search">
                            @i
                        </a>
                    </li>
                }
            </ul>
        </nav>
    }

</div>

<style>
    .card {
        border-radius: 16px;
    }

    .table th {
        font-weight: 600;
        font-size: .85rem;
    }

    .table td {
        font-size: .9rem;
    }

    .badge {
        font-size: .75rem;
    }
</style>