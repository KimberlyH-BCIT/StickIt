@{
    ViewData["Title"] = "Manager Dashboard - Inventory & Operations Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Skip Links for Keyboard Navigation -->
<nav class="skip-links sr-only-focusable mb-2" aria-label="Skip navigation">
    <a href="#main-heading" class="skip-link btn btn-primary">Skip to dashboard</a>
    <a href="#kpi-cards" class="skip-link btn btn-primary">Skip to statistics</a>
    <a href="#recent-activity" class="skip-link btn btn-primary">Skip to recent activity</a>
</nav>

<main role="main" aria-labelledby="main-heading">
    <div class="container-fluid px-4 mt-4 pb-5">

        <!-- Enhanced Header with Accessibility -->
        <header class="manager-header mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h1 id="main-heading" class="fw-bold mb-0">Manager Dashboard</h1>
                    <p class="text-muted mb-0 small" aria-label="Dashboard for inventory and operations, current date @DateTime.Now.ToString("dddd, MMMM d yyyy")">Inventory & operations · @DateTime.Now.ToString("dddd, MMMM d yyyy")</p>
                </div>
                <nav aria-label="View mode navigation" class="d-flex gap-2 flex-wrap">
                    <a asp-controller="Staff" asp-action="Index"
                       class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                       aria-label="Switch to Staff view mode">
                        <span aria-hidden="true">🧑‍💼</span> View as Staff
                    </a>
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-sm btn-outline-secondary rounded-pill px-3"
                       aria-label="Switch to Customer view mode">
                        <span aria-hidden="true">🛒</span> View as Customer
                    </a>
                </nav>
            </div>
        </header>

    <!-- Enhanced KPI Cards with Accessibility -->
    <section aria-labelledby="kpi-heading" id="kpi-cards">
        <h2 id="kpi-heading" class="sr-only">Key Performance Indicators and Quick Actions</h2>

        <div class="row g-3 mb-5" 
             role="group" 
             aria-label="Dashboard statistics and quick navigation links">

            <!-- Total Products -->
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Manager" asp-action="ListOfProducts"
                   class="text-decoration-none kpi-link"
                   role="button"
                   aria-labelledby="total-products-label"
                   aria-describedby="total-products-desc">
                    <article class="card border-0 shadow-sm rounded-4 h-100 kpi-card"
                             aria-labelledby="total-products-label">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                            <span style="font-size:1.6rem;" aria-hidden="true">📦</span>
                            <h3 class="fw-bold mb-0 mt-1 h4" id="total-products-label">@ViewBag.TotalProducts</h3>
                            <p class="text-muted small mb-0" id="total-products-desc">All Products</p>
                        </div>
                    </article>
                </a>
            </div>

            <!-- Active Products -->
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Manager" asp-action="ListOfProducts"
                   asp-route-activeFilter="active"
                   class="text-decoration-none kpi-link"
                   role="button"
                   aria-labelledby="active-products-label"
                   aria-describedby="active-products-desc">
                    <article class="card border-0 shadow-sm rounded-4 h-100 kpi-card border-success-subtle"
                             aria-labelledby="active-products-label">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                            <span style="font-size:1.6rem;" aria-hidden="true">✅</span>
                            <h3 class="fw-bold mb-0 mt-1 text-success h4" id="active-products-label">@ViewBag.ActiveProducts</h3>
                            <p class="text-muted small mb-0" id="active-products-desc">Active Products</p>
                        </div>
                    </article>
                </a>
            </div>

            <!-- Inactive Products -->
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Manager" asp-action="ListOfProducts"
                   asp-route-activeFilter="inactive"
                   class="text-decoration-none kpi-link"
                   role="button"
                   aria-labelledby="inactive-products-label"
                   aria-describedby="inactive-products-desc">
                    <article class="card border-0 shadow-sm rounded-4 h-100 kpi-card"
                             aria-labelledby="inactive-products-label">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                            <span style="font-size:1.6rem;" aria-hidden="true">⛔</span>
                            <h3 class="fw-bold mb-0 mt-1 text-secondary h4" id="inactive-products-label">@ViewBag.InactiveProducts</h3>
                            <p class="text-muted small mb-0" id="inactive-products-desc">Inactive Products</p>
                        </div>
                    </article>
                </a>
            </div>

            <!-- Well Stocked -->
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Manager" asp-action="ListOfProducts"
                   asp-route-stockFilter="stocked"
                   class="text-decoration-none kpi-link"
                   role="button"
                   aria-labelledby="stocked-label"
                   aria-describedby="stocked-desc">
                    <article class="card border-0 shadow-sm rounded-4 h-100 kpi-card"
                             aria-labelledby="stocked-label">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                            <span style="font-size:1.6rem;" aria-hidden="true">🟢</span>
                            <h3 class="fw-bold mb-0 mt-1 text-success h4" id="stocked-label">@ViewBag.StockUpCount</h3>
                            <p class="text-muted small mb-0" id="stocked-desc">Well Stocked</p>
                            <p class="mb-0" style="font-size:.65rem;color:#9ca3af;" aria-label="More than 20 units in stock">&gt; 20 units</p>
                        </div>
                    </article>
                </a>
            </div>

            <!-- Low Stock -->
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Manager" asp-action="ListOfProducts"
                   asp-route-stockFilter="low"
                   class="text-decoration-none kpi-link"
                   role="button"
                   aria-labelledby="low-stock-label"
                   aria-describedby="low-stock-desc">
                    <article class="card border-0 shadow-sm rounded-4 h-100 kpi-card"
                             aria-labelledby="low-stock-label">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                            <span style="font-size:1.6rem;" aria-hidden="true">🔴</span>
                            <h3 class="fw-bold mb-0 mt-1 text-danger h4" id="low-stock-label">@ViewBag.LowStockCount</h3>
                            <p class="text-muted small mb-0" id="low-stock-desc">Low Stock</p>
                            <p class="mb-0" style="font-size:.65rem;color:#9ca3af;" aria-label="5 units or fewer in stock">≤ 5 units</p>
                        </div>
                    </article>
                </a>
            </div>

            <!-- Weekly Orders -->
            <div class="col-6 col-md-4 col-lg-2">
                <a asp-controller="Manager" asp-action="ListAllTransactions"
                   class="text-decoration-none kpi-link"
                   role="button"
                   aria-labelledby="weekly-orders-label"
                   aria-describedby="weekly-orders-desc">
                    <article class="card border-0 shadow-sm rounded-4 h-100 kpi-card"
                             aria-labelledby="weekly-orders-label">
                        <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                            <span style="font-size:1.6rem;" aria-hidden="true">📅</span>
                            <h3 class="fw-bold mb-0 mt-1 h4" id="weekly-orders-label">@ViewBag.WeeklyOrders</h3>
                            <p class="text-muted small mb-0" id="weekly-orders-desc">Weekly Orders</p>
                        </div>
                    </article>
                </a>
            </div>

        </div>
    </section>

            <!-- Enhanced Main Task Cards with Accessibility -->
            <section aria-labelledby="main-tasks-heading" id="recent-activity">
                <h2 id="main-tasks-heading" class="sr-only">Main Management Tasks</h2>

                <div class="row g-4">

                    <div class="col-md-4">
                        <a asp-controller="Manager" 
                           asp-action="ListOfProducts" 
                           class="text-decoration-none mgr-task-link"
                           role="button"
                           aria-labelledby="products-task-title"
                           aria-describedby="products-task-desc">
                            <article class="card border-0 shadow-sm rounded-4 h-100 mgr-card"
                                     aria-labelledby="products-task-title">
                                <div class="card-body p-4 d-flex align-items-center gap-4">
                                    <div class="mgr-icon-wrap bg-primary bg-opacity-10 rounded-4 p-3"
                                         aria-hidden="true">
                                        <span style="font-size:2.4rem;">📦</span>
                                    </div>
                                    <div>
                                        <h3 id="products-task-title" class="fw-bold mb-1 text-dark h5">Manage Products</h3>
                                        <p id="products-task-desc" class="text-muted small mb-2">View, edit, and manage stock</p>
                                        <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small"
                                              aria-label="Inventory management category">
                                            Inventory
                                        </span>
                                    </div>
                                </div>
                                <div class="card-footer bg-primary text-white text-center py-2 rounded-bottom-4 fw-semibold small">
                                    Go to Products →
                                </div>
                            </article>
                        </a>
                    </div>

                    <div class="col-md-4">
                        <a asp-controller="Manager" 
                           asp-action="ListAllTransactions" 
                           class="text-decoration-none mgr-task-link"
                           role="button"
                           aria-labelledby="transactions-task-title"
                           aria-describedby="transactions-task-desc">
                            <article class="card border-0 shadow-sm rounded-4 h-100 mgr-card"
                                     aria-labelledby="transactions-task-title">
                                <div class="card-body p-4 d-flex align-items-center gap-4">
                                    <div class="mgr-icon-wrap bg-success bg-opacity-10 rounded-4 p-3"
                                         aria-hidden="true">
                                        <span style="font-size:2.4rem;">💳</span>
                                    </div>
                                    <div>
                                        <h3 id="transactions-task-title" class="fw-bold mb-1 text-dark h5">Transactions</h3>
                                        <p id="transactions-task-desc" class="text-muted small mb-2">View and track all transactions</p>
                                        <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small"
                                              aria-label="Financial management category">
                                            Financials
                                        </span>
                                    </div>
                                </div>
                                <div class="card-footer bg-success text-white text-center py-2 rounded-bottom-4 fw-semibold small">
                                    Go to Transactions →
                                </div>
                            </article>
                        </a>
                    </div>

                    <div class="col-md-4">
                        <a asp-controller="Manager" 
                           asp-action="ListOfStaffAccount" 
                           class="text-decoration-none mgr-task-link"
                           role="button"
                           aria-labelledby="staff-task-title"
                           aria-describedby="staff-task-desc">
                            <article class="card border-0 shadow-sm rounded-4 h-100 mgr-card"
                                     aria-labelledby="staff-task-title">
                                <div class="card-body p-4 d-flex align-items-center gap-4">
                                    <div class="mgr-icon-wrap bg-warning bg-opacity-10 rounded-4 p-3"
                                         aria-hidden="true">
                                        <span style="font-size:2.4rem;">👥</span>
                                    </div>
                                    <div>
                                        <h3 id="staff-task-title" class="fw-bold mb-1 text-dark h5">Staff Accounts</h3>
                                        <p id="staff-task-desc" class="text-muted small mb-2">View all staff members and roles</p>
                                        <span class="badge bg-warning bg-opacity-25 text-warning px-3 py-1 rounded-pill small"
                                              aria-label="Team management category">
                                            Team
                                        </span>
                                    </div>
                                </div>
                                <div class="card-footer bg-warning text-dark text-center py-2 rounded-bottom-4 fw-semibold small">
                                    Go to Staff Accounts →
                                </div>
                            </article>
                        </a>
                    </div>

                </div>

                <!-- Second Row for Additional Management Features -->
                <div class="row g-4 mt-2">

                    <div class="col-md-4">
                        <a asp-controller="Manager" 
                           asp-action="ShippingMethods" 
                           class="text-decoration-none mgr-task-link"
                           role="button"
                           aria-labelledby="shipping-task-title"
                           aria-describedby="shipping-task-desc">
                            <article class="card border-0 shadow-sm rounded-4 h-100 mgr-card"
                                     aria-labelledby="shipping-task-title">
                                <div class="card-body p-4 d-flex align-items-center gap-4">
                                    <div class="mgr-icon-wrap bg-info bg-opacity-10 rounded-4 p-3"
                                         aria-hidden="true">
                                        <span style="font-size:2.4rem;">🚚</span>
                                    </div>
                                    <div>
                                        <h3 id="shipping-task-title" class="fw-bold mb-1 text-dark h5">Shipping Methods</h3>
                                        <p id="shipping-task-desc" class="text-muted small mb-2">Manage delivery options and pricing</p>
                                        <span class="badge bg-info bg-opacity-25 text-info px-3 py-1 rounded-pill small"
                                              aria-label="Operations category">
                                            Operations
                                        </span>
                                    </div>
                                </div>
                                <div class="card-footer bg-info text-white text-center py-2 rounded-bottom-4 fw-semibold small">
                                    Go to Shipping Methods →
                                </div>
                            </article>
                        </a>
                    </div>

                    <!-- Placeholder for future management features -->
                    <div class="col-md-4">
                        <div class="card border-2 border-dashed border-light rounded-4 h-100"
                             style="opacity: 0.6;">
                            <div class="card-body p-4 d-flex align-items-center justify-content-center text-center">
                                <div>
                                    <div class="text-muted mb-2" style="font-size:2rem;" aria-hidden="true">⚙️</div>
                                    <h3 class="text-muted h6 mb-1">More Features</h3>
                                    <p class="text-muted small mb-0">Additional management tools coming soon</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card border-2 border-dashed border-light rounded-4 h-100"
                             style="opacity: 0.6;">
                            <div class="card-body p-4 d-flex align-items-center justify-content-center text-center">
                                <div>
                                    <div class="text-muted mb-2" style="font-size:2rem;" aria-hidden="true">📊</div>
                                    <h3 class="text-muted h6 mb-1">Advanced Analytics</h3>
                                    <p class="text-muted small mb-0">Business intelligence dashboard planned</p>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </section>

        </div>
    </main>

<!-- Enhanced Accessibility Styles for Manager Dashboard -->
<style>
    /* Skip Links for Enhanced Keyboard Navigation */
    .skip-links {
        position: relative;
        z-index: 1050;
    }

    .skip-link {
        position: absolute !important;
        left: -10000px !important;
        top: auto !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
    }

    .skip-link:focus {
        position: static !important;
        width: auto !important;
        height: auto !important;
        overflow: visible !important;
        margin: 0 0.5rem 0.5rem 0 !important;
        padding: 0.5rem 1rem !important;
        z-index: 1051 !important;
    }

    /* Screen Reader Only but Focusable Elements */
    .sr-only-focusable:not(:focus):not(:focus-within) {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        padding: 0 !important;
        margin: -1px !important;
        overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important;
        white-space: nowrap !important;
        border: 0 !important;
    }

    /* Enhanced Card Hover and Focus States */
    .mgr-card, .kpi-card {
        transition: transform .18s ease, box-shadow .18s ease;
        cursor: pointer;
    }

    .mgr-card:hover, 
    .kpi-card:hover,
    .mgr-card:focus-within,
    .kpi-card:focus-within {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
    }

    /* Enhanced Focus Management for Links */
    .kpi-link:focus,
    .mgr-task-link:focus {
        outline: 2px solid #0d6efd;
        outline-offset: 2px;
        border-radius: 1rem;
    }

    /* Icon Wrapper Styling */
    .mgr-icon-wrap {
        min-width: 64px; 
        min-height: 64px;
        display: flex; 
        align-items: center; 
        justify-content: center;
    }

    /* Reduce motion for users who prefer it */
    @@media (prefers-reduced-motion: reduce) {
        .mgr-card, .kpi-card {
            transition: none;
        }
        .mgr-card:hover, 
        .kpi-card:hover,
        .mgr-card:focus-within,
        .kpi-card:focus-within {
            transform: none;
        }
    }

    /* Section scroll targets */
    #kpi-cards:target,
    #recent-activity:target {
        scroll-margin-top: 2rem;
    }
</style>
