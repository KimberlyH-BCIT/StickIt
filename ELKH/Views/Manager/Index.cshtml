@{
    ViewData["Title"] = "Manager Dashboard - Inventory & Operations Management";
    Layout = "~/Views/Shared/_Layout.cshtml";

        // Read which view the admin is currently "pretending" to be
    string viewAs = ViewBag.ViewAs as string ?? "Manager";
}

<!-- Skip Links for Keyboard Navigation -->
<nav class="skip-links sr-only-focusable mb-2" aria-label="Skip navigation">
    <a href="#main-heading" class="skip-link btn btn-primary">Skip to dashboard</a>
    <a href="#kpi-cards" class="skip-link btn btn-primary">Skip to statistics</a>
    <a href="#recent-activity" class="skip-link btn btn-primary">Skip to recent activity</a>
</nav>

<main role="main" aria-labelledby="main-heading">
    <div class="container-fluid px-4 mt-4 pb-5">

    <!-- ── Header ──────────────────────────────────────────────── -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0">Manager Dashboard</h2>
            <p class="text-muted mb-0 small">Inventory & operations · @DateTime.Now.ToString("dddd, MMMM d yyyy")</p>
        </div>
       <!-- ── Persistent View-As Tab Strip ── -->
        <div class="d-flex gap-2 flex-wrap align-items-center">
            <span class="text-muted small me-1">View as:</span>

            <a asp-controller="Manager" asp-action="Index"
               class="btn btn-sm rounded-pill px-3 view-as-btn @(viewAs == "Manager" ? "btn-primary" : "btn-outline-secondary")">
                👔 Manager
            </a>

            <a asp-controller="Staff" asp-action="Index"
               class="btn btn-sm rounded-pill px-3 view-as-btn @(viewAs == "Staff" ? "btn-info text-dark" : "btn-outline-secondary")">
                🧑‍💼 Staff
            </a>

            <a asp-controller="Home" asp-action="Index"
               class="btn btn-sm rounded-pill px-3 view-as-btn @(viewAs == "Customer" ? "btn-success" : "btn-outline-secondary")">
                🛒 Customer
            </a>
        </div>
    </div>

    <!-- ── KPI Cards (no Orders card) ──────────────────────────── -->
    <div class="row g-3 mb-4">

        <!-- All Products → no filter -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-fromDashboard="all"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">📦</span>
                        <h4 class="fw-bold mb-0 mt-1">@ViewBag.TotalProducts</h4>
                        <p class="text-muted small mb-0">All Products</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Active -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-activeFilter="active"
               asp-route-fromDashboard="active"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">✅</span>
                        <h4 class="fw-bold mb-0 mt-1 text-success">@ViewBag.ActiveProducts</h4>
                        <p class="text-muted small mb-0">Active</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Inactive -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-activeFilter="inactive"
               asp-route-fromDashboard="inactive"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">⛔</span>
                        <h4 class="fw-bold mb-0 mt-1 text-secondary">@ViewBag.InactiveProducts</h4>
                        <p class="text-muted small mb-0">Inactive</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Well Stocked -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-stockFilter="stocked"
               asp-route-fromDashboard="stocked"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">🟢</span>
                        <h4 class="fw-bold mb-0 mt-1 text-success">@ViewBag.StockUpCount</h4>
                        <p class="text-muted small mb-0">Well Stocked</p>
                        <p class="mb-0" style="font-size:.65rem;color:#9ca3af;">&gt;> 11 units</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Low Stock -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-stockFilter="low"
               asp-route-fromDashboard="low"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">🔴</span>
                        <h4 class="fw-bold mb-0 mt-1 text-danger">@ViewBag.LowStockCount</h4>
                        <p class="text-muted small mb-0">Low Stock</p>
                        <p class="mb-0" style="font-size:.65rem;color:#9ca3af;">≤ 10 units</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- delete products -->
        <div class="col-6 col-md-4 col-lg-2">
           <a asp-controller="Manager"
                   asp-action="DeletedProducts"
                   class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                       <span style="font-size:1.6rem;">🗑️</span>
                        <h4 class="fw-bold mb-0 mt-1 text-danger">@ViewBag.DeletedCount</h4>
                        <p class="text-muted small mb-0">Deleted Products</p>
                    </div>
                </div>
            </a>
        </div>

        </div>
    </section>

    <!-- ── 3 Main Task Cards ─────────────────────────────────────── -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <a asp-controller="Manager" asp-action="ListOfProducts" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="mgr-icon-wrap bg-primary bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">📦</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Manage Products</h5>
                            <p class="text-muted small mb-2">View, edit, and manage stock</p>
                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small">Inventory</span>
                        </div>
                    </div>
                    <div class="card-footer bg-primary text-white text-center py-2 rounded-bottom-4 fw-semibold small">
                        Go to Products →
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Manager" asp-action="ListAllTransactions" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="mgr-icon-wrap bg-success bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">💳</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Transactions</h5>
                            <p class="text-muted small mb-2">View and track all transactions</p>
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small">Financials</span>
                        </div>
                    </div>
                    <div class="card-footer bg-success text-white text-center py-2 rounded-bottom-4 fw-semibold small">
                        Go to Transactions →
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Manager" asp-action="ListOfStaffAccount" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="mgr-icon-wrap bg-warning bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">👥</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Staff Accounts</h5>
                            <p class="text-muted small mb-2">View all staff members and roles</p>
                            <span class="badge bg-warning bg-opacity-25 text-warning px-3 py-1 rounded-pill small">Team</span>
                        </div>
                    </div>
                    <div class="card-footer bg-warning text-dark text-center py-2 rounded-bottom-4 fw-semibold small">
                        Go to Staff Accounts →
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- ── Message Box to Staff ─────────────────────────────────── -->
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-1">
                        📢 Send Message to Staff
                    </h5>
                    <p class="text-muted small mb-3">This message will be visible to all staff members on their dashboard.</p>

                    @if (TempData["MessageSent"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show rounded-3 py-2" role="alert">
                            ✅ @TempData["MessageSent"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-controller="Manager" asp-action="SendStaffMessage" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <input type="text" name="MessageTitle" class="form-control rounded-3 mb-2"
                                   placeholder="Message title (e.g. 'Important: Store hours update')"
                                   maxlength="150" required />
                            <textarea name="MessageBody" class="form-control rounded-3" rows="3"
                                      placeholder="Write your message here…" maxlength="1000" required></textarea>
                        </div>
                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary rounded-pill px-4">
                                📤 Send Message
                            </button>
                        </div>
                    </form>

                    <!-- Recent Messages sent -->
                    @if (ViewBag.RecentMessages != null && ((IEnumerable<dynamic>)ViewBag.RecentMessages).Any())
                    {
                        <hr class="my-3" />
                        <h6 class="fw-semibold text-muted small mb-2">Recent Messages</h6>
                        <div class="d-flex flex-column gap-2">
                            @foreach (var msg in ViewBag.RecentMessages)
                            {
                               <div class="p-3 rounded-3 mb-2" style="background:#f9fafb;border:1px solid #e5e7eb;">
    
    <div class="d-flex justify-content-between align-items-center mb-1">
        <span class="fw-semibold small">@msg.Title</span>
        <span class="text-muted" style="font-size:.72rem;">
            @msg.SentAt.ToString("MMM d, yyyy h:mm tt")
        </span>
    </div>

    <p class="mb-1 small text-secondary">@msg.Body</p>

    <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted" style="font-size:.7rem;">
            Sent by: @msg.SentBy
        </span>

        @if (msg.ReplyCount > 0)
        {
            <button class="btn btn-sm btn-outline-primary rounded-pill px-2 py-0"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#replies-@msg.Id">
                Reply (@msg.ReplyCount)
            </button>
        }
    </div>

    <!-- Replies (Hidden by default) -->
    <div class="collapse mt-2" id="replies-@msg.Id">
        @{
            var replies = ((IEnumerable<dynamic>)ViewBag.MessageReplies)
                .Where(r => r.MessageId == msg.Id);
        }

        @foreach (var r in replies)
        {
            <div class="p-2 rounded-3 mb-1"
                 style="background:#eef2ff;border:1px solid #dbeafe;">
                <div class="small">@r.Body</div>
                <div class="text-muted" style="font-size:.65rem;">
                    @r.RepliedBy · @r.RepliedAt.ToString("MMM d, h:mm tt")
                </div>
            </div>
        }
    </div>

</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

        </div>
    </main>

<!-- Enhanced Accessibility Styles for Manager Dashboard -->
<style>
    /* Skip Links for Enhanced Keyboard Navigation */
    .skip-links {
        position: relative;
        z-index: 1050;
    }

    .skip-link {
        position: absolute !important;
        left: -10000px !important;
        top: auto !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
    }

    .skip-link:focus {
        position: static !important;
        width: auto !important;
        height: auto !important;
        overflow: visible !important;
        margin: 0 0.5rem 0.5rem 0 !important;
        padding: 0.5rem 1rem !important;
        z-index: 1051 !important;
    }

    /* Screen Reader Only but Focusable Elements */
    .sr-only-focusable:not(:focus):not(:focus-within) {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        padding: 0 !important;
        margin: -1px !important;
        overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important;
        white-space: nowrap !important;
        border: 0 !important;
    }

    /* Enhanced Card Hover and Focus States */
    .mgr-card, .kpi-card {
        transition: transform .18s ease, box-shadow .18s ease;
        cursor: pointer;
    }

    .mgr-card:hover, 
    .kpi-card:hover,
    .mgr-card:focus-within,
    .kpi-card:focus-within {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
    }

    /* Enhanced Focus Management for Links */
    .kpi-link:focus,
    .mgr-task-link:focus {
        outline: 2px solid #0d6efd;
        outline-offset: 2px;
        border-radius: 1rem;
    }

    /* Icon Wrapper Styling */
    .mgr-icon-wrap {
        min-width: 64px; 
        min-height: 64px;
        display: flex; 
        align-items: center; 
        justify-content: center;
    }

    /* Reduce motion for users who prefer it */
    @@media (prefers-reduced-motion: reduce) {
        .mgr-card, .kpi-card {
            transition: none;
        }
        .mgr-card:hover, 
        .kpi-card:hover,
        .mgr-card:focus-within,
        .kpi-card:focus-within {
            transform: none;
        }
    }

    /* Section scroll targets */
    #kpi-cards:target,
    #recent-activity:target {
        scroll-margin-top: 2rem;
    }
</style>
