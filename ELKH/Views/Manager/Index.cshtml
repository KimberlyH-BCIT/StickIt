@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid px-4 mt-4 pb-5">

    <!-- ── Header ─────────────────────────────────────────────── -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0">Manager Dashboard</h2>
            <p class="text-muted mb-0 small">Inventory & operations · @DateTime.Now.ToString("dddd, MMMM d yyyy")</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="Staff" asp-action="Index"
               class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                🧑‍💼 View as Staff
            </a>
            <a asp-controller="Home" asp-action="Index"
               class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                🛒 View as Customer
            </a>
        </div>
    </div>

    <!-- ── Clickable KPI Cards ────────────────────────────────── -->
    <div class="row g-3 mb-5">

        <!-- Total Products -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">📦</span>
                        <h4 class="fw-bold mb-0 mt-1">@ViewBag.TotalProducts</h4>
                        <p class="text-muted small mb-0">All Products</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Active -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-activeFilter="active"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card border-success-subtle">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">✅</span>
                        <h4 class="fw-bold mb-0 mt-1 text-success">@ViewBag.ActiveProducts</h4>
                        <p class="text-muted small mb-0">Active</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Inactive -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-activeFilter="inactive"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">⛔</span>
                        <h4 class="fw-bold mb-0 mt-1 text-secondary">@ViewBag.InactiveProducts</h4>
                        <p class="text-muted small mb-0">Inactive</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Well Stocked -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-stockFilter="stocked"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">🟢</span>
                        <h4 class="fw-bold mb-0 mt-1 text-success">@ViewBag.StockUpCount</h4>
                        <p class="text-muted small mb-0">Well Stocked</p>
                        <p class="mb-0" style="font-size:.65rem;color:#9ca3af;">&gt; 20 units</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Low Stock -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListOfProducts"
               asp-route-stockFilter="low"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">🔴</span>
                        <h4 class="fw-bold mb-0 mt-1 text-danger">@ViewBag.LowStockCount</h4>
                        <p class="text-muted small mb-0">Low Stock</p>
                        <p class="mb-0" style="font-size:.65rem;color:#9ca3af;">≤ 5 units</p>
                    </div>
                </div>
            </a>
        </div>

        <!-- Weekly Orders -->
        <div class="col-6 col-md-4 col-lg-2">
            <a asp-controller="Manager" asp-action="ListAllTransactions"
               class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 kpi-card">
                    <div class="card-body d-flex flex-column align-items-center justify-content-center p-3 text-center">
                        <span style="font-size:1.6rem;">📅</span>
                        <h4 class="fw-bold mb-0 mt-1">@ViewBag.WeeklyOrders</h4>
                        <p class="text-muted small mb-0">Weekly Orders</p>
                    </div>
                </div>
            </a>
        </div>

    </div>

    <!-- ── 3 Main Task Cards ───────────────────────────────────── -->
    <div class="row g-4">

        <div class="col-md-4">
            <a asp-controller="Manager" asp-action="ListOfProducts" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="mgr-icon-wrap bg-primary bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">📦</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Manage Products</h5>
                            <p class="text-muted small mb-2">View, edit, and manage stock</p>
                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small">
                                Inventory
                            </span>
                        </div>
                    </div>
                    <div class="card-footer bg-primary text-white text-center py-2 rounded-bottom-4 fw-semibold small">
                        Go to Products →
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Manager" asp-action="ListAllTransactions" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="mgr-icon-wrap bg-success bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">💳</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Transactions</h5>
                            <p class="text-muted small mb-2">View and track all transactions</p>
                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small">
                                Financials
                            </span>
                        </div>
                    </div>
                    <div class="card-footer bg-success text-white text-center py-2 rounded-bottom-4 fw-semibold small">
                        Go to Transactions →
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-4">
            <a asp-controller="Manager" asp-action="ListOfStaffAccount" class="text-decoration-none">
                <div class="card border-0 shadow-sm rounded-4 h-100 mgr-card">
                    <div class="card-body p-4 d-flex align-items-center gap-4">
                        <div class="mgr-icon-wrap bg-warning bg-opacity-10 rounded-4 p-3">
                            <span style="font-size:2.4rem;">👥</span>
                        </div>
                        <div>
                            <h5 class="fw-bold mb-1 text-dark">Staff Accounts</h5>
                            <p class="text-muted small mb-2">View all staff members and roles</p>
                            <span class="badge bg-warning bg-opacity-25 text-warning px-3 py-1 rounded-pill small">
                                Team
                            </span>
                        </div>
                    </div>
                    <div class="card-footer bg-warning text-dark text-center py-2 rounded-bottom-4 fw-semibold small">
                        Go to Staff Accounts →
                    </div>
                </div>
            </a>
        </div>

    </div>

</div>

<style>
    .mgr-card, .kpi-card {
        transition: transform .18s ease, box-shadow .18s ease;
        cursor: pointer;
    }
    .mgr-card:hover, .kpi-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
    }
    .mgr-icon-wrap {
        min-width: 64px; min-height: 64px;
        display: flex; align-items: center; justify-content: center;
    }
</style>
