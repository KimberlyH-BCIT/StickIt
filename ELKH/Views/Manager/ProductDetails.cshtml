@model ELKH.ViewModels.ProductVM

@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var ratings     = ViewBag.Ratings as List<ELKH.Models.ProductRatingModel> ?? new();
    int ratingCount = ViewBag.RatingCount ?? 0;

    string stockClass = Model.StockQuantity <= 5  ? "bg-danger"
                      : Model.StockQuantity <= 20 ? "bg-warning text-dark"
                      : "bg-success";
    string stockLabel = Model.StockQuantity <= 5  ? "Low Stock"
                      : Model.StockQuantity <= 20 ? "Medium"
                      : "In Stock";

    string StarFull  = "★";
    string StarEmpty = "☆";
    string RenderStars(double avg) {
        var sb = new System.Text.StringBuilder();
        for (int i = 1; i <= 5; i++)
            sb.Append(i <= Math.Round(avg) ? StarFull : StarEmpty);
        return sb.ToString();
    }
}

<div class="container py-4" style="max-width:900px;">

    <!-- Back + Delete row -->
    <div class="d-flex justify-content-between align-items-center mb-3">

            <form asp-action="DeleteProduct" method="post" class="d-inline"
                  onsubmit="return confirm('Soft-delete this product? It can be restored later.');">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.ProductId" />
                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">
                    🗑️ Delete Product
                </button>
            </form>
        
        <a asp-action="ListOfProducts" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            ← Back to Products
        </a>

    </div>

    @if (Model.IsDeleted)
    {
        <div class="alert alert-warning rounded-3 py-2 mb-3">
            ⚠️ This product has been soft-deleted and is not visible in the active product list.
        </div>
    }
    <!-- ── Main Product Card (LIGHT THEME) ───────────────────────── -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4 bg-white">
        <div class="row g-0" style="min-height:280px;">

            <!-- Left: Image -->
            <div class="col-md-5 d-flex align-items-center justify-content-center p-4"
                 style="background:#f8f9fa; border-right:1px solid #e5e7eb;">
                @if (!string.IsNullOrEmpty(Model.Thumbnail))
                {
                    <img src="@Model.Thumbnail" alt="@Model.ProductName"
                         class="rounded-3 img-fluid"
                         style="max-height:240px;object-fit:contain;" />
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center text-muted"
                         style="width:160px;height:160px;border:2px dashed #dee2e6;border-radius:12px;">
                        <span class="small">No Image</span>
                    </div>
                }
            </div>

            <!-- Right: Details -->
            <div class="col-md-7 p-4 d-flex flex-column justify-content-between">

                <div>
                    <!-- Title + Category -->
                    <div class="d-flex align-items-start justify-content-between mb-2 flex-wrap gap-2">
                        <h4 class="fw-bold mb-0 text-dark">@Model.ProductName</h4>

                        <span class="badge bg-light text-secondary border">
                            @Model.CategoryName
                        </span>
                    </div>

                    <p class="text-muted small mb-2">ID: @Model.ProductId</p>

                    <!-- Rating -->
                    @if (ratingCount > 0)
                    {
                        <div class="mb-3 d-flex align-items-center gap-2">
                            <span class="text-warning">
                                @Html.Raw(RenderStars(Model.AverageRating))
                            </span>
                            <span class="text-muted small">
                                @Model.AverageRating.ToString("0.0") / 5 · @ratingCount review@(ratingCount == 1 ? "" : "s")
                            </span>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">No reviews yet</p>
                    }

                    <!-- Description -->
                    <p class="text-muted mb-4" style="line-height:1.6;">
                        @Model.Description
                    </p>

                    <!-- Price -->
                    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                        <span class="fw-bold text-primary" style="font-size:1.5rem;">
                            $@Model.Price.ToString("N2")
                        </span>

                        @if (Model.DiscountPercent > 0)
                        {
                            <span class="badge bg-primary-subtle text-primary">
                                @Model.DiscountPercent% off
                            </span>
                        }
                    </div>
                </div>

                <!-- Bottom Section -->
                <div class="d-flex flex-wrap gap-2 align-items-center pt-3 border-top">

                    <span class="badge @stockClass px-3 py-2 rounded-pill">
                        @Model.StockQuantity units - @stockLabel
                    </span>

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">
                            ● Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary px-3 py-2 rounded-pill">
                            ○ Inactive
                        </span>
                    }

                </div>

            </div>
        </div>
    </div>

    <!-- ── Ratings Section ──────────────────────────────────────── -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0">
                    ⭐ Customer Reviews
                    @if (ratingCount > 0)
                    {
                        <span class="text-muted fw-normal small ms-1">(@ratingCount)</span>
                    }
                </h6>
                @if (ratingCount > 0)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span style="color:#fbbf24;font-size:1rem;letter-spacing:1px;">
                            @Html.Raw(RenderStars(Model.AverageRating))
                        </span>
                        <span class="fw-bold">@Model.AverageRating.ToString("0.0")</span>
                        <span class="text-muted small">/ 5</span>
                    </div>
                }
            </div>

            @if (ratings.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var r in ratings)
                    {
                        string reviewerName = r.RegisteredUser?.Email ?? "Anonymous";
                        <div class="p-3 rounded-3" style="background:#f9fafb;border:1px solid #e5e7eb;">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div>
                                    <span class="fw-semibold small">@reviewerName</span>
                                    <span style="color:#fbbf24;margin-left:8px;font-size:.9rem;">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @(i <= r.Rating ? StarFull : StarEmpty)
                                        }
                                    </span>
                                </div>
                                <span class="text-muted" style="font-size:.75rem;">
                                    @r.RatedTime.ToString("MMM d, yyyy")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Description))
                            {
                                <p class="mb-0 small text-secondary mt-1">@r.Description</p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <span style="font-size:2rem;">💬</span>
                    <p class="mt-2 mb-0 small">No approved reviews yet for this product.</p>
                </div>
            }
        </div>
    </div>

</div>
