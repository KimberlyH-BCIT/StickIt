@model ELKH.ViewModels.ProductVM

@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var ratings    = ViewBag.Ratings as List<ELKH.Models.ProductRatingModel> ?? new();
    int ratingCount = ViewBag.RatingCount ?? 0;

    string stockClass = Model.StockQuantity <= 5  ? "bg-danger"
                      : Model.StockQuantity <= 20 ? "bg-warning text-dark"
                      : "bg-success";
    string stockLabel = Model.StockQuantity <= 5  ? "Low Stock"
                      : Model.StockQuantity <= 20 ? "Medium"
                      : "In Stock";

    // Star helpers
    string StarFull  = "★";
    string StarEmpty = "☆";
    string RenderStars(double avg) {
        var sb = new System.Text.StringBuilder();
        for (int i = 1; i <= 5; i++)
            sb.Append(i <= Math.Round(avg) ? StarFull : StarEmpty);
        return sb.ToString();
    }
}

<div class="container py-4" style="max-width:900px;">

    <!-- Back -->
    <div class="mb-3">
        <a asp-action="ListOfProducts" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            ← Back to Products
        </a>
    </div>

    <!-- ── Main Product Card ───────────────────────────────────── -->
    <div class="card border-0 shadow rounded-4 overflow-hidden mb-4" style="background:#1a1d2e;">
        <div class="row g-0" style="min-height:300px;">

            <!-- Left: Image -->
            <div class="col-md-5 d-flex align-items-center justify-content-center p-4"
                 style="background:#14172a; border-right:1px solid rgba(255,255,255,.08);">
                @if (!string.IsNullOrEmpty(Model.Thumbnail))
                {
                    <img src="@Model.Thumbnail" alt="@Model.ProductName"
                         class="rounded-3 img-fluid"
                         style="max-height:260px;object-fit:contain;" />
                }
                else
                {
                    <div class="d-flex flex-column align-items-center justify-content-center text-secondary"
                         style="width:180px;height:180px;border:2px dashed rgba(255,255,255,.2);border-radius:12px;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" fill="currentColor"
                             viewBox="0 0 16 16" class="mb-2 opacity-40">
                            <path d="M6.002 5.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/>
                            <path d="M2.002 1a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0
                                     0-2-2h-12zm12 1a1 1 0 0 1 1 1v6.5l-3.777-1.947a.5.5 0 0 0-.577.093l-3.71
                                     3.71-2.66-1.772a.5.5 0 0 0-.63.062L1.002 12V3a1 1 0 0 1 1-1h12z"/>
                        </svg>
                        <span class="small opacity-50">No Image</span>
                    </div>
                }
            </div>

            <!-- Right: Details -->
            <div class="col-md-7 p-4 d-flex flex-column justify-content-between" style="color:#e8eaf6;">
                <div>
                    <div class="d-flex align-items-start justify-content-between mb-1 flex-wrap gap-2">
                        <h3 class="fw-bold mb-0" style="color:#fff;">@Model.ProductName</h3>
                        <span class="badge rounded-pill px-3 py-1"
                              style="background:rgba(255,255,255,.1);color:#a0aec0;font-size:.75rem;">
                            @Model.CategoryName
                        </span>
                    </div>

                    <p class="mb-1" style="color:#6b7280;font-size:.8rem;">ID: @Model.ProductId</p>

                    <!-- Star rating summary -->
                    @if (ratingCount > 0)
                    {
                        <div class="mb-3 d-flex align-items-center gap-2">
                            <span style="color:#fbbf24;font-size:1.1rem;letter-spacing:2px;">
                                @Html.Raw(RenderStars(Model.AverageRating))
                            </span>
                            <span style="color:#9ca3af;font-size:.85rem;">
                                @Model.AverageRating.ToString("0.0") / 5 &nbsp;·&nbsp; @ratingCount review@(ratingCount == 1 ? "" : "s")
                            </span>
                        </div>
                    }
                    else
                    {
                        <p class="mb-3" style="color:#6b7280;font-size:.8rem;">No reviews yet</p>
                    }

                    <p class="mb-4" style="color:#b0b8d1;font-size:.9rem;line-height:1.6;">@Model.Description</p>

                    <div class="d-flex align-items-center gap-3 mb-3 flex-wrap">
                        <span class="fw-bold" style="font-size:1.6rem;color:#60a5fa;">
                            $@Model.Price.ToString("N2")
                        </span>
                        @if (Model.DiscountPercent > 0)
                        {
                            <span class="badge rounded-pill px-3 py-1"
                                  style="background:rgba(96,165,250,.15);color:#60a5fa;">
                                @Model.DiscountPercent% off
                            </span>
                        }
                    </div>
                </div>

                <!-- Bottom badges + edit button -->
                <div class="d-flex flex-wrap gap-2 align-items-center pt-3"
                     style="border-top:1px solid rgba(255,255,255,.08);">
                    <span class="badge @stockClass px-3 py-2 rounded-pill">
                        @Model.StockQuantity units — @stockLabel
                    </span>
                    @if (Model.IsActive)
                    {
                        <span class="badge px-3 py-2 rounded-pill"
                              style="background:rgba(52,211,153,.15);color:#34d399;">● Active</span>
                    }
                    else
                    {
                        <span class="badge px-3 py-2 rounded-pill"
                              style="background:rgba(156,163,175,.15);color:#9ca3af;">○ Inactive</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ── Ratings Section ────────────────────────────────────── -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h6 class="fw-bold mb-0">
                    ⭐ Customer Reviews
                    @if (ratingCount > 0)
                    {
                        <span class="text-muted fw-normal small ms-1">(@ratingCount)</span>
                    }
                </h6>
                @if (ratingCount > 0)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span style="color:#fbbf24;font-size:1rem;letter-spacing:1px;">
                            @Html.Raw(RenderStars(Model.AverageRating))
                        </span>
                        <span class="fw-bold">@Model.AverageRating.ToString("0.0")</span>
                        <span class="text-muted small">/ 5</span>
                    </div>
                }
            </div>

            @if (ratings.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var r in ratings)
                    {
                        string reviewerName = r.RegisteredUser?.Email ?? "Anonymous";
                        <div class="p-3 rounded-3" style="background:#f9fafb;border:1px solid #e5e7eb;">
                            <div class="d-flex justify-content-between align-items-start mb-1">
                                <div>
                                    <span class="fw-semibold small">@reviewerName</span>
                                    <span style="color:#fbbf24;margin-left:8px;font-size:.9rem;">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            @(i <= r.Rating ? StarFull : StarEmpty)
                                        }
                                    </span>
                                </div>
                                <span class="text-muted" style="font-size:.75rem;">
                                    @r.RatedTime.ToString("MMM d, yyyy")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(r.Description))
                            {
                                <p class="mb-0 small text-secondary mt-1">@r.Description</p>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center text-muted py-4">
                    <span style="font-size:2rem;">💬</span>
                    <p class="mt-2 mb-0 small">No approved reviews yet for this product.</p>
                </div>
            }
        </div>
    </div>

</div>
