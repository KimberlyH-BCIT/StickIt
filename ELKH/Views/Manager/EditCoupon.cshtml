@model ELKH.Models.CouponModel

@{
    ViewData["Title"] = "Edit Coupon";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main role="main" aria-labelledby="main-heading">
    <div class="container mt-4 pb-5" style="max-width: 640px">

        <header class="mb-4">
            <h1 id="main-heading" class="fw-bold text-primary mb-0">Edit Coupon</h1>
            <p class="text-muted small">Modify an existing discount code</p>
        </header>

        <div class="kawaii-card">
            <form asp-action="EditCoupon" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="PkCouponId" />
                <input type="hidden" asp-for="CurrentUsageCount" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="row g-3">
                    <div class="col-sm-6">
                        <label asp-for="Code" class="form-label fw-semibold"></label>
                        <input asp-for="Code" class="form-control input-kawaii text-uppercase" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control input-kawaii" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control textarea-kawaii" rows="2"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="DiscountType" class="form-label fw-semibold"></label>
                        <select asp-for="DiscountType" class="form-select select-kawaii" id="discountTypeSelect">
                            <option value="Percentage">Percentage (%)</option>
                            <option value="FixedAmount">Fixed Amount ($)</option>
                            <option value="FreeShipping">Free Shipping</option>
                        </select>
                        <span asp-validation-for="DiscountType" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6" id="discountValueGroup">
                        <label asp-for="DiscountValue" class="form-label fw-semibold"></label>
                        <input asp-for="DiscountValue" type="number" step="0.01" min="0" class="form-control input-kawaii" />
                        <span asp-validation-for="DiscountValue" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6" id="maxDiscountGroup">
                        <label asp-for="MaxDiscountAmount" class="form-label fw-semibold"></label>
                        <input asp-for="MaxDiscountAmount" type="number" step="0.01" min="0" class="form-control input-kawaii" />
                        <span asp-validation-for="MaxDiscountAmount" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="MinimumOrderValue" class="form-label fw-semibold"></label>
                        <input asp-for="MinimumOrderValue" type="number" step="0.01" min="0" class="form-control input-kawaii" />
                        <span asp-validation-for="MinimumOrderValue" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="UsageLimit" class="form-label fw-semibold"></label>
                        <input asp-for="UsageLimit" type="number" min="1" class="form-control input-kawaii" placeholder="Blank = unlimited" />
                        <span asp-validation-for="UsageLimit" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ValidFrom" class="form-label fw-semibold"></label>
                        <input asp-for="ValidFrom" type="date" class="form-control input-kawaii" />
                        <span asp-validation-for="ValidFrom" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="ValidUntil" class="form-label fw-semibold"></label>
                        <input asp-for="ValidUntil" type="date" class="form-control input-kawaii" />
                        <span asp-validation-for="ValidUntil" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label asp-for="IsActive" class="form-check-label fw-semibold">Active</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <small class="text-muted">
                            Used <strong>@Model.CurrentUsageCount</strong> time(s) &bull;
                            Created @Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                        </small>
                    </div>
                </div>

                <hr class="my-3" />
                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Coupons" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-floppy me-1" aria-hidden="true"></i>Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        const typeSelect = document.getElementById('discountTypeSelect');
        const valueGroup = document.getElementById('discountValueGroup');
        const maxGroup = document.getElementById('maxDiscountGroup');
        function updateFields() {
            const isFree = typeSelect.value === 'FreeShipping';
            const isPct = typeSelect.value === 'Percentage';
            valueGroup.style.display = isFree ? 'none' : '';
            maxGroup.style.display = isPct ? '' : 'none';
        }
        typeSelect.addEventListener('change', updateFields);
        updateFields();
    </script>
}
