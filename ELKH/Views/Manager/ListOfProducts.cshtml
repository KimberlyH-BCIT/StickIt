@model List<ELKH.ViewModels.ProductVM>

@{
    ViewData["Title"] = "Products";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-4 px-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary mb-0">Products</h2>
        <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">← Dashboard</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Search + Add -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body d-flex justify-content-between align-items-center gap-3 flex-wrap p-4">

            <form method="get" class="d-flex gap-2 flex-grow-1">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control rounded-pill"
                       placeholder="Search by name or category..." />
                <button type="submit" class="btn btn-primary rounded-pill px-4">Search</button>
                @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                {
                    <a asp-action="ListOfProducts" class="btn btn-outline-secondary rounded-pill px-4">Clear</a>
                }
            </form>

            <a asp-action="AddNewProduct" class="btn btn-success rounded-pill px-4">
                + Add Product
            </a>
        </div>
    </div>

    <!-- Table -->
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Product Name</th>
                            <th>Category</th>
                            <th class="text-end">Price</th>
                            <th class="text-center">Stock</th>
                            <th class="text-center">Active</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var p in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted small">@p.ProductId</td>
                                    <td class="fw-semibold">@p.ProductName</td>
                                    <td><span class="badge bg-secondary bg-opacity-10 text-secondary">@p.CategoryName</span></td>
                                    <td class="text-end">$@p.Price.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (p.StockQuantity <= 5)
                                        {
                                            <span class="badge bg-danger">@p.StockQuantity</span>
                                        }
                                        else if (p.StockQuantity <= 20)
                                        {
                                            <span class="badge bg-warning text-dark">@p.StockQuantity</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@p.StockQuantity</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (p.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-action="ProductDetails"
                                               asp-route-id="@p.ProductId"
                                               class="btn btn-sm btn-outline-info rounded-pill px-3">
                                                Details
                                            </a>
                                            <a asp-action="UpdateProductDetails"
                                               asp-route-id="@p.ProductId"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                Edit
                                            </a>
                                            <a asp-action="DeleteProduct"
                                               asp-route-id="@p.ProductId"
                                               class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-5">No products found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Pagination -->
    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">
                        <a class="page-link rounded-pill mx-1"
                           asp-action="ListOfProducts"
                           asp-route-page="@i"
                           asp-route-search="@ViewBag.Search">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }

</div>
