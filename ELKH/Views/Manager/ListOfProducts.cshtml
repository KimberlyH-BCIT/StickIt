@model List<ELKH.ViewModels.ProductVM>

@{
    ViewData["Title"] = "Manager - Product Catalog";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string stockFilter = ViewBag.StockFilter as string ?? "";
    string activeFilter = ViewBag.ActiveFilter as string ?? "";
    string search = ViewBag.Search as string ?? "";
}

<div class="container mt-4 pb-5" style="max-width:1100px;">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0">Product Inventory</h2>
            <p class="text-muted small mb-0">Monitor stock levels and toggle product visibility</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 shadow-sm">
            <i class="bi bi-arrow-left"></i> Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 shadow-sm text-center rounded-3">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <form method="get" class="d-flex">
                        <input type="hidden" name="stockFilter" value="@stockFilter" />
                        <input type="hidden" name="activeFilter" value="@activeFilter" />
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 rounded-start-pill">
                                <i class="bi bi-search text-muted"></i>
                            </span>
                            <input type="text" name="search" value="@search"
                                   class="form-control border-start-0 rounded-end-pill"
                                   placeholder="Search products..." />
                            <button type="submit" class="btn btn-primary rounded-pill ms-2 px-4 shadow-sm">Search</button>
                        </div>
                    </form>
                </div>

                <div class="col-md-7">
                    <div class="d-flex flex-wrap justify-content-md-end gap-3 align-items-center">
                        <div class="btn-group shadow-sm rounded-pill p-1 bg-light">
                            <span class="px-2 small fw-bold text-muted align-self-center">Stock:</span>
                            <a asp-action="ListOfProducts" asp-route-activeFilter="@activeFilter" asp-route-search="@search"
                               class="btn btn-sm rounded-pill @(stockFilter == "" ? "btn-dark" : "text-muted")">All</a>
                            <a asp-action="ListOfProducts" asp-route-stockFilter="stocked" asp-route-activeFilter="@activeFilter" asp-route-search="@search"
                               class="btn btn-sm rounded-pill @(stockFilter == "stocked" ? "btn-success" : "text-outline-success")">Full</a>
                            <a asp-action="ListOfProducts" asp-route-stockFilter="low" asp-route-activeFilter="@activeFilter" asp-route-search="@search"
                               class="btn btn-sm rounded-pill @(stockFilter == "low" ? "btn-danger" : "text-outline-danger")">Low (≤20)</a>
                        </div>

                        <div class="btn-group shadow-sm rounded-pill p-1 bg-light">
                            <span class="px-2 small fw-bold text-muted align-self-center">Status:</span>
                            <a asp-action="ListOfProducts" asp-route-stockFilter="@stockFilter" asp-route-search="@search"
                               class="btn btn-sm rounded-pill @(activeFilter == "" ? "btn-dark" : "text-muted")">All</a>
                            <a asp-action="ListOfProducts" asp-route-activeFilter="active" asp-route-stockFilter="@stockFilter" asp-route-search="@search"
                               class="btn btn-sm rounded-pill @(activeFilter == "active" ? "btn-primary" : "text-muted")">Active</a>
                            <a asp-action="ListOfProducts" asp-route-activeFilter="inactive" asp-route-stockFilter="@stockFilter" asp-route-search="@search"
                               class="btn btn-sm rounded-pill @(activeFilter == "inactive" ? "btn-secondary" : "text-muted")">Inactive</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-uppercase small fw-bold text-muted">ID</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Product</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted">Category</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-end">Price</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-center">Stock</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-center">Status (Click to Toggle)</th>
                        <th class="py-3 text-uppercase small fw-bold text-muted text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var p in Model)
                        {
                            // Business Rule: Low stock is <= 20
                            int stock = p.StockQuantity ?? 0;
                            string stockClass = stock <= 20 ? "bg-danger" : "bg-success";
                            string rowClass = stock <= 20 ? "table-danger-light" : "";

                            <tr class="@rowClass">
                                <td class="ps-4 text-muted small">#@p.ProductId</td>
                                <td><div class="fw-bold text-dark">@p.ProductName</div></td>
                                <td><span class="badge bg-light text-dark border fw-normal">@p.CategoryName</span></td>
                                <td class="text-end fw-bold text-primary">$@p.Price.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge @stockClass px-3 py-2 rounded-pill shadow-sm">@stock</span>
                                </td>
                                <td class="text-center">
                                    <form asp-action="ToggleActive" method="post">
                                        <input type="hidden" name="id" value="@p.ProductId" />
                                        <input type="hidden" name="stockFilter" value="@stockFilter" />
                                        <input type="hidden" name="activeFilter" value="@activeFilter" />
                                        <input type="hidden" name="search" value="@search" />
                                        
                                        <button type="submit" class="btn p-0 border-0 bg-transparent shadow-none" title="Toggle Visibility">
                                            @if (p.IsActive)
                                            {
                                                <span class="badge rounded-pill bg-success-subtle text-success border border-success px-3 py-2 cursor-pointer status-badge">
                                                    <i class="bi bi-circle-fill small me-1"></i> Active
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary-subtle text-secondary border border-secondary px-3 py-2 cursor-pointer status-badge">
                                                    <i class="bi bi-circle small me-1"></i> Inactive
                                                </span>
                                            }
                                        </button>
                                    </form>
                                </td>
                                <td class="text-center">
                                    <a asp-action="ProductDetails" asp-route-id="@p.ProductId" 
                                       class="btn btn-sm btn-outline-primary rounded-pill px-4">View Details</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted">
                                    <i class="bi bi-search display-4 d-block mb-3"></i>
                                    <p>No products found matching your filters.</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table-danger-light { background-color: rgba(220, 53, 69, 0.05) !important; }
    .bg-success-subtle { background-color: #e6f4ea; transition: 0.2s; }
    .bg-secondary-subtle { background-color: #f1f3f4; transition: 0.2s; }
    
    .status-badge:hover {
        transform: scale(1.05);
        filter: brightness(0.95);
    }

    .cursor-pointer { cursor: pointer; }
</style>