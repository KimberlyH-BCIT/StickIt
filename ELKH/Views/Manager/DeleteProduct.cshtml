@model ELKH.ViewModels.ProductVM

@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-sm border-0 rounded-4" style="width:600px;">
        <div class="card-body p-5 text-center">

            <div class="mb-3">
                <span class="display-4">🗑️</span>
            </div>

            <h2 class="fw-bold text-danger mb-2">Delete Product</h2>
            <p class="text-muted mb-4">Are you sure you want to permanently delete this product?</p>

            <div class="card bg-light border-0 rounded-3 p-4 text-start mb-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.ProductName</dd>

                    <dt class="col-sm-4 text-muted">Category</dt>
                    <dd class="col-sm-8">@Model.CategoryName</dd>

                    <dt class="col-sm-4 text-muted">Price</dt>
                    <dd class="col-sm-8">$@Model.Price.ToString("N2")</dd>

                    <dt class="col-sm-4 text-muted">Stock</dt>
                    <dd class="col-sm-8">@Model.StockQuantity units</dd>
                </dl>
            </div>

            <div class="d-flex justify-content-center gap-3">
                <a asp-action="ListOfProducts" class="btn btn-outline-secondary px-5">Cancel</a>

                <form asp-action="DeleteProduct"
                      asp-route-id="@Model.ProductId"
                      method="post"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-5">Yes, Delete</button>
                </form>
            </div>

        </div>
    </div>
</div>
