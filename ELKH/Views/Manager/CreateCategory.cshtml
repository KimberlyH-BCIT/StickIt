@model ELKH.Models.CategoryModel

@{
    ViewData["Title"] = "Create Category";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main role="main" aria-labelledby="main-heading">
    <div class="container mt-4 pb-5" style="max-width: 500px">

        <header class="mb-4">
            <h1 id="main-heading" class="fw-bold text-primary mb-0">Create Category</h1>
            <p class="text-muted small">Add a new product category</p>
        </header>

        <div class="kawaii-card">
            <form asp-action="CreateCategory" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="CategoryName" class="form-label fw-semibold"></label>
                    <input asp-for="CategoryName" class="form-control input-kawaii" placeholder="e.g. Sticker Sheets" autofocus />
                    <span asp-validation-for="CategoryName" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-action="Categories" class="btn btn-outline-secondary rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-success rounded-pill px-4">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>Create
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
