@model List<ELKH.Models.ShippingMethodModel>

@{
    ViewData["Title"] = "Shipping Methods Management - Delivery Options";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Skip Links for Keyboard Navigation -->
<nav class="skip-links sr-only-focusable mb-2" aria-label="Skip navigation">
    <a href="#main-heading" class="skip-link btn btn-primary">Skip to shipping methods</a>
    <a href="#shipping-actions" class="skip-link btn btn-primary">Skip to actions</a>
    <a href="#shipping-list" class="skip-link btn btn-primary">Skip to shipping list</a>
</nav>

<main role="main" aria-labelledby="main-heading">
    <div class="container-fluid mt-4 px-4 pb-5">

        <!-- Enhanced Header with Accessibility -->
        <header class="shipping-header mb-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h1 id="main-heading" class="fw-bold text-primary mb-0">Shipping Methods Management</h1>
                    <p class="text-muted mb-0 small" aria-label="Manage delivery options and pricing">Delivery Options & Pricing</p>
                </div>
                <nav aria-label="Return to dashboard">
                    <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">← Dashboard</a>
                </nav>
            </div>
        </header>

        <!-- Action Controls -->
        <section aria-labelledby="actions-heading" id="shipping-actions" class="mb-4">
            <h2 id="actions-heading" class="sr-only">Shipping method management actions</h2>
            
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 p-3 bg-light rounded">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-semibold text-secondary">Quick Actions:</span>
                    <span class="badge bg-info text-white" role="status" aria-label="Total shipping methods: @Model.Count">
                        @Model.Count Method@(Model.Count != 1 ? "s" : "")
                    </span>
                </div>
                
                <div class="d-flex gap-2">
                    <a asp-action="CreateShippingMethod" 
                       class="btn btn-success rounded-pill px-4"
                       aria-label="Create new shipping method">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
                        Add New Method
                    </a>
                </div>
            </div>
        </section>

        <!-- Success/Error Messages -->
        @if (TempData["Message"] is string message)
        {
            string[] messageParts = message.Split(',');
            string messageType = messageParts[0];
            string messageText = messageParts.Length > 1 ? messageParts[1] : messageParts[0];
            
            string alertClass = messageType switch
            {
                "success" => "alert-success",
                "error" => "alert-danger", 
                "warning" => "alert-warning",
                _ => "alert-info"
            };

            <div class="alert @alertClass alert-dismissible fade show" role="alert" aria-live="polite">
                <strong>@(messageType == "success" ? "Success!" : messageType == "error" ? "Error!" : "Notice:")</strong>
                @messageText
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Shipping Methods List -->
        <section aria-labelledby="list-heading" id="shipping-list">
            <h2 id="list-heading" class="sr-only">Current shipping methods</h2>

            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-truck text-muted" style="font-size: 3rem;" aria-hidden="true"></i>
                    </div>
                    <h3 class="text-muted">No Shipping Methods</h3>
                    <p class="text-muted">Create your first shipping method to offer delivery options to customers.</p>
                    <a asp-action="CreateShippingMethod" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1" aria-hidden="true"></i>
                        Create First Method
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle" role="table" aria-label="Shipping methods with management options">
                        <thead class="table-dark">
                            <tr>
                                <th scope="col" class="fw-semibold">Method Name</th>
                                <th scope="col" class="fw-semibold">Description</th>
                                <th scope="col" class="fw-semibold text-center">Price</th>
                                <th scope="col" class="fw-semibold text-center">Delivery Time</th>
                                <th scope="col" class="fw-semibold text-center">Status</th>
                                <th scope="col" class="fw-semibold text-center">Display Order</th>
                                <th scope="col" class="fw-semibold text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var method in Model)
                            {
                                <tr class="@(method.IsActive ? "" : "table-secondary")" data-shipping-id="@method.PkShippingMethodId">
                                    <td class="fw-semibold">
                                        @method.Name
                                        @if (!method.IsActive)
                                        {
                                            <small class="text-muted d-block">(Hidden from customers)</small>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(method.Description))
                                        {
                                            <span class="text-muted">@method.Description</span>
                                        }
                                        else
                                        {
                                            <em class="text-muted">No description</em>
                                        }
                                    </td>
                                    <td class="text-center fw-semibold">
                                        @method.BasePrice.ToString("C")
                                    </td>
                                    <td class="text-center">
                                        @if (method.DeliveryDaysMin == method.DeliveryDaysMax)
                                        {
                                            <span>@method.DeliveryDaysMin day@(method.DeliveryDaysMin != 1 ? "s" : "")</span>
                                        }
                                        else
                                        {
                                            <span>@method.DeliveryDaysMin-@method.DeliveryDaysMax days</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(method.IsActive ? "bg-success" : "bg-secondary")" 
                                              role="status" 
                                              aria-label="Status: @(method.IsActive ? "Active" : "Inactive")">
                                            @(method.IsActive ? "Active" : "Inactive")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="text-muted">@method.DisplayOrder</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Actions for @method.Name">
                                            <!-- Edit Button -->
                                            <a asp-action="EditShippingMethod" 
                                               asp-route-id="@method.PkShippingMethodId"
                                               class="btn btn-outline-primary btn-sm"
                                               aria-label="Edit @method.Name"
                                               title="Edit shipping method">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                            </a>

                                            <!-- Status Toggle Button -->
                                            <button type="button" 
                                                    class="btn @(method.IsActive ? "btn-outline-warning" : "btn-outline-success") btn-sm toggle-status-btn"
                                                    data-shipping-id="@method.PkShippingMethodId"
                                                    data-current-status="@method.IsActive.ToString().ToLower()"
                                                    aria-label="@(method.IsActive ? "Deactivate" : "Activate") @method.Name"
                                                    title="@(method.IsActive ? "Deactivate" : "Activate") shipping method">
                                                <i class="bi @(method.IsActive ? "bi-toggle-on" : "bi-toggle-off")" aria-hidden="true"></i>
                                            </button>

                                            <!-- Delete Button -->
                                            <button type="button" 
                                                    class="btn btn-outline-danger btn-sm delete-shipping-btn"
                                                    data-shipping-id="@method.PkShippingMethodId"
                                                    data-shipping-name="@method.Name"
                                                    aria-label="Delete @method.Name"
                                                    title="Delete shipping method">
                                                <i class="bi bi-trash" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Summary Information -->
                <div class="mt-4 p-3 bg-light rounded">
                    <div class="row text-center">
                        <div class="col-6 col-md-3">
                            <div class="fw-semibold text-success">@Model.Count(m => m.IsActive)</div>
                            <small class="text-muted">Active Methods</small>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fw-semibold text-secondary">@Model.Count(m => !m.IsActive)</div>
                            <small class="text-muted">Inactive Methods</small>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fw-semibold text-primary">@Model.Where(m => m.IsActive).Min(m => (decimal?)m.BasePrice)?.ToString("C") ?? "N/A"</div>
                            <small class="text-muted">Cheapest Option</small>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="fw-semibold text-info">@Model.Where(m => m.IsActive).Min(m => (int?)m.DeliveryDaysMin)?.ToString() ?? "N/A" day@((Model.Where(m => m.IsActive).Min(m => (int?)m.DeliveryDaysMin) ?? 0) != 1 ? "s" : "")</div>
                            <small class="text-muted">Fastest Delivery</small>
                        </div>
                    </div>
                </div>
            }
        </section>

        <!-- Hidden Forms for Actions -->
        <form id="delete-form" asp-action="DeleteShippingMethod" method="post" style="display: none;">
            <input type="hidden" id="delete-id" name="id" value="" />
            @Html.AntiForgeryToken()
        </form>

    </div>
</main>

<!-- JavaScript for Interactive Features -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    
    // Status Toggle Functionality
    document.querySelectorAll('.toggle-status-btn').forEach(button => {
        button.addEventListener('click', function() {
            const shippingId = this.dataset.shippingId;
            const currentStatus = this.dataset.currentStatus === 'true';
            const buttonElement = this;
            const row = this.closest('tr');
            
            // Disable button during request
            buttonElement.disabled = true;
            buttonElement.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>';
            
            fetch(`@Url.Action("ToggleShippingMethodStatus", "Manager")`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                    'X-Requested-With': 'XMLHttpRequest',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: `id=${shippingId}`
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Update button appearance
                    const newStatus = data.isActive;
                    buttonElement.className = `btn ${newStatus ? 'btn-outline-warning' : 'btn-outline-success'} btn-sm toggle-status-btn`;
                    buttonElement.innerHTML = `<i class="bi ${newStatus ? 'bi-toggle-on' : 'bi-toggle-off'}" aria-hidden="true"></i>`;
                    buttonElement.setAttribute('aria-label', `${newStatus ? 'Deactivate' : 'Activate'} shipping method`);
                    buttonElement.setAttribute('title', `${newStatus ? 'Deactivate' : 'Activate'} shipping method`);
                    buttonElement.dataset.currentStatus = newStatus.toString();
                    
                    // Update status badge
                    const statusBadge = row.querySelector('.badge');
                    statusBadge.className = `badge ${newStatus ? 'bg-success' : 'bg-secondary'}`;
                    statusBadge.textContent = newStatus ? 'Active' : 'Inactive';
                    statusBadge.setAttribute('aria-label', `Status: ${newStatus ? 'Active' : 'Inactive'}`);
                    
                    // Update row appearance
                    row.className = newStatus ? '' : 'table-secondary';
                    
                    // Show success message
                    showAlert('success', data.message);
                } else {
                    showAlert('error', data.message || 'Failed to update shipping method status');
                    // Restore original button state
                    buttonElement.innerHTML = `<i class="bi ${currentStatus ? 'bi-toggle-on' : 'bi-toggle-off'}" aria-hidden="true"></i>`;
                }
            })
            .catch(error => {
                console.error('Error:', error);
                showAlert('error', 'An error occurred while updating the shipping method');
                // Restore original button state
                buttonElement.innerHTML = `<i class="bi ${currentStatus ? 'bi-toggle-on' : 'bi-toggle-off'}" aria-hidden="true"></i>`;
            })
            .finally(() => {
                buttonElement.disabled = false;
            });
        });
    });
    
    // Delete Confirmation
    document.querySelectorAll('.delete-shipping-btn').forEach(button => {
        button.addEventListener('click', function() {
            const shippingId = this.dataset.shippingId;
            const shippingName = this.dataset.shippingName;
            
            if (confirm(`Are you sure you want to delete the shipping method "${shippingName}"?\n\nThis action cannot be undone. If this method is used in existing orders, deletion will be prevented.`)) {
                document.getElementById('delete-id').value = shippingId;
                document.getElementById('delete-form').submit();
            }
        });
    });
    
    // Alert Display Function
    function showAlert(type, message) {
        const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
        const alertHtml = `
            <div class="alert ${alertClass} alert-dismissible fade show mt-3" role="alert" aria-live="polite">
                <strong>${type === 'success' ? 'Success!' : 'Error!'}</strong> ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>`;
        
        // Insert alert at the top of the main content
        const header = document.querySelector('.shipping-header');
        header.insertAdjacentHTML('afterend', alertHtml);
        
        // Auto-dismiss success alerts after 5 seconds
        if (type === 'success') {
            setTimeout(() => {
                const alert = document.querySelector('.alert-success');
                if (alert) {
                    alert.querySelector('.btn-close').click();
                }
            }, 5000);
        }
    }
});
</script>
