@{
    ViewData["Title"] = "Error";
    var statusCode = (int?)ViewBag.StatusCode;
    var requestId  = (string?)ViewBag.RequestId;

    string heading = statusCode switch
    {
        404 => "Page not found",
        403 => "Access denied",
        429 => "Too many requests",
        _   => "Something went wrong"
    };
    string message = statusCode switch
    {
        404 => "The page you are looking for doesn't exist or has been moved.",
        403 => "You don't have permission to access this resource.",
        429 => "You have made too many requests. Please wait a moment and try again.",
        _   => "An unexpected error occurred. Our team has been notified."
    };
}
<div class="container d-flex align-items-center justify-content-center" style="min-height:60vh">
    <div class="text-center" style="max-width:520px">
        @if (statusCode.HasValue)
        {
            <div class="display-1 font-heading text-danger lh-1">@statusCode</div>
        }
        else
        {
            <div class="display-1 font-heading text-danger lh-1">⚠</div>
        }
        <h1 class="h3 mt-3 mb-2 font-heading">@heading</h1>
        <p class="hierarchy-secondary mb-4">@message</p>
        <a href="/" class="btn-kawaii btn-primary-kawaii">Back to home</a>
        @if (!string.IsNullOrEmpty(requestId))
        {
            <p class="hierarchy-tertiary mt-4" style="font-size:.75rem">
                Request ID: <code>@requestId</code>
            </p>
        }
    </div>
</div>

