@model ELKH.ViewModels.PaginationVM

@*
╔==================================================================================╗
║ Pagination Controls Partial View Component                                       ║
║ Provides reusable pagination with page state preservation                       ║
║ Supports multiple contexts: Product search, Category, and Promotions            ║
╚==================================================================================╝
*@

@{
    // Determine the action based on context
    var action = "Index"; // Default for Product.Index
    var controller = "Product"; // Default controller

    if (Model.CategoryId.HasValue)
    {
        // If we have a category ID, we're browsing a specific category
        action = "ByCategory";
        controller = "Category";
    }
    else if (ViewContext.RouteData.Values["controller"]?.ToString() == "Promotions")
    {
        // If we're on the Promotions controller, stay on Promotions
        action = "Index";
        controller = "Promotions";
    }
}

@if (Model.TotalPages > 1)
{
    <nav class="mt-4" aria-label="Product pages">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="@controller"
                   asp-action="@action"
                   asp-route-search="@Model.Search"
                   asp-route-id="@Model.CategoryId"
                   asp-route-page="@(Model.CurrentPage - 1)">‹</a>
            </li>
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-controller="@controller"
                       asp-action="@action"
                       asp-route-search="@Model.Search"
                       asp-route-id="@Model.CategoryId"
                       asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link"
                   asp-controller="@controller"
                   asp-action="@action"
                   asp-route-search="@Model.Search"
                   asp-route-id="@Model.CategoryId"
                   asp-route-page="@(Model.CurrentPage + 1)">›</a>
            </li>
        </ul>
    </nav>
}
