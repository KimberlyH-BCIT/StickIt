@model ELKH.ViewModels.ProductVM

@*
╔══════════════════════════════════════════════════════════════════════════════════╗
║ Product Card Partial View Component                                              ║
║ Provides reusable product display card with badges, pricing, stock, & actions   ║
╚══════════════════════════════════════════════════════════════════════════════════╝
*@

<article class="card h-100 shadow-sm product-card" 
         role="article"
         aria-labelledby="product-title-@Model.ProductId"
         data-href="@Url.Action("Details", "Product", new { id = Model.ProductId })">
    <div class="card-body d-flex flex-column p-3">

        @* Badges for trending, bestseller, new arrival *@
        @if (Model.IsBestSeller || Model.IsTrending || Model.IsNewArrival)
        {
            <div class="mb-2 d-flex gap-1 flex-wrap" role="group" aria-label="Product badges">
                @if (Model.IsBestSeller)
                {
                    <span class="badge bg-warning text-dark" aria-label="Best seller product">
                        <i class="bi bi-star-fill" aria-hidden="true"></i> Best Seller
                    </span>
                }
                @if (Model.IsTrending)
                {
                    <span class="badge bg-info text-dark" aria-label="Trending product">
                        <i class="bi bi-graph-up-arrow" aria-hidden="true"></i> Trending
                    </span>
                }
                @if (Model.IsNewArrival)
                {
                    <span class="badge bg-success" aria-label="New arrival product">
                        <i class="bi bi-sparkles" aria-hidden="true"></i> New
                    </span>
                }
            </div>
        }

        <h3 class="card-title text-truncate mb-2 fw-semibold h6"
            id="product-title-@Model.ProductId"
            title="@Model.ProductName">
            <a href="@Url.Action("Details", "Product", new { id = Model.ProductId })" 
               class="text-decoration-none text-dark stretched-link"
               aria-label="View details for @Model.ProductName">
                @Model.ProductName
            </a>
        </h3>

        <p class="text-muted small mb-2" 
           style="display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;"
           aria-describedby="product-description-@Model.ProductId">
            <span id="product-description-@Model.ProductId" class="sr-only">Product description: </span>
            @Model.Description
        </p>

        <div class="mb-3" role="group" aria-labelledby="price-info-@Model.ProductId">
            <div id="price-info-@Model.ProductId" class="sr-only">Price information</div>
            @if (Model.DiscountPercent > 0)
            {
                var effective = Model.Price * (1 - Model.DiscountPercent / 100m);
                <div>
                    <span class="text-muted text-decoration-line-through small" aria-label="Original price @Model.Price.ToString("C")">@Model.Price.ToString("C")</span>
                    <span class="badge bg-danger ms-1" aria-label="@Model.DiscountPercent percent off">@Model.DiscountPercent%&nbsp;off</span>
                </div>
                <span class="fw-bold text-success" aria-label="Sale price @effective.ToString("C")">@effective.ToString("C")</span>
            }
            else
            {
                <span class="fw-semibold" aria-label="Price @Model.Price.ToString("C")">@Model.Price.ToString("C")</span>
            }
        </div>

        @* Stock information *@
        <div class="mb-2" role="status" aria-live="polite">
            @if (Model.IsInStock)
            {
                if (Model.IsLowStock)
                {
                    <small class="text-warning" aria-label="Low stock warning: Only @Model.StockQuantity left in stock">
                        <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> Only @Model.StockQuantity left in stock!
                    </small>
                }
                else
                {
                    <small class="text-success" aria-label="In stock: @Model.StockQuantity available">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i> In Stock (@Model.StockQuantity available)
                    </small>
                }
            }
            else
            {
                <small class="text-danger" aria-label="Out of stock">
                    <i class="bi bi-x-circle-fill" aria-hidden="true"></i> Out of Stock
                </small>
            }
        </div>

        <div class="mt-auto d-flex flex-column gap-2" role="group" aria-label="Product actions">
            @if (Model.StockQuantity > 0)
            {
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Cart" asp-action="AddToCart" method="post" aria-label="Add @Model.ProductName to shopping cart">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="itemId" value="@Model.ProductId" />
                        <input type="hidden" name="quantity" value="1" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-sm btn-primary w-100" 
                                aria-label="Add @Model.ProductName to cart for @Model.Price.ToString("C")">
                            <span class="d-flex align-items-center justify-content-center">
                                <i class="bi bi-cart-plus me-1" aria-hidden="true"></i>
                                Add to Cart
                            </span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" 
                       asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                       class="btn btn-sm btn-primary w-100"
                       aria-label="Sign in to add @Model.ProductName to cart">
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign in to Add to Cart
                    </a>
                }
            }
            else
            {
                @* Out of stock - show notify button *@
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Product" asp-action="NotifyStock" method="post" 
                          aria-label="Request notification when @Model.ProductName is back in stock">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="productId" value="@Model.ProductId" />
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                        <button type="submit" class="btn btn-sm btn-warning w-100"
                                aria-label="Get notified when @Model.ProductName is available">
                            <i class="bi bi-bell-fill me-1" aria-hidden="true"></i>Notify When Available
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-sm btn-secondary w-100" 
                            disabled
                            aria-label="@Model.ProductName is out of stock">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Out of Stock
                    </button>
                }
            }

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-controller="Wishlist" asp-action="AddAjax" method="post"
                      class="add-to-wishlist-form" 
                      data-product-id="@Model.ProductId"
                      aria-label="Add @Model.ProductName to wishlist">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <button type="submit"
                            class="btn btn-sm btn-outline-secondary w-100 add-to-wishlist-button"
                            aria-label="Add @Model.ProductName to your wishlist">
                        <span class="d-flex align-items-center justify-content-center">
                            <span class="me-1" aria-hidden="true">♡</span>
                            Wishlist
                        </span>
                    </button>
                </form>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" 
                   asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString"
                   class="btn btn-sm btn-outline-secondary w-100"
                   aria-label="Sign in to add @Model.ProductName to your wishlist">
                    <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign in for Wishlist
                </a>
            }
        </div>

    </div>
</article>