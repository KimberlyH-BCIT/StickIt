@model ELKH.Models.ProductModel

<form method="post" asp-controller="Wishlist" asp-action="AddAjax" class="add-to-wishlist-form" data-product-id="@Model.PkProductId">
    @Html.AntiForgeryToken()
    <input type="hidden" name="productId" value="@Model.PkProductId" />
    <button type="submit" class="btn btn-sm btn-outline-primary add-to-wishlist-button">Add to Wishlist</button>
</form>
