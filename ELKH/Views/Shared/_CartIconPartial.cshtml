@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject ELKH.Data.ApplicationDbContext _cartDb

@if (SignInManager.IsSignedIn(User))
{
    var _cartEmail = User.Identity?.Name ?? string.Empty;
    var _cartUser  = !string.IsNullOrEmpty(_cartEmail)
        ? _cartDb.RegisteredUsers.FirstOrDefault(u => u.Email == _cartEmail)
        : null;
    var _cartCount = _cartUser != null
        ? _cartDb.Carts
            .Where(c => c.FkRegisteredUserId == _cartUser.PkRegisteredUserId)
            .Sum(c => (int?)c.Quantity) ?? 0
        : 0;
    var _cartLabel = _cartCount > 99 ? "99+" : _cartCount.ToString();

    <a asp-controller="Cart" asp-action="Index"
       class="cart-icon-link position-relative d-inline-flex align-items-center justify-content-center"
       title="Shopping Cart"
       aria-label="Shopping Cart, @_cartCount item@(_cartCount == 1 ? "" : "s")">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l1.313 7h8.17l1.313-7H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
        </svg>
        @if (_cartCount > 0)
        {
            <span id="cart-badge" class="cart-badge" aria-hidden="true">@_cartLabel</span>
            <span id="cart-badge-sr" class="visually-hidden">@_cartCount item@(_cartCount == 1 ? "" : "s") in cart</span>
        }
        else
        {
            <span id="cart-badge" class="cart-badge" style="display: none;" aria-hidden="true">0</span>
            <span id="cart-badge-sr" class="visually-hidden">0 items in cart</span>
        }
    </a>
}
