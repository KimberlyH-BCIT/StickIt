        <div class="offcanvas-header border-bottom">
            <a class="navbar-brand mb-0 h1" asp-area="" asp-controller="Home" asp-action="Index" id="navOffcanvasTitle">ELKH</a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="navbar-nav flex-column">
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2 fw-semibold" asp-controller="Admin" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-controller="Home" asp-action="Index">View as Customer</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-controller="Manager" asp-action="Index">View as Manager</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-controller="Home" asp-action="Index">View as Staff</a>
                    </li>
                }
                else
                {
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                    </li>

                    @* Categories Section *@
