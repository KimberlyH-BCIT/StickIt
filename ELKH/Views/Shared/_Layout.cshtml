<!DOCTYPE html>
<html lang="en">
<head>
    @using Microsoft.AspNetCore.Identity
    @using Microsoft.AspNetCore.Antiforgery
    @using Microsoft.AspNetCore.Http.Extensions
    @inject SignInManager<IdentityUser> SignInManager
    @inject IAntiforgery AntiforgeryService
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        // ===============================================================================
        // ║ CSRF Token Generation for Client-Side AJAX Operations                      ║
        // ║ Generates antiforgery token for secure AJAX requests                       ║
        // ===============================================================================

        // Generate and store a per-request antiforgery token. The token is written into
        // a <meta> tag so client-side JavaScript can read it and attach it as the
        // X-CSRF-TOKEN request header on every state-changing fetch() call. This
        // complements the standard form-field token used by Razor form tag helpers.
        var csrfToken = AntiforgeryService.GetAndStoreTokens(Context).RequestToken;
    }
    <meta name="csrf-token" content="@csrfToken" />

    @* =============================================================================== *@
    @* ║ PWA (Progressive Web App) Configuration                                      ║ *@
    @* =============================================================================== *@

    <!-- PWA Manifest -->
    <link rel="manifest" href="~/manifest.json" />

    <!-- Theme and Display Configuration -->
    <meta name="theme-color" content="#6f42c1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="StickIt" />
    <meta name="msapplication-TileColor" content="#6f42c1" />
    <meta name="msapplication-config" content="~/browserconfig.xml" />

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="~/logo-stickit.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/logo-stickit.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/logo-stickit.png" />
    <link rel="mask-icon" href="~/logo-stickit.png" color="#6f42c1" />

    <!-- Standard favicon -->
    <link rel="icon" type="image/png" href="~/logo-stickit.png" />

    <!-- Open Graph for social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] - StickIt" />
    <meta property="og:description" content="StickIt is a modern sticker storefront built with ASP.NET Core, Razor Pages, and production-ready eCommerce architecture." />
    <meta property="og:image" content="~/logo-stickit.png" />
    <meta property="og:url" content="@Context.Request.GetDisplayUrl()" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - StickIt" />
    <meta name="twitter:description" content="StickIt is a modern sticker storefront built with ASP.NET Core, Razor Pages, and production-ready eCommerce architecture." />
    <meta name="twitter:image" content="~/logo-stickit.png" />

    <title>@ViewData["Title"] - StickIt</title>
    <script type="importmap"></script>

    @* =============================================================================== *@
    @* ║ Google Fonts for Kawaii Theme - Optimized Loading                          ║ *@
    @* =============================================================================== *@

    <!-- Preload critical fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <!-- 
    Sniglet: Chunky playful headings (400=regular, 800=black)
    Nunito: Clean body text with full weight range for flexibility
    display=swap ensures text shows immediately with fallbacks
    -->
    <link href="https://fonts.googleapis.com/css2?family=Sniglet:wght@400;800&family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet" preload>

    @* =============================================================================== *@
    @* ║ CSS Loading Order - Optimized Cascade Priority                              ║ *@
    @* =============================================================================== *@
    @* 
        Loading Order (Low to High Priority):
        1. Bootstrap - Foundation framework styles
        2. site.css - Base site utilities and accessibility
        3. ELKH.styles.css - Scoped CSS from Razor components (includes _Layout.cshtml.css)
        4. kawaii-theme.css - FINAL authority on design system (loaded LAST to override)

        WHY THIS ORDER:
        - Bootstrap provides base components
        - site.css adds site-wide utilities
        - ELKH.styles.css (scoped) now uses kawaii CSS variables (no conflicts)
        - kawaii-theme.css defines those variables and has final say
    *@

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ELKH.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kawaii-theme.css" asp-append-version="true" />

    <!-- Global Accessibility Styles -->
    <style>
        /* =========================================================================== */
        /* ║ GLOBAL ACCESSIBILITY STYLES - WCAG 2.1 AA COMPLIANCE                   ║ */
        /* ║ Now using kawaii theme CSS variables for consistent styling            ║ */
        /* ║ Skip-link styles are defined globally in site.css                     ║ */
        /* =========================================================================== */

        /* Enhanced focus indicators using kawaii theme */
        *:focus,
        *:focus-visible {
            outline: 2px solid var(--purple, #7B5FB6) !important;
            outline-offset: 2px !important;
        }

        .btn:focus,
        .form-control:focus,
        .form-select:focus {
            border-color: var(--purple, #7B5FB6) !important;
            box-shadow: 0 0 0 0.25rem var(--surface-lavender, rgba(228, 193, 249, 0.30)) !important;
        }

        /* High contrast mode support */
        @@media (prefers-contrast: high) {
            .text-white-50 {
                color: #ccc !important;
            }

            .text-muted {
                color: #666 !important;
            }

            .border-secondary {
                border-color: #999 !important;
            }

            /* Enhance kawaii color contrasts for high contrast mode */
            .btn-primary-kawaii,
            .btn-secondary-kawaii,
            .btn-sky-kawaii {
                border-width: 3px !important;
                font-weight: 900 !important;
            }

            .kawaii-nav-link,
            .kawaii-dropdown-item {
                border-width: 2px !important;
                font-weight: 800 !important;
            }

            /* Ensure proper contrast for text on colored backgrounds */
            .pill-mint,
            .pill-sky,
            .pill-lavender {
                color: #333 !important;
            }

            .pill-pink,
            .pill-butter {
                color: #000 !important;
            }
        }

        /* Reduced motion support - already in site.css but critical for inline */
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }

        /* Screen reader only content */
        .sr-only {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0, 0, 0, 0) !important;
            white-space: nowrap !important;
            border: 0 !important;
        }

        /* Ensure sufficient color contrast */
        .text-white-50 {
            color: rgba(255, 255, 255, 0.75) !important; /* Improved contrast */
        }

        /* Focus management for dynamic content */
        [aria-live="polite"] {
            position: relative;
        }

        /* Accessible dropdown indicators */
        .dropdown-toggle::after {
            margin-left: 0.5em;
        }

        /* Mobile touch target sizes (minimum 44x44px) */
        @@media (max-width: 768px) {
            .btn, .nav-link, .kawaii-nav-link, .dropdown-item {
                min-height: 44px;
                min-width: 44px;
                padding: 12px 16px;
            }
        }
    </style>

    @* =============================================================================== *@
    @* ║ Page-specific styles injection point                                        ║ *@
    @* =============================================================================== *@
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <!-- Skip Navigation Links for Screen Reader and Keyboard Users -->
    <nav class="skip-links sr-only-focusable" aria-label="Skip navigation">
        <a href="#main-content" class="skip-link">Skip to main content</a>
        <a href="#site-navigation" class="skip-link">Skip to navigation</a>
        <a href="#search-form" class="skip-link">Skip to search</a>
        <a href="#site-footer" class="skip-link">Skip to footer</a>
    </nav>

    <!-- Floating Sparkles Background Effect -->
    <div class="sparkle-bg" aria-hidden="true"></div>

    <!-- Kawaii Navigation - Complete navigation with hamburger menu -->
    <partial name="_Navbar" />

    <!-- Main Content Container -->
    <div class="container">
        <div>
            @RenderSection("title",false)
        </div>
        
        @{
            var raw = TempData["Message"] as string;
            if (!string.IsNullOrEmpty(raw))
            {
                var parts = raw.Split(',', 2);
                var level = parts.Length > 0 ? parts[0].Trim().ToLower() : "info";
                var text = parts.Length > 1 ? parts[1].Trim() : string.Empty;
                var isCartMessage = text.Contains("cart", StringComparison.OrdinalIgnoreCase);
                var alertClass = level switch
                {
                    "success" => "alert-success",
                    "danger" or "error" => "alert-danger",
                    "warning" => "alert-warning",
                    "info" => "alert-info",
                    _ => "alert-secondary"
                };

                if (!string.IsNullOrEmpty(text))
                {
                    var isOnCartPage = Context.Request.Path.StartsWithSegments("/Cart");

                    var globalAlertVM = new ELKH.ViewModels.AlertBannerVM
                    {
                        Message = $"<strong>{text}</strong>",
                        AlertType = alertClass,
                        Icon = level == "success" ? "check-circle-fill" : null,
                        IconType = "bootstrap",
                        Dismissible = true,
                        CssClasses = "alert-dismissible fade show d-flex align-items-center justify-content-between",
                        ActionText = (level == "success" && isCartMessage && !isOnCartPage) ? "View Cart" : null,
                        ActionController = (level == "success" && isCartMessage && !isOnCartPage) ? "Cart" : null,
                        ActionAction = (level == "success" && isCartMessage && !isOnCartPage) ? "Index" : null,
                        ActionButtonClass = "btn btn-sm btn-success me-2"
                    };
        <div class="row">
            <div class="col-12">
                <div id="globalAlert">
                    @await Html.PartialAsync("_AlertBannerPartial", globalAlertVM)
                </div>
            </div>
        </div>
                }
            }
        }
        
        <!-- =========================================================================== -->
        <!-- ║ Main Content Area - Dynamic page content injection point              ║ -->
        <!-- =========================================================================== -->
        <main role="main" class="pb-3" id="main-content">
            @RenderBody()
        </main>
    </div>

    <!-- ================================================================================ -->
    <!-- ║ Site Footer - Company information, legal links, and contact details       ║ -->
    <!-- ================================================================================ -->
    <footer style="background:#111;" role="contentinfo" id="site-footer">
        <div class="container py-5 text-white-50 small">
            <div class="row g-4">

                <div class="col-6 col-lg-3">
                    <h3 class="text-white fw-bold mb-2 h5">Useful links</h3>
                    <nav aria-label="Footer useful links">
                        <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Product" asp-action="Index">All Products</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Cart" asp-action="Index">Cart</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a class="text-white-50 text-decoration-none" asp-controller="Order" asp-action="MyHistory">My Orders</a></li>
                        }
                        else
                        {
                            <li><a class="text-white-50 text-decoration-none" asp-area="Identity" asp-page="/Account/Login">My Orders</a></li>
                        }
                    </ul>
                    </nav>
                </div>

                <div class="col-6 col-lg-3">
                    <h3 class="text-white fw-bold mb-2 h5">Support</h3>
                    <nav aria-label="Footer support links">
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Contact">Contact</a></li>
                            <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="FAQ">FAQ</a></li>
                            <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Shipping">Shipping</a></li>
                            <li><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Returns">Returns</a></li>
                        </ul>
                    </nav>
                </div>

                <div class="col-6 col-lg-3">
                    <h3 class="text-white fw-bold mb-2 h5">Company</h3>
                    <nav aria-label="Footer company links">
                        <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Terms">Terms</a></li>
                        <li><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Accessibility">Accessibility</a></li>
                    </ul>
                    </nav>
                </div>

                <div class="col-12 col-lg-3">
                    <h3 class="text-white fw-bold mb-2 h5">Stay connected</h3>
                    <p class="text-white-50 mb-3">Project updates and support details are available through the site content and contact page.</p>
                    <p class="small text-white-50 mb-0">
                        Use the <a class="text-warning text-decoration-none" asp-controller="Home" asp-action="Contact">contact page</a>
                        for project questions and support.
                    </p>
                </div>

            </div>

            <hr class="border-secondary my-4" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>&copy; @DateTime.Now.Year - StickIt</div>
                <div class="d-flex gap-3">
                    <a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Terms">Terms</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Wishlist sign-in prompt (shared across all pages; shown when a guest clicks any wishlist button) -->
    <div class="modal fade" id="wishlistSignInModal" tabindex="-1"
         aria-labelledby="wishlistSignInModalLabel" aria-hidden="true" role="dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="wishlistSignInModalLabel">
                        <i class="bi bi-heart me-2" aria-hidden="true"></i>Save to Wishlist
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Sign in to save items to your wishlist and access them any time.</p>
                </div>
                <div class="modal-footer justify-content-start gap-2">
                    <a asp-area="Identity" asp-page="/Account/Login"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="btn btn-dark"
                       aria-label="Sign in to your account">
                        <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Sign In
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="btn btn-outline-secondary"
                       aria-label="Create a new account">
                        <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Create an Account
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ================================================================================ -->
    <!-- ║ Scripts Section - Framework and application JavaScript loading             ║ -->
    <!-- ================================================================================ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cart-ajax.js" asp-append-version="true"></script>

    @* =============================================================================== *@
    @* ║ Kawaii UI Components                                                         ║ *@
    @* =============================================================================== *@
    <script src="~/js/kawaii-ui.js" asp-append-version="true"></script>

    @* =============================================================================== *@
    @* ║ Image Optimization & Lazy Loading                                           ║ *@
    @* =============================================================================== *@
    <script src="~/js/lazy-loading.js" asp-append-version="true"></script>

    @* =============================================================================== *@
    @* ║ Progressive Web App (PWA) Service Worker Registration                       ║ *@
    @* =============================================================================== *@
    <script>
        // PWA Service Worker Registration
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', async () => {
                try {
                    const registration = await navigator.serviceWorker.register('/sw.js');
                    console.log('PWA: Service Worker registered successfully:', registration.scope);

                    // Handle service worker updates
                    registration.addEventListener('updatefound', () => {
                        const newWorker = registration.installing;
                        if (newWorker) {
                            newWorker.addEventListener('statechange', () => {
                                if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                                    // New content available, show update notification
                                    if (confirm('New version available! Refresh to update?')) {
                                        window.location.reload();
                                    }
                                }
                            });
                        }
                    });
                } catch (error) {
                    console.log('PWA: Service Worker registration failed:', error);
                }
            });
        }

        // PWA Install Prompt
        let deferredPrompt;

        window.addEventListener('beforeinstallprompt', (e) => {
            console.log('PWA: Install prompt available');
            e.preventDefault();
            deferredPrompt = e;

            // Show custom install button or banner
            showInstallPromotion();
        });

        window.addEventListener('appinstalled', (evt) => {
            console.log('PWA: App was installed successfully');
            hideInstallPromotion();
        });

        function showInstallPromotion() {
            // Create install promotion banner
            if (document.getElementById('pwa-install-banner')) return;

            const banner = document.createElement('div');
            banner.id = 'pwa-install-banner';
            banner.className = 'alert alert-info alert-dismissible fade show d-flex align-items-center justify-content-between mb-0';
            banner.style.cssText = 'position: fixed; top: 0; left: 0; right: 0; z-index: 9999; border-radius: 0; margin: 0;';
            banner.setAttribute('role', 'banner');
            banner.setAttribute('aria-live', 'polite');
            banner.setAttribute('aria-label', 'Install app notification');

            const messageContainer = document.createElement('div');
            messageContainer.className = 'd-flex align-items-center';

            const icon = document.createElement('i');
            icon.className = 'bi bi-download me-2';
            icon.setAttribute('aria-hidden', 'true');

            const messageText = document.createElement('span');
            messageText.textContent = 'Install StickIt app for a better shopping experience!';

            messageContainer.append(icon, messageText);

            const actionContainer = document.createElement('div');
            actionContainer.className = 'd-flex gap-2';

            const installButton = document.createElement('button');
            installButton.type = 'button';
            installButton.className = 'btn btn-sm btn-primary';
            installButton.setAttribute('aria-label', 'Install StickIt app');
            installButton.textContent = 'Install';
            installButton.addEventListener('click', installPWA);

            const closeButton = document.createElement('button');
            closeButton.type = 'button';
            closeButton.className = 'btn-close';
            closeButton.setAttribute('aria-label', 'Close install notification');
            closeButton.addEventListener('click', hideInstallPromotion);

            actionContainer.append(installButton, closeButton);
            banner.append(messageContainer, actionContainer);

            document.body.prepend(banner);

            // Auto-hide after 10 seconds
            setTimeout(() => {
                if (banner.parentNode) {
                    banner.remove();
                }
            }, 10000);
        }

        function hideInstallPromotion() {
            const banner = document.getElementById('pwa-install-banner');
            if (banner) {
                banner.remove();
            }
        }

        function installPWA() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                deferredPrompt.userChoice.then((choiceResult) => {
                    if (choiceResult.outcome === 'accepted') {
                        console.log('PWA: User accepted the install prompt');
                    } else {
                        console.log('PWA: User dismissed the install prompt');
                    }
                    deferredPrompt = null;
                    hideInstallPromotion();
                });
            }
        }

        // Online/Offline status handling
        function updateConnectionStatus() {
            if (navigator.onLine) {
                console.log('PWA: Back online');
                document.body.classList.remove('offline');

                // Hide offline indicator if present
                const offlineIndicator = document.getElementById('offline-indicator');
                if (offlineIndicator) {
                    offlineIndicator.remove();
                }
            } else {
                console.log('PWA: Gone offline');
                document.body.classList.add('offline');

                // Show offline indicator
                if (!document.getElementById('offline-indicator')) {
                    const indicator = document.createElement('div');
                    indicator.id = 'offline-indicator';
                    indicator.className = 'alert alert-warning alert-dismissible mb-0 text-center';
                    indicator.style.cssText = 'position: fixed; bottom: 0; left: 0; right: 0; z-index: 9999; border-radius: 0;';

                    const offlineIcon = document.createElement('i');
                    offlineIcon.className = 'bi bi-wifi-off me-2';
                    offlineIcon.setAttribute('aria-hidden', 'true');

                    const offlineText = document.createTextNode("You're offline. Some features may be limited.");

                    const closeButton = document.createElement('button');
                    closeButton.type = 'button';
                    closeButton.className = 'btn-close';
                    closeButton.setAttribute('aria-label', 'Close');
                    closeButton.addEventListener('click', () => indicator.remove());

                    indicator.append(offlineIcon, offlineText, closeButton);
                    document.body.appendChild(indicator);
                }
            }
        }

        window.addEventListener('online', updateConnectionStatus);
        window.addEventListener('offline', updateConnectionStatus);

        // Initial status check
        updateConnectionStatus();
    </script>

    @await Html.PartialAsync("_ValidationScriptsPartial")

    <!-- Page-specific script injection point for additional functionality -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
