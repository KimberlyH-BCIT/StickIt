                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-category="Thanksgiving">Thanksgiving</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="Product" asp-action="Index" asp-route-category="Miscellaneous">Miscellaneous</a></li>
                            </ul>
                        </li>
                        @if (User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
