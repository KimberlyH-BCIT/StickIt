<!DOCTYPE html>
<html lang="en">
<head>
    @using Microsoft.AspNetCore.Identity
    @using Microsoft.AspNetCore.Antiforgery
    @inject SignInManager<IdentityUser> SignInManager
    @inject IAntiforgery AntiforgeryService
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        // Generate and store a per-request antiforgery token. The token is written into
        // a <meta> tag so client-side JavaScript can read it and attach it as the
        // X-CSRF-TOKEN request header on every state-changing fetch() call. This
        // complements the standard form-field token used by Razor form tag helpers.
        var csrfToken = AntiforgeryService.GetAndStoreTokens(Context).RequestToken;
    }
    <meta name="csrf-token" content="@csrfToken" />
    <link rel="icon" type="image/png" href="~/logo-stickit.png" />
    <title>@ViewData["Title"] - ELKH</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ELKH.styles.css" asp-append-version="true" />
</head>
<body>
<header class="site-header bg-white box-shadow mb-3">

    @* ① Top bar: brand + login greeting *@
    <div class="header-top border-bottom py-2">
        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-2">
            <a class="navbar-brand mb-0 h1" asp-area="" asp-controller="Home" asp-action="Index">ELKH</a>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <partial name="_LoginPartial" />
                <partial name="_CartIconPartial" />
            </div>
        </div>
    </div>

        @* ② Search bar centered *@
        <div class="header-search py-2">
            <div class="container-fluid d-flex justify-content-center">
                <div class="header-search-wrap position-relative">
                    <form asp-controller="Product" asp-action="Index" method="get" class="d-flex" role="search">
                        <input id="productNameInput"
                               type="search"
                               name="q"
                               class="form-control"
                               placeholder="Search products…"
                               autocomplete="off"
                               aria-label="Search products" />
                        <button type="submit" class="btn btn-outline-secondary ms-2">Search</button>
                    </form>
                    <div id="productNameSuggestions"
                         class="list-group position-absolute w-100 shadow-sm"
                         style="z-index:1050;display:none;"></div>
                </div>
            </div>
        </div>

        @* ③ Nav strip — sits at the bottom of the header, separated by border-top *@
        <nav class="header-nav border-top">
            <div class="container-fluid d-flex align-items-center">
                <button class="nav-hamburger flex-shrink-0 me-2"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#navOffcanvas"
                        aria-controls="navOffcanvas"
                        aria-label="Open navigation menu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                    </svg>
                </button>
                @if (User.IsInRole("Admin"))
                {
                    <ul class="navbar-nav flex-row flex-grow-1 justify-content-evenly mb-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark fw-semibold" asp-controller="Admin" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">View as Customer</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Manager" asp-action="Index">View as Manager</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Staff" asp-action="Index">View as Staff</a>
                        </li>
                    </ul>
                }
                else
                {
                    <ul class="navbar-nav flex-row flex-grow-1 justify-content-evenly mb-0">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                        </li>
                            @* @if (User.IsInRole("Staff")) *@
                            @* { *@
                                <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="OrderHistory" asp-action="Index">Order History</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="Inventory" asp-action="Index">Inventory</a>
                                </li>
                            @* } *@
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Order" asp-action="MyHistory">My Orders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="MyRatings">My Ratings</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="User" asp-action="EditProfile">My Profile</a>
                            </li>
                        }
                    </ul>
                }
            </div>
        </nav>

    </header>

    @* Off-canvas sidebar — opened by the hamburger button in the nav strip *@
    <div class="offcanvas offcanvas-start" tabindex="-1" id="navOffcanvas" aria-labelledby="navOffcanvasTitle">
        <div class="offcanvas-header border-bottom">
            <a class="navbar-brand mb-0 h1" asp-area="" asp-controller="Home" asp-action="Index" id="navOffcanvasTitle">ELKH</a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body p-0">
            <ul class="navbar-nav flex-column">
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2 fw-semibold" asp-controller="Admin" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-controller="Home" asp-action="Index">View as Customer</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-controller="Manager" asp-action="Index">View as Manager</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-controller="Staff" asp-action="Index">View as Staff</a>
                    </li>
                }
                else
                {
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Product" asp-action="Index">Products</a>
                    </li>
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                        </li>
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Order" asp-action="MyHistory">My Orders</a>
                        </li>
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="User" asp-action="MyRatings">My Ratings</a>
                        </li>
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="User" asp-action="EditProfile">My Profile</a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="container">
        <div>
            @RenderSection("title",false)
        </div>
        @{
            // TempData["Message"] uses the application-wide "level, text" convention.
            // Controllers write this value through the SetSuccessMessage / SetWarningMessage /
            // SetErrorMessage helpers in AuthenticatedControllerBase (or directly as raw strings
            // in controllers that do not inherit from it, e.g. OrderHistoryController).
            // Format:  "<level>, <display text>"  — e.g. "success, Order placed successfully"
            // The level token is compared case-insensitively and mapped to a Bootstrap alert class.
            var raw = TempData["Message"] as string;
            if (!string.IsNullOrEmpty(raw))
            {
                var parts = raw.Split(',', 2);
                var level = parts.Length > 0 ? parts[0].Trim().ToLower() : "info";
                var text = parts.Length > 1 ? parts[1].Trim() : string.Empty;
                var alertClass = "alert-secondary";
                if (level == "success") { alertClass = "alert-success"; }
                else if (level == "danger" || level == "error") { alertClass = "alert-danger"; }
                else if (level == "warning") { alertClass = "alert-warning"; }
                else if (level == "info") { alertClass = "alert-info"; }
        <div class="row">
            <div class="col-12">
                <div class="alert @alertClass alert-dismissible fade show" role="alert">
                    @text
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            </div>
        </div>
            }
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer style="background:#111;">
        <div class="container py-5 text-white-50 small">
            <div class="row g-4">

                <div class="col-6 col-lg-3">
                    <div class="text-white fw-bold mb-2">Useful links</div>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Product" asp-action="Index">All Products</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Cart" asp-action="Index">Cart</a></li>
                        <li><a class="text-white-50 text-decoration-none" asp-controller="Order" asp-action="History">My Orders</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="text-white fw-bold mb-2">Support</div>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" href="#">Contact</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" href="#">FAQ</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" href="#">Shipping</a></li>
                        <li><a class="text-white-50 text-decoration-none" href="#">Returns</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="text-white fw-bold mb-2">Company</div>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" href="#">About</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" href="#">Terms</a></li>
                        <li><a class="text-white-50 text-decoration-none" href="#">Accessibility</a></li>
                    </ul>
                </div>

                <div class="col-12 col-lg-3">
                    <div class="text-white fw-bold mb-2">Stay connected</div>
                    <div class="text-white-50 mb-3">Subscribe for product drops and updates.</div>

                    <form class="d-flex gap-2 mb-3">
                        <input class="form-control form-control-sm" type="email" placeholder="Email address" />
                        <button class="btn btn-warning btn-sm fw-bold" type="button">Subscribe</button>
                    </form>

                    <div class="d-flex gap-3 fs-5">
                        <a class="text-white-50" href="#"><i class="bi bi-instagram"></i></a>
                        <a class="text-white-50" href="#"><i class="bi bi-facebook"></i></a>
                        <a class="text-white-50" href="#"><i class="bi bi-youtube"></i></a>
                        <a class="text-white-50" href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

            </div>

            <hr class="border-secondary my-4" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>© @DateTime.Now.Year - ELKH</div>
                <div class="d-flex gap-3">
                    <a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a class="text-white-50 text-decoration-none" href="#">Terms</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Wishlist sign-in prompt (shared across all pages; shown when a guest clicks any wishlist button) -->
    <div class="modal fade" id="wishlistSignInModal" tabindex="-1"
         aria-labelledby="wishlistSignInModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="wishlistSignInModalLabel">
                        <i class="bi bi-heart me-2"></i>Save to Wishlist
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Sign in to save items to your wishlist and access them any time.</p>
                </div>
                <div class="modal-footer justify-content-start gap-2">
                    <a asp-area="Identity" asp-page="/Account/Login"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="btn btn-dark">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-person-plus me-1"></i>Create an Account
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
