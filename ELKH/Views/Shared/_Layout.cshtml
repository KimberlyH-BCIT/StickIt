<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/logo-stickit.png" />
    <title>STICK IT</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ELKH.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="top-gradient-bar"></div>

    <header>
        <nav class="navbar navbar-expand-lg kawaii-navbar shadow-sm">
            <div class="container">

                <a class="navbar-brand kawaii-brand"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    <img src="~/welcome-sticker-removebg.png" class="navbar-logo" />
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="mainNav">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link kawaii-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kawaii-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kawaii-link"
                               asp-controller="OrderHistory"
                               asp-action="Index">
                                Order History
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link kawaii-link"
                               asp-controller="Inventory"
                               asp-action="Index">
                                Inventory
                            </a>
                        </li>

                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link kawaii-link"
                                       asp-controller="Admin"
                                       asp-action="Index">
                                        Admin Dashboard
                                    </a>
                                </li>
                            }

                            if (User.IsInRole("Manager"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link kawaii-link"
                                       asp-controller="Manager"
                                       asp-action="Index">
                                        Manager Dashboard
                                    </a>
                                </li>
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="OrderHistory" asp-action="Index">Order History</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Inventory" asp-action="Index">Inventory</a>
                        </li>
                    </ul>

                    <partial name="_LoginPartial" />

                </div>

            </div>
        </nav>
    </header>

    <div class="container kawaii-container flex-grow-1">

        <div>
            @RenderSection("title", false)
        </div>

        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <footer class="kawaii-footer text-center mt-5">
        <div class="container">
            🌷 © 2026 - ELKH 🌷
            <br />
            <a asp-controller="Home" asp-action="Privacy" class="kawaii-link">
                Privacy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>