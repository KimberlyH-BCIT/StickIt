<!DOCTYPE html>
<html lang="en">
<head>
    @using Microsoft.AspNetCore.Identity
    @using Microsoft.AspNetCore.Antiforgery
    @inject SignInManager<IdentityUser> SignInManager
    @inject IAntiforgery AntiforgeryService
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var csrfToken = AntiforgeryService.GetAndStoreTokens(Context).RequestToken;
    }
    <meta name="csrf-token" content="@csrfToken" />
    <link rel="icon" type="image/png" href="~/logo-stickit.png" />
    <title>@ViewData["Title"] - STICK IT</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ELKH.styles.css" asp-append-version="true" />

    <style>
        /* ── Pink Gradient Theme ─────────────────────────────── */
        body {
            background: #fff8fb;
            font-family: 'Segoe UI', system-ui, sans-serif;
        }

        /* ── Navbar ──────────────────────────────────────────── */
        .site-navbar {
            background: linear-gradient(135deg, #e91e8c 0%, #f06292 50%, #ba68c8 100%);
            box-shadow: 0 2px 16px rgba(233,30,140,.3);
            position: sticky;
            top: 0;
            z-index: 1030;
        }

        .site-navbar .navbar-brand {
            font-weight: 800;
            font-size: 1.35rem;
            color: #fff !important;
            letter-spacing: .3px;
            text-shadow: 0 1px 4px rgba(0,0,0,.15);
        }

        .site-navbar .nav-link {
            color: rgba(255,255,255,.92) !important;
            font-weight: 500;
            padding: .4rem .8rem !important;
            border-radius: 20px;
            font-size: .87rem;
            transition: background .18s;
        }
        .site-navbar .nav-link:hover {
            background: rgba(255,255,255,.22);
            color: #fff !important;
        }

        /* Search */
        .navbar-search .form-control {
            border-radius: 20px 0 0 20px;
            border: none;
            background: rgba(255,255,255,.93);
            font-size: .87rem;
        }
        .navbar-search .btn-search {
            border-radius: 0 20px 20px 0;
            background: rgba(255,255,255,.93);
            border: none;
            color: #c2185b;
            font-weight: 700;
            padding: .375rem 1rem;
            transition: background .18s;
        }
        .navbar-search .btn-search:hover { background: #fce4ec; }

        /* Hamburger */
        .nav-hamburger {
            background: rgba(255,255,255,.18);
            border: none;
            border-radius: 8px;
            color: #fff;
            padding: .3rem .5rem;
            cursor: pointer;
            line-height: 1;
            transition: background .18s;
        }
        .nav-hamburger:hover { background: rgba(255,255,255,.32); }

        /* Cart */
        .cart-icon-link {
            color: #fff !important;
            text-decoration: none;
            padding: .3rem .5rem;
            border-radius: 8px;
            transition: background .18s;
            position: relative;
        }
        .cart-icon-link:hover { background: rgba(255,255,255,.2); }
        .cart-badge {
            position: absolute;
            top: -4px; right: -6px;
            min-width: 17px; height: 17px;
            padding: 0 3px;
            border-radius: 9px;
            background: #fff;
            color: #c2185b;
            font-size: .6rem;
            font-weight: 800;
            line-height: 17px;
            text-align: center;
            pointer-events: none;
        }

        /* Force login partial text white in navbar */
        .site-navbar .navbar-text,
        .site-navbar form a,
        .site-navbar a { color: rgba(255,255,255,.92) !important; }
        .site-navbar form .btn { border-color: rgba(255,255,255,.5); color: #fff; }
        .site-navbar form .btn:hover { background: rgba(255,255,255,.2); }

        /* ── Offcanvas ───────────────────────────────────────── */
        #navOffcanvas .offcanvas-header {
            background: linear-gradient(135deg, #e91e8c, #ba68c8);
        }
        #navOffcanvas .offcanvas-title { color: #fff; font-weight: 800; }
        #navOffcanvas .btn-close { filter: invert(1); }
        #navOffcanvas .nav-link {
            color: #4a1030;
            padding: .65rem 1rem;
            font-weight: 500;
            font-size: .9rem;
        }
        #navOffcanvas .nav-link:hover {
            background: #fce4ec;
            color: #c2185b;
        }

        /* ── Footer ──────────────────────────────────────────── */
        .site-footer {
            background: linear-gradient(135deg, #880e4f 0%, #ad1457 45%, #6a1b9a 100%);
            color: rgba(255,255,255,.72);
        }
        .site-footer a { color: rgba(255,255,255,.6); text-decoration: none; transition: color .15s; }
        .site-footer a:hover { color: #fff; }
        .site-footer .footer-heading { color: #fff; font-weight: 700; margin-bottom: .55rem; font-size: .95rem; }
        .site-footer hr { border-color: rgba(255,255,255,.15); }

        /* ── Misc ────────────────────────────────────────────── */
        main { min-height: 60vh; }
        #productNameSuggestions {
            z-index: 1060;
            border-radius: 0 0 12px 12px;
            overflow: hidden;
        }
    </style>
</head>

<body>

    <!-- ══════════════════ NAVBAR ══════════════════ -->
    <nav class="site-navbar navbar py-2 px-3">
        <div class="container-fluid d-flex align-items-center gap-2 flex-nowrap">

            <!-- Hamburger -->
            <button class="nav-hamburger flex-shrink-0"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#navOffcanvas"
                    aria-controls="navOffcanvas"
                    aria-label="Menu">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd"
                          d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                </svg>
            </button>

            <!-- Brand -->
            <a class="navbar-brand flex-shrink-0" asp-controller="Home" asp-action="Index">
                🌸 STICK IT
            </a>

            <!-- Search (hides on small screens) -->
            <div class="navbar-search d-none d-md-flex flex-grow-1 position-relative" style="max-width:400px;">
                <form asp-controller="Product" asp-action="Index" method="get" class="d-flex w-100" role="search">
                    <input id="productNameInput"
                           type="search" name="q"
                           class="form-control"
                           placeholder="Search stickers & more…"
                           autocomplete="off" />
                    <button type="submit" class="btn-search">🔍</button>
                </form>
                <div id="productNameSuggestions"
                     class="list-group position-absolute w-100 shadow mt-1 top-100"></div>
            </div>

            <!-- Desktop nav links -->
            <ul class="navbar-nav flex-row gap-1 ms-auto d-none d-lg-flex align-items-center">
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Admin"   asp-action="Index">🛡️ Admin</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Manager" asp-action="Index">Manager</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Staff"   asp-action="Index">Staff</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home"    asp-action="Index">Customer View</a></li>
                }
                else if (User.IsInRole("Manager"))
                {
                    <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Manager" asp-action="Index">📦 Manager</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Staff"   asp-action="Index">Staff View</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home"    asp-action="Index">Customer View</a></li>
                }
                else if (User.IsInRole("Staff"))
                {
                    <li class="nav-item"><a class="nav-link fw-semibold" asp-controller="Staff" asp-action="Index">🧑‍💼 Staff</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="OrderHistory" asp-action="Index">Orders</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Inventory"    asp-action="Index">Inventory</a></li>
                }
                else
                {
                    <li class="nav-item"><a class="nav-link" asp-controller="Home"    asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Product" asp-action="Index">Products</a></li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Wishlist" asp-action="Index">Wishlist</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Order"    asp-action="MyHistory">My Orders</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="User"     asp-action="MyRatings">Ratings</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="User"     asp-action="EditProfile">Profile</a></li>
                    }
                }
            </ul>

            <!-- Cart + Login always visible -->
            <div class="d-flex align-items-center gap-1 ms-2 flex-shrink-0">
                <partial name="_CartIconPartial" />
                <partial name="_LoginPartial" />
            </div>

        </div>
    </nav>

    <!-- ══════════════════ OFF-CANVAS ══════════════════ -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="navOffcanvas" aria-labelledby="navOffcanvasTitle" style="max-width:280px;">
        <div class="offcanvas-header py-3">
            <span class="offcanvas-title h6 mb-0" id="navOffcanvasTitle">🌸 STICK IT</span>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <!-- Mobile search inside sidebar -->
        <div class="px-3 py-2 border-bottom" style="background:#fce4ec;">
            <form asp-controller="Product" asp-action="Index" method="get" class="d-flex gap-1">
                <input type="search" name="q"
                       class="form-control form-control-sm rounded-pill"
                       placeholder="Search…" autocomplete="off" />
                <button type="submit"
                        class="btn btn-sm rounded-pill px-2"
                        style="background:#e91e8c;color:#fff;border:none;">🔍</button>
            </form>
        </div>

        <div class="offcanvas-body p-0">
            <ul class="navbar-nav flex-column">
                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2 fw-bold" asp-controller="Admin"   asp-action="Index">🛡️ Admin Dashboard</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Manager" asp-action="Index">📦 Manager View</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Staff"   asp-action="Index">🧑‍💼 Staff View</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Home"    asp-action="Index">🛒 Customer View</a></li>
                }
                else if (User.IsInRole("Manager"))
                {
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2 fw-bold" asp-controller="Manager" asp-action="Index">📦 Manager Dashboard</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Staff"   asp-action="Index">🧑‍💼 Staff View</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Home"    asp-action="Index">🛒 Customer View</a></li>
                }
                else if (User.IsInRole("Staff"))
                {
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2 fw-bold" asp-controller="Staff" asp-action="Index">🧑‍💼 Staff Dashboard</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="OrderHistory" asp-action="Index">📋 Order History</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Inventory"    asp-action="Index">📦 Inventory</a></li>
                }
                else
                {
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Home"    asp-action="Index">🏠 Home</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Product" asp-action="Index">🛍️ Products</a></li>
                    <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Home"    asp-action="Privacy">🔒 Privacy</a></li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Wishlist" asp-action="Index">💖 Wishlist</a></li>
                        <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="Order"    asp-action="MyHistory">📦 My Orders</a></li>
                        <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="User"     asp-action="MyRatings">⭐ My Ratings</a></li>
                        <li class="nav-item border-bottom"><a class="nav-link px-3 py-2" asp-controller="User"     asp-action="EditProfile">👤 My Profile</a></li>
                    }
                }
            </ul>
        </div>
    </div>

    <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
    <div>

        @* TempData["Message"] alert — format: "level, text" *@
        @{
            var raw = TempData["Message"] as string;
            if (!string.IsNullOrEmpty(raw))
            {
                var parts      = raw.Split(',', 2);
                var level      = parts.Length > 0 ? parts[0].Trim().ToLower() : "info";
                var msgText    = parts.Length > 1 ? parts[1].Trim() : "";
                var alertClass = level switch
                {
                    "success"           => "alert-success",
                    "danger" or "error" => "alert-danger",
                    "warning"           => "alert-warning",
                    "info"              => "alert-info",
                    _                   => "alert-secondary"
                };
                if (!string.IsNullOrEmpty(msgText))
                {
                    <div class="alert @alertClass alert-dismissible fade show rounded-0 mb-0 border-0 border-start border-4" role="alert">
                        <div class="container">@msgText</div>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            }
        }

        @RenderSection("title", required: false)

        <main role="main" class="pb-4">
            @RenderBody()
        </main>

    </div>

    <!-- ══════════════════ FOOTER ══════════════════ -->
    <footer class="site-footer pt-5 pb-3 mt-4">
        <div class="container small">
            <div class="row g-4 mb-4">

                <div class="col-6 col-lg-3">
                    <div class="footer-heading">🌸 Quick Links</div>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a asp-controller="Home"    asp-action="Index">Home</a></li>
                        <li class="mb-1"><a asp-controller="Product" asp-action="Index">All Products</a></li>
                        <li class="mb-1"><a asp-controller="Cart"    asp-action="Index">Cart</a></li>
                        <li>            <a asp-controller="Order"   asp-action="MyHistory">My Orders</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="footer-heading">💌 Support</div>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a href="#">Contact Us</a></li>
                        <li class="mb-1"><a href="#">FAQ</a></li>
                        <li class="mb-1"><a href="#">Shipping Info</a></li>
                        <li>            <a href="#">Returns</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="footer-heading">🏢 Company</div>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a href="#">About Us</a></li>
                        <li class="mb-1"><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li class="mb-1"><a href="#">Terms of Service</a></li>
                        <li>            <a href="#">Accessibility</a></li>
                    </ul>
                </div>

                <div class="col-12 col-lg-3">
                    <div class="footer-heading">📬 Stay Connected</div>
                    <p style="color:rgba(255,255,255,.58);" class="mb-2">
                        Subscribe for new sticker drops &amp; updates!
                    </p>
                    <form class="d-flex gap-2 mb-3">
                        <input class="form-control form-control-sm rounded-pill"
                               type="email" placeholder="Your email…" />
                        <button class="btn btn-sm rounded-pill px-3 fw-bold"
                                style="background:#fff;color:#c2185b;border:none;"
                                type="button">Go</button>
                    </form>
                    <div class="d-flex gap-3" style="font-size:1.2rem;">
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                        <a href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>🌸 © @DateTime.Now.Year STICK IT — Made with love 💕</div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a href="#">Terms</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Wishlist sign-in modal -->
    <div class="modal fade" id="wishlistSignInModal" tabindex="-1"
         aria-labelledby="wishlistSignInModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0"
                     style="background:linear-gradient(135deg,#e91e8c,#ba68c8);">
                    <h5 class="modal-title text-white" id="wishlistSignInModalLabel">
                        <i class="bi bi-heart-fill me-2"></i>Save to Wishlist
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Sign in to save items to your wishlist and access them any time.</p>
                </div>
                <div class="modal-footer border-0 justify-content-start gap-2">
                    <a asp-area="Identity" asp-page="/Account/Login"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="btn btn-sm rounded-pill px-4 fw-semibold text-white"
                       style="background:linear-gradient(135deg,#e91e8c,#ba68c8);border:none;">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="btn btn-sm btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-person-plus me-1"></i>Create Account
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
