@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Antiforgery
@inject SignInManager<IdentityUser> SignInManager
@inject IAntiforgery AntiforgeryService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var csrfToken = AntiforgeryService.GetAndStoreTokens(Context).RequestToken;
    }
    <meta name="csrf-token" content="@csrfToken" />
    <link rel="icon" type="image/png" href="~/logo-stickit.png" />
    <title>@ViewData["Title"] - StickIt</title>

    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
       
        string role = "Registered user";
        if (User.IsInRole("Admin")) role = "Admin";
        else if (User.IsInRole("Manager")) role = "Manager";
        else if (User.IsInRole("Staff")) role = "Staff";
    }
    <header>
        <div class="border-bottom py-2" style="background:linear-gradient(90deg,#fce4ec,#e1f5fe);">
            <div class="container-fluid d-flex align-items-center justify-content-between">

                <!-- LEFT: HAMBURGER + LOGO -->
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-sm" type="button"
                            data-bs-toggle="offcanvas" data-bs-target="#navOffcanvas"
                            aria-controls="navOffcanvas">
                        <i class="bi bi-list fs-4"></i>
                    </button>
                    <a class="navbar-brand mb-0 h1"
                           asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="~/logo-stickit.png" style="height:85px;" />
                    </a>
                </div>

                <!-- SEARCH -->
                <div class="py-2 text-center d-none d-md-block flex-grow-1 px-4">
                    <div class="d-flex justify-content-center">
                        <div class="header-search-wrap position-relative" style="width:100%;max-width:500px;">
                            <form asp-controller="Product" asp-action="Index" method="get"
                                  class="d-flex" role="search">
                                <input id="productNameInput"
                                       type="search" name="q"
                                       class="form-control"
                                       placeholder="Search products"
                                       autocomplete="off"
                                       aria-label="Search products" />
                                <button type="submit"
                                        class="btn btn-outline-secondary ms-2">
                                    Search
                                </button>
                            </form>
                            <div id="productNameSuggestions"
                                 class="list-group position-absolute w-100 shadow-sm"
                                 style="z-index:1050;display:none;"></div>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: DASHBOARD BADGE + LOGIN + CART -->
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <a class="btn btn-sm btn-dark rounded-pill px-3"
                               asp-controller="@(User.IsInRole("Admin")   ? "Admin"   :
                                User.IsInRole("Manager") ? "Manager" :
                                User.IsInRole("Staff") ? "Staff" : "Home")"
                               asp-action="Index">
                            <span class="badge bg-light text-dark">@role</span> Dashboard
                        </a>
                    }
                    <partial name="_LoginPartial" />
                    <partial name="_CartIconPartial" />
                </div>

            </div>
        </div>
    </header>

    <!-- ══════════════════ SIDEBAR (OFFCANVAS) ══════════════════ -->
    <div class="offcanvas offcanvas-start" tabindex="-1"
         id="navOffcanvas" aria-labelledby="navOffcanvasTitle">
        <div class="offcanvas-header border-bottom">
            <a class="navbar-brand mb-0 h1"
                   asp-area="" asp-controller="Home" asp-action="Index"
                   id="navOffcanvasTitle">
                <img src="~/logo-stickit.png" style="height:35px;" />
            </a>
            <button type="button" class="btn-close"
                    data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body p-0">

            <!-- Mobile search inside sidebar -->
            <div class="px-3 py-2 border-bottom" style="background:#fce4ec;">
                <form asp-controller="Product" asp-action="Index"
                      method="get" class="d-flex gap-1">
                    <input type="search" name="q"
                           class="form-control form-control-sm rounded-pill"
                           placeholder="Search…" autocomplete="off" />
                    <button type="submit"
                            class="btn btn-sm rounded-pill px-2"
                            style="background:#e91e8c;color:#fff;border:none;">
                        🔍
                    </button>
                </form>
            </div>

            <!-- NAV LINKS -->
            <ul class="navbar-nav flex-column px-3 pt-2">
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Home" asp-action="Index">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-dark" asp-controller="Product" asp-action="Index">Shop Stickers</a>
                </li>

                @if (User.IsInRole("Admin"))
                {
                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark fw-bold"
                           asp-controller="Admin" asp-action="Index">Admin Dashboard</a>
                    </li>
                }

                @if (User.IsInRole("Staff") || User.IsInRole("Admin"))
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="OrderHistory" asp-action="Index">Order History</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Inventory" asp-action="Index">Inventory</a>
                    </li>
                }

                @if (SignInManager.IsSignedIn(User))
                {
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Cart" asp-action="Index">My Cart</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="Order" asp-action="MyHistory">My Orders</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="User" asp-action="MyRatings">My Ratings</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-dark"
                           asp-controller="User" asp-action="EditProfile">My Profile</a>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
    @RenderSection("title", required: false)

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <!-- ══════════════════ WISHLIST MODAL ══════════════════ -->
    <div class="modal fade" id="wishlistSignInModal" tabindex="-1"
         aria-labelledby="wishlistSignInModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0"
                     style="background:linear-gradient(135deg,#e91e8c,#ba68c8);">
                    <h5 class="modal-title text-white" id="wishlistSignInModalLabel">
                        <i class="bi bi-heart-fill me-2"></i>Save to Wishlist
                    </h5>
                    <button type="button" class="btn-close btn-close-white"
                            data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Sign in to save items to your wishlist and access them any time.</p>
                </div>
                <div class="modal-footer border-0 justify-content-start gap-2">
                    <a asp-area="Identity" asp-page="/Account/Login"
                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                           class="btn btn-sm rounded-pill px-4 fw-semibold text-white"
                           style="background:linear-gradient(135deg,#e91e8c,#ba68c8);border:none;">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register"
                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                           class="btn btn-sm btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-person-plus me-1"></i>Create Account
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ══════════════════ FOOTER ══════════════════ -->
    <footer class="site-footer pt-5 pb-3 mt-4"
            style="background:linear-gradient(90deg,#f3e5f5,#e1f5fe);">
        <div class="container small">
            <div class="row g-4 mb-4">

                <div class="col-6 col-lg-3">
                    <div class="footer-heading">🌸 Quick Links</div>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-1"><a asp-controller="Product" asp-action="Index">All Products</a></li>
                        <li class="mb-1"><a asp-controller="Cart" asp-action="Index">Cart</a></li>
                        <li>            <a asp-controller="Order" asp-action="MyHistory">My Orders</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="footer-heading">💌 Support</div>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a href="#">Contact Us</a></li>
                        <li class="mb-1"><a href="#">FAQ</a></li>
                        <li class="mb-1"><a href="#">Shipping Info</a></li>
                        <li>            <a href="#">Returns</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="footer-heading">🏢 Company</div>
                    <ul class="list-unstyled">
                        <li class="mb-1"><a href="#">About Us</a></li>
                        <li class="mb-1"><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li class="mb-1"><a href="#">Terms of Service</a></li>
                        <li>            <a href="#">Accessibility</a></li>
                    </ul>
                </div>

                <div class="col-12 col-lg-3">
                    <div class="footer-heading">📬 Stay Connected</div>
                    <p class="mb-2" style="color:rgba(255,255,255,.58);">
                        Subscribe for new sticker drops &amp; updates!
                    </p>
                    <form class="d-flex gap-2 mb-3">
                        <input class="form-control form-control-sm rounded-pill"
                               type="email" placeholder="Your email…" />
                        <button class="btn btn-sm rounded-pill px-3 fw-bold"
                                style="background:#fff;color:#c2185b;border:none;"
                                type="button">
                            Go
                        </button>
                    </form>
                    <div class="d-flex gap-3" style="font-size:1.2rem;">
                        <a href="#"><i class="bi bi-instagram"></i></a>
                        <a href="#"><i class="bi bi-facebook"></i></a>
                        <a href="#"><i class="bi bi-youtube"></i></a>
                        <a href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

            </div>

            <hr />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>© @DateTime.Now.Year - ELKH</div>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a href="#">Terms</a>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>