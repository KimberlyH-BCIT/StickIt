                                <div id="categoriesCollapse" class="accordion-collapse collapse" aria-labelledby="categoriesHeading" data-bs-parent="#categoriesAccordion">
                                    <div class="accordion-body p-0">
                                        <ul class="list-unstyled mb-0">
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Canadian">Canadian</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Christmas">Christmas</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Cute Animals">Cute Animals</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Easter">Easter</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Food">Food</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Halloween">Halloween</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Lunar New Year">Lunar New Year</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Nature & Floral">Nature & Floral</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="New Years Eve">New Years Eve</a></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Thanksgiving">Thanksgiving</a></li>
                                            <li><hr class="my-1"></li>
                                            <li><a class="dropdown-item py-2" asp-controller="Product" asp-action="Index" asp-route-category="Miscellaneous">Miscellaneous</a></li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </li>

                    <li class="nav-item border-bottom">
                        <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Cart" asp-action="Index">My Cart</a>
                        </li>
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Wishlist" asp-action="Index">Wishlist</a>
                        </li>
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="Order" asp-action="MyHistory">My Orders</a>
                        </li>
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="User" asp-action="MyRatings">My Ratings</a>
                        </li>
                        <li class="nav-item border-bottom">
                            <a class="nav-link text-dark px-3 py-2" asp-area="" asp-controller="User" asp-action="EditProfile">My Profile</a>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
    <div class="container">
        <div>
            @RenderSection("title",false)
        </div>
        @{
            var raw = TempData["Message"] as string;
            if (!string.IsNullOrEmpty(raw))
            {
                var parts = raw.Split(',', 2);
                var level = parts.Length > 0 ? parts[0].Trim().ToLower() : "info";
                var text = parts.Length > 1 ? parts[1].Trim() : string.Empty;
                var isCartMessage = text.Contains("cart", StringComparison.OrdinalIgnoreCase);
                var alertClass = level switch
                {
                    "success" => "alert-success",
                    "danger" or "error" => "alert-danger",
                    "warning" => "alert-warning",
                    "info" => "alert-info",
                    _ => "alert-secondary"
                };
                if (!string.IsNullOrEmpty(text))
                {
        <div class="row">
            <div class="col-12">
                <div id="globalAlert" class="alert @alertClass alert-dismissible fade show d-flex align-items-center justify-content-between" role="alert">
                    <div>
                        @if (level == "success")
                        {
                            <i class="bi bi-check-circle-fill me-2"></i>
                        }
                        <strong id="alertMessage">@text</strong>
                    </div>
                    <div class="d-flex gap-2 align-items-center">
                        @{
                            var isOnCartPage = Context.Request.Path.StartsWithSegments("/Cart");
                        }
                        @if (level == "success" && isCartMessage && !isOnCartPage)
                        {
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-sm btn-success">
                                <i class="bi bi-cart-check me-1"></i>View Cart
                            </a>
                        }
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        </div>
                }
            }
        }
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <!-- ║ Main Content Area - Dynamic page content injection point              ║ -->
        <!-- ═══════════════════════════════════════════════════════════════════════════ -->
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

    </div>

    <!-- ════════════════════════════════════════════════════════════════════════════════ -->
    <!-- ║ Site Footer - Company information, legal links, and contact details       ║ -->
    <!-- ════════════════════════════════════════════════════════════════════════════════ -->
    <footer style="background:#111;">
        <div class="container py-5 text-white-50 small">
            <div class="row g-4">

                <div class="col-6 col-lg-3">
                    <div class="text-white fw-bold mb-2">Useful links</div>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Product" asp-action="Index">All Products</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Cart" asp-action="Index">Cart</a></li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li><a class="text-white-50 text-decoration-none" asp-controller="Order" asp-action="MyHistory">My Orders</a></li>
                        }
                        else
                        {
                            <li><a class="text-white-50 text-decoration-none" asp-area="Identity" asp-page="/Account/Login">My Orders</a></li>
                        }
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="text-white fw-bold mb-2">Support</div>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Contact">Contact</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="FAQ">FAQ</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Shipping">Shipping</a></li>
                        <li><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Returns">Returns</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-3">
                    <div class="text-white fw-bold mb-2">Company</div>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="About">About</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        <li class="mb-2"><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Terms">Terms</a></li>
                        <li><a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Accessibility">Accessibility</a></li>
                    </ul>
                </div>

                <div class="col-12 col-lg-3">
                    <div class="text-white fw-bold mb-2">Stay connected</div>
                    <div class="text-white-50 mb-3">Subscribe for product drops and updates.</div>

                    <form id="newsletter-form" class="d-flex gap-2 mb-3">
                        <input id="newsletter-email" name="email" class="form-control form-control-sm" type="email" placeholder="Email address" aria-label="Email address for newsletter" autocomplete="email" required />
                        <button id="newsletter-btn" class="btn btn-warning btn-sm fw-bold" type="submit">Subscribe</button>
                    </form>

                    <div class="d-flex gap-3 fs-5">
                        <a class="text-white-50" href="#"><i class="bi bi-instagram"></i></a>
                        <a class="text-white-50" href="#"><i class="bi bi-facebook"></i></a>
                        <a class="text-white-50" href="#"><i class="bi bi-youtube"></i></a>
                        <a class="text-white-50" href="#"><i class="bi bi-tiktok"></i></a>
                    </div>
                </div>

            </div>

            <hr class="border-secondary my-4" />

            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>&copy; @DateTime.Now.Year - ELKH</div>
                <div class="d-flex gap-3">
                    <a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Privacy">Privacy</a>
                    <a class="text-white-50 text-decoration-none" asp-controller="Home" asp-action="Terms">Terms</a>
                </div>
            </div>
        </div>
    <!-- Wishlist sign-in prompt (shared across all pages; shown when a guest clicks any wishlist button) -->
    <div class="modal fade" id="wishlistSignInModal" tabindex="-1"
         aria-labelledby="wishlistSignInModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="wishlistSignInModalLabel">
                        <i class="bi bi-heart me-2"></i>Save to Wishlist
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-0">Sign in to save items to your wishlist and access them any time.</p>
                </div>
                <div class="modal-footer justify-content-start gap-2">
                    <a asp-area="Identity" asp-page="/Account/Login"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="btn btn-dark">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Sign In
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register"
                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-person-plus me-1"></i>Create an Account
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════════════════════════ -->
    <!-- ║ Scripts Section - Framework and application JavaScript loading             ║ -->
    <!-- ════════════════════════════════════════════════════════════════════════════════ -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/cart-ajax.js" asp-append-version="true"></script>
    @await Html.PartialAsync("_ValidationScriptsPartial")

    <!-- Page-specific script injection point for additional functionality -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

