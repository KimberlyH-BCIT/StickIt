<!DOCTYPE html>
<html lang="en">
<head>
    @using Microsoft.AspNetCore.Identity
    @using Microsoft.AspNetCore.Antiforgery
    @using Microsoft.AspNetCore.Http.Extensions
    @inject SignInManager<IdentityUser> SignInManager
    @inject IAntiforgery AntiforgeryService
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        // ═══════════════════════════════════════════════════════════════════════════════
        // ║ CSRF Token Generation for Client-Side AJAX Operations                      ║
        // ║ Generates antiforgery token for secure AJAX requests                       ║
        // ═══════════════════════════════════════════════════════════════════════════════

        // Generate and store a per-request antiforgery token. The token is written into
        // a <meta> tag so client-side JavaScript can read it and attach it as the
        // X-CSRF-TOKEN request header on every state-changing fetch() call. This
        // complements the standard form-field token used by Razor form tag helpers.
        var csrfToken = AntiforgeryService.GetAndStoreTokens(Context).RequestToken;
    }
    <meta name="csrf-token" content="@csrfToken" />

    @* ═══════════════════════════════════════════════════════════════════════════════ *@
    @* ║ PWA (Progressive Web App) Configuration                                      ║ *@
    @* ═══════════════════════════════════════════════════════════════════════════════ *@

    <!-- PWA Manifest -->
    <link rel="manifest" href="~/manifest.json" />

    <!-- Theme and Display Configuration -->
    <meta name="theme-color" content="#6f42c1" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="ELKH" />
    <meta name="msapplication-TileColor" content="#6f42c1" />
    <meta name="msapplication-config" content="~/browserconfig.xml" />

    <!-- Apple Touch Icons -->
    <link rel="apple-touch-icon" sizes="180x180" href="~/logo-stickit.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/logo-stickit.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/logo-stickit.png" />
    <link rel="mask-icon" href="~/logo-stickit.png" color="#6f42c1" />

    <!-- Standard favicon -->
    <link rel="icon" type="image/png" href="~/logo-stickit.png" />

    <!-- Open Graph for social sharing -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] - ELKH" />
    <meta property="og:description" content="Your favorite online sticker store with kawaii and decorative stickers" />
    <meta property="og:image" content="~/logo-stickit.png" />
    <meta property="og:url" content="@Context.Request.GetDisplayUrl()" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@ViewData["Title"] - ELKH" />
    <meta name="twitter:description" content="Your favorite online sticker store with kawaii and decorative stickers" />
    <meta name="twitter:image" content="~/logo-stickit.png" />

<title>@ViewData["Title"] - ELKH</title>
    <script type="importmap"></script>

    @* ═══════════════════════════════════════════════════════════════════════════════ *@
    @* ║ Google Fonts for Kawaii Theme                                               ║ *@
    @* ═══════════════════════════════════════════════════════════════════════════════ *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sniglet:wght@400;800&family=Nunito:ital,wght@0,200..1000;1,200..1000&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/kawaii-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ELKH.styles.css" asp-append-version="true" />

    <!-- Global Accessibility Styles -->
    <style>
        /* ═══════════════════════════════════════════════════════════════════════════ */
        /* ║ GLOBAL ACCESSIBILITY STYLES - WCAG 2.1 AA COMPLIANCE                   ║ */
        /* ═══════════════════════════════════════════════════════════════════════════ */

        /* Skip links for keyboard navigation */
        .skip-links {
            position: absolute;
            top: -40px;
            left: 6px;
            z-index: 10000;
        }

        .skip-links a {
            position: absolute;
            top: 0;
            background: #000;
            color: #fff;
            padding: 8px 16px;
            text-decoration: none;
            border-radius: 0 0 4px 4px;
            font-weight: bold;
            transition: top 0.3s;
        }

        .skip-links a:focus,
        .skip-links a:active {
            top: 0;
            position: relative;
        }

        /* Enhanced focus indicators */
        *:focus,
        *:focus-visible {
            outline: 2px solid #0066cc !important;
            outline-offset: 2px !important;
        }

        .btn:focus,
        .form-control:focus,
        .form-select:focus {
            border-color: #0066cc !important;
            box-shadow: 0 0 0 0.25rem rgba(0, 102, 204, 0.25) !important;
        }

        /* High contrast mode support */
        @@media (prefers-contrast: high) {
            .text-white-50 {
                color: #ccc !important;
            }

            .text-muted {
                color: #666 !important;
            }

            .border-secondary {
                border-color: #999 !important;
            }
        }

        /* Reduced motion support */
        @@media (prefers-reduced-motion: reduce) {
            *, *::before, *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }

        /* Screen reader only content */
        .sr-only {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0, 0, 0, 0) !important;
            white-space: nowrap !important;
            border: 0 !important;
        }

        /* Ensure sufficient color contrast */
        .text-white-50 {
            color: rgba(255, 255, 255, 0.75) !important; /* Improved contrast */
        }

        /* Focus management for dynamic content */
        [aria-live="polite"] {
            position: relative;
        }

        /* Accessible dropdown indicators */
        .dropdown-toggle::after {
            margin-left: 0.5em;
        }

        /* Mobile touch target sizes (minimum 44x44px) */
        @@media (max-width: 768px) {
            .btn, .nav-link, .dropdown-item {
                min-height: 44px;
                min-width: 44px;
                padding: 12px 16px;
            }
        }
    </style>
</head>

