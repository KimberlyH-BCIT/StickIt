        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="User" asp-action="Index">View as Customer</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Manager" asp-action="Index">View as Manager</a>
        </li>
        <li class="nav-item">
