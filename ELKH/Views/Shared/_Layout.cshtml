<!DOCTYPE html>
<html lang="en">
<head>
    @using Microsoft.AspNetCore.Identity
    @using Microsoft.AspNetCore.Antiforgery
    @inject SignInManager<IdentityUser> SignInManager
    @inject IAntiforgery AntiforgeryService
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        // ═══════════════════════════════════════════════════════════════════════════════
        // ║ CSRF Token Generation for Client-Side AJAX Operations                      ║
        // ║ Generates antiforgery token for secure AJAX requests                       ║
        // ═══════════════════════════════════════════════════════════════════════════════

        // Generate and store a per-request antiforgery token. The token is written into
        // a <meta> tag so client-side JavaScript can read it and attach it as the
        // X-CSRF-TOKEN request header on every state-changing fetch() call. This
        // complements the standard form-field token used by Razor form tag helpers.
        var csrfToken = AntiforgeryService.GetAndStoreTokens(Context).RequestToken;
    }
    <meta name="csrf-token" content="@csrfToken" />
    <link rel="icon" type="image/png" href="~/logo-stickit.png" />
<title>@ViewData["Title"] - ELKH</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ELKH.styles.css" asp-append-version="true" />
</head>

<body>
<header class="site-header bg-white box-shadow mb-3">

    @* â‘  Top bar: brand + login greeting *@
    <div class="header-top border-bottom py-2">
        <div class="container-fluid d-flex align-items-center justify-content-between flex-wrap gap-2">
            <a class="navbar-brand mb-0 h1" asp-area="" asp-controller="Home" asp-action="Index">ELKH</a>
            <div class="d-flex align-items-center flex-wrap gap-2">
                <partial name="_LoginPartial" />
                <partial name="_CartIconPartial" />
            </div>
        </div>
    </div>

        @* â‘¡ Search bar centered *@
        <div class="header-search py-2">
            <div class="container-fluid d-flex justify-content-center">
                <div class="header-search-wrap position-relative">
                    <form asp-controller="Product" asp-action="Index" method="get" class="d-flex" role="search">
                        <input id="productNameInput"
                               type="search"
                               name="search"
                               class="form-control"
                               placeholder="Search products"
                               autocomplete="off"
                               aria-label="Search products" />
                        <button type="submit" class="btn btn-outline-secondary ms-2">Search</button>
                    </form>
                    <div id="productNameSuggestions"
                         class="list-group position-absolute w-100 shadow-sm"
                         style="z-index:1050;display:none;"></div>
                </div>
            </div>
        </div>

        @* â‘¢ Nav strip â€” sits at the bottom of the header, separated by border-top *@
        <nav class="header-nav border-top">
            <div class="container-fluid d-flex align-items-center">
                <button class="nav-hamburger flex-shrink-0 me-2"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#navOffcanvas"
                        aria-controls="navOffcanvas"
                        aria-label="Open navigation menu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path fill-rule="evenodd" d="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5zm0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5z"/>
                    </svg>
</button>
@if (User.IsInRole("Admin"))
{
