@model ELKH.ViewModels.ProductSortingVM

@*
╔==================================================================================╗
║ Product Sorting Controls Partial View Component                                  ║
║ Provides reusable sorting buttons with active state highlighting               ║
╚==================================================================================╝
*@

@{
    // Helper methods for dynamic URL generation maintaining current state
    string SortLink(string sortKey) =>
        Url.Action("Index", "Product", new { search = Model.Search, categoryId = Model.CategoryId, page = 1, sort = sortKey }) ?? "#";

    string BtnClass(string sortKey) =>
        Model.CurrentSort == sortKey
            ? "tab-kawaii active"
            : "tab-kawaii";
}

<span id="sorting-controls-heading" class="sr-only">Product sorting options</span>
<div class="tab-row" role="group" aria-label="Product sorting controls" aria-describedby="sorting-controls-heading">
    <span class="hierarchy-tertiary align-self-center me-1" aria-hidden="true">Sort:</span>

    <a href="@SortLink("name_asc")"
       class="@BtnClass("name_asc")"
       role="button"
       aria-pressed="@(Model.CurrentSort == "name_asc" ? "true" : "false")"
       aria-label="Sort products by name from A to Z">
        Name A &rarr; Z
    </a>
    <a href="@SortLink("name_desc")"
       class="@BtnClass("name_desc")"
       role="button"
       aria-pressed="@(Model.CurrentSort == "name_desc" ? "true" : "false")"
       aria-label="Sort products by name from Z to A">
        Name Z &rarr; A
    </a>
    <a href="@SortLink("price_low")"
       class="@BtnClass("price_low")"
       role="button"
       aria-pressed="@(Model.CurrentSort == "price_low" ? "true" : "false")"
       aria-label="Sort products by price from low to high">
        Price Low &rarr; High
    </a>
    <a href="@SortLink("price_high")"
       class="@BtnClass("price_high")"
       role="button"
       aria-pressed="@(Model.CurrentSort == "price_high" ? "true" : "false")"
       aria-label="Sort products by price from high to low">
        Price High &rarr; Low
    </a>
    <a href="@SortLink("newest")"
       class="@BtnClass("newest")"
       role="button"
       aria-pressed="@(Model.CurrentSort == "newest" ? "true" : "false")"
       aria-label="Sort products by newest arrivals first">
        Newest First
    </a>
    <a href="@SortLink("oldest")"
       class="@BtnClass("oldest")"
       role="button"
       aria-pressed="@(Model.CurrentSort == "oldest" ? "true" : "false")"
       aria-label="Sort products by oldest first">
        Oldest First
    </a>
</div>
