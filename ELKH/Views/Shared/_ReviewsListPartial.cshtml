@model IEnumerable<ELKH.Models.ProductRatingModel>

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

<div>
    <h4 class="font-heading">Customer Reviews</h4>
    @if (!Model.Any())
    {
        <p class="hierarchy-secondary">No reviews yet.</p>
    }
    else
    {
        foreach (var r in Model.OrderByDescending(r => r.RatedTime))
        {
            if (!r.Approved)
            {
                // show only to moderators/admins
                if (SignInManager.IsSignedIn(User) && (User.IsInRole("Moderator") || User.IsInRole("Admin")))
                {
                    <div class="kawaii-card surface-butter p-3 mb-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <strong class="font-heading">Rating: @r.Rating / 5</strong>
                            <partial name="_Badge" model="@(new ELKH.ViewModels.BadgeVM { Text = "Pending", Type = "hot" })" />
                        </div>
                        <p class="hierarchy-secondary">@r.Description</p>
                        <small class="hierarchy-tertiary">@r.RatedTime.ToLocalTime().ToString("g")</small>
                        <div class="mt-2 d-flex gap-2">
                            <form asp-controller="Moderation" asp-action="Approve" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.PkRatingId" />
                                <button class="btn-kawaii btn-primary-kawaii btn-sm">Approve</button>
                            </form>
                            <form asp-controller="Moderation" asp-action="Flag" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@r.PkRatingId" />
                                <input type="hidden" name="note" value="Flagged by moderator" />
                                <button class="btn-kawaii btn-secondary-kawaii btn-sm">Flag</button>
                            </form>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="kawaii-card p-3 mb-3">
                    <strong class="font-heading">Rating: @r.Rating / 5</strong>
                    <p class="hierarchy-secondary">@r.Description</p>
                    <small class="hierarchy-tertiary">@r.RatedTime.ToLocalTime().ToString("g")</small>
                    @if (r.IsFlagged)
                    {
                        <div class="mt-2">
                            <partial name="_Badge" model="@(new ELKH.ViewModels.BadgeVM { Text = "Flagged for moderation", Type = "sale" })" />
                        </div>
                    }
                </div>
            }
        }
    }
</div>
