@model IEnumerable<ELKH.Models.WishListItemModel>

@{
    ViewData["Title"] = "My Wishlist - Saved Products";
}

<!-- Skip Links for Keyboard Navigation -->
<nav class="skip-links sr-only-focusable mb-2" aria-label="Skip navigation">
    <a href="#wishlist-heading" class="skip-link btn btn-primary">Skip to wishlist</a>
    <a href="#wishlist-sorting" class="skip-link btn btn-primary">Skip to sorting options</a>
    <a href="#wishlist-items" class="skip-link btn btn-primary">Skip to wishlist items</a>
</nav>

<main role="main" aria-labelledby="wishlist-heading">
    <header class="wishlist-header mb-4">
        <h1 id="wishlist-heading" class="fw-bold">
            <i class="bi bi-heart-fill text-danger me-2" aria-hidden="true"></i>
            My Wishlist
        </h1>
        <p class="text-muted mb-0">Your saved favorite products for later shopping</p>
    </header>

    <!-- Sorting Controls with Enhanced Accessibility -->
    <section class="sorting-controls mb-4" aria-labelledby="sorting-heading" id="wishlist-sorting">
        <h2 id="sorting-heading" class="sr-only">Wishlist sorting options</h2>

        <div class="card bg-light">
            <div class="card-body py-3">
                <div class="d-flex align-items-center gap-2" role="group" aria-label="Sort wishlist items">
                    <span class="text-muted small me-2" id="sort-label">Sort by:</span>
                    <a class="btn btn-sm btn-outline-primary" 
                       asp-action="Index" 
                       asp-route-sort="date_desc"
                       role="button"
                       aria-describedby="sort-label"
                       aria-label="Sort wishlist items by newest first">
                        <i class="bi bi-sort-down-alt me-1" aria-hidden="true"></i>
                        Newest
                    </a>
                    <a class="btn btn-sm btn-outline-primary" 
                       asp-action="Index" 
                       asp-route-sort="date_asc"
                       role="button"
                       aria-describedby="sort-label"
                       aria-label="Sort wishlist items by oldest first">
                        <i class="bi bi-sort-up me-1" aria-hidden="true"></i>
                        Oldest
                    </a>
                </div>
            </div>
        </div>
    </section>

@if (!Model.Any())
{
    var emptyWishlistVM = new ELKH.ViewModels.EmptyStateCardVM
    {
        Title = "Your Wishlist is Empty",
        Description = "Save your favorite stickers to your wishlist and shop them later!",
        Icon = "heart",
        IconType = "bootstrap",
        ActionText = "Browse Products",
        ActionController = "Product",
        ActionAction = "Index",
        ActionIcon = "grid-3x3-gap",
        ActionButtonClass = "btn btn-primary"
    };

    <section aria-labelledby="empty-wishlist-heading" id="wishlist-items">
        <h2 id="empty-wishlist-heading" class="sr-only">Empty wishlist message</h2>
        @await Html.PartialAsync("_EmptyStateCardPartial", emptyWishlistVM)
    </section>
}
else
{
    <!-- Wishlist Items with Enhanced Accessibility -->
    <section aria-labelledby="wishlist-items-heading" id="wishlist-items">
        <h2 id="wishlist-items-heading" class="sr-only">
            Wishlist Items - @Model.Count() @(Model.Count() == 1 ? "product" : "products") saved
        </h2>

        <!-- Results Summary -->
        <div class="wishlist-summary mb-3" role="status" aria-live="polite">
            <p class="text-muted small mb-0">
                <strong>@Model.Count()</strong> @(Model.Count() == 1 ? "product" : "products") in your wishlist
            </p>
        </div>

        <!-- Bulk Actions (Optional Enhancement for Future) -->
        <div class="bulk-actions mb-3" style="display: none;" role="group" aria-label="Bulk wishlist actions">
            <button type="button" class="btn btn-sm btn-outline-danger" id="bulk-remove-btn" disabled>
                <i class="bi bi-trash me-1" aria-hidden="true"></i>
                Remove Selected
            </button>
            <button type="button" class="btn btn-sm btn-outline-primary" id="select-all-btn">
                <i class="bi bi-check-all me-1" aria-hidden="true"></i>
                Select All
            </button>
        </div>

        <div class="row g-3" 
             role="list" 
             aria-label="Wishlist products grid with @Model.Count() items">
            @foreach (var item in Model)
            {
                var p = item.Product;
                <div class="col-md-6 col-lg-4" role="listitem">
                    <article class="card h-100 shadow-sm wishlist-item" 
                             aria-labelledby="product-title-@p.PkProductId"
                             data-product-id="@p.PkProductId">

                        <!-- Product Image Section -->
                        <div class="card-img-top-container position-relative" style="height: 200px; overflow: hidden;">
                            @{
                                var firstImage = p.ProductImage?.FirstOrDefault();
                                var imageUrl = firstImage?.ProductImageURL ?? "";
                            }
                            @if (!string.IsNullOrEmpty(imageUrl))
                            {
                                <img src="@imageUrl" 
                                     alt="@p.Name - Product image" 
                                     class="card-img-top w-100 h-100"
                                     style="object-fit: cover;"
                                     loading="lazy" />
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center h-100 bg-light">
                                    <i class="bi bi-image text-muted" style="font-size: 3rem;" aria-hidden="true"></i>
                                    <span class="sr-only">No image available for @p.Name</span>
                                </div>
                            }

                            <!-- Heart Icon Overlay -->
                            <div class="position-absolute top-0 end-0 p-2">
                                <span class="badge bg-danger" aria-label="Product is in your wishlist">
                                    <i class="bi bi-heart-fill" aria-hidden="true"></i>
                                </span>
                            </div>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <header class="mb-3">
                                <h3 class="card-title mb-2 h5" id="product-title-@p.PkProductId">
                                    <a href="@Url.Action("Details", "Product", new { id = p.PkProductId })" 
                                       class="text-decoration-none"
                                       aria-label="View details for @p.Name">
                                        @p.Name
                                    </a>
                                </h3>
                                <p class="card-text text-muted small mb-2">@p.Description</p>
                            </header>

                            <!-- Price Information -->
                            <div class="price-section mb-3" role="group" aria-labelledby="price-info-@p.PkProductId">
                                <div id="price-info-@p.PkProductId" class="sr-only">Price information</div>
                                <p class="card-text mb-0">
                                    <strong class="text-success fs-6" aria-label="Price @p.Price.ToString("C")">
                                        @p.Price.ToString("C")
                                    </strong>
                                </p>
                            </div>

                            <!-- Date Added -->
                            <div class="date-added mb-3">
                                <p class="card-text small text-muted mb-0" 
                                   aria-label="Added to wishlist on @item.DateAdded.ToLocalTime().ToString("MMMM d, yyyy")">
                                    <i class="bi bi-calendar-plus me-1" aria-hidden="true"></i>
                                    Added @item.DateAdded.ToLocalTime().ToString("MMM d, yyyy")
                                </p>
                            </div>

                            <!-- Actions -->
                            <div class="card-actions mt-auto d-flex flex-column gap-2">
                                <!-- View Product Button -->
                                <a href="@Url.Action("Details", "Product", new { id = p.PkProductId })" 
                                   class="btn btn-primary btn-sm"
                                   aria-label="View details and purchase @p.Name">
                                    <i class="bi bi-eye me-1" aria-hidden="true"></i>
                                    View Product
                                </a>

                                <!-- Remove from Wishlist -->
                                <form method="post" 
                                      asp-action="RemoveAjax" 
                                      class="remove-from-wishlist-form" 
                                      data-product-id="@p.PkProductId"
                                      aria-label="Remove @p.Name from wishlist">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.PkProductId" />
                                    <button type="submit" 
                                            class="btn btn-outline-danger btn-sm w-100 remove-from-wishlist-button"
                                            aria-label="Remove @p.Name from your wishlist"
                                            data-product-name="@p.Name">
                                        <i class="bi bi-heart-break me-1" aria-hidden="true"></i>
                                        Remove from Wishlist
                                    </button>
                                </form>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </section>
}

<!-- Back to Shopping Link -->
<nav aria-label="Return to shopping" class="mt-4">
    <a asp-controller="Product" asp-action="Index" class="btn btn-outline-primary">
        <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>
        Back to Shop
    </a>
</nav>
</main>

<!-- Enhanced Accessibility Styles -->
<style>
    /* Skip Links for Enhanced Keyboard Navigation */
    .skip-links {
        position: relative;
        z-index: 1050;
    }

    .skip-link {
        position: absolute !important;
        left: -10000px !important;
        top: auto !important;
        width: 1px !important;
        height: 1px !important;
        overflow: hidden !important;
    }

    .skip-link:focus {
        position: static !important;
        width: auto !important;
        height: auto !important;
        overflow: visible !important;
        margin: 0 0.5rem 0.5rem 0 !important;
        padding: 0.5rem 1rem !important;
        z-index: 1051 !important;
    }

    /* Screen Reader Only but Focusable Elements */
    .sr-only-focusable:not(:focus):not(:focus-within) {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        padding: 0 !important;
        margin: -1px !important;
        overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important;
        white-space: nowrap !important;
        border: 0 !important;
    }

    /* Enhanced Focus Management for Wishlist Items */
    .wishlist-item:focus-within {
        outline: 2px solid #0d6efd;
        outline-offset: 2px;
        border-radius: 0.375rem;
    }

    /* Wishlist Card Hover and Focus States */
    .wishlist-item {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .wishlist-item:hover,
    .wishlist-item:focus-within {
        transform: translateY(-2px);
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.1) !important;
    }

    /* Reduce motion for users who prefer it */
    @@media (prefers-reduced-motion: reduce) {
        .wishlist-item {
            transition: none;
        }
        .wishlist-item:hover,
        .wishlist-item:focus-within {
            transform: none;
        }
    }

    /* Enhanced button accessibility */
    .remove-from-wishlist-button:focus {
        box-shadow: 0 0 0 0.2rem rgba(220, 53, 69, 0.25);
    }

    /* Section scroll targets */
    #wishlist-items:target,
    #wishlist-sorting:target {
        scroll-margin-top: 2rem;
    }
</style>
