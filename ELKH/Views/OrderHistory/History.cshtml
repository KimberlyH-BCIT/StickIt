@model ELKH.ViewModels.OrderHistoryVM
@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@if (TempData["Message"] is string msg)
{
    var parts = msg.Split(',', 2);
    var isSuccess = parts[0].Trim() == "success";
    var alertVM = new ELKH.ViewModels.AlertBannerVM
    {
        Message = parts[^1].Trim(),
        AlertType = isSuccess ? "alert-success" : "alert-warning",
        Icon = isSuccess ? "check-circle-fill" : "exclamation-triangle-fill",
        IconType = "bootstrap",
        IconAriaLabel = isSuccess ? "Success" : "Warning",
        Dismissible = true
    };
    @await Html.PartialAsync("_AlertBannerPartial", alertVM)
}

<header class="kawaii-hero">
    <h1 class="kawaii-cloud-title font-heading">
        <i class="bi bi-bag-check me-2" aria-hidden="true"></i>
        My Orders
    </h1>
    <p class="kawaii-subtitle">Track and manage your purchases</p>
</header>

<div class="container-kawaii">
    @if (!Model.Orders.Any())
    {
        <div class="kawaii-card text-center py-5">
            <i class="bi bi-box display-1" style="color: var(--lavender);" aria-hidden="true"></i>
            <p class="fs-5 mt-3 hierarchy-secondary">You haven't placed any orders yet.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-kawaii btn-primary-kawaii mt-2">
                <i class="bi bi-bag me-2" aria-hidden="true"></i>
                Start Shopping
            </a>
        </div>
    }
    else
    {
        <div class="kawaii-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Delivery</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            var statusBadgeType = order.OrderStatus switch
                            {
                                ELKH.Models.OrderStatus.Shipped => "hot",
                                ELKH.Models.OrderStatus.Pending => "new",
                                ELKH.Models.OrderStatus.Cancelled => "default",
                                _ => "sale"
                            };
                            var statusBadgeVM = new ELKH.ViewModels.BadgeVM
                            {
                                Text = order.OrderStatus.ToString(),
                                Type = statusBadgeType
                            };

                            var deliveryBadgeType = order.DeliveryStatus.ToString() switch
                            {
                                "Delivered" => "best",
                                "Shipped" => "hot",
                                "Processing" => "sale",
                                _ => "new"
                            };
                            var deliveryBadgeVM = new ELKH.ViewModels.BadgeVM
                            {
                                Text = order.DeliveryStatus.ToString(),
                                Type = deliveryBadgeType
                            };

                            <tr>
                                <td class="font-heading text-purple">#@order.PkOrderId</td>
                                <td class="hierarchy-tertiary">@order.CreatedAt.ToString("MMM d, yyyy")</td>
                                <td class="hierarchy-secondary">@order.OrderItems.Count item@(order.OrderItems.Count != 1 ? "s" : "")</td>
                                <td class="hierarchy-primary">$@order.TotalAmount.ToString("F2")</td>
                                <td><partial name="_Badge" model="statusBadgeVM" /></td>
                                <td><partial name="_Badge" model="deliveryBadgeVM" /></td>
                                <td class="d-flex gap-1 flex-wrap">
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.PkOrderId"
                                       class="btn-kawaii btn-secondary-kawaii btn-sm">
                                        <i class="bi bi-eye me-1" aria-hidden="true"></i>
                                        View
                                    </a>
                                    @if (order.OrderStatus == ELKH.Models.OrderStatus.Pending)
                                    {
                                        <form asp-controller="Order" asp-action="CancelOrder" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@order.PkOrderId" />
                                            <button type="submit"
                                                    class="btn-kawaii btn-outline-kawaii btn-sm"
                                                    style="border-color: #f082b0; color: #c73864;"
                                                    onclick="return confirm('Cancel order #@order.PkOrderId? This cannot be undone.')"
                                                    aria-label="Cancel order #@order.PkOrderId">
                                                <i class="bi bi-x-circle me-1" aria-hidden="true"></i>
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    @foreach (var item in order.OrderItems)
                                    {
                                        if (item.Product is not null)
                                        {
                                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemId" value="@item.FkProductId" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="btn-kawaii btn-outline-kawaii btn-sm"
                                                        title="Buy @item.Product.Name again">
                                                    <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>@item.Product.Name
                                                </button>
                                            </form>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
