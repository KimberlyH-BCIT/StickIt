@model ELKH.ViewModels.OrderHistoryVM
@{
    ViewData["Title"] = "My Orders";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string SortLink(string sortKey) =>
        Url.Action("MyHistory", "Order", new { sort = sortKey }) ?? "#";

    string BtnClass(string sortKey) =>
        Model.CurrentSort == sortKey
            ? "btn btn-sm btn-primary"
            : "btn btn-sm btn-outline-secondary";
}

@section title {
    <h1 class="fw-bold mb-4">My Orders 📦</h1>
}

<div class="container py-4">

    @if (TempData["Message"] is string msg)
{
        var parts = msg.Split(',', 2);
        var alertType = parts[0].Trim() == "success" ? "alert-success" : "alert-warning";
        <div class="alert @alertType alert-dismissible fade show" role="alert">
            @parts[^1].Trim()
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
}

    @if (!Model.Orders.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-box display-1 text-muted"></i>
            <p class="fs-5 text-muted mt-3">You haven't placed any orders yet.</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-dark mt-2">Start Shopping</a>
        </div>
    }
else
{
        @* ── Sort controls ─────────────────────────────────────────────────── *@
        <div class="card mb-3">
            <div class="card-body py-2">
                <div class="d-flex align-items-center flex-wrap gap-2">
                    <span class="text-muted small me-1">Sort by:</span>

                    <a href="@SortLink("date_desc")" class="@BtnClass("date_desc")">
                        Date <span aria-hidden="true">↓</span>
                    </a>
                    <a href="@SortLink("date_asc")" class="@BtnClass("date_asc")">
                        Date <span aria-hidden="true">↑</span>
                    </a>
                    <a href="@SortLink("total_high")" class="@BtnClass("total_high")">
                        Total High &rarr; Low
                    </a>
                    <a href="@SortLink("total_low")" class="@BtnClass("total_low")">
                        Total Low &rarr; High
                    </a>
                    <a href="@SortLink("status")" class="@BtnClass("status")">
                        Status
                    </a>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
            <tr>
                <th>Order #</th>
                <th>Date</th>
                            <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                            <th>Delivery</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
                        @foreach (var order in Model.Orders)
                        {
                            var statusBadge = order.OrderStatus switch
            {
                                "Paid" => "bg-success",
                                "Processing" => "bg-info text-dark",
                                "Shipped" => "bg-primary",
                                "Delivered" => "bg-success",
                                "Cancelled" => "bg-danger",
                                _ => "bg-secondary"
                            };
                            <tr class="align-middle">
                                <td>#@order.PkOrderId</td>
                                <td>@order.CreatedAt.ToString("MMM d, yyyy")</td>
                                <td>@order.OrderItems.Count item@(order.OrderItems.Count != 1 ? "s" : "")</td>
                                <td>$@order.TotalAmount.ToString("F2")</td>
                                <td><span class="badge @statusBadge">@order.OrderStatus</span></td>
                                <td><span class="text-muted small">@order.DeliveryStatus</span></td>
                                <td class="d-flex gap-1 flex-wrap">
                                    <a asp-controller="Order" asp-action="Details" asp-route-id="@order.PkOrderId"
                                       class="btn btn-sm btn-outline-dark">View</a>
                                    @foreach (var item in order.OrderItems)
                                    {
                                        if (item.Product is not null)
                                        {
                                            <form asp-controller="Cart" asp-action="AddToCart" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="itemId"   value="@item.FkProductId" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary"
                                                        title="Buy @item.Product.Name again">
                                                    <i class="bi bi-arrow-repeat me-1"></i>@item.Product.Name
                                                </button>
                                            </form>
                                            @if (order.DeliveryStatus == "Delivered" || order.DeliveryStatus == "Shipped")
                                            {
                                                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.FkProductId" asp-fragment="reviews"
                                                   class="btn btn-sm btn-outline-primary"
                                                   title="Leave a review for @item.Product.Name">
                                                    <i class="bi bi-star me-1"></i>Review
                                                </a>
                                            }
                                        }
                                    }
                                </td>
                </tr>
            }
        </tbody>
    </table>
            </div>
        </div>
}
</div>
