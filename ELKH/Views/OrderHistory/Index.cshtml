@model List<OrderDetailsVM>

@section title{
    <h3>Order Managemnt</h3>
}

<table>
    <thead>
        <tr>
            <th>Order Id</th>
            <th>User Email</th>
            <th>Delivery Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var order in Model)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.UserEmail</td>
                <td>@order.DeliveryStatus</td>
                <td><a asp-controller="OrderHistory" asp-action="OrderDetails"  asp-route-orderId="@order.OrderId">Detail</a></td>
            </tr>
        }
    </tbody>
</table>