@model List<OrderDetailsVM>
@{
    ViewData["Title"] = "Order Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string[] statusOptions = ["Pending", "Processing", "Shipped", "Delivered", "Cancelled"];
}

@if (TempData["Message"] is string msg)
{
    var parts     = msg.Split(',', 2);
    var isSuccess = parts[0].Trim() == "success";
    var alertVM = new ELKH.ViewModels.AlertBannerVM
    {
        Message = parts[^1].Trim(),
        AlertType = isSuccess ? "alert-success" : "alert-warning",
        Icon = isSuccess ? "check-circle-fill" : "exclamation-triangle-fill",
        IconType = "bootstrap",
        IconAriaLabel = isSuccess ? "Success" : "Warning",
        Dismissible = true
    };
    @await Html.PartialAsync("_AlertBannerPartial", alertVM)
}

<header class="kawaii-hero">
    <h1 class="kawaii-cloud-title font-heading">
        <i class="bi bi-clipboard-check me-2" aria-hidden="true"></i>
        Order Management
    </h1>
</header>

<div class="container-kawaii">
    <div class="kawaii-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Delivery Status</th>
                        <th>Update Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="font-heading text-purple">#@order.OrderId</td>
                            <td class="hierarchy-tertiary">@order.UserEmail</td>
                            <td>
                                @{
                                    var badgeType = order.DeliveryStatus switch
                                    {
                                        "Delivered" => "best",
                                        "Shipped" => "hot",
                                        "Processing" => "sale",
                                        "Pending" => "new",
                                        _ => "default"
                                    };
                                    var badgeVM = new ELKH.ViewModels.BadgeVM
                                    {
                                        Text = order.DeliveryStatus,
                                        Type = badgeType
                                    };
                                }
                                <partial name="_Badge" model="badgeVM" />
                            </td>
                            <td>
                                <form asp-action="UpdateDeliveryStatus" method="post"
                                      class="d-flex gap-2 align-items-center">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <select name="deliveryStatus" class="input-kawaii form-select form-select-sm" style="width:auto;">
                                        @foreach (var s in statusOptions)
                                        {
                                            @if (s == order.DeliveryStatus)
                                            {
                                                <option value="@s" selected>@s</option>
                                            }
                                            else
                                            {
                                                <option value="@s">@s</option>
                                            }
                                        }
                                    </select>
                                    <button type="submit" class="btn-kawaii btn-primary-kawaii btn-sm">
                                        <i class="bi bi-check-lg me-1" aria-hidden="true"></i>
                                        Update
                                    </button>
                                </form>
                            </td>
                            <td>
                                <a asp-action="OrderDetails" asp-route-orderId="@order.OrderId"
                                   class="btn-kawaii btn-secondary-kawaii btn-sm">
                                    <i class="bi bi-eye me-1" aria-hidden="true"></i>
                                    Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
