@model PagedResult<OrderDetailsVM>

<nav>
    <ul class="pagination justify-content-center mt-3">
        @for( int i = 1; i<=Model.AllPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "") ">
                <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
            </li>
        }
        <form asp-action="Index" method="get" class="form-inline">
            <div class="form-group">
                @* Name MUST match the parameter name in the controller (searchString) *@
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control" placeholder="Search products..." />
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Clear</a>
            </div>
        </form>
        <a class="btn btn-outline-secondary mb-3" asp-controller="Staff" asp-action="Index">Go Back To Dashboard</a>
    </ul>
</nav>


<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>Order Id</th>
            <th>User Email</th>
            <th>Delivery Status</td>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach(var order in Model.Items)
        {
            <tr>
                <td>@order.OrderId</td>
                <td>@order.UserEmail</td>
                <td>@order.DeliveryStatus</td>
                <td>
                        <a class="btn btn-sm btn-outline-primary rounded-pill px-3" asp-controller="OrdersHistoryStaff" asp-action="OrderDetail" asp-route-orderId="@order.OrderId">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>