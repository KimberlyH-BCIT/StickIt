@using ELKH.Models
@model PagedResult<OrderDetailsVM>

<div class="container mt-4">
    <header class="kawaii-hero text-center mb-4">
        <h1 class="kawaii-cloud-title font-heading">
            <i class="bi bi-clock-history me-2" aria-hidden="true"></i>
            Order History
        </h1>
        <p class="hierarchy-tertiary">Manage and review all processed customer orders</p>
    </header>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a class="btn-kawaii btn-secondary-kawaii btn-sm radius-pill" asp-controller="Staff" asp-action="Index">
            ← Back To Dashboard
        </a>
    </div>

    <div class="kawaii-card mb-4">
        <div class="card-body">
            <form asp-action="Index" method="get" class="d-flex justify-content-center mb-3">
                @* FIXED: Use .ToString() for hidden input *@
                <input type="hidden" name="status" value="@ViewBag.CurrentStatus?.ToString()" />

                <div class="input-group" style="max-width:450px;">
                    <input type="text"
                           name="searchString"
                           value="@ViewBag.SearchString"
                           class="input-kawaii rounded-start-pill"
                           placeholder="Search by Email or Order ID..." />
                    <button type="submit" class="btn-kawaii btn-primary-kawaii px-4">
                        Search
                    </button>
                    <a asp-action="Index" class="btn-kawaii btn-outline-kawaii rounded-end-pill">Clear</a>
                </div>
            </form>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="small font-heading hierarchy-tertiary">Filter Status:</span>
                    <div class="btn-group" role="group">
                        <a asp-action="Index"
                           asp-route-searchString="@ViewBag.SearchString"
                           class="btn-kawaii btn-sm @(ViewBag.CurrentStatus == null ? "btn-secondary-kawaii" : "btn-outline-kawaii")">All</a>

                        @* FIXED: Pass specific Enum values as strings for the route *@
                        <a asp-action="Index"
                               asp-route-status="@DeliveryStatus.Pending"
                               asp-route-searchString="@ViewBag.SearchString"
                               class="btn-kawaii btn-sm @(ViewBag.CurrentStatus == DeliveryStatus.Pending ? "btn-primary-kawaii" : "btn-outline-kawaii")">
                            Pending <span class="badge-mini bg-dark ms-1">@ViewBag.PendingOrders</span>
                        </a>

                        <a asp-action="Index"
                               asp-route-status="@DeliveryStatus.Delivered"
                               asp-route-searchString="@ViewBag.SearchString"
                               class="btn-kawaii btn-sm @(ViewBag.CurrentStatus == DeliveryStatus.Delivered ? "btn-primary-kawaii" : "btn-outline-kawaii")">
                            Delivered <span class="badge-mini bg-dark ms-1">@ViewBag.DeliveredOrders</span>
                        </a>

                        <a asp-action="Index"
                               asp-route-status="@DeliveryStatus.Cancelled"
                               asp-route-searchString="@ViewBag.SearchString"
                               class="btn-kawaii btn-sm @(ViewBag.CurrentStatus == DeliveryStatus.Cancelled ? "btn-primary-kawaii" : "btn-outline-kawaii")">
                            Cancelled <span class="badge-mini bg-dark ms-1">@ViewBag.CancelledOrders</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="kawaii-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-4">Order ID</th>
                            <th>User Email</th>
                            <th>Delivery Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            @foreach (var order in Model.Items)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">#@order.OrderId</td>
                                    <td>@order.UserEmail</td>
                                    <td>
                                        @* FIXED: Compare against Enum strings or the Enum itself *@
                                        @if (order.DeliveryStatus == DeliveryStatus.Delivered.ToString())
                                        {
                                            <partial name="_Badge" model="@(new ELKH.ViewModels.BadgeVM { Text = "Delivered", Type = "best" })" />
                                        }
                                        else if (order.DeliveryStatus == DeliveryStatus.Cancelled.ToString())
                                        {
                                            <partial name="_Badge" model="@(new ELKH.ViewModels.BadgeVM { Text = "Cancelled", Type = "sale" })" />
                                        }
                                        else
                                        {
                                            <partial name="_Badge" model="@(new ELKH.ViewModels.BadgeVM { Text = order.DeliveryStatus, Type = "new" })" />
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <a class="btn-kawaii btn-primary-kawaii btn-sm radius-pill"
                                               asp-controller="OrdersHistoryStaff"
                                               asp-action="OrderDetail"
                                               asp-route-orderId="@order.OrderId">
                                            View Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">No orders found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <nav aria-label="Order history pagination" class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.AllPages; i++)
            {
                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-page="@i"
                       asp-route-searchString="@ViewBag.SearchString"
                       asp-route-status="@ViewBag.CurrentStatus?.ToString()">@i</a>
                </li>
            }
        </ul>
    </nav>
</div>
