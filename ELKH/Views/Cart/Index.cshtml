@model ELKH.ViewModels.CartVM
@{
    ViewData["Title"] = "Your Cart";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var totalQuantity = Model.Items.Sum(i => i.Quantity);
}

@section title {
    <h1 class="fw-bold mb-4">Your Cart 🛒</h1>
}

<div class="container py-4" data-cart-count="@totalQuantity">

    @if (Model.IsEmpty)
    {
        <div class="text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <p class="fs-5 text-muted mt-3">Your cart is empty.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Product" asp-action="Index" class="btn btn-dark mt-2">Shop Stickers</a>
            }
else
{
                <p class="text-muted">
                    <a asp-area="Identity" asp-page="/Account/Login">Log in</a> to start shopping.
                </p>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-borderless mb-0">
                            <thead class="table-light">
            <tr>
                <th>Product</th>
                                    <th class="text-center">Price</th>
                                    <th class="text-center">Qty</th>
                                    <th class="text-end">Total</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
                                @foreach (var item in Model.Items)
            {
                                    <tr class="align-middle">
                    <td>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@item.ImageUrl" alt="@item.ProductName"
                                                         style="width:50px;height:50px;object-fit:contain;" />
                                                }
                                                else
                                                {
                                                    <div style="width:50px;height:50px;" class="bg-light rounded d-flex align-items-center justify-content-center">
                                                        <i class="bi bi-image text-muted"></i>
                                                    </div>
                                                }
                                                <span class="fw-semibold">@item.ProductName</span>
                                            </div>
                                        </td>
                                        <td class="text-center">$@item.UnitPrice.ToString("F2")</td>
                                        <td class="text-center" style="width:140px;">
                                            <form asp-controller="Cart" asp-action="Update" method="post" class="d-flex gap-1">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="cartId" value="@item.CartItemId" />

                                                <input type="number"
                                                       name="quantity"
                                                       value="@item.Quantity"
                                                       min="1"
                                                       step="1"
                                                       class="form-control form-control-sm text-center"
                                                       style="width:70px;" />

                                                
                                                

                                                
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Reset to 1"
                                                        onclick="this.form.quantity.value = 1; this.form.submit();">
                                                    ↻
                                                </button>
                                            </form>
                                        </td>
                                        <td class="text-end fw-bold">$@item.LineTotal.ToString("F2")</td>
                                        <td class="text-end">
                                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="cartId" value="@item.CartItemId" />
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger d-inline-flex align-items-center justify-content-center"
                                                        style="width:32px;height:32px;border-radius:999px;line-height:1;"
                                                        title="Remove">
                                                    ×
                                                </button>
                                            </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
                    </div>
                </div>

                <div class="mt-2">
                    <form asp-controller="Cart" asp-action="Clear" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm"
                                onclick="return confirm('Clear your entire cart?')">
                            <i class="bi bi-trash me-1"></i>Clear Cart
                        </button>
                    </form>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Order Summary</h5>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Subtotal</span>
                            <span>$@Model.Subtotal.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tax (12%)</span>
                            <span>$@Model.Tax.ToString("F2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Shipping</span>
                            <span>@(Model.ShippingCost == 0 ? "Free!" : "$" + Model.ShippingCost.ToString("F2"))</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between fw-bold fs-5 mb-3">
                            <span>Total</span>
                            <span>$@Model.Total.ToString("F2")</span>
                        </div>

                        <p class="text-muted small text-center mb-3">
                            <i class="bi bi-truck me-1"></i>
                            @(Model.ShippingCost == 0 ? "Free shipping!" : "Free shipping!")
                        </p>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Checkout" asp-action="Index" class="btn btn-dark w-100 btn-lg">
                                <i class="bi bi-credit-card me-2"></i>Proceed to Checkout
                            </a>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login"
                               class="btn btn-dark w-100 btn-lg">Login to Checkout</a>
                        }
                    </div>
                </div>
            </div>
        </div>
}
</div>
