@model ELKH.ViewModels.SalesVM

@{
    ViewData["Title"] = "Admin Dashboard - System Management & Analytics | Administrator Panel";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var topProducts = ViewBag.TopProducts as List<ELKH.ViewModels.TopProductVM>
                      ?? new List<ELKH.ViewModels.TopProductVM>();
}

@section title {
    <header class="mb-4">
        <h1 class="fw-bold d-flex align-items-center">
            <i class="bi bi-speedometer2 me-2" aria-hidden="true"></i>
            Administrator Dashboard
        </h1>
        <p class="text-muted mb-0">
            System management and analytics overview • @DateTime.Now.ToString("dddd, MMMM d, yyyy")
        </p>
    </header>
}

    <main class="container-fluid px-4 py-4" role="main">

        <!-- Role Navigation Shortcuts -->
        <section aria-labelledby="role-shortcuts-heading">
            <div class="d-flex justify-content-end align-items-center mb-4 flex-wrap gap-2">
                <h2 id="role-shortcuts-heading" class="sr-only">Quick role view shortcuts</h2>
                <nav aria-label="Switch to different user role views" role="group">
                    <div class="d-flex gap-2 flex-wrap">
                        <a asp-controller="Manager" 
                           asp-action="Index"
                           class="btn-kawaii btn-secondary-kawaii btn-sm radius-pill"
                           aria-label="Switch to Manager role view">
                            <i class="bi bi-briefcase me-1" aria-hidden="true"></i>Manager View
                        </a>
                        <a asp-controller="Staff" 
                           asp-action="Index"
                           class="btn-kawaii btn-secondary-kawaii btn-sm radius-pill"
                           aria-label="Switch to Staff role view">
                            <i class="bi bi-person-badge me-1" aria-hidden="true"></i>Staff View
                        </a>
                        <a asp-controller="Home" 
                           asp-action="Index"
                           class="btn-kawaii btn-secondary-kawaii btn-sm radius-pill"
                           aria-label="Switch to Customer view">
                            <i class="bi bi-person me-1" aria-hidden="true"></i>Customer View
                        </a>
                    </div>
                </nav>
            </div>
        </section>
    <!-- Main Administrative Actions -->
    <section aria-labelledby="admin-actions-heading">
        <h2 id="admin-actions-heading" class="fw-bold mb-4 h5">Main Administrative Functions</h2>
        <div class="row g-4 mb-5">

            <!-- Manage Roles -->
            <div class="col-md-4">
                <a asp-controller="AdminRole" 
                   asp-action="ListRoles" 
                   class="text-decoration-none"
                   aria-labelledby="role-management-title"
                   aria-describedby="role-management-desc">
                    @{
                        var roleCard = new ELKH.ViewModels.FeatureCardVM
                        {
                            ColumnSize = "12",
                            Title = "Manage Roles",
                            Description = "Assign and remove user roles",
                            Icon = "🔐",
                            IconType = "emoji",
                            IconWrapperClass = "admin-icon-wrap bg-primary bg-opacity-10 rounded-4 p-3",
                            Badge = "Roles & Permissions",
                            BadgeCssClass = "badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small",
                            FooterText = "Go to Role Management →",
                            FooterCssClass = "bg-primary text-white text-center py-2 rounded-bottom-4 fw-semibold small",
                            CardCssClass = "admin-card"
                        };
                    }
                    @await Html.PartialAsync("_FeatureCardPartial", roleCard)
                </a>
            </div>

            <!-- Manage Accounts -->
            <div class="col-md-4">
                <a asp-controller="Admin" 
                   asp-action="ListUsers" 
                   class="text-decoration-none"
                   aria-labelledby="user-management-title"
                   aria-describedby="user-management-desc">
                    @{
                        var accountCard = new ELKH.ViewModels.FeatureCardVM
                        {
                            ColumnSize = "12",
                            Title = "Manage Accounts",
                            Description = "View, edit, and manage all users",
                            Icon = "👤",
                            IconType = "emoji",
                            IconWrapperClass = "admin-icon-wrap bg-success bg-opacity-10 rounded-4 p-3",
                            Badge = "User Management",
                            BadgeCssClass = "badge bg-success bg-opacity-10 text-success px-3 py-1 rounded-pill small",
                            FooterText = "Go to User Accounts →",
                            FooterCssClass = "bg-success text-white text-center py-2 rounded-bottom-4 fw-semibold small",
                            CardCssClass = "admin-card"
                        };
                    }
                    @await Html.PartialAsync("_FeatureCardPartial", accountCard)
                </a>
            </div>

            <!-- Manage Sales -->
            <div class="col-md-4">
                <a asp-controller="Admin" 
                   asp-action="ManageSales" 
                   class="text-decoration-none"
                   aria-labelledby="sales-management-title"
                   aria-describedby="sales-management-desc">
                    @{
                        var salesCard = new ELKH.ViewModels.FeatureCardVM
                        {
                            ColumnSize = "12",
                            Title = "Manage Sales",
                            Description = "Daily, weekly, monthly & yearly stats",
                            Icon = "📊",
                            IconType = "emoji",
                            IconWrapperClass = "admin-icon-wrap bg-warning bg-opacity-10 rounded-4 p-3",
                            Badge = "Sales Analytics",
                            BadgeCssClass = "badge bg-warning bg-opacity-25 text-warning px-3 py-1 rounded-pill small",
                            FooterText = "Go to Sales Dashboard →",
                            FooterCssClass = "bg-warning text-dark text-center py-2 rounded-bottom-4 fw-semibold small",
                            CardCssClass = "admin-card"
                        };
                    }
                    @await Html.PartialAsync("_FeatureCardPartial", salesCard)
                </a>
            </div>

        </div>
    </section>

    <!-- Sales Performance Analytics -->
    <section aria-labelledby="sales-analytics-heading">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h2 id="sales-analytics-heading" class="fw-bold mb-4 h5">
                    <i class="bi bi-trophy me-2 text-warning" aria-hidden="true"></i>
                    Top 5 Products by Units Sold
                </h2>

                @if (topProducts.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0"
                               role="table"
                               aria-label="Top performing products with sales statistics"
                               aria-describedby="products-table-desc">
                            <caption id="products-table-desc" class="sr-only">
                                Top 5 best-selling products ranked by units sold with revenue information
                            </caption>
                            <thead class="table-light">
                                <tr role="row">
                                    <th scope="col" style="width:60px;">Rank</th>
                                    <th scope="col" class="text-start">Product Name</th>
                                    <th scope="col">Units Sold</th>
                                    <th scope="col">Total Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{ int rank = 1; }
                                @foreach (var p in topProducts)
                                {
                                    <tr role="row">
                                        <td role="gridcell" class="text-center">
                                            @if (rank == 1)
                                            {
                                                <span class="badge bg-warning text-dark fs-6" 
                                                      role="img" 
                                                      aria-label="First place">🥇</span>
                                            }
                                            else if (rank == 2)
                                            {
                                                <span class="badge bg-secondary fs-6" 
                                                      role="img" 
                                                      aria-label="Second place">🥈</span>
                                            }
                                            else if (rank == 3)
                                            {
                                                <span class="badge bg-danger bg-opacity-75 fs-6" 
                                                      role="img" 
                                                      aria-label="Third place">🥉</span>
                                            }
                                            else
                                            {
                                                <span class="fw-semibold text-muted" aria-label="Rank @rank">@rank</span>
                                            }
                                        </td>
                                        <td role="gridcell" class="text-start fw-semibold">@p.ProductName</td>
                                        <td role="gridcell" class="text-center">
                                            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-2"
                                                  aria-label="@p.UnitsSold units sold">
                                                @p.UnitsSold units
                                            </span>
                                        </td>
                                        <td role="gridcell" 
                                            class="text-success fw-bold text-center"
                                            aria-label="Revenue @p.Revenue.ToString("C")">
                                            @p.Revenue.ToString("C")
                                        </td>
                                    </tr>
                                    rank++;
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-5" role="status">
                        <i class="bi bi-box display-1" aria-hidden="true"></i>
                        <p class="mt-2">No sales data available yet. Products will appear here once orders are placed.</p>
                    </div>
                }
            </div>
        </div>
    </section>

    <!-- System Management Tools -->
    <section aria-labelledby="system-tools-heading">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h2 id="system-tools-heading" class="fw-bold mb-1 h5">
                    <i class="bi bi-tools me-2" aria-hidden="true"></i>
                    Search Index & Cache Management
                </h2>
                <p class="text-muted small mb-4">
                    Manage the fuzzy search index and clear stale cache entries for optimal system performance.
                </p>

                <div class="row g-4">

                    <!-- Search Index Management -->
                    <div class="col-md-6">
                        <section aria-labelledby="search-index-heading">
                            <div class="p-3 bg-light rounded-3">
                                <h3 id="search-index-heading" class="fw-semibold mb-3 h6">Search Index Management</h3>
                                <p class="text-muted small">Use the tools below to manage search functionality and cache.</p>

                                <fieldset class="mb-3">
                                    <legend class="sr-only">Clear fuzzy search cache</legend>
                                    <label for="clearReason" class="form-label small fw-semibold">
                                        Clear Cache Reason
                                    </label>
                                    <input id="clearReason" 
                                           type="text" 
                                           class="form-control mb-2"
                                           placeholder="Optional reason for clearing cache"
                                           aria-describedby="clear-cache-help" />
                                    <small id="clear-cache-help" class="form-text text-muted d-block mb-2">
                                        Clearing cache will refresh search suggestions
                                    </small>
                                    <button onclick="clearCache()" 
                                            class="btn btn-danger btn-sm rounded-pill px-4"
                                            aria-describedby="clear-cache-help">
                                        <i class="bi bi-trash me-1" aria-hidden="true"></i>Clear Fuzzy Cache
                                    </button>
                                </fieldset>

                                <fieldset class="mb-3">
                                    <legend class="sr-only">Reindex full-text search</legend>
                                    <label for="reindexReason" class="form-label small fw-semibold">
                                        <span aria-hidden="true">*</span> Reindex Reason
                                    </label>
                                    <input id="reindexReason" 
                                           type="text" 
                                           class="form-control mb-2"
                                           placeholder="Required reason for reindexing"
                                           required
                                           aria-describedby="reindex-help" />
                                    <small id="reindex-help" class="form-text text-muted d-block mb-2">
                                        Reindexing will rebuild the full-text search database
                                    </small>
                                    <button onclick="reindexFTS()" 
                                            class="btn btn-primary btn-sm rounded-pill px-4"
                                            aria-describedby="reindex-help">
                                        <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Reindex FTS
                                    </button>
                                </fieldset>

                                <p class="small text-muted mb-0">
                                    View <a asp-controller="Admin" 
                                           asp-action="AuditIndex"
                                           aria-label="View system audit log for recent administrative actions">audit log</a> 
                                    for recent actions.
                                </p>
                            </div>
                        </section>
                    </div>

                    <!-- Cache Statistics -->
                    <div class="col-md-6">
                        <section aria-labelledby="cache-stats-heading">
                            <div class="p-3 bg-light rounded-3 h-100">
                                <h3 id="cache-stats-heading" class="fw-semibold mb-3 h6">Cache Statistics</h3>

                                <dl class="small">
                                    <dt>Persisted fuzzy keys:</dt>
                                    <dd>
                                        <strong id="cacheKeyCount" aria-live="polite">—</strong>
                                    </dd>

                                    <dt>Last cache clear:</dt>
                                    <dd>
                                        <strong id="lastClear" aria-live="polite">—</strong>
                                    </dd>
                                </dl>

                                <button onclick="refreshStats()" 
                                        class="btn btn-outline-secondary btn-sm rounded-pill px-4 mb-3"
                                        aria-label="Refresh cache statistics">
                                    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Refresh Stats
                                </button>

                                <div class="small">
                                    <p class="mb-1">
                                        Reindex status: <span id="reindexStatus" aria-live="polite">Loading…</span>
                                    </p>
                                    <div id="reindexMetrics" class="text-muted d-none" aria-live="polite">
                                        <p class="mb-0">Suggestion rows: <strong id="suggestionCount">—</strong></p>
                                        <p class="mb-0">Run count: <strong id="runCount">—</strong></p>
                                    </div>
                                </div>
                            </div>
                        </section>
                    </div>

                </div>

                <!-- Result toast -->
                <div id="cacheResult" 
                     class="alert mt-3 d-none" 
                     role="alert" 
                     aria-live="assertive" 
                     aria-atomic="true"></div>
            </div>
        </div>
    </section>

</main>

<style>
    /* Admin card hover and focus effects with accessibility support */
    .admin-card {
        transition: transform .18s ease, box-shadow .18s ease;
        cursor: pointer;
    }

    /* Enhanced accessibility - support both hover and focus */
    .admin-card:hover,
    .admin-card:focus-within {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
    }

    /* Focus indicators for keyboard navigation */
    .admin-card:focus-within {
        outline: 2px solid #0d6efd;
        outline-offset: 2px;
    }

    /* Remove focus outline from nested elements when parent handles it */
    .admin-card a:focus {
        outline: none;
    }

    .admin-icon-wrap {
        min-width: 64px;
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    /* Enhanced table accessibility */
    .table-hover tbody tr:hover {
        background-color: rgba(0,123,255,.075);
    }

    .table-hover tbody tr:focus-within {
        background-color: rgba(0,123,255,.1);
        outline: 2px solid #0d6efd;
        outline-offset: -2px;
    }

    /* Form accessibility enhancements */
    .form-control:focus {
        border-color: #0d6efd;
        box-shadow: 0 0 0 0.25rem rgba(13,110,253,.25);
    }

    /* Button accessibility */
    .btn:focus {
        box-shadow: 0 0 0 0.25rem rgba(13,110,253,.25);
    }

    /* Screen reader improvements */
    .sr-only {
        position: absolute !important;
        width: 1px !important;
        height: 1px !important;
        padding: 0 !important;
        margin: -1px !important;
        overflow: hidden !important;
        clip: rect(0, 0, 0, 0) !important;
        white-space: nowrap !important;
        border: 0 !important;
    }

    /* High contrast improvements */
    @@media (prefers-contrast: high) {
        .card {
            border: 2px solid #000 !important;
        }

        .btn {
            border-width: 2px !important;
        }
    }

    /* Reduced motion support */
    @@media (prefers-reduced-motion: reduce) {
        .admin-card {
            transition: none;
        }

        .admin-card:hover,
        .admin-card:focus-within {
            transform: none;
        }
    }
</style>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    // Enhanced keyboard navigation support for admin cards
    document.addEventListener('DOMContentLoaded', function() {
        // Add keyboard navigation support for admin action cards
        const adminCards = document.querySelectorAll('.admin-card');

        adminCards.forEach(card => {
            // Add keyboard support for Enter and Space keys
            card.addEventListener('keydown', function(e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    e.preventDefault();
                    const link = this.closest('a');
                    if (link) {
                        link.click();
                    }
                }
            });

            // Add focus management
            card.addEventListener('focus', function() {
                this.classList.add('admin-card-focused');
            });

            card.addEventListener('blur', function() {
                this.classList.remove('admin-card-focused');
            });
        });

        // Enhanced form validation with accessibility
        const forms = document.querySelectorAll('form');
        forms.forEach(form => {
            form.addEventListener('submit', function(e) {
                const requiredFields = this.querySelectorAll('[required]');
                let hasErrors = false;

                requiredFields.forEach(field => {
                    if (!field.value.trim()) {
                        field.setAttribute('aria-invalid', 'true');
                        field.focus();
                        hasErrors = true;
                    } else {
                        field.setAttribute('aria-invalid', 'false');
                    }
                });

                if (hasErrors) {
                    e.preventDefault();
                }
            });
        });
    });

    async function refreshStats() {
        try {
            announceToScreenReader('Refreshing cache statistics...');

            const r = await fetch('/Admin/CacheStats');
            const d = await r.json();
            if (d.success) {
                document.getElementById('cacheKeyCount').textContent = d.keys ?? 0;
                document.getElementById('lastClear').textContent = d.lastClear
                    ? new Date(d.lastClear).toLocaleString() : 'never';
                if (d.lastRun) {
                    document.getElementById('reindexStatus').textContent =
                        'Last run: ' + new Date(d.lastRun).toLocaleString() +
                        (d.lastDuration ? ' (duration: ' + d.lastDuration + ')' : '');
                }
                announceToScreenReader('Cache statistics refreshed successfully.');
            }
            const h = await (await fetch('/Admin/ReindexHealth')).json();
            if (h.success) {
                document.getElementById('suggestionCount').textContent = h.suggestionCount ?? 0;
                document.getElementById('runCount').textContent = h.runCount ?? 0;
                document.getElementById('reindexMetrics').classList.remove('d-none');
            }
        } catch(e) { 
            console.error(e);
            announceToScreenReader('Error refreshing statistics. Please try again.');
        }
    }

    async function clearCache() {
        const reasonField = document.getElementById('clearReason');
        const reason = reasonField.value;

        try {
            announceToScreenReader('Clearing fuzzy cache...');

            const r = await fetch('/Admin/ClearFuzzyCache', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ reason })
            });
            const d = await r.json();
            const message = d.success
                ? `Cache cleared successfully. ${d.cleared} entries removed.`
                : `Error clearing cache: ${d.message ?? 'Unknown error occurred.'}`;

            showResult(message, d.success);
            announceToScreenReader(message);

            if (d.success) {
                reasonField.value = ''; // Clear form on success
            }

            refreshStats();
        } catch (e) {
            const errorMessage = 'Network error occurred while clearing cache.';
            showResult(errorMessage, false);
            announceToScreenReader(errorMessage);
        }
    }

    async function reindexFTS() {
        const reasonField = document.getElementById('reindexReason');
        const reason = reasonField.value;

        if (!reason.trim()) { 
            const errorMessage = 'Reason is required for reindexing operation.';
            showResult(errorMessage, false);
            announceToScreenReader(errorMessage);
            reasonField.focus();
            reasonField.setAttribute('aria-invalid', 'true');
            return; 
        }

        reasonField.setAttribute('aria-invalid', 'false');

        try {
            announceToScreenReader('Starting full-text search reindexing...');

            const r = await fetch('/Admin/ReindexFTS', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ reason })
            });
            const d = await r.json();
            const message = d.success ? 'Reindexing completed successfully.' : 'Reindexing failed. Please check the audit log.';

            showResult(message, d.success);
            announceToScreenReader(message);

            if (d.success) {
                reasonField.value = ''; // Clear form on success
            }

            refreshStats();
        } catch (e) {
            const errorMessage = 'Network error occurred during reindexing.';
            showResult(errorMessage, false);
            announceToScreenReader(errorMessage);
        }
    }

    function showResult(msg, ok) {
        const el = document.getElementById('cacheResult');
        el.className = `alert mt-3 ${ok ? 'alert-success' : 'alert-danger'}`;
        el.textContent = msg;
        el.classList.remove('d-none');
        el.setAttribute('role', 'alert');
        el.setAttribute('aria-live', 'assertive');

        // Auto-hide after 5 seconds with accessibility consideration
        setTimeout(() => {
            el.classList.add('d-none');
            el.removeAttribute('role');
        }, 5000);
    }

    function announceToScreenReader(message) {
        const announcement = document.createElement('div');
        announcement.setAttribute('aria-live', 'polite');
        announcement.setAttribute('aria-atomic', 'true');
        announcement.className = 'sr-only';
        announcement.textContent = message;
        document.body.appendChild(announcement);

        // Clean up after announcement
        setTimeout(() => {
            document.body.removeChild(announcement);
        }, 1000);
    }

    // Load stats on page load
    document.addEventListener('DOMContentLoaded', refreshStats);
</script>
}
