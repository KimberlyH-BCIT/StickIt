<style>
    .admin-card {
        transition: transform .18s ease, box-shadow .18s ease;
        cursor: pointer;
    }
    .admin-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0,0,0,.12) !important;
    }
    .admin-icon-wrap {
        min-width: 64px;
        min-height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

@section Scripts {
<script>
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '';

    async function refreshStats() {
        try {
            const r = await fetch('/Admin/CacheStats');
            const d = await r.json();
            if (d.success) {
                document.getElementById('cacheKeyCount').textContent = d.keys ?? 0;
                document.getElementById('lastClear').textContent = d.lastClear
                    ? new Date(d.lastClear).toLocaleString() : 'never';
                if (d.lastRun) {
                    document.getElementById('reindexStatus').textContent =
                        'Last run: ' + new Date(d.lastRun).toLocaleString() +
                        (d.lastDuration ? ' (duration: ' + d.lastDuration + ')' : '');
                }
            }
            const h = await (await fetch('/Admin/ReindexHealth')).json();
            if (h.success) {
                document.getElementById('suggestionCount').textContent = h.suggestionCount ?? 0;
                document.getElementById('runCount').textContent = h.runCount ?? 0;
                document.getElementById('reindexMetrics').classList.remove('d-none');
            }
        } catch(e) { console.error(e); }
    }

    async function clearCache() {
        const reason = document.getElementById('clearReason').value;
        const r = await fetch('/Admin/ClearFuzzyCache', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ reason })
        });
        const d = await r.json();
        showResult(d.success
            ? `✅ Cleared ${d.cleared} cache entries.`
            : `❌ ${d.message ?? 'Error clearing cache.'}`, d.success);
        refreshStats();
    }

    async function reindexFTS() {
        const reason = document.getElementById('reindexReason').value;
        if (!reason.trim()) { showResult('❌ Reason is required for reindexing.', false); return; }
        const r = await fetch('/Admin/ReindexFTS', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
            body: JSON.stringify({ reason })
        });
        const d = await r.json();
        showResult(d.success ? '✅ Reindex complete.' : '❌ Reindex failed.', d.success);
        refreshStats();
    }

    function showResult(msg, ok) {
        const el = document.getElementById('cacheResult');
        el.className = `alert mt-3 ${ok ? 'alert-success' : 'alert-danger'}`;
        el.textContent = msg;
        el.classList.remove('d-none');
        setTimeout(() => el.classList.add('d-none'), 5000);
    }

    // Load stats on page load
    refreshStats();
</script>
}
<hr />

<h4>Search Index &amp; Cache Tools</h4>

<div class="mb-3">
    <h4>Search Index</h4>
    <p>Use the button below to clear fuzzy autocomplete cache.</p>
    <div class="input-group mb-2">
        <input id="clear-reason" class="form-control" placeholder="Reason for clearing (optional)" />
        <button id="clear-fuzzy-cache" class="btn btn-danger">Clear Fuzzy Cache</button>
    </div>
    <div class="input-group mb-2">
        <input id="reindex-reason" class="form-control" placeholder="Reason for reindexing (required)" />
        <button id="reindex-fts" class="btn btn-secondary">Reindex FTS</button>
    </div>
    <div id="clear-result" class="mt-2"></div>
    <p class="mt-2">View <a asp-area="Admin" asp-controller="Audit" asp-action="Index">audit log</a> for recent actions.</p>
</div>

<div class="mb-3">
    <h4>Cache Stats</h4>
    <div class="d-flex align-items-center">
        <div id="cache-stats">Loading...</div>
        <button id="refresh-stats" class="btn btn-sm btn-outline-primary ms-3">Refresh</button>
    </div>
    <div class="mt-2">
        <strong>Reindex status:</strong> <span id="reindex-status">Loading...</span>
    </div>
</div>
<div class="mb-3">
    <h4>Reindex Metrics</h4>
    <div id="reindex-metrics">Loading metrics...</div>
</div>

<script>
    // ─── Admin dashboard scripts ─────────────────────────────────────────────────
    // Three independent async handlers wired to the admin tool buttons:
    //   1. #clear-fuzzy-cache  – POST to /Admin/ClearFuzzyCache with audit reason
    //   2. loadStats()         – GET /Admin/CacheStats + GET /Admin/ReindexHealth
    //   3. #reindex-fts        – POST to /Admin/ReindexFTS with audit reason

    // Read the per-request antiforgery token written by _Layout.cshtml.
    // Every state-changing POST attaches this as X-CSRF-TOKEN so ASP.NET Core's
    // [ValidateAntiForgeryToken] attribute can verify the request origin.
    const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content ?? '';

    // ─── 1. Clear fuzzy-search cache ─────────────────────────────────────────────
    // Requires a non-empty reason field so the action is always audit-logged.
    document.getElementById('clear-fuzzy-cache')?.addEventListener('click', async function(){
        const reasonInput = document.getElementById('clear-reason');
        if (!reasonInput || !reasonInput.value.trim()) { alert('Please provide a reason for clearing the cache.'); return; }
        if (!confirm('Clear fuzzy autocomplete cache?')) return;
        const btn = this;
        btn.disabled = true;
        btn.textContent = 'Clearing...';
        try {
            const reason = document.getElementById('clear-reason').value;
            const res = await fetch('@Url.Action("ClearFuzzyCache","Admin")', { method: 'POST', headers: { 'X-Requested-With':'XMLHttpRequest', 'Content-Type':'application/json', 'X-CSRF-TOKEN': csrfToken }, body: JSON.stringify({ reason }) });
            const json = await res.json();
            if (json.success) {
                document.getElementById('clear-result').innerHTML = '<div class="alert alert-success">Cache cleared</div>';
            } else {
                document.getElementById('clear-result').innerHTML = '<div class="alert alert-warning">Failed to clear cache</div>';
            }
        } catch (e) {
            document.getElementById('clear-result').innerHTML = '<div class="alert alert-danger">Network error</div>';
        } finally { btn.disabled = false; btn.textContent = 'Clear Fuzzy Cache'; }
    });

    // ─── 2. Cache & reindex stats ────────────────────────────────────────────────
    // loadStats() performs two sequential fetches and updates three separate DOM regions:
    //   - #cache-stats      ← populated from /Admin/CacheStats
    //   - #reindex-status   ← populated from /Admin/ReindexHealth (lastRun, lastDuration)
    //   - #reindex-metrics  ← populated from /Admin/ReindexHealth (suggestionCount, runCount)
    // Errors in the secondary ReindexHealth call are silently ignored so a background
    // service restart never breaks the primary cache stats display.
    async function loadStats(){
        const container = document.getElementById('cache-stats');
        const refreshBtn = document.getElementById('refresh-stats');
        if (refreshBtn) refreshBtn.disabled = true;
        // show spinner
        if (container) container.innerHTML = '<div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Loading...</span></div> Loading...';
        try{
            const res = await fetch('@Url.Action("CacheStats","Admin")');
            if (!res.ok) {
                if (container) container.innerHTML = '<span class="text-danger">Failed to load stats</span>';
                return;
            }
            const j = await res.json();
            if (j.success) {
                const last = j.lastClear ? new Date(j.lastClear).toLocaleString() : 'never';
                container.innerHTML = `<p>Persisted fuzzy keys: <strong>${j.keys}</strong></p><p>Last clear: <strong>${last}</strong></p>`;
            } else {
                container.innerHTML = '<span class="text-danger">Failed to load stats</span>';
            }
            // also fetch reindex health from a lightweight endpoint
            try {
                const r = await fetch('@Url.Action("ReindexHealth","Admin")');
                if (r.ok) {
                    const rr = await r.json();
                    const statusEl = document.getElementById('reindex-status');
                    if (rr && rr.success) {
                        statusEl.textContent = `Last run: ${rr.lastRun || 'never'}${rr.lastDuration ? ' (duration: ' + rr.lastDuration + ')' : ''}`;
                    }

                    // metrics
                    const met = document.getElementById('reindex-metrics');
                    if (met) met.innerHTML = `<p>Suggestion rows: <strong>${rr.suggestionCount}</strong></p><p>Run count: <strong>${rr.runCount}</strong></p>`;
                }
            } catch { }
        } catch (err) {
            if (container) container.innerHTML = '<span class="text-danger">Network error</span>';
        } finally {
            if (refreshBtn) refreshBtn.disabled = false;
        }
    }
    loadStats();
    document.getElementById('refresh-stats')?.addEventListener('click', function(){ loadStats(); });
    // expose last-run stat by hitting cache-stats which includes lastClear; also add a small health display
    const healthEl = document.createElement('div');
    healthEl.id = 'reindex-health';
    document.getElementById('cache-stats')?.insertAdjacentElement('afterend', healthEl);

    // ─── 3. Trigger FTS reindex ───────────────────────────────────────────────────
    // Requires a non-empty reason field (validated by the server) so every manual
    // reindex is traceable in the audit log. On success, stats are refreshed in-place.
    document.getElementById('reindex-fts')?.addEventListener('click', async function(){
        const reasonInput = document.getElementById('reindex-reason');
        if (!reasonInput || !reasonInput.value.trim()) { alert('Please provide a reason for reindexing.'); return; }
        if (!confirm('Trigger FTS reindex?')) return;
        const btn = this;
        btn.disabled = true;
        btn.textContent = 'Reindexing...';
        try {
            const res = await fetch('@Url.Action("ReindexFTS","Admin")', { method: 'POST', headers: { 'X-Requested-With':'XMLHttpRequest', 'Content-Type':'application/json', 'X-CSRF-TOKEN': csrfToken }, body: JSON.stringify({ reason: reasonInput.value }) });
            const json = await res.json();
            if (json.success) {
                document.getElementById('clear-result').innerHTML = '<div class="alert alert-success">Reindex completed</div>';
                // refresh stats
                loadStats();
            } else {
                document.getElementById('clear-result').innerHTML = '<div class="alert alert-warning">Reindex failed</div>';
            }
        } catch (e) {
            document.getElementById('clear-result').innerHTML = '<div class="alert alert-danger">Network error</div>';
        } finally { btn.disabled = false; btn.textContent = 'Reindex FTS'; }
    });
</script>