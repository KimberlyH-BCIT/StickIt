@model ELKH.ViewModels.SalesVM

@{
    ViewData["Title"] = "Sales Dashboard - Analytics & Revenue Management | Admin Panel";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var dailyLabels   = System.Text.Json.JsonSerializer.Serialize(Model.DailyLabels);
    var dailySales    = System.Text.Json.JsonSerializer.Serialize(Model.DailySalesData);
    var weeklyLabels  = System.Text.Json.JsonSerializer.Serialize(Model.WeeklyLabels);
    var weeklySales   = System.Text.Json.JsonSerializer.Serialize(Model.WeeklySalesData);
    var monthlyLabels = System.Text.Json.JsonSerializer.Serialize(Model.MonthlyLabels);
    var monthlySales  = System.Text.Json.JsonSerializer.Serialize(Model.MonthlySalesData);
    var yearlyLabels  = System.Text.Json.JsonSerializer.Serialize(Model.YearlyLabels);
    var yearlySales   = System.Text.Json.JsonSerializer.Serialize(Model.YearlySalesData);
}

@section title {
    <header class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Admin" asp-action="Index" aria-label="Return to admin dashboard">Admin Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Sales Dashboard</li>
            </ol>
        </nav>
        <h1 class="fw-bold d-flex align-items-center">
            <i class="bi bi-graph-up me-2" aria-hidden="true"></i>
            Sales Dashboard & Analytics
        </h1>
        <p class="text-muted mb-0">
            Revenue metrics, order analysis, and performance trends across all time periods
        </p>
    </header>
}

    <main class="container-fluid px-4 py-4" role="main">

        <!-- Sales Metrics Overview -->
        <section aria-labelledby="sales-metrics-heading">
            <h2 id="sales-metrics-heading" class="fw-bold mb-4 h5">Sales Performance Overview</h2>
            <div class="row g-3 mb-4">

                <!-- Daily Sales Card -->
                <div class="col-6 col-xl-3">
                    <article class="card border-0 shadow-sm rounded-4 h-100"
                             style="border-left: 4px solid #06b6d4 !important;"
                             aria-labelledby="daily-sales-title"
                             aria-describedby="daily-sales-desc">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h3 id="daily-sales-title" class="text-muted small mb-1 h6">Today's Sales</h3>
                                    <p class="fw-bold mb-0 h4" 
                                       aria-label="Today's revenue @Model.DailyGrossSales.ToString("C")">
                                        @Model.DailyGrossSales.ToString("C")
                                    </p>
                                    <small id="daily-sales-desc" class="text-muted">
                                        @Model.DailyTotalOrders order@(Model.DailyTotalOrders != 1 ? "s" : "") today
                                    </small>
                                </div>
                                <div class="rounded-circle bg-info bg-opacity-10 p-3" aria-hidden="true">
                                    <i class="bi bi-sun fs-4 text-info"></i>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>

                <!-- Weekly Sales Card -->
                <div class="col-6 col-xl-3">
                    <article class="card border-0 shadow-sm rounded-4 h-100"
                             style="border-left: 4px solid #6366f1 !important;"
                             aria-labelledby="weekly-sales-title"
                             aria-describedby="weekly-sales-desc">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h3 id="weekly-sales-title" class="text-muted small mb-1 h6">Weekly Sales</h3>
                                    <p class="fw-bold mb-0 h4" 
                                       aria-label="This week's revenue @Model.WeeklyGrossSales.ToString("C")">
                                        @Model.WeeklyGrossSales.ToString("C")
                                    </p>
                                    <small id="weekly-sales-desc" class="text-muted">
                                        @Model.WeeklyTotalOrders order@(Model.WeeklyTotalOrders != 1 ? "s" : "") this week
                                    </small>
                                </div>
                                <div class="rounded-circle bg-primary bg-opacity-10 p-3" aria-hidden="true">
                                    <i class="bi bi-calendar-week fs-4 text-primary"></i>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>

                <!-- Monthly Sales Card -->
                <div class="col-6 col-xl-3">
                    <article class="card border-0 shadow-sm rounded-4 h-100"
                             style="border-left: 4px solid #22c55e !important;"
                             aria-labelledby="monthly-sales-title"
                             aria-describedby="monthly-sales-desc">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h3 id="monthly-sales-title" class="text-muted small mb-1 h6">Monthly Sales</h3>
                                    <p class="fw-bold mb-0 h4" 
                                       aria-label="This month's revenue @Model.MonthlyGrossSales.ToString("C")">
                                        @Model.MonthlyGrossSales.ToString("C")
                                    </p>
                                    <small id="monthly-sales-desc" class="text-muted">
                                        @Model.MonthlyTotalOrders order@(Model.MonthlyTotalOrders != 1 ? "s" : "") this month
                                    </small>
                                </div>
                                <div class="rounded-circle bg-success bg-opacity-10 p-3" aria-hidden="true">
                                    <i class="bi bi-calendar-month fs-4 text-success"></i>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>

                <!-- Yearly Sales Card -->
                <div class="col-6 col-xl-3">
                    <article class="card border-0 shadow-sm rounded-4 h-100"
                             style="border-left: 4px solid #f97316 !important;"
                             aria-labelledby="yearly-sales-title"
                             aria-describedby="yearly-sales-desc">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h3 id="yearly-sales-title" class="text-muted small mb-1 h6">Yearly Sales</h3>
                                    <p class="fw-bold mb-0 h4" 
                                       aria-label="This year's revenue @Model.YearlyGrossSales.ToString("C")">
                                        @Model.YearlyGrossSales.ToString("C")
                                    </p>
                                    <small id="yearly-sales-desc" class="text-muted">
                                        @Model.YearlyTotalOrders order@(Model.YearlyTotalOrders != 1 ? "s" : "") this year
                                    </small>
                                </div>
                                <div class="rounded-circle bg-warning bg-opacity-10 p-3" aria-hidden="true">
                                    <i class="bi bi-calendar fs-4 text-warning"></i>
                                </div>
                            </div>
                        </div>
                    </article>
                </div>

            </div>
        </section>

    <!-- Sales Analytics Charts -->
    <section aria-labelledby="charts-heading">
        <h2 id="charts-heading" class="fw-bold mb-4 h5">Revenue Trends & Analytics</h2>

        <!-- Charts Row 1: Daily + Weekly -->
        <div class="row g-4 mb-4">

            <div class="col-12 col-lg-6">
                <article class="card border-0 shadow-sm rounded-4 h-100" 
                         aria-labelledby="daily-chart-title"
                         aria-describedby="daily-chart-desc">
                    <div class="card-body p-4">
                        <h3 id="daily-chart-title" class="fw-semibold text-muted mb-3 h6">
                            <i class="bi bi-sun me-1 text-info" aria-hidden="true"></i>Daily Sales by Hour
                        </h3>
                        <p id="daily-chart-desc" class="sr-only">
                            Line chart showing today's sales performance broken down by hour
                        </p>
                        <div role="img" aria-labelledby="daily-chart-title" aria-describedby="daily-chart-summary">
                            <canvas id="dailyChart" 
                                    height="220"
                                    aria-label="Daily sales chart showing hourly revenue for today"></canvas>
                        </div>
                        <div id="daily-chart-summary" class="sr-only">
                            Chart displaying @Model.DailyTotalOrders orders totaling @Model.DailyGrossSales.ToString("C") for today
                        </div>
                    </div>
                </article>
            </div>

            <div class="col-12 col-lg-6">
                <article class="card border-0 shadow-sm rounded-4 h-100"
                         aria-labelledby="weekly-chart-title"
                         aria-describedby="weekly-chart-desc">
                    <div class="card-body p-4">
                        <h3 id="weekly-chart-title" class="fw-semibold text-muted mb-3 h6">
                            <i class="bi bi-bar-chart-line me-1 text-primary" aria-hidden="true"></i>Weekly Trends - Last 7 Days
                        </h3>
                        <p id="weekly-chart-desc" class="sr-only">
                            Bar chart showing sales performance for the past 7 days
                        </p>
                        <div role="img" aria-labelledby="weekly-chart-title" aria-describedby="weekly-chart-summary">
                            <canvas id="weeklyChart" 
                                    height="220"
                                    aria-label="Weekly sales chart showing daily revenue for past 7 days"></canvas>
                        </div>
                        <div id="weekly-chart-summary" class="sr-only">
                            Chart displaying @Model.WeeklyTotalOrders orders totaling @Model.WeeklyGrossSales.ToString("C") this week
                        </div>
                    </div>
                </article>
            </div>

        </div>

        <!-- Charts Row 2: Monthly + Yearly -->
        <div class="row g-4 mb-4">

            <div class="col-12 col-lg-6">
                <article class="card border-0 shadow-sm rounded-4 h-100"
                         aria-labelledby="monthly-chart-title"
                         aria-describedby="monthly-chart-desc">
                    <div class="card-body p-4">
                        <h3 id="monthly-chart-title" class="fw-semibold text-muted mb-3 h6">
                            <i class="bi bi-graph-up me-1 text-success" aria-hidden="true"></i>Monthly Performance - Last 12 Months
                        </h3>
                        <p id="monthly-chart-desc" class="sr-only">
                            Line chart showing monthly sales trends over the past 12 months
                        </p>
                        <div role="img" aria-labelledby="monthly-chart-title" aria-describedby="monthly-chart-summary">
                            <canvas id="monthlyChart" 
                                    height="220"
                                    aria-label="Monthly sales chart showing revenue trends over past 12 months"></canvas>
                        </div>
                        <div id="monthly-chart-summary" class="sr-only">
                            Chart displaying @Model.MonthlyTotalOrders orders totaling @Model.MonthlyGrossSales.ToString("C") this month
                        </div>
                    </div>
                </article>
            </div>

            <div class="col-12 col-lg-6">
                <article class="card border-0 shadow-sm rounded-4 h-100"
                         aria-labelledby="yearly-chart-title"
                         aria-describedby="yearly-chart-desc">
                    <div class="card-body p-4">
                        <h3 id="yearly-chart-title" class="fw-semibold text-muted mb-3 h6">
                            <i class="bi bi-calendar-range me-1 text-warning" aria-hidden="true"></i>Yearly Growth - Last 5 Years
                        </h3>
                        <p id="yearly-chart-desc" class="sr-only">
                            Bar chart showing annual sales performance over the past 5 years
                        </p>
                        <div role="img" aria-labelledby="yearly-chart-title" aria-describedby="yearly-chart-summary">
                            <canvas id="yearlyChart" 
                                    height="220"
                                    aria-label="Yearly sales chart showing annual revenue trends over past 5 years"></canvas>
                        </div>
                        <div id="yearly-chart-summary" class="sr-only">
                            Chart displaying @Model.YearlyTotalOrders orders totaling @Model.YearlyGrossSales.ToString("C") this year
                        </div>
                    </div>
                </article>
            </div>

        </div>
    </section>

    <!-- ── Top Products ──────────────────────────────────────── -->

</main>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    const dailyLabels   = @Html.Raw(dailyLabels);
    const dailySales    = @Html.Raw(dailySales);
    const weeklyLabels  = @Html.Raw(weeklyLabels);
    const weeklySales   = @Html.Raw(weeklySales);
    const monthlyLabels = @Html.Raw(monthlyLabels);
    const monthlySales  = @Html.Raw(monthlySales);
    const yearlyLabels  = @Html.Raw(yearlyLabels);
    const yearlySales   = @Html.Raw(yearlySales);

    const yAxis = { beginAtZero: true, ticks: { callback: v => '$' + v.toLocaleString() } };
    const noLegend = { legend: { display: false } };

    // Daily — bar by hour
    new Chart(document.getElementById('dailyChart'), {
        type: 'bar',
        data: {
            labels: dailyLabels,
            datasets: [{ label: 'Sales ($)', data: dailySales,
                backgroundColor: 'rgba(6,182,212,0.7)', borderColor: 'rgba(6,182,212,1)',
                borderWidth: 1, borderRadius: 5 }]
        },
        options: { responsive: true, plugins: noLegend, scales: { y: yAxis } }
    });

    // Weekly — bar
    new Chart(document.getElementById('weeklyChart'), {
        type: 'bar',
        data: {
            labels: weeklyLabels,
            datasets: [{ label: 'Sales ($)', data: weeklySales,
                backgroundColor: 'rgba(99,102,241,0.7)', borderColor: 'rgba(99,102,241,1)',
                borderWidth: 1, borderRadius: 5 }]
        },
        options: { responsive: true, plugins: noLegend, scales: { y: yAxis } }
    });

    // Monthly — line
    new Chart(document.getElementById('monthlyChart'), {
        type: 'line',
        data: {
            labels: monthlyLabels,
            datasets: [{ label: 'Sales ($)', data: monthlySales,
                fill: true, backgroundColor: 'rgba(34,197,94,0.15)',
                borderColor: 'rgba(34,197,94,1)', borderWidth: 2, tension: 0.4,
                pointBackgroundColor: 'rgba(34,197,94,1)', pointRadius: 4 }]
        },
        options: { responsive: true, plugins: noLegend, scales: { y: yAxis } }
    });

    // Yearly — bar
    new Chart(document.getElementById('yearlyChart'), {
        type: 'bar',
        data: {
            labels: yearlyLabels,
            datasets: [{ label: 'Sales ($)', data: yearlySales,
                backgroundColor: 'rgba(249,115,22,0.7)', borderColor: 'rgba(249,115,22,1)',
                borderWidth: 1, borderRadius: 5 }]
        },
        options: { responsive: true, plugins: noLegend, scales: { y: yAxis } }
    });

    // Top Products — horizontal bar
    new Chart(document.getElementById('topProductsChart'), {
        type: 'bar',
        data: {
            labels: topNames,
            datasets: [{ label: 'Units Sold', data: topUnits,
                backgroundColor: [
                    'rgba(251,191,36,0.8)', 'rgba(99,102,241,0.8)', 'rgba(34,197,94,0.8)',
                    'rgba(239,68,68,0.8)',  'rgba(20,184,166,0.8)'
                ], borderRadius: 6 }]
        },
        options: {
            indexAxis: 'y', responsive: true,
            plugins: { legend: { display: false } },
            scales: { x: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });
</script>
}
