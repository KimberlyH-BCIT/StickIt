@model ELKH.ViewModels.SalesVM

@{
    ViewData["Title"] = "Sales Dashboard - Analytics & Revenue Management | Admin Panel";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ── Dummy data fallback so the page always looks populated ──
    // Remove this block once real transactions exist in your DB.
    bool useDummy = !Model.WeeklyLabels.Any();

    List<string> dailyLabels;
    List<decimal> dailySales;
    List<string> weeklyLabels;
    List<decimal> weeklySales;
    List<string> monthlyLabels;
    List<decimal> monthlySales;
    List<string> yearlyLabels;
    List<decimal> yearlySales;
    List<ELKH.ViewModels.TopProductVM> topProducts;

    decimal dailyGross, weeklyGross, monthlyGross, yearlyGross;
    int dailyOrders, weeklyOrders, monthlyOrders, yearlyOrders, totalOrders;

    if (useDummy)
    {
        var rng = new Random(42);
        var now = DateTime.Now;

        // Daily – last 24 hours by hour
        dailyLabels = Enumerable.Range(0, 24)
            .Select(h => now.AddHours(-23 + h).ToString("HH:00")).ToList();
        dailySales = dailyLabels.Select(_ => Math.Round((decimal)(rng.NextDouble() * 400 + 50), 2)).ToList();

        // Weekly – last 7 days
        weeklyLabels = Enumerable.Range(0, 7)
            .Select(d => now.AddDays(-6 + d).ToString("ddd dd")).ToList();
        weeklySales = weeklyLabels.Select(_ => Math.Round((decimal)(rng.NextDouble() * 1200 + 300), 2)).ToList();

        // Monthly – last 12 months
        monthlyLabels = Enumerable.Range(0, 12)
            .Select(m => now.AddMonths(-11 + m).ToString("MMM yyyy")).ToList();
        monthlySales = monthlyLabels.Select(_ => Math.Round((decimal)(rng.NextDouble() * 8000 + 2000), 2)).ToList();

        // Yearly – last 5 years
        yearlyLabels = Enumerable.Range(0, 5)
            .Select(y => now.AddYears(-4 + y).Year.ToString()).ToList();
        yearlySales = yearlyLabels.Select(_ => Math.Round((decimal)(rng.NextDouble() * 60000 + 20000), 2)).ToList();

        dailyGross   = dailySales.Sum();
        weeklyGross  = weeklySales.Sum();
        monthlyGross = monthlySales.Sum();
        yearlyGross  = yearlySales.Sum();
        dailyOrders  = rng.Next(8, 30);
        weeklyOrders = rng.Next(40, 120);
        monthlyOrders = rng.Next(150, 400);
        yearlyOrders  = rng.Next(1800, 5000);
        totalOrders   = rng.Next(6000, 15000);

        topProducts = new List<ELKH.ViewModels.TopProductVM>
        {
            new() { ProductName = "Wireless Headphones",  UnitsSold = 312, Revenue = 31188m },
            new() { ProductName = "USB-C Hub",            UnitsSold = 287, Revenue = 14350m },
            new() { ProductName = "Mechanical Keyboard",  UnitsSold = 214, Revenue = 25680m },
            new() { ProductName = "Ergonomic Mouse",      UnitsSold = 198, Revenue = 9900m  },
            new() { ProductName = "Monitor Stand",        UnitsSold = 155, Revenue = 7750m  },
        };
    }
    else
    {
        dailyLabels   = Model.DailyLabels;
        dailySales    = Model.DailySalesData;
        weeklyLabels  = Model.WeeklyLabels;
        weeklySales   = Model.WeeklySalesData;
        monthlyLabels = Model.MonthlyLabels;
        monthlySales  = Model.MonthlySalesData;
        yearlyLabels  = Model.YearlyLabels   ?? new List<string>();
        yearlySales   = Model.YearlySalesData ?? new List<decimal>();
        dailyGross    = Model.DailyGrossSales;
        weeklyGross   = Model.WeeklyGrossSales;
        monthlyGross  = Model.MonthlyGrossSales;
        yearlyGross   = Model.YearlyGrossSales;
        dailyOrders   = Model.DailyTotalOrders;
        weeklyOrders  = Model.WeeklyTotalOrders;
        monthlyOrders = Model.MonthlyTotalOrders;
        yearlyOrders  = Model.YearlyTotalOrders;
        totalOrders   = Model.TotalOrdersAllTime;
        topProducts   = Model.TopProducts ?? new List<ELKH.ViewModels.TopProductVM>();
    }

    var topNames    = System.Text.Json.JsonSerializer.Serialize(topProducts.Select(p => p.ProductName).ToList());
    var topUnits    = System.Text.Json.JsonSerializer.Serialize(topProducts.Select(p => p.UnitsSold).ToList());
    var topRevenues = System.Text.Json.JsonSerializer.Serialize(topProducts.Select(p => p.Revenue).ToList());

    var jsDailyLabels   = System.Text.Json.JsonSerializer.Serialize(dailyLabels);
    var jsDailySales    = System.Text.Json.JsonSerializer.Serialize(dailySales);
    var jsWeeklyLabels  = System.Text.Json.JsonSerializer.Serialize(weeklyLabels);
    var jsWeeklySales   = System.Text.Json.JsonSerializer.Serialize(weeklySales);
    var jsMonthlyLabels = System.Text.Json.JsonSerializer.Serialize(monthlyLabels);
    var jsMonthlySales  = System.Text.Json.JsonSerializer.Serialize(monthlySales);
    var jsYearlyLabels  = System.Text.Json.JsonSerializer.Serialize(yearlyLabels);
    var jsYearlySales   = System.Text.Json.JsonSerializer.Serialize(yearlySales);
}

@section title {
    <header class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Admin" asp-action="Index" aria-label="Return to admin dashboard">Admin Dashboard</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">Sales Dashboard</li>
            </ol>
        </nav>
        <h1 class="fw-bold d-flex align-items-center">
            <i class="bi bi-graph-up me-2" aria-hidden="true"></i>
            Sales Dashboard & Analytics
        </h1>
        <p class="text-muted mb-0">
            Revenue metrics, order analysis, and performance trends across all time periods
        </p>
    </header>
}

    <!-- ── Header ── -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-0">Sales Dashboard</h2>
            <p class="text-muted small mb-0">Revenue and order metrics across all time periods.
                @if (useDummy)
                {
                    <span class="badge bg-warning text-dark ms-2">Demo data — no real transactions yet</span>
                }
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
            ← Back to Dashboard
        </a>
    </div>

    <!-- ── 4 Summary Cards ── -->
    <div class="row g-3 mb-4">

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left:4px solid #06b6d4 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Today's Sales</p>
                            <h3 class="fw-bold mb-0">$@dailyGross.ToString("N2")</h3>
                            <small class="text-muted">@dailyOrders orders today</small>
                        </div>
                        <div class="rounded-circle bg-info bg-opacity-10 p-3">
                            <i class="bi bi-sun fs-4 text-info"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left:4px solid #6366f1 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Weekly Sales</p>
                            <h3 class="fw-bold mb-0">$@weeklyGross.ToString("N2")</h3>
                            <small class="text-muted">@weeklyOrders orders this week</small>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">
                            <i class="bi bi-calendar-week fs-4 text-primary"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left:4px solid #22c55e !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Monthly Sales</p>
                            <h3 class="fw-bold mb-0">$@monthlyGross.ToString("N2")</h3>
                            <small class="text-muted">@monthlyOrders orders this month</small>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3">
                            <i class="bi bi-calendar-month fs-4 text-success"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-xl-3">
            <div class="card border-0 shadow-sm rounded-4 h-100" style="border-left:4px solid #f97316 !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <p class="text-muted small mb-1">Yearly Sales</p>
                            <h3 class="fw-bold mb-0">$@yearlyGross.ToString("N2")</h3>
                            <small class="text-muted">@yearlyOrders orders this year</small>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3">
                            <i class="bi bi-calendar fs-4 text-warning"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

            </div>
        </section>

    <!-- Sales Analytics Charts -->
    <section aria-labelledby="charts-heading">
        <h2 id="charts-heading" class="fw-bold mb-4 h5">Revenue Trends & Analytics</h2>

    <!-- ── Charts Row 1: Daily + Weekly ── -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-semibold text-muted mb-3">
                        <i class="bi bi-sun me-1 text-info"></i> Today — Sales by Hour
                    </h6>
                    <canvas id="dailyChart" height="220"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-semibold text-muted mb-3">
                        <i class="bi bi-bar-chart-line me-1 text-primary"></i> Weekly — Last 7 Days
                    </h6>
                    <canvas id="weeklyChart" height="220"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Charts Row 2: Monthly + Yearly ── -->
    <div class="row g-4 mb-4">
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-semibold text-muted mb-3">
                        <i class="bi bi-graph-up me-1 text-success"></i> Monthly — Last 12 Months
                    </h6>
                    <canvas id="monthlyChart" height="220"></canvas>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h6 class="fw-semibold text-muted mb-3">
                        <i class="bi bi-calendar-range me-1 text-warning"></i> Yearly — Last 5 Years
                    </h6>
                    <canvas id="yearlyChart" height="220"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Top 5 Products ── -->
    <div class="row g-4 mb-4">

        <!-- Table -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">🏆 Top 5 Products</h5>
                    @if (topProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:50px;">Rank</th>
                                        <th>Product</th>
                                        <th class="text-center">Units</th>
                                        <th class="text-end">Revenue</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int rank = 1; }
                                    @foreach (var p in topProducts)
                                    {
                                        <tr>
                                            <td>
                                                @if (rank == 1)     { <span>🥇</span> }
                                                else if (rank == 2) { <span>🥈</span> }
                                                else if (rank == 3) { <span>🥉</span> }
                                                else                { <span class="text-muted fw-semibold">@rank</span> }
                                            </td>
                                            <td class="fw-semibold">@p.ProductName</td>
                                            <td class="text-center">
                                                <span class="badge bg-primary bg-opacity-10 text-primary px-2">@p.UnitsSold</span>
                                            </td>
                                            <td class="text-end text-success fw-bold">$@p.Revenue.ToString("N2")</td>
                                        </tr>
                                        rank++;
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted fst-italic">No product data yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Horizontal bar chart -->
        <div class="col-12 col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4">📊 Units Sold Chart</h5>
                    <canvas id="topProductsChart" height="220"></canvas>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/chart.js"></script>
    <script src="~/js/sales-charts.js"></script>
}
<script>
    window.chartData = {
        dailyLabels: @Html.Raw(jsDailyLabels),
        dailySales: @Html.Raw(jsDailySales),
        weeklyLabels: @Html.Raw(jsWeeklyLabels),
        weeklySales: @Html.Raw(jsWeeklySales),
        monthlyLabels: @Html.Raw(jsMonthlyLabels),
        monthlySales: @Html.Raw(jsMonthlySales),
        yearlyLabels: @Html.Raw(jsYearlyLabels),
        yearlySales: @Html.Raw(jsYearlySales),
        topNames: @Html.Raw(topNames),
        topUnits: @Html.Raw(topUnits)
        };
</script>
