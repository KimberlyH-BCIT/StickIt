<div class="container mt-4 pb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-primary">All Users</h2>

        <a asp-action="Index" class="btn btn-outline-primary rounded-pill px-4">
            ← Back to Dashboard
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-4 rounded-4">
        <div class="card-body p-4">

            <form method="get" class="mb-4">
                <input type="hidden" name="roleFilter" value="@ViewBag.RoleFilter" />

                <div class="d-flex justify-content-center">
                    <div class="input-group" style="max-width:500px;">

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control rounded-start-pill"
                               placeholder="Search by email or role…" />

                        <button type="submit" class="btn btn-primary rounded-end-pill px-4">
                            Search
                        </button>

                    </div>
                </div>

            </form>


            <div class="d-flex justify-content-center flex-wrap gap-2">

                @foreach (var role in filterRoles)
                {
                    bool active = (ViewBag.RoleFilter == role) || (role == "All" && string.IsNullOrEmpty(ViewBag.RoleFilter));

                    string roleClass = role switch
                    {
                        "Admin" => "role-admin",
                        "Manager" => "role-manager",
                        "Staff" => "role-staff",
                        "Customer" => "role-customer",
                        _ => "role-none"
                    };

                    <a asp-action="ListUsers"
                       asp-route-roleFilter="@(role == "All" ? "" : role)"
                       asp-route-search="@ViewBag.Search"
                       asp-route-page="1"
                       class="role-badge @roleClass @(active ? "active-role" : "")">
                        @role
                    </a>
                }

            </div>

        </div>
    </div>



    <div class="d-flex justify-content-center">

        <div class="card shadow-sm border-0 rounded-4" style="max-width:900px;width:100%;">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover table-sm align-middle mb-0 text-center">

                        <thead class="table-light">
                            <tr>

                                <th style="width:80px;" class="ps-3">ID</th>

                                <th class="text-start">Email</th>

                                <th style="width:200px;">Roles</th>

                                <th style="width:120px;">Action</th>

                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.Any())
                            {
                                foreach (var user in Model)
                                {

                                    <tr>

                                        <td class="ps-3">
                                            <span class="text-muted small font-monospace"
                                                  title="@user.Id"
                                                  data-bs-toggle="tooltip"
                                                  style="cursor:default;">
                                                @user.Id.Substring(0, Math.Min(6, user.Id.Length))…
                                            </span>
                                        </td>


                                        <td class="text-start">@user.Email</td>


                                        <td>

                                            @{

                                                var rolePriority = new List<string> { "Admin", "Manager", "Staff", "Customer" };

                                                var sortedRoles = user.Roles
                                                .OrderBy(r => rolePriority.IndexOf(r))
                                                .ToList();

                                                string filterRole = ViewBag.RoleFilter as string;

                                                string displayRole;

                                                if (!string.IsNullOrEmpty(filterRole) && sortedRoles.Contains(filterRole))
                                                {
                                                    displayRole = filterRole;
                                                }
                                                else
                                                {
                                                    displayRole = sortedRoles.FirstOrDefault();
                                                }

                                                int extraCount = sortedRoles.Count - 1;

                                                string roleClass = displayRole switch
                                                {
                                                    "Admin" => "role-admin",
                                                    "Manager" => "role-manager",
                                                    "Staff" => "role-staff",
                                                    _ => "role-customer"
                                                };

                                            }

                                            @if (displayRole != null)
                                            {

                                                <span class="role-badge @roleClass">
                                                    @displayRole
                                                </span>

                                                @if (extraCount > 0)
                                                {
                                                    <span class="text-muted small ms-1">+@extraCount</span>
                                                }

                                            }
                                            else
                                            {
                                                <span class="role-badge role-none">No Role</span>
                                            }

                                        </td>


                                        <td>

                                            <a asp-controller="Admin"
                                               asp-action="AccountDetails"
                                               asp-route-id="@user.Id"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                                Details
                                            </a>

                                        </td>

                                    </tr>

                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <span style="font-size:2rem;">🔍</span><br />
                                        No users found matching your search.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            </div>
        </div>
    </div>



    @if (ViewBag.TotalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center flex-wrap">

                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {

                    <li class="page-item @(ViewBag.CurrentPage == i ? "active" : "")">

                        <a class="page-link rounded-pill mx-1"
                           asp-action="ListUsers"
                           asp-route-page="@i"
                           asp-route-search="@ViewBag.Search"
                           asp-route-roleFilter="@ViewBag.RoleFilter">
                            @i
                        </a>

                    </li>

                }

            </ul>

        </nav>
    }

</div>



@section Scripts {

    <script>

        document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el=>{
        new bootstrap.Tooltip(el);
        });

    </script>

