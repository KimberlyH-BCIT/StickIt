@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<header class="kawaii-hero mb-4" aria-labelledby="change-password-heading">
    <h2 id="change-password-heading" class="kawaii-cloud-title font-heading h3 mb-2">
        <i class="bi bi-shield-lock me-2" aria-hidden="true"></i>@ViewData["Title"]
    </h2>
    <p class="kawaii-subtitle mb-0">Keep your account secure by updating your password regularly.</p>
</header>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="change-password-form" method="post">
    <div asp-validation-summary="ModelOnly" class="kawaii-card surface-mint mb-4" role="alert"></div>
    <div class="form-floating mb-3">
        <input asp-for="Input.OldPassword" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Please enter your old password." />
        <label asp-for="Input.OldPassword" class="form-label"></label>
        <span asp-validation-for="Input.OldPassword" class="text-danger small"></span>
    </div>
    <div class="form-floating mb-3">
        <input asp-for="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please enter your new password." />
        <label asp-for="Input.NewPassword" class="form-label"></label>
        <span asp-validation-for="Input.NewPassword" class="text-danger small"></span>
    </div>
    <div class="form-floating mb-4">
        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Please confirm your new password." />
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn-kawaii btn-primary-kawaii btn-lg w-100">Update password</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
