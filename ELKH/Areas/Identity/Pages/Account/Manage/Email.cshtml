@page
@model EmailModel
@{
    ViewData["Title"] = "Manage Email";
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<header class="kawaii-hero mb-4" aria-labelledby="manage-email-heading">
    <h2 id="manage-email-heading" class="kawaii-cloud-title font-heading h3 mb-2">
        <i class="bi bi-envelope-paper-heart me-2" aria-hidden="true"></i>@ViewData["Title"]
    </h2>
    <p class="kawaii-subtitle mb-0">Review your current email address or switch to a new one.</p>
</header>

<partial name="_StatusMessage" for="StatusMessage" />

<form id="email-form" method="post">
    <div asp-validation-summary="All" class="kawaii-card surface-mint mb-4" role="alert"></div>
    @if (Model.IsEmailConfirmed)
    {
        <div class="form-floating mb-3 position-relative">
            <input asp-for="Email" class="form-control" placeholder="Please enter your email." disabled />
            <label asp-for="Email" class="form-label"></label>
            <span class="position-absolute top-50 end-0 translate-middle-y me-3" style="color: var(--purple); font-weight: var(--font-weight-bold);" aria-label="Email confirmed">✓</span>
        </div>
    }
    else
    {
        <div class="form-floating mb-3">
            <input asp-for="Email" class="form-control" placeholder="Please enter your email." disabled />
            <label asp-for="Email" class="form-label"></label>
            <button id="email-verification" type="submit" asp-page-handler="SendVerificationEmail" class="btn-kawaii btn-outline-kawaii btn-sm mt-2">
                <i class="bi bi-envelope me-1" aria-hidden="true"></i>Send verification email
            </button>
        </div>
    }
    <div class="form-floating mb-4">
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" aria-required="true" placeholder="Please enter new email." />
        <label asp-for="Input.NewEmail" class="form-label"></label>
        <span asp-validation-for="Input.NewEmail" class="text-danger small"></span>
    </div>
    <button id="change-email-button" type="submit" asp-page-handler="ChangeEmail" class="btn-kawaii btn-primary-kawaii btn-lg w-100">Change email</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
