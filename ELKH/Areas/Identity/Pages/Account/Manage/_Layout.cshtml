@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout !=  null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="container-kawaii py-4 py-md-5">
    <header class="kawaii-hero mb-4" aria-labelledby="account-management-heading">
        <h1 id="account-management-heading" class="kawaii-cloud-title font-heading">
            <i class="bi bi-person-gear me-2" aria-hidden="true"></i>
            My Account
        </h1>
        <p class="kawaii-subtitle">Manage your account settings</p>
    </header>

    <main id="main-content" role="main">
        <div class="row g-4 align-items-start">
            <div class="col-lg-3">
                <div class="kawaii-card h-100">
                    <nav aria-label="Account management navigation">
                        <partial name="_ManageNav" />
                    </nav>
                </div>
            </div>
            <div class="col-lg-9">
                <div class="kawaii-card h-100">
                    @RenderBody()
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}
