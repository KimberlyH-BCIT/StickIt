@page
@model RegisterModel
@{
    ViewData["Title"] = "Register - Create Your Account";
}

<div class="container my-5">
    <!-- Skip Links for Keyboard Navigation -->
    <nav class="skip-links sr-only-focusable" aria-label="Skip navigation">
        <a href="#registration-heading" class="skip-link btn btn-primary">Skip to registration form</a>
        <a href="#account-credentials" class="skip-link btn btn-primary">Skip to credentials section</a>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <main class="card shadow-sm" role="main">
                <div class="card-body p-4 p-md-5">
                    <header class="text-center mb-4">
                        <h1 class="card-title">Create Account</h1>
                        <p class="text-muted mb-0">Join our community to start shopping and track your orders</p>
                    </header>

                    <section aria-labelledby="registration-heading">
                        <h2 id="registration-heading" class="sr-only">Registration Form</h2>

                        <form id="registerForm" 
                              asp-route-returnUrl="@Model.ReturnUrl" 
                              method="post" 
                              aria-label="Account registration form"
                              novalidate>
                            <div id="registration-status" aria-live="polite" aria-atomic="true" class="sr-only"></div>

                            <div asp-validation-summary="ModelOnly" 
                                 class="alert alert-danger" 
                                 role="alert" 
                                 aria-live="assertive"
                                 aria-labelledby="validation-heading"
                                 style="display:none;">
                                <h3 id="validation-heading" class="alert-heading h6 mb-2">
                                    <i class="bi bi-exclamation-triangle-fill me-1" aria-hidden="true"></i>
                                    Please fix the following errors:
                                </h3>
                            </div>

                            <!-- Account Credentials Section -->
                            <fieldset class="mb-4" id="account-credentials">
                                <legend class="h6 text-secondary mb-3">
                                    <i class="bi bi-lock-fill me-2" aria-hidden="true"></i>
                                    Account Credentials
                                </legend>

                                <div class="form-floating mb-3">
                                    <input asp-for="Input.Email" 
                                           class="form-control" 
                                           autocomplete="username email" 
                                           aria-required="true" 
                                           aria-describedby="email-help email-validation"
                                           placeholder="name@example.com"
                                           type="email"
                                           inputmode="email" />
                                    <label asp-for="Input.Email">
                                        <span class="required-indicator" aria-label="Required field">*</span>
                                        Email Address
                                    </label>
                                    <div id="email-help" class="form-text sr-only">
                                        This will be your username for signing in
                                    </div>
                                    <span asp-validation-for="Input.Email" 
                                          id="email-validation"
                                          class="text-danger small d-block"
                                          role="alert"
                                          aria-live="polite"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3 position-relative">
                                            <input asp-for="Input.Password" 
                                                   class="form-control" 
                                                   autocomplete="new-password" 
                                                   aria-required="true" 
                                                   aria-describedby="password-help password-validation"
                                                   placeholder="Password"
                                                   type="password" />
                                            <label asp-for="Input.Password">
                                                <span class="required-indicator" aria-label="Required field">*</span>
                                                Password
                                            </label>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary position-absolute top-50 end-0 translate-middle-y me-2" 
                                                    aria-label="Show password" 
                                                    onclick="togglePassword('Input_Password', this)">
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </button>
                                            <div id="password-help" class="form-text small">
                                                Must be at least 8 characters with uppercase, lowercase, number, and special character
                                            </div>
                                            <span asp-validation-for="Input.Password" 
                                                  id="password-validation"
                                                  class="text-danger small d-block"
                                                  role="alert"
                                                  aria-live="polite"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating mb-3 position-relative">
                                            <input asp-for="Input.ConfirmPassword" 
                                                   class="form-control" 
                                                   autocomplete="new-password" 
                                                   aria-required="true" 
                                                   aria-describedby="confirm-password-help confirm-password-validation"
                                                   placeholder="Confirm Password"
                                                   type="password" />
                                            <label asp-for="Input.ConfirmPassword">
                                                <span class="required-indicator" aria-label="Required field">*</span>
                                                Confirm Password
                                            </label>
                                            <button type="button" 
                                                    class="btn btn-sm btn-outline-secondary position-absolute top-50 end-0 translate-middle-y me-2" 
                                                    aria-label="Show password confirmation" 
                                                    onclick="togglePassword('Input_ConfirmPassword', this)">
                                                <i class="bi bi-eye" aria-hidden="true"></i>
                                            </button>
                                            <div id="confirm-password-help" class="form-text small">
                                                Must match the password above
                                            </div>
                                            <span asp-validation-for="Input.ConfirmPassword" 
                                                  id="confirm-password-validation"
                                                  class="text-danger small d-block"
                                                  role="alert"
                                                  aria-live="polite"></span>
                                        </div>
                                    </div>
                                </div>
                            </fieldset>

                            <hr class="my-4" />

                            <!-- Contact Details -->
                            <h6 class="text-secondary mb-3"><i class="bi bi-person-fill me-2"></i>Personal Information</h6>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.FirstName" class="form-control" placeholder="First Name" />
                                        <label asp-for="Input.FirstName">First Name</label>
                                        <span asp-validation-for="Input.FirstName" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.LastName" class="form-control" placeholder="Last Name" />
                                        <label asp-for="Input.LastName">Last Name</label>
                                        <span asp-validation-for="Input.LastName" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Phone Number" />
                                <label asp-for="Input.PhoneNumber">Phone Number</label>
                                <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                            </div>

                            <hr class="my-4" />

                            <!-- Shipping Address -->
                            <h6 class="text-secondary mb-3"><i class="bi bi-geo-alt-fill me-2"></i>Shipping Address</h6>

                            <div class="form-floating mb-3">
                                <input asp-for="Input.Street" class="form-control" placeholder="Street Address" />
                                <label asp-for="Input.Street">Street Address</label>
                                <span asp-validation-for="Input.Street" class="text-danger small"></span>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.City" class="form-control" placeholder="City" />
                                        <label asp-for="Input.City">City</label>
                                        <span asp-validation-for="Input.City" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Province" class="form-control" placeholder="Province/State" />
                                        <label asp-for="Input.Province">Province/State</label>
                                        <span asp-validation-for="Input.Province" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.PostCode" class="form-control" placeholder="Postal Code" />
                                        <label asp-for="Input.PostCode">Postal Code</label>
                                        <span asp-validation-for="Input.PostCode" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating mb-3">
                                        <input asp-for="Input.Country" class="form-control" placeholder="Country" />
                                        <label asp-for="Input.Country">Country</label>
                                        <span asp-validation-for="Input.Country" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-4" />

                            <!-- reCAPTCHA widget -->
                            <div class="mb-4 d-flex justify-content-center">
                                <div>
                                    <div class="g-recaptcha" data-sitekey="@Model.ReCaptchaSiteKey"></div>
                                    <span class="text-danger small">@Html.ValidationMessage("ReCaptcha")</span>
                                </div>
                            </div>

                            <div class="d-grid gap-2 mb-4">
                                <button id="registerSubmit" type="submit" class="btn btn-lg btn-primary">
                                    <i class="bi bi-person-plus-fill me-2"></i>Create Account
                                </button>
                            </div>

                            <hr class="my-4" />

                            <div class="text-center">
                                <p class="mb-0">
                                    Already have an account? <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold">Sign in here</a>
                                </p>
                            </div>
                        </form>
                    </section>
                </div>
            </div>

            @* External Login Section (only shown if providers are configured) *@
            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <div class="card shadow-sm mt-4">
                    <div class="card-body p-4">
                        <h5 class="card-title text-center mb-3">Or register with</h5>
                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            <div class="d-grid gap-2">
                                @foreach (var provider in Model.ExternalLogins!)
                                {
                                    <button type="submit" class="btn btn-outline-secondary" name="provider" value="@provider.Name" title="Register using your @provider.DisplayName account">
                                        <i class="bi bi-@provider.Name.ToLower()"></i> @provider.DisplayName
                                    </button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>

    <!-- Enhanced Accessibility Styles -->
    <style>
        /* Skip Links for Enhanced Keyboard Navigation */
        .skip-links {
            position: relative;
            z-index: 1050;
        }

        .skip-link {
            position: absolute !important;
            left: -10000px !important;
            top: auto !important;
            width: 1px !important;
            height: 1px !important;
            overflow: hidden !important;
        }

        .skip-link:focus {
            position: static !important;
            width: auto !important;
            height: auto !important;
            overflow: visible !important;
            margin: 0 0.5rem 0.5rem 0 !important;
            padding: 0.5rem 1rem !important;
            z-index: 1051 !important;
        }

        /* Screen Reader Only but Focusable Elements */
        .sr-only-focusable:not(:focus):not(:focus-within) {
            position: absolute !important;
            width: 1px !important;
            height: 1px !important;
            padding: 0 !important;
            margin: -1px !important;
            overflow: hidden !important;
            clip: rect(0, 0, 0, 0) !important;
            white-space: nowrap !important;
            border: 0 !important;
        }
    </style>
}