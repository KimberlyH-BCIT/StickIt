@model IEnumerable<ELKH.Models.AuditEntryModel>

@{
    ViewData["Title"] = "Audit Log";
}

<h2>Audit Log</h2>
<p class="text-muted">Administrative audit trail for compliance and security monitoring.</p>

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="date" name="from" class="form-control" placeholder="From Date" />
    </div>
    <div class="col-auto">
        <input type="date" name="to" class="form-control" placeholder="To Date" />
    </div>
    <div class="col-auto">
        <input name="actor" placeholder="Actor" class="form-control" />
    </div>
    <div class="col-auto">
        <input name="action" placeholder="Action" class="form-control" />
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Filter</button>
        <a class="btn btn-outline-secondary ms-1" href="?export=csv">Export CSV</a>
    </div>
</form>

<table class="table table-sm table-hover">
    <thead>
        <tr>
            <th>Time (UTC)</th>
            <th>Actor</th>
            <th>Action</th>
            <th>Keys Affected</th>
            <th>Reason</th>
            <th>Details</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Timestamp.ToString("u")</td>
                <td>@a.Actor</td>
                <td>@a.Action</td>
                <td>@a.AffectedKeysCount</td>
                <td>@a.Reason</td>
                <td style="max-width:400px;word-break:break-all;">@a.Details</td>
                <td>
                    @if (!string.IsNullOrEmpty(a.Details))
                    {
                        <a asp-area="Admin" asp-controller="Audit" asp-action="Details" asp-route-id="@a.Id">View Keys</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<nav>
    <ul class="pagination">
        @{ var page = ViewBag.Page as int? ?? 1; var totalPages = ViewBag.TotalPages as int? ?? 1; }
        @for (int i = 1; i <= totalPages; i++)
        {
            <li class="page-item @(i == page ? "active" : "")"><a class="page-link" href="?page=@i">@i</a></li>
        }
    </ul>
</nav>
