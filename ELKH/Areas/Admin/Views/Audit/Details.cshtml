@model ELKH.Models.AuditEntryModel

@{
    ViewData["Title"] = "Audit Details";
}

<h2>Audit Details</h2>

<div class="card">
    <div class="card-body">
        <h5 class="card-title">@Model.Action</h5>
        <h6 class="card-subtitle mb-2 text-muted">By @Model.Actor on @Model.Timestamp.ToString("u")</h6>
        <p><strong>Reason:</strong> @Model.Reason</p>
        <p><strong>Affected keys:</strong> @Model.AffectedKeysCount</p>
        <pre style="white-space:pre-wrap;">@Model.Details</pre>
    </div>
</div>

<a asp-area="Admin" asp-controller="Audit" asp-action="Index" class="btn btn-secondary mt-3">Back to Audit Log</a>
