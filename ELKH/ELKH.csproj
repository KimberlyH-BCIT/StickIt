    <Compile Remove="Views\Manager\**" />
    <Content Remove="Repostories\**" />
    <Content Remove="View Models\**" />
    <Content Remove="Views\Manager\**" />
    <EmbeddedResource Remove="Repostories\**" />
    <EmbeddedResource Remove="View Models\**" />
