    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-ELKH-b32582b7-e53b-4481-ba17-11a5c3c1aa56</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Repostories\**" />
