## =====================================================================
## .NET 10 / ASP.NET Core Razor Pages - Best Practices .gitignore
## =====================================================================
## This file prevents sensitive data, build artifacts, and temporary
## files from being committed to version control.
##
## Last Updated: 2026
## Target: .NET 10, ASP.NET Core, Razor Pages
## =====================================================================

# =====================================================================
# EF Core Migrations (temporary)
# =====================================================================
# Each developer maintains their own local SQLite database with mock data
# so migrations create merge conflicts without adding any value right now.
# Remove this section when the team switches to a shared/production database.
Migrations/

# =====================================================================
# User-Specific Files
# =====================================================================
# Visual Studio user preferences and workspace settings
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# MonoDevelop/Xamarin Studio
*.userprefs

# Rider
.idea/
*.sln.iml

# VS Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Mono auto generated files
mono_crash.*

# =====================================================================
# Build Results
# =====================================================================
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]logs/

# Visual Studio cache/options
.vs/

# Visual Studio auto generated files
Generated\ Files/

# =====================================================================
# End-to-End Testing (Playwright)
# =====================================================================
# Playwright writes test artifacts, traces, and screenshots here.
# These are CI/CD outputs — they must not be committed to source control.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Playwright HAR files and state snapshots captured during test runs.
*.har
*.zip

# =====================================================================
# Test Results
# =====================================================================
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
*.VisualState.xml
TestResult.xml
nunit-*.xml

# xUnit
*.xunit.runner.json

# MSTest
*.trx

# Coverlet/Code Coverage
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml

# =====================================================================
# .NET Core / .NET 10 Specific
# =====================================================================
project.lock.json
project.fragment.lock.json
artifacts/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# StyleCop
StyleCopReport.xml

