# =====================================================================
# Publishing
# =====================================================================
# Click-Once directory
publish/

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml

# Web deploy settings (may contain sensitive data)
*.pubxml
*.publishproj

# Azure publish settings
PublishScripts/

# =====================================================================
# NuGet
# =====================================================================
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# =====================================================================
# Microsoft Azure
# =====================================================================
csx/
*.build.csdef
ecf/
rcf/

# Azure Functions
local.settings.json
.azurefunctions/

# =====================================================================
# Windows Store Apps
# =====================================================================
AppPackages/
BundleArtifacts/
Package.StoreAssociation.xml
_pkginfo.txt
*.appx
*.appxbundle
*.appxupload

# =====================================================================
# Cache Files
# =====================================================================
*.[Cc]ache
!?*.[Cc]ache/

# =====================================================================
# Database Files
# =====================================================================
# SQLite databases (development only)
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# SQL Server
*.mdf
*.ldf
*.ndf

# LocalDB
*.localdb

# Database backups
*.bak

# Project-specific: Development database
/ELKH/app.db
/ELKH/app.db-shm
/ELKH/app.db-wal

# =====================================================================
# Secrets & Configuration
# =====================================================================
# User secrets (ASP.NET Core)
**/secrets.json
secrets.*

# All environment-specific appsettings overrides — NEVER commit production credentials.
# The base appsettings.json (no environment suffix) is intentionally tracked.
appsettings.*.json

# FileEmailSender output directory — may contain Identity confirmation tokens
# and other sensitive email content written during local development.
SavedEmails/
**/SavedEmails/

# Environment variables
.env
.env.local
.env.*.local

# Certificates
*.pfx
*.p12
*.key
*.cer
*.crt

# API keys and tokens
**/apikeys.json
**/tokens.json

# =====================================================================
# Logs & Temporary Files
# =====================================================================
*.log
logs/
*.tmp
temp/
tmp/

# Health checks DB
healthchecksdb
healthchecksdb-shm
healthchecksdb-wal

# =====================================================================
# Backup & Migration Files
# =====================================================================
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak
MigrationBackup/

# =====================================================================
# Business Intelligence
# =====================================================================
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# =====================================================================
# Fakes & Mocks
# =====================================================================
FakesAssemblies/

# =====================================================================
