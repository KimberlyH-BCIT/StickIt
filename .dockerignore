# =====================================================================
# Docker Ignore File for ELKH Sticker Store - Best Practices
# =====================================================================
# Optimizes build context, improves build performance, and enhances security
# by excluding unnecessary files from the Docker build context.
#
# Last Updated: March 2026
# Target: .NET 10, ASP.NET Core, Razor Pages, Production Deployment
# =====================================================================

# =====================================================================
# .NET Build Artifacts
# =====================================================================
**/bin/
**/obj/
**/out/
**/publish/
**/.vs/
**/.vscode/
**/artifacts/

# =====================================================================
# Development Files & IDE
# =====================================================================
.git/
.gitignore
.gitattributes
**/*.md
!README.md
.env*
.env.local
.env.development
.env.staging
.editorconfig

# Visual Studio
.vs/
*.user
*.suo
*.userprefs
*.sln.docstates

# VS Code
.vscode/
!.vscode/tasks.json
!.vscode/launch.json

# JetBrains Rider
.idea/
*.sln.iml

# =====================================================================
# Testing and Coverage
# =====================================================================
**/TestResults/
**/coverage/
**/test-results/
**/playwright-report/
**/blob-report/
**/*.trx
**/*.coverage
**/*.coveragexml
**/*.har

# xUnit
*.xunit.runner.json

# Playwright
playwright/.cache/
e2e/test-results/
e2e/playwright-report/

# =====================================================================
# Node.js (if any front-end build tools)
# =====================================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock

# =====================================================================
# Database Files
# =====================================================================
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/*.mdf
**/*.ldf
healthchecksdb*

# =====================================================================
# Secrets & Configuration
# =====================================================================
# User secrets
**/secrets.json
secrets.*

# Environment-specific configurations
appsettings.Development.json
appsettings.Staging.json
appsettings.Production.json
appsettings.*.json
!appsettings.json

# Sensitive files
*.pfx
*.p12
*.key
*.cer
*.crt
*.pem

# API keys and tokens
**/apikeys.json
**/tokens.json

# Email test output
SavedEmails/
**/SavedEmails/

# =====================================================================
# Logs and Temporary Files
# =====================================================================
**/logs/
**/*.log
**/temp/
**/tmp/
**/*.tmp

# =====================================================================
# OS Generated Files
# =====================================================================
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*~
.directory

# =====================================================================
# Container and Deployment Files
# =====================================================================
Dockerfile*
docker-compose*
.dockerignore
kubernetes/
helm/
charts/

# =====================================================================
# CI/CD Files
# =====================================================================
.github/
.gitlab-ci.yml
azure-pipelines.yml
buildspec.yml
Jenkinsfile
.circleci/

# =====================================================================
# Documentation (exclude from container)
# =====================================================================
docs/
docs/supplementalDocs/
documentation/
**/*.md
!README.md
**/*.txt
!requirements.txt

# =====================================================================
# Monitoring & Analysis
# =====================================================================
# Grafana
grafana/data/
grafana/logs/

# Prometheus
prometheus-data/

# Application Insights
ApplicationInsightsOfflineCache/

# SonarQube
.sonarqube/

# =====================================================================
# Development Tools
# =====================================================================
# Backup files
*.backup
*.bak
*~

# Profiling
*.diagsession
*.psess
*.vsp
*.vspx
*.dmp

# Coverage
*.dotCover

# =====================================================================
# User-Generated Content (Development)
# =====================================================================
# User uploads during development
wwwroot/uploads/user-content/
wwwroot/images/user-uploads/

# =====================================================================
# Cache and Build Artifacts
# =====================================================================
**/*.cache
.sass-cache/

# NuGet
*.nupkg
*.snupkg

# Package managers
**/packages/
!**/packages/build/

# =====================================================================
# Documentation - Selective Inclusion Enhancement
# =====================================================================
# Exclude all markdown files by default
**/*.md

# But include essential deployment documentation
!README.md
!docs/DEPLOYMENT.md
!docs/API.md
!Infrastructure/README.md

# =====================================================================
# Modern Development Enhancements
# =====================================================================
# .NET Hot Reload files
*.runtimeconfig.dev.json
*.HotReloadInfo.json
*.hotreload.json
HotReloadServer*/

# JetBrains profiling tools
*.dmw
*.dpw
*.dwp
*.workspace
*.dtp
*.dtp.*

# Azure Functions
.azure/
.azurefunctions/
PublishProfiles/

# Tye orchestrator
.tye/

# DevContainers
.devcontainer/

# Codespaces
.codespaces/

