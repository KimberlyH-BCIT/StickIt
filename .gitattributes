# =====================================================================
# Git Attributes for ELKH .NET 10 Project - Best Practices
# =====================================================================
# Controls how Git handles line endings and file merging
# Last Updated: March 2026
# =====================================================================

# Auto detect text files and perform LF normalization
* text=auto

# =====================================================================
# Source Code Files
# =====================================================================
*.cs text diff=csharp
*.csx text diff=csharp
*.vb text
*.fs text
*.fsx text
*.fsi text

# =====================================================================
# Web Files
# =====================================================================
*.html text diff=html
*.htm text diff=html
*.cshtml text diff=html
*.razor text diff=html
*.css text diff=css
*.scss text diff=css
*.sass text diff=css
*.less text diff=css
*.js text
*.ts text
*.tsx text
*.jsx text
*.json text
*.xml text
*.yml text
*.yaml text

# =====================================================================
# Configuration Files
# =====================================================================
*.config text
*.conf text
*.ini text
*.cfg text
*.properties text
*.settings text

# =====================================================================
# Documentation
# =====================================================================
*.md text diff=markdown
*.txt text
*.rtf text
*.rst text

# =====================================================================
# Project Files (union merge for better collaboration)
# =====================================================================
*.csproj text merge=union
*.vbproj text merge=union
*.fsproj text merge=union
*.sln text merge=union
*.props text
*.targets text
*.nuspec text

# =====================================================================
# Database & Migrations
# =====================================================================
*.sql text

# =====================================================================
# Scripts
# =====================================================================
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# =====================================================================
# Binary Files (explicit binary marking)
# =====================================================================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary
*.bmp binary
*.tiff binary
*.tif binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary
*.ppt binary
*.pptx binary

# Archives
*.zip binary
*.7z binary
*.tar binary
*.gz binary
*.rar binary

# Executables and Libraries
*.exe binary
*.dll binary
*.lib binary
*.a binary
*.so binary
*.dylib binary

# Fonts
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary

# Database files
*.db binary
*.sqlite binary
*.sqlite3 binary

# =====================================================================
# Merge Strategies
# =====================================================================
# Use union merge for changelog files
CHANGELOG.md merge=union
CHANGELOG.txt merge=union

# Don't merge generated files
*.designer.cs -merge
*.Designer.cs -merge
*.generated.cs -merge
*.g.cs -merge
*.g.i.cs -merge

# =====================================================================
# Platform-specific line endings
# =====================================================================
# Ensure shell scripts use LF on all platforms
*.sh text eol=lf
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf

# Ensure batch files use CRLF on all platforms  
*.bat text eol=crlf
*.cmd text eol=crlf

# =====================================================================
# Visual Studio specific
# =====================================================================
*.resx text
*.vsixmanifest text
*.vsct text

# =====================================================================
# Special files
# =====================================================================
# License and readme files
LICENSE text
COPYING text
README text
readme.txt text
